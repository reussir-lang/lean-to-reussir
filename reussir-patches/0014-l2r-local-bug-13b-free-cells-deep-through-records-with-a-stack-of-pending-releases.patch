diff --git a/crates/reussir-rt/src/drop.rs b/crates/reussir-rt/src/drop.rs
new file mode 100644
index 00000000..b31fd822
--- /dev/null
+++ b/crates/reussir-rt/src/drop.rs
@@ -0,0 +1,101 @@
+//! Pending releases of the compiler's drop glue.
+//!
+//! Freeing a value releases the cells it holds, and theirs, and so on. Doing
+//! that by recursion takes stack proportional to the depth of the value, so
+//! the drop glue instead hands the members it frees to one stack of pending
+//! work per thread, as Lean's `lean_del` does with its to-do list: a member
+//! whose last reference the glue drops is pushed together with the glue
+//! function that releases it ([`__reussir_drop_defer`]), and the outermost
+//! drop empties the stack ([`__reussir_drop_drain`]), last pushed first. The
+//! depth of the native stack stays bounded however deep the value is, and
+//! resources held in records are released in Lean's order (a record's last
+//! member first).
+//!
+//! Code that frees other kinds of objects (a host runtime's containers, say)
+//! can share the stack, so that one free releases everything in one order:
+//! [`active`], [`depth`], [`defer_step`] and [`run_step`] push incremental work, which
+//! stays on the stack while it runs, so whatever it pushes is done before its
+//! next step.
+
+use core::cell::{Cell, RefCell};
+
+/// Releases one pending member, given the pointer it was deferred with.
+pub type Release = unsafe extern "C" fn(*mut u8);
+
+/// One step of incremental work on `p`; answers whether the work is done.
+pub type Step = unsafe fn(usize) -> bool;
+
+#[derive(Clone, Copy)]
+enum Work {
+    Release(*mut u8, Release),
+    Step(usize, Step),
+}
+
+thread_local! {
+    static PENDING: RefCell<Vec<Work>> = const { RefCell::new(Vec::new()) };
+    static DRAINING: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Whether the current thread is emptying its pending stack (work started
+/// now is pushed and done by that drain).
+#[inline]
+pub fn active() -> bool {
+    DRAINING.with(|draining| draining.get())
+}
+
+/// The number of pending entries (a step can tell whether it pushed work).
+#[inline]
+pub fn depth() -> usize {
+    PENDING.with(|pending| pending.borrow().len())
+}
+
+/// Pushes incremental work: `step(p)` runs, while the entry stays on the
+/// stack, until it answers that it is done.
+pub fn defer_step(p: usize, step: Step) {
+    PENDING.with(|pending| pending.borrow_mut().push(Work::Step(p, step)));
+}
+
+/// Runs incremental work and everything it pushes; inside a drain, only
+/// pushes it.
+pub fn run_step(p: usize, step: Step) {
+    defer_step(p, step);
+    unsafe { __reussir_drop_drain() };
+}
+
+/// Defers `release(cell)` until the current thread drains its pending work.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __reussir_drop_defer(cell: *mut u8, release: Release) {
+    PENDING.with(|pending| pending.borrow_mut().push(Work::Release(cell, release)));
+}
+
+/// Runs the current thread's pending work, last pushed first, until none is
+/// left, including the work it pushes in turn. A call made while the thread
+/// is already draining (from a release) returns at once: the outermost call
+/// runs whatever is pushed meanwhile.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __reussir_drop_drain() {
+    if DRAINING.with(|draining| draining.replace(true)) {
+        return;
+    }
+    loop {
+        let top = PENDING.with(|pending| {
+            let pending = pending.borrow();
+            pending.last().map(|&work| (pending.len() - 1, work))
+        });
+        match top {
+            None => break,
+            Some((_, Work::Release(cell, release))) => {
+                PENDING.with(|pending| pending.borrow_mut().pop());
+                unsafe { release(cell) };
+            }
+            Some((index, Work::Step(p, step))) => {
+                if unsafe { step(p) } {
+                    PENDING.with(|pending| {
+                        pending.borrow_mut().remove(index);
+                    });
+                }
+            }
+        }
+    }
+    DRAINING.with(|draining| draining.set(false));
+}
