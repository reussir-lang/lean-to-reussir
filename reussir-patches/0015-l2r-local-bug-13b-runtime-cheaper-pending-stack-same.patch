 //! [`active`], [`depth`], [`defer_step`] and [`run_step`] push incremental work, which
 //! stays on the stack while it runs, so whatever it pushes is done before its
 //! next step.
+//!
+//! The glue calls these functions for every cell it frees, so they are kept
+//! cheap. The state is one thread-local with no destructor (an access is only
+//! its address, with no lazy registration or borrow flags). The top entry,
+//! when it is a run (the entry every deferral and every pop touches), is kept
+//! in the state itself, and the entries below it in a vector: freeing a cell
+//! whose members defer one cell does not touch the vector. A drain with
+//! nothing pending, or started while one runs, returns after a load or two,
+//! and one with a single cell pending releases it without the general loop.
+//! The vector, kept between drops, is freed at thread exit by a guard
+//! registered when it is first allocated.
 
-use core::cell::{Cell, RefCell};
+use core::cell::Cell;
+use core::mem::ManuallyDrop;
+use core::ptr::NonNull;
 
 /// Releases one pending member, given the pointer it was deferred with.
 pub type Release = unsafe extern "C" fn(*mut u8);
@@ -46,7 +59,11 @@ enum Work {
     /// `n` deferred cells, the last pushed at `head`, to be released with
     /// `release`; every cell of the run but the first pushed links to the
     /// cell pushed before it (see the module comment).
-    Run { release: Release, head: *mut u8, n: u32 },
+    Run {
+        release: Release,
+        head: *mut u8,
+        n: u32,
+    },
     Step(usize, Step),
 }
 
@@ -62,18 +79,286 @@ const SAME: u32 = 0xff;
 /// Offsets (in 8-byte units) a link can hold: 40 bits, signed.
 const OFFSET_BITS: u32 = 40;
 
-thread_local! {
-    static PENDING: RefCell<Vec<Work>> = const { RefCell::new(Vec::new()) };
-    static DRAINING: Cell<bool> = const { Cell::new(false) };
+/// The current thread's pending work: the entries of the vector, then the
+/// run `(n, head, release)` if `n` is not 0. The top entry is a run exactly
+/// when `n` is not 0 (a run on top is always kept here), so the vector's last
+/// entry, when `n` is 0, is a step.
+#[repr(C)]
+struct State {
+    n: Cell<u32>,
+    /// Whether the thread is emptying the stack.
+    draining: Cell<bool>,
+    head: Cell<*mut u8>,
+    release: Cell<Release>,
+    /// The entries below: a `Vec<Work>` by its raw parts.
+    len: Cell<usize>,
+    ptr: Cell<NonNull<Work>>,
+    cap: Cell<usize>,
+    /// The number of entries of `releases` in use.
+    known: Cell<usize>,
     /// The release functions that links name, by index (at most 255).
-    static RELEASES: RefCell<Vec<Release>> = const { RefCell::new(Vec::new()) };
+    releases: [Cell<Release>; SAME as usize],
+}
+
+/// No release function (a field or table entry not in use).
+unsafe extern "C" fn unnamed(_: *mut u8) {
+    unreachable!("a link names no release function")
+}
+
+thread_local! {
+    static STATE: State = const {
+        State {
+            n: Cell::new(0),
+            draining: Cell::new(false),
+            head: Cell::new(core::ptr::null_mut()),
+            release: Cell::new(unnamed as Release),
+            len: Cell::new(0),
+            ptr: Cell::new(NonNull::dangling()),
+            cap: Cell::new(0),
+            known: Cell::new(0),
+            releases: [const { Cell::new(unnamed as Release) }; SAME as usize],
+        }
+    };
+    /// Frees the vector at thread exit (registered with its first buffer).
+    static GUARD: Guard = const { Guard };
+}
+
+/// The current thread's state. Only for use within the current call: the
+/// reference does not outlive the thread (`State` is not `Sync`, so it
+/// cannot leave it), and the state has no destructor.
+#[inline(always)]
+fn state() -> &'static State {
+    STATE.with(|state| unsafe { &*(state as *const State) })
+}
+
+struct Guard;
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        let _ = STATE.try_with(|state| {
+            let cap = state.cap.replace(0);
+            let len = state.len.replace(0);
+            let ptr = state.ptr.replace(NonNull::dangling());
+            if cap != 0 {
+                drop(unsafe { Vec::from_raw_parts(ptr.as_ptr(), len, cap) });
+            }
+        });
+    }
+}
+
+impl State {
+    /// The number of entries.
+    #[inline(always)]
+    fn depth(&self) -> usize {
+        self.len.get() + (self.n.get() != 0) as usize
+    }
+
+    /// Runs `f` on the vector as a `Vec`, and keeps its new parts.
+    fn with_vec(&self, f: impl FnOnce(&mut Vec<Work>)) {
+        let mut stack = ManuallyDrop::new(unsafe {
+            Vec::from_raw_parts(self.ptr.get().as_ptr(), self.len.get(), self.cap.get())
+        });
+        f(&mut stack);
+        self.ptr
+            .set(unsafe { NonNull::new_unchecked(stack.as_mut_ptr()) });
+        self.len.set(stack.len());
+        self.cap.set(stack.capacity());
+    }
+
+    /// Makes room for one more entry in the vector.
+    #[cold]
+    #[inline(never)]
+    fn grow(&self) {
+        if self.cap.get() == 0 {
+            // Past the guard's destruction (a release from another
+            // thread-local's destructor) the buffer is left to the OS.
+            let _ = GUARD.try_with(|_| ());
+        }
+        self.with_vec(|stack| stack.reserve(1));
+    }
+
+    /// Moves the run on top, if any, to the vector (another entry goes on
+    /// top). Answers false, changing nothing, when the vector is full.
+    #[inline(always)]
+    fn try_spill(&self) -> bool {
+        let n = self.n.get();
+        if n == 0 {
+            return true;
+        }
+        let len = self.len.get();
+        if len == self.cap.get() {
+            return false;
+        }
+        unsafe {
+            self.ptr.get().as_ptr().add(len).write(Work::Run {
+                release: self.release.get(),
+                head: self.head.get(),
+                n,
+            })
+        };
+        self.len.set(len + 1);
+        self.n.set(0);
+        true
+    }
+
+    /// After the top entry left: the vector's last entry is the top now,
+    /// kept in the state if it is a run.
+    #[inline(always)]
+    fn unspill(&self) {
+        let len = self.len.get();
+        if len != 0
+            && let Work::Run { release, head, n } =
+                unsafe { self.ptr.get().as_ptr().add(len - 1).read() }
+        {
+            self.release.set(release);
+            self.head.set(head);
+            self.n.set(n);
+            self.len.set(len - 1);
+            return;
+        }
+        self.n.set(0);
+    }
+
+    /// The link's index for `prev_release`, the function of the cell linked
+    /// to, from a cell released with `release`.
+    #[inline(always)]
+    fn release_index(&self, prev_release: Release, release: Release) -> Option<u32> {
+        if prev_release as usize == release as usize {
+            return Some(SAME);
+        }
+        let known = self.known.get().min(SAME as usize);
+        match self.releases[..known]
+            .iter()
+            .rposition(|f| f.get() as usize == prev_release as usize)
+        {
+            Some(index) => Some(index as u32),
+            None if known < SAME as usize => {
+                self.releases[known].set(prev_release);
+                self.known.set(known + 1);
+                Some(known as u32)
+            }
+            None => None,
+        }
+    }
+
+    /// Links `cell`, deferred with `release` and with a wide header, to
+    /// `prev`, the head of the run on top, deferred with `prev_release`;
+    /// answers whether it did (if not, nothing changed).
+    #[inline(always)]
+    unsafe fn link(
+        &self,
+        cell: *mut u8,
+        release: Release,
+        prev: *mut u8,
+        prev_release: Release,
+    ) -> bool {
+        let (at, to) = (cell as usize, prev as usize);
+        // An immediate's dummy box (nonzero top byte) is shared: never written.
+        if at >> 56 != 0 || (at | to) & 7 != 0 {
+            return false;
+        }
+        let units = (to as isize).wrapping_sub(at as isize) >> 3;
+        let limit = 1isize << (OFFSET_BITS - 1);
+        if units == 0 || !(-limit..limit).contains(&units) {
+            return false;
+        }
+        let Some(index) = self.release_index(prev_release, release) else {
+            return false;
+        };
+        let units = units as u64;
+        let words = cell.cast::<u32>();
+        unsafe {
+            words.write(((units as u32 & 0xff_ffff) << 8) | index);
+            let tag = words.add(1).read() & 0xffff;
+            words
+                .add(1)
+                .write((((units >> 24) as u32 & 0xffff) << 16) | tag);
+        }
+        true
+    }
+
+    /// Defers `release(cell)`: links it to the run on top, or starts a run.
+    /// Answers false, changing nothing, when that needs the vector to grow.
+    #[inline(always)]
+    unsafe fn try_defer(&self, cell: *mut u8, release: Release, wide: bool) -> bool {
+        let n = self.n.get();
+        if wide
+            && n != 0
+            && n < u32::MAX
+            && unsafe { self.link(cell, release, self.head.get(), self.release.get()) }
+        {
+            self.head.set(cell);
+            self.release.set(release);
+            self.n.set(n + 1);
+            return true;
+        }
+        if !self.try_spill() {
+            return false;
+        }
+        self.head.set(cell);
+        self.release.set(release);
+        self.n.set(1);
+        true
+    }
+
+    /// The body of [`__reussir_drop_drain`] when work is pending and no drain
+    /// runs.
+    #[inline(always)]
+    unsafe fn drain(&self) {
+        self.draining.set(true);
+        loop {
+            let n = self.n.get();
+            if n != 0 {
+                let (head, release) = (self.head.get(), self.release.get());
+                if n == 1 {
+                    self.unspill();
+                } else {
+                    let (prev, index) = unsafe { unlink(head) };
+                    if index != SAME {
+                        self.release.set(self.releases[index as usize].get());
+                    }
+                    self.head.set(prev);
+                    self.n.set(n - 1);
+                }
+                unsafe { release(head) };
+                continue;
+            }
+            let len = self.len.get();
+            if len == 0 {
+                break;
+            }
+            // The top entry is a step.
+            let index = len - 1;
+            let Work::Step(p, step) = (unsafe { self.ptr.get().as_ptr().add(index).read() }) else {
+                unreachable!("the vector's last entry is a run")
+            };
+            if unsafe { step(p) } {
+                // Whatever the step pushed stays above it.
+                let now = self.len.get();
+                unsafe {
+                    let at = self.ptr.get().as_ptr().add(index);
+                    core::ptr::copy(at.add(1), at, now - index - 1);
+                }
+                self.len.set(now - 1);
+                if now == len && self.n.get() == 0 {
+                    self.unspill();
+                }
+            }
+        }
+        // Nothing is pending, so no link names a table entry.
+        self.known.set(0);
+        if self.cap.get() > KEEP {
+            self.with_vec(|stack| stack.shrink_to(KEEP));
+        }
+        self.draining.set(false);
+    }
 }
 
