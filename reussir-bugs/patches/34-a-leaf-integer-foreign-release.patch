From a1d3e5fb1b65f4dc9d1c4b6c5bf523e3e459de5c Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Wed, 18 Nov 2026 14:44:56 -0500
Subject: [PATCH 12/18] [drop] release a foreign box of scalars and integers in
 place

A `reussir.foreign_drop` function keeps its direct body when the payload
of its box is a leaf by the classification of the worklist glue
(scalars, arbitrary-precision integers, value records of them) or a
variant whose arms are all such leaves. The rule is per box type: a
variant with one arm that holds a box, a record with a box or a foreign
object, and a regional box keep the bridge. It holds under both drop
orders.

Such a box has no child and no cleanup hook. Its release decrements the
count, releases the integers, which never touches the drop stack, and
frees the box, so the destruction scope that the bridge opened had
nothing to run. This extends the rule for boxes of trivially copyable
payloads to integers and depends on the leaf classification of the
integer-members change.

Measured on 53 programs of a compiler that targets Reussir, direct
pairs, median of 9 and minimum: one program that keeps records of two
integers in an array goes from 315.6 ms to 295.6 ms (0.937) and its
665,000 scope entries fall to 0; the geometric mean is 0.999, no other
program moves by more than 3%, and peak memory and code size are
unchanged (1.000). A foreign release worker disappears in 20 of the 53
programs. The variant rule was checked for correctness and is not timed
on its own.

Tests: conversion/worklist_drop_bridges_integers.mlir (a record of
integers and a scalar, a record of value records, a variant of leaf
arms keep their bodies under both drop orders; a variant with a boxed
arm, a record with a box and one with a foreign object get the bridge).
Runs with a tracking integer allocator over foreign vectors of such
records, dropped whole and element by element: 16 runs, no integer left
alive, no bad free.
---
 .../AcquireDropExpansion/WorklistDrop.cpp     | 21 ++++-
 .../worklist_drop_bridges_integers.mlir       | 90 +++++++++++++++++++
 2 files changed, 109 insertions(+), 2 deletions(-)
 create mode 100644 tests/integration/conversion/worklist_drop_bridges_integers.mlir

diff --git a/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp b/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp
index 83129e95..8cff6b48 100644
--- a/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp
+++ b/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp
@@ -459,6 +459,22 @@ public:
     call->setAttr(kMustTailCallAttr, builder.getUnitAttr());
   }
 
+  // Whether releasing a box of `payload` only releases integers in place
+  // and frees the box: a leaf, or a variant whose arms are all leaves.
+  static bool releasesInPlace(mlir::Type payload) {
+    auto record = llvm::dyn_cast<RecordType>(payload);
+    if (!record || !record.isVariant() || !record.getComplete())
+      return classify(payload) == Visit::Leaf;
+    return llvm::all_of(
+        llvm::zip(record.getMembers(), record.getMemberIsField()),
+        [](auto arm) {
+          auto [member, field] = arm;
+          return !field &&
+                 classify(getProjectedType(member, false,
+                                           Capability::shared)) == Visit::Leaf;
+        });
+  }
+
   // Release the integers stored in line in `slot` and hand its boxes to
   // `onBox`. Only for a slot that `classify` does not call `Ordered`.
   void visitInline(mlir::Value slot,
@@ -703,8 +719,9 @@ prepareWorklistDropBridges(mlir::ModuleOp module,
     } else if (auto rc =
                    llvm::dyn_cast<RcType>(function.getArgument(0).getType());
                rc && !rc.isRegional() &&
-               isTriviallyCopyable(rc.getElementType())) {
-      // Releasing such a box only frees it: no work to enqueue, no scope.
+               WorklistGlue::releasesInPlace(rc.getElementType())) {
+      // Releasing such a box releases its integers in place and frees it:
+      // no work to enqueue, no scope.
       function->removeAttr(REUSSIR_FOREIGN_DROP);
       continue;
     }
diff --git a/tests/integration/conversion/worklist_drop_bridges_integers.mlir b/tests/integration/conversion/worklist_drop_bridges_integers.mlir
new file mode 100644
index 00000000..b28ab62d
--- /dev/null
+++ b/tests/integration/conversion/worklist_drop_bridges_integers.mlir
@@ -0,0 +1,90 @@
+// REQUIRES: rcgmp
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true' --verify-each | %FileCheck %s --implicit-check-not='{{(two|nest|val)}}.worklist'
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true drop-order=forward' --verify-each | %FileCheck %s --implicit-check-not='{{(two|nest|val)}}.worklist'
+
+// A foreign drop of a box of scalars and integers releases the integers in
+// place and frees the box: it keeps its body, as a box of scalars does. A
+// variant qualifies when every arm does. A box or a foreign object in the
+// payload keeps the bridge.
+
+!handle = !reussir.rc<!reussir.ffi_object<"Handle", @handle_drop>>
+!two = !reussir.record<compound "Two" { !rcgmp.mpz, i64, !rcgmp.mpz }>
+!inner = !reussir.record<compound "Inner" [value] { !rcgmp.mpz, f64 }>
+!nest = !reussir.record<compound "Nest" { !inner, !inner }>
+!vnat = !reussir.record<compound "Val::N" [value] { !rcgmp.mpz }>
+!vnone = !reussir.record<compound "Val::None" [value] { }>
+!val = !reussir.record<variant "Val" { !vnone, !vnat }>
+!leaf = !reussir.record<compound "Leaf" { i64 }>
+!mbox = !reussir.record<compound "Mixed::B" [value] { !leaf }>
+!mixed = !reussir.record<variant "Mixed" { !vnat, !mbox }>
+!held = !reussir.record<compound "Held" { !rcgmp.mpz, !leaf }>
+!owner = !reussir.record<compound "Owner" { !rcgmp.mpz, !handle }>
+!t24 = !reussir.nullable<!reussir.token<align: 8, size: 24>>
+!t32 = !reussir.nullable<!reussir.token<align: 8, size: 32>>
+!t40 = !reussir.nullable<!reussir.token<align: 8, size: 40>>
+!dyn = !reussir.nullable<!reussir.token<align: 8, size: ?>>
+module {
+  func.func private @handle_drop(!handle)
+
+  // CHECK-LABEL: func.func @two(
+  // CHECK-NOT: reussir.drop
+  // CHECK: call @{{.*}}drop_in_place
+  // CHECK-NOT: reussir.drop
+  // CHECK: return
+  func.func @two(%rc: !reussir.rc<!two shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!two shared>) : !t32
+    reussir.token.free(%token : !t32)
+    return
+  }
+
+  // Value records in the payload are stored in line.
+  // CHECK-LABEL: func.func @nest(
+  // CHECK-NOT: reussir.drop
+  // CHECK: call @{{.*}}drop_in_place
+  // CHECK-NOT: reussir.drop
+  // CHECK: return
+  func.func @nest(%rc: !reussir.rc<!nest shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!nest shared>) : !t40
+    reussir.token.free(%token : !t40)
+    return
+  }
+
+  // CHECK-LABEL: func.func @val(
+  // CHECK-NOT: reussir.drop
+  // CHECK: call @{{.*}}drop_in_place
+  // CHECK-NOT: reussir.drop
+  // CHECK: return
+  func.func @val(%rc: !reussir.rc<!val shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!val shared>) : !dyn
+    reussir.token.free(%token : !dyn)
+    return
+  }
+
+  // One arm of the variant holds a box.
+  // CHECK-LABEL: func.func private @mixed.worklist.
+  // CHECK-LABEL: func.func @mixed(
+  // CHECK: reussir.drop.join @mixed.worklist.
+  func.func @mixed(%rc: !reussir.rc<!mixed shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!mixed shared>) : !dyn
+    reussir.token.free(%token : !dyn)
+    return
+  }
+
+  // CHECK-LABEL: func.func private @held.worklist.
+  // CHECK-LABEL: func.func @held(
+  // CHECK: reussir.drop.join @held.worklist.
+  func.func @held(%rc: !reussir.rc<!held shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!held shared>) : !t24
+    reussir.token.free(%token : !t24)
+    return
+  }
+
+  // CHECK-LABEL: func.func private @owner.worklist.
+  // CHECK-LABEL: func.func @owner(
+  // CHECK: reussir.drop.join @owner.worklist.
+  func.func @owner(%rc: !reussir.rc<!owner shared>) attributes {reussir.foreign_drop} {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!owner shared>) : !t24
+    reussir.token.free(%token : !t24)
+    return
+  }
+}
