From 34df7ac4ccf392b59b913d34bd725460bfc564ec Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Sun, 25 Oct 2026 22:59:05 -0400
Subject: [PATCH 19/25] l2r-local: entry 23-k: drop stack: end work after the
 outermost drain

A host runtime registers one end function (set_end_work) and a release
asks for it (want_end_work); the outermost drain calls it once it has
ended, with the thread no longer draining and nothing pending. Outside a
drain the request calls it at once. For work that must not run inside a
drain because it may block or switch contexts: the drain state is the
thread's, so a context suspended inside it would make every other
context's drop join the suspended drain. A drain that nobody asked costs
one test at its end.

An end function whose own drops ask for the end work again gets it at the
end of their drains, inside the call: one nesting level per generation, as
native Lean's frees nest inside the dependents they run (deliberate).
---
 crates/reussir-rt/src/drop_stack.rs       | 57 ++++++++++++++++++++++-
 crates/reussir-rt/src/drop_stack/tests.rs | 37 +++++++++++++++
 2 files changed, 92 insertions(+), 2 deletions(-)

diff --git a/crates/reussir-rt/src/drop_stack.rs b/crates/reussir-rt/src/drop_stack.rs
index 40e75e4c..8f456b93 100644
--- a/crates/reussir-rt/src/drop_stack.rs
+++ b/crates/reussir-rt/src/drop_stack.rs
@@ -11,9 +11,17 @@
 //! the glue defers. Outside a drain the stack is empty. The stack never reads
 //! or writes a deferred pointer; its buffer shrinks back to `KEEP` entries
 //! after a drain and is freed at thread exit.
+//!
+//! A host runtime whose releases may need work that must not run inside a
+//! drain (code that may block or switch contexts, which would leave the
+//! thread's drain suspended) registers one end function ([`set_end_work`]);
+//! a release asks for it ([`want_end_work`]), and the outermost drain calls
+//! it once it has ended, with the thread no longer draining and nothing
+//! pending. A drain that nobody asked costs one test at its end.
 
 use core::cell::Cell;
 use core::mem::ManuallyDrop;
+use core::sync::atomic::{AtomicPtr, Ordering};
 
 /// Releases one deferred pointer.
 pub type Release = unsafe extern "C" fn(*mut u8);
@@ -27,10 +35,12 @@ struct Entry {
 /// Capacity the buffer keeps after a drain.
 const KEEP: usize = 64;
 
-/// Whether the thread drains, whether its exit guard ran (a later drain then
-/// frees its buffer), and its pending drops, a `Vec<Entry>` by raw parts.
+/// Whether the thread drains, whether a release asked for the end work,
+/// whether its exit guard ran (a later drain then frees its buffer), and its
+/// pending drops, a `Vec<Entry>` by raw parts.
 struct State {
     releasing: Cell<bool>,
+    end_work: Cell<bool>,
     exited: Cell<bool>,
     len: Cell<usize>,
     cap: Cell<usize>,
@@ -41,6 +51,7 @@ thread_local! {
     static STATE: State = const {
         State {
             releasing: Cell::new(false),
+            end_work: Cell::new(false),
             exited: Cell::new(false),
             len: Cell::new(0),
             cap: Cell::new(0),
@@ -136,6 +147,48 @@ unsafe extern "C" fn run_outermost(object: *mut u8, walk: Release) {
     unsafe { walk(object) };
     unsafe { state.pop_all() };
     state.releasing.set(false);
+    if state.end_work.get() {
+        end_work(state);
+    }
+}
+
+/// The end function a host registered ([`set_end_work`]), or null.
+static END_WORK: AtomicPtr<()> = AtomicPtr::new(core::ptr::null_mut());
+
+/// The function the end of a drain calls when a release asked for it
+/// ([`want_end_work`]). One per process: a later call replaces it.
+pub fn set_end_work(f: unsafe extern "C" fn()) {
+    END_WORK.store(f as *mut (), Ordering::Release);
+}
+
+/// Asks for the end function once the current thread's outermost drain is
+/// over. Outside a drain, calls it at once, as [`defer`] runs a release.
+#[inline(always)]
+pub fn want_end_work() {
+    let state = state();
+    if state.releasing.get() {
+        state.end_work.set(true);
+    } else {
+        end_work(state);
+    }
+}
+
+/// Uses up the request and calls the end function: the drain is over (the
+/// thread no longer drains, nothing is pending), so it may drop values,
+/// whose drains then end on their own. A drain inside the end function
+/// whose releases ask for the end work again runs it at its own end, inside
+/// this call: one level of nesting per generation, as native Lean's frees
+/// nest inside the dependents they run (deliberate; a host whose end work
+/// can chain without bound bounds it itself).
+#[cold]
+#[inline(never)]
+fn end_work(state: &State) {
+    state.end_work.set(false);
+    let f = END_WORK.load(Ordering::Acquire);
+    if !f.is_null() {
+        let f = unsafe { core::mem::transmute::<*mut (), unsafe extern "C" fn()>(f) };
+        unsafe { f() };
+    }
 }
 
 #[cold]
diff --git a/crates/reussir-rt/src/drop_stack/tests.rs b/crates/reussir-rt/src/drop_stack/tests.rs
index 1632ea17..b74059d4 100644
--- a/crates/reussir-rt/src/drop_stack/tests.rs
+++ b/crates/reussir-rt/src/drop_stack/tests.rs
@@ -122,6 +122,43 @@ fn a_drop_after_the_thread_exit_guard() {
     thread.join().unwrap();
 }
 
+// The end work: asked for by releases inside a drain, called once after the
+// outermost drain, with the thread no longer draining and nothing pending.
+thread_local! {
+    static ENDS: RefCell<Vec<(bool, usize)>> = const { RefCell::new(Vec::new()) };
+}
+unsafe extern "C" fn end() {
+    ENDS.with(|e| e.borrow_mut().push((releasing(), state().len.get())));
+    log('e', 0);
+}
+unsafe extern "C" fn asks(cell: *mut u8) {
+    log('k', cell as usize);
+    want_end_work();
+}
+unsafe extern "C" fn asking_walk(_: *mut u8) {
+    unsafe { defer(p(1), asks) };
+    unsafe { defer(p(2), b) };
+    unsafe { defer(p(3), asks) };
+    unsafe { run(p(0), walk) };
+}
+
+#[test]
+fn end_work_runs_once_after_the_outermost_drain() {
+    set_end_work(end);
+    unsafe { run(p(0), asking_walk) };
+    let log = take_log();
+    assert_eq!(log.last(), Some(&('e', 0)));
+    assert_eq!(log.iter().filter(|e| e.0 == 'e').count(), 1);
+    assert_eq!(ENDS.with(|e| core::mem::take(&mut *e.borrow_mut())), [(false, 0)]);
+    // A drain that nobody asked: no end work.
+    unsafe { run(p(0), walk) };
+    assert!(!take_log().contains(&('e', 0)));
+    // Outside a drain the end work runs at once.
+    want_end_work();
+    assert_eq!(take_log(), [('e', 0)]);
+    assert_eq!(ENDS.with(|e| core::mem::take(&mut *e.borrow_mut())), [(false, 0)]);
+}
+
 #[test]
 fn symbols_are_exported() {
     let symbols = crate::symbols::exported_symbols();
