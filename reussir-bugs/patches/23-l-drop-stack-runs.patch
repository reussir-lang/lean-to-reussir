-            len: Cell::new(0),
-            cap: Cell::new(0),
-            ptr: Cell::new(core::ptr::dangling_mut()),
+            head: Cell::new(core::ptr::null_mut()),
+            release: Cell::new(unnamed as Release),
+            stack: Parts::new(),
+            cells: Parts::new(),
