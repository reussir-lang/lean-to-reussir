+    let read = len(v) == 3 && get(v, 0) == 1267650600228229401496703205376 && get(v, 1) == 7
+        && get(v, 2) == 147808829414345923316083210206383297601;
+    let w = set(set(v, 1, odd + 7), 0, 5);
+    read && get(w, 0) == 5 && get(w, 1) == 147808829414345923316083210206383297608
+        && get(w, 2) == 147808829414345923316083210206383297601
+}
