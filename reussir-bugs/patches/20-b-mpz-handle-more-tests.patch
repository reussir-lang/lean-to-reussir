+    #[test]
+    fn bigint_type_arguments_cross_the_ffi_as_owned_handles() {
+        // A type argument and a generic instantiated at `Nat` are the owned
+        // handle, which the body may store; a `Nat` the signature declares
+        // stays the raw handle, which the wrapper releases after the body.
+        check_with_bigint(
+            "#[ffi(rust = \"::reussir_rt::collections::vec::Vec\")]\n\
+             pub struct Vec<T>;\n\
+             #[ffi(import)]\n\
+             pub fn push<T>(v: Vec<T>, x: T) -> Vec<T> [{ v.push(x) }];\n\
+             #[ffi(import)]\n\
+             pub fn store(v: Vec<Nat>, n: Nat) -> Vec<Nat> [{ v }];\n\
+             pub fn f(v: Vec<Nat>, n: Nat) -> Vec<Nat> { store(push(v, n), n) }",
+            |elab, _| {
+                use crate::full::mir::RecordLayout;
+                assert!(!elab.has_errors(), "{:#?}", elab.reports);
+                let (full, reports) = crate::full::mono::monomorphize(&elab.mono_input());
+                assert!(reports.is_empty(), "{reports:#?}");
+                let owned = "::reussir_rt::rcgmp::Mpz";
+                let vec = format!("::reussir_rt::collections::vec::Vec<{owned}>");
+                let texture = |name: &str| {
+                    full.ffi_imports
+                        .iter()
+                        .find(|i| full.symbol(i.boundary).contains(name))
+                        .map(|i| i.texture.as_str())
+                        .unwrap_or_else(|| panic!("no texture for `{name}`"))
+                };
+                let push = texture("4push");
+                assert!(
+                    push.contains(&format!("(r#v: {vec}, r#x: {owned}) -> {vec}")),
+                    "{push}"
+                );
+                assert!(!push.contains("rcgmp_mpz_release"), "{push}");
+                let store = texture("5store");
+                assert!(
+                    store.contains(&format!(
+                        "(r#v: {vec}, r#n: *mut ::std::ffi::c_void) -> {vec}"
+                    )),
+                    "{store}"
+                );
+                assert!(store.contains("rcgmp_mpz_release(r#n, 0)"), "{store}");
+                let opaque: Vec<&str> = full
+                    .records
+                    .iter()
+                    .filter_map(|r| match r.layout {
+                        RecordLayout::Opaque { rust_name, .. } => Some(full.symbol(rust_name)),
+                        _ => None,
+                    })
+                    .collect();
+                assert_eq!(opaque, [vec.as_str()]);
+            },
+        );
+    }
