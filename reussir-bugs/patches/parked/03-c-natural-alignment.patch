From 71314e74f661f045627adf3fb72ac8115d8977f3 Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Tue, 6 Oct 2026 21:26:03 -0400
Subject: [PATCH] l2r-local: issue 3: the global allocator gives each Rust
 allocation the alignment its Layout asks for

ReussirGlobalAlloc raised every Rust allocation to 16-byte alignment
(layout.align().max(16)), C's max_align_t rule. Rust's GlobalAlloc
contract asks only for the alignment of each Layout, and nearly every
Rust allocation asks for 8 bytes or less. With the alignment passed
through as asked, such a request whose size is a multiple of its
alignment takes mimalloc's plain path (mi_malloc, mi_realloc), like the
language heap: mimalloc's blocks are always 8-aligned
(MI_MAX_ALIGN_SIZE=8), so nothing moves, no page is marked for the slow
free path, and no bytes are added (03-a's rounding gave an 8-, 24-, 40-
or 56-byte request a 16-, 32-, 48- or 64-byte block).

The rounding of 03-a stays for requests aligned above 8 bytes, now to a
multiple of the alignment (16, 32, ...; up to 64 KiB, mimalloc's natural
alignment limit): the size class of a multiple of a power of two A is a
multiple of A, and a page's blocks then start at multiples of A, so
mi_malloc_aligned never moves such a block either. GLOBAL_MAX_ALIGN is
gone. The libc fallback still gets the size as asked.

Tests (alloc.rs): global_alloc_keeps_requested_alignment (alignments 1
to 4096, sizes 1 to 144 and some up to 16 MiB, also sizes that are not a
multiple of the alignment: alloc, alloc_zeroed and realloc give the
requested alignment and keep contents; the libc fallback reallocs only up
to 16, as before) and global_alloc_moves_no_block (mimalloc v2: 19,456
live allocations, alignments up to 8 at every size 1 to 4096 and 16 to
64 up to 1024, each one a block start by mi_heap_visit_blocks; an
alignment of at most 8 gets the class of its size, one above 8 the class
of its size rounded up to the alignment). With the old raising to 16 the
second test fails (159 moved allocations, and 24 usable bytes for 1).
Both pass with the default features; with --no-default-features and
with mimalloc-v3 the first one does.
---
 crates/reussir-rt/src/alloc.rs | 187 ++++++++++++++++++++-------------
 1 file changed, 116 insertions(+), 71 deletions(-)

diff --git a/crates/reussir-rt/src/alloc.rs b/crates/reussir-rt/src/alloc.rs
index 7a7bed8c..4b3c9663 100644
--- a/crates/reussir-rt/src/alloc.rs
+++ b/crates/reussir-rt/src/alloc.rs
@@ -273,53 +273,58 @@ mod backend {
 /// memory is released through `std::alloc::dealloc` — so both sides must be one
 /// allocator.
 ///
-/// It uses the same allocator but *not* the language heap's 8-byte-natural
-/// convention: the process global allocator must honor `max_align_t`
-/// (16-byte) alignment even for small requests, because platform code that
-/// shares this heap assumes it (notably macOS system frameworks and parts of
-/// Rust's std). So every allocation is forced to at least 16-byte alignment
-/// via the backend's aligned path, with its size rounded up to a multiple of
-/// 16 (`global_size`). `__reussir_*` keep the 8-byte convention
-/// (reussir boxes request their own alignment and never escape to that code),
-/// preserving the 8-granular per-constructor win; they also call the backend
-/// *directly*, so the unsized `token<?>` ABI needs no `Layout`.
+/// It passes each `Layout`'s alignment through as asked: Rust's
+/// `GlobalAlloc` contract requires exactly that alignment, not C's
+/// `max_align_t` (16 bytes), and nearly every Rust allocation asks for 8
+/// bytes or less. Such a request whose size is a multiple of its alignment
+/// takes mimalloc's plain path (`mi_malloc`, `mi_realloc`), like the language
+/// heap: mimalloc's blocks are always 8-aligned (`MI_MAX_ALIGN_SIZE=8`), so
+/// it moves no block, marks no page and wastes no bytes. (Until issue 3's
+/// patch 03-c, every allocation was raised to 16-byte alignment, as C's
+/// `malloc` gives it; Rust code does not rely on that.) `__reussir_*` call
+/// the backend *directly*, so the unsized `token<?>` ABI needs no `Layout`.
 pub struct ReussirGlobalAlloc;
 
-/// `max_align_t` — the alignment a C/Rust global allocator is expected to
-/// provide for any allocation.
-const GLOBAL_MAX_ALIGN: usize = 16;
+/// The largest block size for which mimalloc v2 aligns every block of a
+/// page to the block size when the class is a multiple of the alignment
+/// (`MI_MAX_ALIGN_GUARANTEE`, 64 KiB; `mi_malloc_is_naturally_aligned`).
+const NATURAL_ALIGN_MAX: usize = 64 * 1024;
 
-/// The size a global allocation asks the backend for: under mimalloc, the
-/// requested size rounded up to a multiple of `GLOBAL_MAX_ALIGN`.
+/// The size a global allocation asks the backend for. Under mimalloc, a
+/// request aligned above 8 bytes (and at most `NATURAL_ALIGN_MAX`) is
+/// rounded up to a multiple of its alignment; every other request keeps its
+/// size.
 ///
-/// mimalloc v2 (built with `MI_MAX_ALIGN_SIZE=8`) then gives the 16-byte
-/// alignment from the size class alone: every size class of a multiple of 16
-/// bytes is a multiple of 16 (the classes up to 64 bytes are exact, the
-/// larger ones even word counts), and a page starts at a 64 KiB slice
-/// boundary plus an offset that is then a multiple of 16
-/// (`_mi_segment_page_start_from_slice`; a block over 64 KiB is alone in its
-/// page). `mi_malloc_aligned` and `mi_realloc_aligned` take the free block
-/// or the plain allocation (`mi_malloc_is_naturally_aligned`). With the size
-/// as requested (24 bytes, say), `mi_malloc_aligned` took the 24-byte class
-/// only when its next free block happened to be 16-aligned; otherwise it
+/// mimalloc v2 (built with `MI_MAX_ALIGN_SIZE=8`) then gives the alignment
+/// from the size class alone: the size class of a multiple of a power of
+/// two `A` is a multiple of `A` (the classes up to 64 bytes are exact, and
+/// the larger ones are every multiple of a step that grows with the size),
+/// and a page starts at a 64 KiB slice boundary plus an offset that is then
+/// a multiple of `A` (`_mi_segment_page_start_from_slice`; a block over 64
+/// KiB is alone in its page). `mi_malloc_aligned` and `mi_realloc_aligned`
+/// take the free block or the plain allocation
+/// (`mi_malloc_is_naturally_aligned`). With the size as requested (24 bytes
+/// at alignment 16, say), `mi_malloc_aligned` took the 24-byte class only
+/// when its next free block happened to be 16-aligned; otherwise it
 /// allocated `size + 15` bytes and moved the pointer, which marks the page
 /// as holding moved blocks (`mi_page_set_has_aligned`): every later free in
 /// that page, of any object (the language heap shares the pages), took
 /// mimalloc's slow path (`mi_free_generic_local`, `_mi_page_ptr_unalign`).
-/// Only requests of at most 64 bytes change size: every larger class is a
-/// multiple of 16 already.
+/// A request aligned to at most 8 bytes never moves: every block is
+/// 8-aligned.
 ///
 /// A larger block is allowed: Rust's `dealloc` and `realloc` pass the
 /// requested size back, which the size-recovering backends ignore. The
 /// default `alloc_zeroed` goes through `alloc`. No overflow: a `Layout`'s
-/// size is at most `isize::MAX`. The libc fallback (the sanitizer builds,
-/// miri) gets the size as requested: `malloc` gives 16-byte alignment
-/// anyway, and the exact size lets the sanitizers see a Rust-side overflow
-/// past the end of the block.
+/// size rounded up to its alignment is at most `isize::MAX`, and a request
+/// to `realloc` keeps the old alignment. The libc fallback (the sanitizer
+/// builds, miri) gets the size as requested: `malloc` and `posix_memalign`
+/// give the alignment anyway, and the exact size lets the sanitizers see a
+/// Rust-side overflow past the end of the block.
 #[inline]
-const fn global_size(size: usize) -> usize {
-    if cfg!(all(feature = "mimalloc", not(miri))) {
-        size.next_multiple_of(GLOBAL_MAX_ALIGN)
+const fn global_size(align: usize, size: usize) -> usize {
+    if cfg!(all(feature = "mimalloc", not(miri))) && align > 8 && align <= NATURAL_ALIGN_MAX {
+        size.next_multiple_of(align)
     } else {
         size
     }
@@ -328,12 +333,7 @@ const fn global_size(size: usize) -> usize {
 unsafe impl std::alloc::GlobalAlloc for ReussirGlobalAlloc {
     #[inline]
     unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
-        unsafe {
-            backend::alloc(
-                layout.align().max(GLOBAL_MAX_ALIGN),
-                global_size(layout.size()),
-            )
-        }
+        unsafe { backend::alloc(layout.align(), global_size(layout.align(), layout.size())) }
     }
     #[inline]
     unsafe fn dealloc(&self, ptr: *mut u8, _layout: std::alloc::Layout) {
@@ -341,13 +341,7 @@ unsafe impl std::alloc::GlobalAlloc for ReussirGlobalAlloc {
     }
     #[inline]
     unsafe fn realloc(&self, ptr: *mut u8, layout: std::alloc::Layout, new_size: usize) -> *mut u8 {
-        unsafe {
-            backend::realloc(
-                ptr,
-                layout.align().max(GLOBAL_MAX_ALIGN),
-                global_size(new_size),
-            )
-        }
+        unsafe { backend::realloc(ptr, layout.align(), global_size(layout.align(), new_size)) }
     }
 }
 
@@ -503,70 +497,121 @@ mod tests {
         }
     }
 
-    /// The global allocator keeps `max_align_t` (16-byte) alignment for every
-    /// request, through `alloc`, `alloc_zeroed` and `realloc`, whatever the
-    /// requested size and alignment (under mimalloc, sizes are rounded up to
-    /// a multiple of 16: `global_size`), and `realloc` keeps the contents.
+    /// The global allocator gives each request the alignment its `Layout`
+    /// asks for, through `alloc`, `alloc_zeroed` and `realloc`, whatever the
+    /// size (also a size that is not a multiple of the alignment, or below
+    /// it), and `realloc` keeps the contents (up to 16-byte alignment under
+    /// the libc fallback, which cannot realloc above it).
     #[test]
-    fn global_alloc_is_16_aligned() {
+    fn global_alloc_keeps_requested_alignment() {
         use std::alloc::{GlobalAlloc, Layout};
         let a = super::ReussirGlobalAlloc;
         let large: &[usize] = if cfg!(miri) { &[] } else { &[1 << 20, (16 << 20) + 8] };
         let sizes = (1..=144).chain([255, 1000, 4097, 9000, 70_000]).chain(large.iter().copied());
         for size in sizes {
-            for align in [1usize, 2, 4, 8, 16] {
+            for align in [1usize, 2, 4, 8, 16, 32, 64, 4096] {
                 let layout = Layout::from_size_align(size, align).unwrap();
                 let grown = size + size / 2 + 1;
                 unsafe {
                     let p = a.alloc(layout);
                     assert!(!p.is_null());
-                    assert_eq!(p as usize % 16, 0, "alloc {size} align {align}");
+                    assert_eq!(p as usize % align, 0, "alloc {size} align {align}");
                     p.write_bytes(0xA5, size);
                     let z = a.alloc_zeroed(layout);
                     assert!(!z.is_null());
-                    assert_eq!(z as usize % 16, 0, "alloc_zeroed {size} align {align}");
+                    assert_eq!(z as usize % align, 0, "alloc_zeroed {size} align {align}");
                     assert!(std::slice::from_raw_parts(z, size).iter().all(|&b| b == 0));
+                    a.dealloc(z, layout);
+                    // The libc fallback cannot realloc above 16-byte
+                    // alignment (see its `realloc`).
+                    if align > 16 && !cfg!(all(feature = "mimalloc", not(miri))) {
+                        a.dealloc(p, layout);
+                        continue;
+                    }
                     let q = a.realloc(p, layout, grown);
                     assert!(!q.is_null());
-                    assert_eq!(q as usize % 16, 0, "realloc {size} -> {grown} align {align}");
+                    assert_eq!(q as usize % align, 0, "realloc {size} -> {grown} align {align}");
                     assert!(std::slice::from_raw_parts(q, size).iter().all(|&b| b == 0xA5));
                     let r = a.realloc(q, Layout::from_size_align(grown, align).unwrap(), size);
                     assert!(!r.is_null());
-                    assert_eq!(r as usize % 16, 0, "realloc {grown} -> {size} align {align}");
+                    assert_eq!(r as usize % align, 0, "realloc {grown} -> {size} align {align}");
                     assert!(std::slice::from_raw_parts(r, size).iter().all(|&b| b == 0xA5));
                     a.dealloc(r, layout);
-                    a.dealloc(z, layout);
                 }
             }
         }
     }
 
-    /// Under mimalloc v2, a global allocation is a whole block of the size
-    /// class of its size rounded up to 16: mimalloc did not allocate more and
-    /// move the pointer, which would mark the page and send every later free
-    /// in it to mimalloc's slow path. The blocks stay live, so that the
-    /// allocations come from fresh and partly used pages alike. (v3 starts
-    /// most pages of classes that are not powers of two 8 bytes off 16, so
-    /// it still moves blocks there.)
+    /// Under mimalloc v2, no global allocation is moved inside a larger block
+    /// (which would mark its page and send every later free in it to
+    /// mimalloc's slow path): every pointer starts a block of the heap
+    /// (`mi_heap_visit_blocks`). Alignments up to 8 at every size from 1 to
+    /// 4096, and 16 to 64 at every size up to 1024; the blocks stay live, so
+    /// that the allocations come from fresh and partly used pages alike. A
+    /// request aligned to at most 8 bytes whose size is a multiple of the
+    /// alignment takes the size class of its size (nothing is rounded up);
+    /// one aligned above 8 takes the class of its size rounded up to the
+    /// alignment. (v3 starts most pages of classes that are not powers of two
+    /// 8 bytes off 16, so it still moves blocks aligned above 8.)
     #[cfg(all(feature = "mimalloc", not(feature = "mimalloc-v3"), not(miri)))]
     #[test]
-    fn global_alloc_takes_whole_blocks() {
+    fn global_alloc_moves_no_block() {
         use libmimalloc_sys as ffi;
         use std::alloc::{GlobalAlloc, Layout};
+        use std::ffi::c_void;
+        struct Seen {
+            ptrs: Vec<usize>,
+            found: Vec<bool>,
+        }
+        unsafe extern "C" fn visit(
+            _heap: *const ffi::mi_heap_t,
+            _area: *const ffi::mi_heap_area_t,
+            block: *mut c_void,
+            _size: usize,
+            arg: *mut c_void,
+        ) -> bool {
+            if !block.is_null() {
+                let seen = unsafe { &mut *(arg as *mut Seen) };
+                if let Ok(i) = seen.ptrs.binary_search(&(block as usize)) {
+                    seen.found[i] = true;
+                }
+            }
+            true
+        }
         let a = super::ReussirGlobalAlloc;
         let mut live = Vec::new();
-        for round in 0..4 {
-            for size in (1..=1024usize).chain([4097, 9000, 40_000]) {
-                let layout = Layout::from_size_align(size, 1 << (round % 4)).unwrap();
+        for align in [1usize, 2, 4, 8, 16, 32, 64] {
+            let top = if align <= 8 { 4096 } else { 1024 };
+            for size in 1..=top {
+                let layout = Layout::from_size_align(size, align).unwrap();
                 unsafe {
                     let p = a.alloc(layout);
                     assert!(!p.is_null());
-                    let want = ffi::mi_good_size(size.next_multiple_of(16));
-                    assert_eq!(ffi::mi_usable_size(p.cast()), want, "size {size}");
+                    assert_eq!(p as usize % align, 0, "size {size} align {align}");
+                    let usable = ffi::mi_usable_size(p.cast());
+                    if align > 8 {
+                        let want = ffi::mi_good_size(size.next_multiple_of(align));
+                        assert_eq!(usable, want, "size {size} align {align}");
+                    } else if size % align == 0 {
+                        assert_eq!(usable, ffi::mi_good_size(size), "size {size} align {align}");
+                    }
                     live.push((p, layout));
                 }
             }
         }
+        let mut ptrs: Vec<usize> = live.iter().map(|&(p, _)| p as usize).collect();
+        ptrs.sort_unstable();
+        let mut seen = Seen { found: vec![false; ptrs.len()], ptrs };
+        unsafe {
+            ffi::mi_heap_visit_blocks(
+                ffi::mi_heap_get_default(),
+                true,
+                Some(visit),
+                &mut seen as *mut Seen as *mut c_void,
+            );
+        }
+        let moved: Vec<usize> = (0..seen.ptrs.len()).filter(|&i| !seen.found[i]).collect();
+        assert!(moved.is_empty(), "{} of {} allocations moved", moved.len(), seen.ptrs.len());
         for (p, layout) in live {
             unsafe { a.dealloc(p, layout) };
         }
