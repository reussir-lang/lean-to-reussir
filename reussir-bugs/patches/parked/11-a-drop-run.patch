+/// A random forest with runs ([`scenario_with`]), its roots released by a
+/// run or in line at random, through [`run_forest`].
+fn run_scenario(seed: u64, budget: usize, defer_runs: bool) -> Outcome {
+    let (roots, nodes) = scenario_with(seed, budget, true);
+    let mut rng = Rng(seed ^ 0xaaaa);
+    let roots: Vec<(usize, bool)> = roots.into_iter().map(|r| (r, rng.chance(50))).collect();
+    run_forest(seed, &roots, nodes, defer_runs)
+}
+
+/// Asserts that two runs of a forest saw the same events, with the same
+/// depth and activity at each, and the same calls of the drain-end hook,
+/// each after its drain (not active, nothing pending).
+fn assert_same_events(what: &str, a: &Outcome, b: &Outcome) {
+    assert_eq!(a.seen.len(), b.seen.len(), "{what}: event count");
+    for (i, (x, y)) in a.seen.iter().zip(&b.seen).enumerate() {
+        assert_eq!(x, y, "{what}: event {i}");
+    }
+    assert_eq!(a.hooks, b.hooks, "{what}: drain-end hook calls");
+    assert!(
+        a.hooks.iter().all(|&h| h == (false, 0)),
+        "{what}: {:?}",
+        a.hooks
+    );
+}
+
+/// A run releases in the order of a deferral and a drain, with the same
+/// depth and activity at every event, and in the model's order (one stack
+/// entry per pending cell): inside a drain, outside one with nothing
+/// pending, and outside one with work pending (a root released in line
+/// does its actions outside a drain, so its deferrals and steps are
+/// pending when a run among them follows).
+#[test]
+fn random_runs_match_defer_and_drain() {
+    let (count, budget) = seeds();
+    let mut kinds = [0; 3];
+    for seed in 0..count {
+        let run = run_scenario(seed, budget, false);
+        let defer = run_scenario(seed, budget, true);
+        assert_same_events(&format!("seed {seed}"), &run, &defer);
+        assert_eq!(run.runs, defer.runs, "seed {seed}: runs");
+        for (k, n) in run.runs.iter().enumerate() {
+            kinds[k] += n;
+        }
+    }
+    assert!(
+        kinds.iter().all(|&n| n > 0),
+        "runs inside, outside, outside with work pending: {kinds:?}"
+    );
+}
+
+/// A cell with no header word of note.
+fn cell_node(actions: Vec<Action>) -> Node {
+    Node {
+        k: 0,
+        imm: false,
+        word: 0,
+        actions,
+    }
+}
+
+/// Runs a hand-made forest with runs both ways ([`__reussir_drop_run`];
+/// deferral and drain), asserts the same events, and answers them as the
+/// nodes released or stepped, in order, with the activity seen at each.
+fn run_both_ways(roots: &[(usize, bool)], nodes: impl Fn() -> Vec<Node>) -> Vec<(usize, bool)> {
+    let run = run_forest(1, roots, nodes(), false);
+    let defer = run_forest(1, roots, nodes(), true);
+    assert_same_events("hand-made forest", &run, &defer);
+    run.seen
+        .iter()
+        .map(|&(ev, _, active)| match ev {
+            Ev::Release { node, .. } | Ev::Step { node, .. } => (node, active),
+        })
+        .collect()
+}
+
+/// Outside a drain with nothing pending: the cell is released inside the
+/// drain the run starts (its deferrals are pushed, a run it makes is
+/// deferred, a release in line happens at once), then what it pushed,
+/// last first.
+#[test]
+fn run_outside_a_drain() {
+    use Action::*;
+    let nodes = || {
+        vec![
+            cell_node(vec![
+                Defer {
+                    child: 1,
+                    wide: true,
+                },
+                Defer {
+                    child: 2,
+                    wide: false,
+                },
+                Run { child: 3 },
+                Inline { child: 4 },
+            ]),
+            cell_node(vec![Defer {
+                child: 5,
+                wide: true,
+            }]),
+            cell_node(vec![]),
+            cell_node(vec![]),
+            cell_node(vec![]),
+            cell_node(vec![]),
+        ]
+    };
+    let events = run_both_ways(&[(0, true)], nodes);
+    assert_eq!(
+        events,
+        vec![
+            (0, true),
+            (4, true),
+            (3, true),
+            (2, true),
+            (1, true),
+            (5, true)
+        ]
+    );
+}
