+/// [`__reussir_drop_run`], or what it stands for: a deferral, then a drain.
+unsafe fn release_now(p: *mut u8, release: Release, defer: bool) {
+    let kind = if active() {
+        0
+    } else if depth() == 0 {
+        1
+    } else {
+        2
+    };
+    with_world(|w| w.runs[kind] += 1);
+    unsafe {
+        if defer {
+            __reussir_drop_defer(p, release);
+            __reussir_drop_drain();
+        } else {
+            __reussir_drop_run(p, release);
+        }
+    }
