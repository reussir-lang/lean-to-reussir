@@ -0,0 +1,67 @@
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true retcon-drops=true' --verify-each | %FileCheck %s
+
+// Two retcon variants, T1's direct arm T1Leaf holding a T0. A drop of either
+// type is a call to its `.direct` function, also inside the other type's
+// `.direct`, so a nested type's arms are not copied into the drop of its
+// parent (reussir#759: code size exponential in type nesting). Inside a
+// retcon destructor, the tag test leaves out a direct arm that holds a
+// retcon value: T1Leaf suspends, so its T0 is dropped in the running
+// executor instead of starting its own.
+
+!box = !reussir.record<compound "Box" {i64}>
+!t0_ = !reussir.record<variant "T0" incomplete>
+!t0two = !reussir.record<compound "T0Two" [value] {!t0_, !t0_}>
+!t0leaf = !reussir.record<compound "T0Leaf" [value] {!box}>
+!t0 = !reussir.record<variant "T0" {!t0two, !t0leaf}>
+!t1_ = !reussir.record<variant "T1" incomplete>
+!t1two = !reussir.record<compound "T1Two" [value] {!t1_, !t1_}>
+!t1leaf = !reussir.record<compound "T1Leaf" [value] {!t0}>
+!t1plain = !reussir.record<compound "T1Plain" [value] {!box}>
+!t1 = !reussir.record<variant "T1" {!t1two, !t1leaf, !t1plain}>
+
+module {
+  // CHECK-LABEL: func.func private @{{.*}}T0E.direct(
+  // CHECK: reussir.record.dispatch
+  // CHECK: return
+  // CHECK-LABEL: func.func private @{{.*}}T0E.retcon(
+  // CHECK: return
+
+  // One dispatch, T1's own; the T0 in arm 1 is a call to T0's `.direct`.
+  // CHECK-LABEL: func.func private @{{.*}}T1E.direct(
+  // CHECK: reussir.record.dispatch
+  // CHECK-NOT: reussir.record.dispatch
+  // CHECK-NOT: reussir.dtor.suspend
+  // CHECK: [1] ->
+  // CHECK-NOT: reussir.record.dispatch
+  // CHECK: call @{{.*}}T0E.direct(
+  // CHECK-NOT: reussir.record.dispatch
+  // CHECK-NOT: reussir.dtor.suspend
+  // CHECK: return
+  // CHECK-LABEL: func.func private @{{.*}}T1E.retcon(
+  // CHECK: return
+
+  // CHECK-LABEL: func.func @root(
+  // CHECK-NEXT: call @{{.*}}T1E.direct(
+  // CHECK-NEXT: return
+  func.func @root(%ref: !reussir.ref<!t1>) {
+    reussir.ref.drop (%ref : !reussir.ref<!t1>)
+    return
+  }
+
+  // The mask has arm 2 only (0b100, printed as -4 : i3): arm 0 is not
+  // direct, and arm 1 holds a T0.
+  // CHECK-LABEL: func.func @parent(
+  // CHECK-NOT: reussir.record.dispatch
+  // CHECK: arith.constant -4 : i3
+  // CHECK: reussir.record.tag
+  // CHECK: arith.shrui
+  // CHECK: scf.if
+  // CHECK: call @{{.*}}T1E.direct(
+  // CHECK: } else {
+  // CHECK: reussir.dtor.suspend @{{.*}}T1E.retcon
+  // CHECK: return
+  func.func @parent(%ref: !reussir.ref<!t1>) attributes {reussir.retcon_drop} {
+    reussir.ref.drop (%ref : !reussir.ref<!t1>)
+    return
+  }
+}
