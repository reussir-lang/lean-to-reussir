+  // Whether dropping a `type` slot can run a retcon destructor (reach a
+  // Worklist record). Memoized; a type met again on the walk counts as no.
+  mutable llvm::DenseMap<mlir::Type, bool> reachesRetcon;
+  bool mayRunRetconDrop(mlir::Type type) const {
+    auto [it, inserted] = reachesRetcon.try_emplace(type, false);
+    if (!inserted)
+      return it->second;
+    bool result = false;
+    if (auto record = llvm::dyn_cast<RecordType>(type)) {
+      result = record.classifyRecordDrop() == RecordDropKind::Worklist;
+      for (auto [member, field] :
+           llvm::zip(record.getMembers(), record.getMemberIsField()))
+        if (!result && !field)
+          result = mayRunRetconDrop(
+              getProjectedType(member, false, Capability::shared));
+    } else if (auto nullable = llvm::dyn_cast<NullableType>(type)) {
+      result = mayRunRetconDrop(nullable.getPtrTy());
+    } else if (auto rc = llvm::dyn_cast<RcType>(type)) {
+      result = mayRunRetconDrop(rc.getElementType());
+    } else if (auto array = llvm::dyn_cast<ArrayType>(type)) {
+      result = mayRunRetconDrop(array.getElementType());
+    } else if (auto cell = llvm::dyn_cast<CellType>(type)) {
+      result = mayRunRetconDrop(cell.getElementType());
+    }
+    reachesRetcon[type] = result;
+    return result;
+  }
+
+  // `(mask >> tag) & 1`: bit i is set for a direct arm i whose drop cannot
+  // run a retcon destructor. Inside a retcon destructor, other direct arms
+  // suspend too, so the values in them stay in the running executor.
+  mlir::Value isDirectArm(RecordType recordType, mlir::Value ref,
+                          mlir::Location loc,
+                          mlir::PatternRewriter &rewriter) const {
+    unsigned arms = recordType.getMembers().size();
+    unsigned width = std::max(arms, 2u);
+    llvm::APInt mask(width, 0);
+    for (auto [idx, memberTy, memberIsField] : llvm::enumerate(
+             recordType.getMembers(), recordType.getMemberIsField()))
+      if (isDirectVariantMember(memberTy, memberIsField) &&
+          (memberIsField || !mayRunRetconDrop(memberTy)))
+        mask.setBit(idx);
+    auto maskType = rewriter.getIntegerType(width);
+    mlir::Value tag = ReussirRecordTagOp::create(
+        rewriter, loc, rewriter.getIndexType(), ref);
+    mlir::Value shift =
+        mlir::arith::IndexCastUIOp::create(rewriter, loc, maskType, tag);
+    mlir::Value bits = mlir::arith::ShRUIOp::create(
+        rewriter, loc,
+        mlir::arith::ConstantOp::create(
+            rewriter, loc, rewriter.getIntegerAttr(maskType, mask)),
+        shift);
+    return mlir::arith::TruncIOp::create(rewriter, loc, rewriter.getI1Type(),
+                                         bits);
+  }
+
   void emitOutlinedDrop(mlir::func::FuncOp dtor, ReussirRefDropOp op,
                         mlir::PatternRewriter &rewriter) const {
     auto parent = op->getParentOfType<mlir::func::FuncOp>();
@@ -281,6 +338,46 @@ private:
       mlir::func::CallOp::create(rewriter, op.getLoc(), dtor, op.getRef());
   }
 
+  // The direct-arm fast path of a retcon variant, emitted once per type: a
+  // plain (non-coroutine) function that dispatches on the tag, drops a direct
+  // arm in place and hands every other arm to the retcon destructor. Drop
+  // sites call it, so nested types' paths are calls, not copies.
+  mlir::func::FuncOp directDrop(RecordType recordType, AtomicKind kind,
+                                mlir::func::FuncOp dtor, ReussirRefDropOp op,
+                                mlir::PatternRewriter &rewriter) const {
+    auto module = op->getParentOfType<mlir::ModuleOp>();
+    std::optional<mlir::SymbolTable> ownTable;
+    auto &table =
+        symbols ? symbols->getSymbolTable(module) : ownTable.emplace(module);
+    std::string name =
+        (recordType.getDtorName(kind).getValue() + ".direct").str();
+    if (auto function = table.lookup<mlir::func::FuncOp>(name))
+      return function;
+    mlir::OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.setInsertionPointToStart(module.getBody());
+    auto function = mlir::func::FuncOp::create(rewriter, op.getLoc(), name,
+                                               dtor.getFunctionType());
+    function.setPrivate();
+    table.insert(function);
+    function->setAttr("llvm.linkage",
+                      rewriter.getAttr<mlir::LLVM::LinkageAttr>(
+                          mlir::LLVM::linkage::Linkage::LinkonceODR));
+    function->setAttr("llvm.passthrough",
+                      rewriter.getStrArrayAttr({"nounwind"}));
+    inheritSanitizerPassthrough(module, function);
+    function.setAllArgAttrs(dtor.getAllArgAttrs());
+    mlir::Block *entry = function.addEntryBlock();
+    rewriter.setInsertionPointToStart(entry);
+    auto ret = mlir::func::ReturnOp::create(rewriter, op.getLoc());
+    rewriter.setInsertionPoint(ret);
+    auto drop =
+        ReussirRefDropOp::create(rewriter, op.getLoc(), entry->getArgument(0));
+    rewriter.setInsertionPoint(drop);
+    (void)rewriteDropVariant(recordType, Capability::unspecified, kind, drop,
+                             rewriter, dtor);
+    return function;
+  }
+
   mlir::LogicalResult
   rewriteDropVariant(RecordType recordType, Capability refCap,
                      AtomicKind refAtomic, ReussirRefDropOp op,
@@ -460,10 +557,31 @@ public:
                              [](auto member) {
                                return isDirectVariantMember(std::get<0>(member),
                                                             std::get<1>(member));
-                             }))
-              return rewriteDropVariant(recordType, refCap,
-                                        refType.getAtomicKind(), op, rewriter,
-                                        dtor);
+                             })) {
+              auto direct = directDrop(recordType, refType.getAtomicKind(),
+                                       dtor, op, rewriter);
+              // Inside a retcon destructor the other arms must suspend: one
+              // test of the tag against the set of direct arms picks
+              // `direct` or the suspension.
+              auto parent = op->getParentOfType<mlir::func::FuncOp>();
+              if (parent && parent->hasAttr("reussir.retcon_drop")) {
+                mlir::Value isDirect =
+                    isDirectArm(recordType, op.getRef(), op.getLoc(), rewriter);
+                auto ifOp = mlir::scf::IfOp::create(rewriter, op.getLoc(),
+                                                    isDirect, true);
+                rewriter.setInsertionPointToStart(ifOp.thenBlock());
+                mlir::func::CallOp::create(rewriter, op.getLoc(), direct,
+                                           op.getRef());
+                rewriter.setInsertionPointToStart(ifOp.elseBlock());
+                emitOutlinedDrop(dtor, op, rewriter);
+                rewriter.eraseOp(op);
+                return llvm::success();
+              }
+              mlir::func::CallOp::create(rewriter, op.getLoc(), direct,
+                                         op.getRef());
+              rewriter.eraseOp(op);
+              return llvm::success();
+            }
             emitOutlinedDrop(dtor, op, rewriter);
             rewriter.eraseOp(op);
             return llvm::success();
diff --git a/tests/integration/conversion/retcon_drop_direct_nested.mlir b/tests/integration/conversion/retcon_drop_direct_nested.mlir
