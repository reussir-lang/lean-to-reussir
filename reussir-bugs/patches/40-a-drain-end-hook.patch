From 19cdab355559d5415351cc4fcae483260d6307db Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Fri, 2 Oct 2026 22:09:42 -0400
Subject: [PATCH] l2r-local: drop: call the host's function when a drain ends
 (__reussir_drop_drained)

A host runtime that shares the pending stack (lean2rr's frees its
containers through it) may have work that must wait until the drain is
over: code that can switch to another coroutine of the thread, whose
frees would otherwise be pushed onto this drain's stack. lean2rr's
runtime defers the sync continuations of a promise released inside a
free; it sees the end of a free its own containers start, but not the
end of one the record glue starts (drop_in_place's drain), so those
continuations ran late.

reussir_rt::drop exports __reussir_drop_drained, an AtomicPtr to an
unsafe extern "C" fn() (null by default). Every drain that released
something (the general loop and the one-cell path) calls it on its
thread once it has ended, with draining false and nothing pending; a
drain with nothing pending, or started inside a drain, does not. The
host stores its function through the symbol (lean2rr's runtime links
it weakly, so it also builds against a runtime without it). The cost is
one relaxed load per drain that released something.

A unit test checks that the function runs once per outermost drain,
after it (not active, depth 0), through both paths, and not for a drain
with nothing to do or one started inside a drain.
---
 crates/reussir-rt/src/drop.rs       | 29 ++++++++++++++++-
 crates/reussir-rt/src/drop/tests.rs | 49 +++++++++++++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)

diff --git a/crates/reussir-rt/src/drop.rs b/crates/reussir-rt/src/drop.rs
index 1c63a6d0..18845f29 100644
--- a/crates/reussir-rt/src/drop.rs
+++ b/crates/reussir-rt/src/drop.rs
@@ -31,7 +31,11 @@
 //! can share the stack, so that one free releases everything in one order:
 //! [`active`], [`depth`], [`defer_step`] and [`run_step`] push incremental work, which
 //! stays on the stack while it runs, so whatever it pushes is done before its
-//! next step.
+//! next step. Some of that work may have to wait until the drain is over
+//! (code that may switch to another coroutine of the thread, whose frees
+//! would go onto this drain's stack): every drain that released something
+//! calls the function the host stores in [`__reussir_drop_drained`], on its
+//! thread, once it has ended.
 //!
 //! The glue calls these functions for every cell it frees, so they are kept
 //! cheap. The state is one thread-local with no destructor (an access is only
@@ -47,6 +51,7 @@
 use core::cell::Cell;
 use core::mem::ManuallyDrop;
 use core::ptr::NonNull;
+use core::sync::atomic::{AtomicPtr, Ordering};
 
 /// Releases one pending member, given the pointer it was deferred with.
 pub type Release = unsafe extern "C" fn(*mut u8);
@@ -354,6 +359,7 @@ impl State {
             self.with_vec(|stack| stack.shrink_to(KEEP));
         }
         self.draining.set(false);
+        drained();
     }
 }
 
@@ -442,11 +448,32 @@ unsafe extern "C" fn drain_one() {
     unsafe { state.release.get()(state.head.get()) };
     if state.n.get() == 0 && state.len.get() == 0 {
         state.draining.set(false);
+        drained();
         return;
     }
     unsafe { drain_slow() }
 }
 
+/// A function (`unsafe extern "C" fn()`) that every drain which released
+/// something calls on its thread once it has ended ([`active`] is false
+/// again and nothing is pending), or null (none). A host runtime stores it
+/// through this symbol, which it may link weakly (lean2rr's runtime does).
+/// The function may release values in turn (a new drain) and may switch
+/// coroutines.
+#[unsafe(no_mangle)]
+#[allow(non_upper_case_globals)]
+pub static __reussir_drop_drained: AtomicPtr<()> = AtomicPtr::new(core::ptr::null_mut());
+
+/// Calls [`__reussir_drop_drained`]'s function, if any.
+#[inline(always)]
+fn drained() {
+    let f = __reussir_drop_drained.load(Ordering::Relaxed);
+    if !f.is_null() {
+        let f: unsafe extern "C" fn() = unsafe { core::mem::transmute(f) };
+        unsafe { f() }
+    }
+}
+
 /// Defers `release(cell)` until the current thread drains its pending work.
 /// `cell` is a box whose count was read as 1 and which nothing else
 /// references (or an immediate's dummy box); the cell is not written.
diff --git a/crates/reussir-rt/src/drop/tests.rs b/crates/reussir-rt/src/drop/tests.rs
index ab33190d..fb57a05f 100644
--- a/crates/reussir-rt/src/drop/tests.rs
+++ b/crates/reussir-rt/src/drop/tests.rs
@@ -561,3 +561,52 @@ fn table_full() {
     let want: Vec<usize> = std::iter::once(0).chain((1..=n).rev()).collect();
     assert_eq!(order, want);
 }
+
+thread_local! {
+    /// What the function in `__reussir_drop_drained` saw on this thread
+    /// ([`active`], [`depth`]), while the test below has armed it.
+    static DRAINED: RefCell<Option<Vec<(bool, usize)>>> = const { RefCell::new(None) };
+}
+
+unsafe extern "C" fn on_drained() {
+    DRAINED.with(|d| {
+        if let Some(seen) = d.borrow_mut().as_mut() {
+            seen.push((active(), depth()));
+        }
+    });
+}
+
+unsafe extern "C" fn release_nothing(_: *mut u8) {}
+
+unsafe fn leaf_step(_: usize) -> bool {
+    true
+}
+
+/// A step that starts work inside the drain (only pushed) and a nested drain
+/// (returns at once).
+unsafe fn nesting_step(_: usize) -> bool {
+    run_step(0, leaf_step);
+    unsafe { __reussir_drop_drain() };
+    true
+}
+
+/// The host's function runs once per drain that released something, after
+/// it is over (not active, nothing pending), through the general loop and
+/// through the one-cell path; never inside a drain, nor for a drain with
+/// nothing to do.
+#[test]
+fn drained_runs_after_the_outermost_drain() {
+    use core::sync::atomic::Ordering::Relaxed;
+    DRAINED.with(|d| *d.borrow_mut() = Some(Vec::new()));
+    __reussir_drop_drained.store(on_drained as *mut (), Relaxed);
+    run_step(0, nesting_step);
+    unsafe { __reussir_drop_drain() };
+    let mut cell = [1u64, 0];
+    unsafe {
+        __reussir_drop_defer(cell.as_mut_ptr().cast(), release_nothing);
+        __reussir_drop_drain();
+    }
+    __reussir_drop_drained.store(core::ptr::null_mut(), Relaxed);
+    let seen = DRAINED.with(|d| d.borrow_mut().take().unwrap());
+    assert_eq!(seen, vec![(false, 0), (false, 0)]);
+}
-- 
