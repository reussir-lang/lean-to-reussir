diff --git a/tests/integration/conversion/locked_cell_drop.mlir b/tests/integration/conversion/locked_cell_drop.mlir
new file mode 100644
index 00000000..1f92e657
--- /dev/null
+++ b/tests/integration/conversion/locked_cell_drop.mlir
@@ -0,0 +1,19 @@
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true tail-recursive-drops=false' --reussir-token-reuse --verify-each | %FileCheck %s
+
+// With neither retcon nor worklist drops (TPDE's options), a locked cell's
+// payload is still released by a locked-drop function, whose decrement
+// token is freed; inline in the critical section it was never freed.
+
+!b = !reussir.record<compound "LkBox" {i64}>
+module {
+  // CHECK-LABEL: func.func private @__reussir_locked_drop(
+  // CHECK: reussir.rc.fetch_sub
+  // CHECK: reussir.token.free
+  // CHECK-LABEL: func.func @locked(
+  // CHECK: sync.mutex.critical_section
+  // CHECK: call @__reussir_locked_drop(
+  func.func @locked(%ref: !reussir.ref<!reussir.cell<!reussir.rc<!b atomic> mutex>>) {
+    reussir.ref.drop (%ref : !reussir.ref<!reussir.cell<!reussir.rc<!b atomic> mutex>>)
+    return
+  }
+}
