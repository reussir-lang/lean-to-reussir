diff --git a/tests/integration/conversion/worklist_drop_members.mlir b/tests/integration/conversion/worklist_drop_members.mlir
new file mode 100644
index 00000000..72d9885a
--- /dev/null
+++ b/tests/integration/conversion/worklist_drop_members.mlir
@@ -0,0 +1,35 @@
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true' --verify-each | %FileCheck %s --implicit-check-not=tail_release --implicit-check-not=reussir.dtor.suspend
+
+// Worklist glue defers every box of its record's cycle itself, whatever
+// holds it: a nullable member, a cell box (released inline, not by a tail
+// release helper), a locked cell (in a locked-drop function that is glue
+// itself) and a plain member. A locked cell outside glue keeps the ordinary
+// locked-drop function.
+
+!a_ = !reussir.record<compound "WmA" incomplete>
+!a = !reussir.record<compound "WmA" {!reussir.nullable<!reussir.rc<!a_>>, !reussir.cell<!reussir.rc<!a_ shared>>, !reussir.cell<!reussir.rc<!a_ shared> mutex>, !a_}>
