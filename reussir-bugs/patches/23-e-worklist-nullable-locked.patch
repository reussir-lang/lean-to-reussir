+  // LLVM-LABEL: define private void @__reussir_locked_drop(ptr
+  // LLVM: atomicrmw sub ptr %{{.+}}, i32 1
+  // LLVM: call void @__reussir_deallocate(ptr %{{.+}}, i64 8, i64 16)
   // LLVM-LABEL: define void @flatlock_cell_drop(ptr
