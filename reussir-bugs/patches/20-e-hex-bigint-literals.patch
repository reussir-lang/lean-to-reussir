-            attrs.push((kind, key.map(|k| self.narrowest(k)).transpose()?));
+            attrs.push((kind, key.map(literal::mlir_integer_attr_text)));
             // Only an arm whose sub-tree uses a derived occurrence takes the
             // argument; otherwise the match releases the integer itself.
             let argument = kind != ArmKind::Case && uses_derived(tree, path);
@@ -453,14 +453,6 @@ impl<'c, 'p, 'tcx> Lowerer<'c, 'p, 'tcx> {
         Ok((!unit).then(|| op.result(0).unwrap().into()))
     }
 
-    /// `n` as an integer attribute of the narrowest signless type holding it in
-    /// two's complement, the form the dialect's constants and match arms take.
-    fn narrowest(&self, n: &Integer) -> Result<Attribute<'c>> {
-        let text = format!("{n} : i{}", literal::signed_width(n));
-        Attribute::parse(self.context, &text)
-            .ok_or_else(|| LoweringError(format!("could not build integer `{text}`").into()))
-    }
-
     /// The innermost arm of the match at `root_idx` that produced the value at
     /// `path`, with how that value follows from the arm.
     pub(super) fn int_arm_value(
@@ -689,3 +681,55 @@ fn uses_derived(tree: &DecisionTree<'_>, path: &[u32]) -> bool {
         DecisionTree::Uncovered | DecisionTree::Unreachable => false,
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use reussir_backend::melior::ir::attribute::Attribute;
+    use reussir_backend::rcgmp::{self, ArmKind};
+    use reussir_core::literal::{self, Integer};
+
+    /// The hexadecimal text of an integer attribute, and of a match key,
+    /// gives the attribute its decimal text gives, at the edges of the
+    /// narrowest widths, of the immediate range and of a limb, either sign.
+    #[test]
+    fn hexadecimal_integer_attributes_match_decimal_ones() {
+        let context = crate::testing::context();
+        let values = [
+            "0",
+            "1",
+            "-1",
+            "2",
+            "-2",
+            "127",
+            "-128",
+            "128",
+            "-129",
+            "2305843009213693951",
+            "-2305843009213693952",
+            "9223372036854775807",
+            "-9223372036854775808",
+            "9223372036854775808",
+            "18446744073709551615",
+            "-18446744073709551616",
+            "1267650600228229401496703205376",
+            "-1267650600228229401496703205377",
+        ];
+        for value in values {
+            let n: Integer = value.parse().unwrap();
+            let decimal = format!("{n} : i{}", literal::signed_width(&n));
+            let hexadecimal = literal::mlir_integer_attr_text(&n);
+            assert_eq!(
+                Attribute::parse(&context, &decimal),
+                Attribute::parse(&context, &hexadecimal),
+                "{decimal} against {hexadecimal}"
+            );
+            if rcgmp::mpz_type(&context, false).is_some() {
+                assert_eq!(
+                    rcgmp::match_arms(&context, &[(ArmKind::Case, Some(decimal.clone()))]),
+                    rcgmp::match_arms(&context, &[(ArmKind::Case, Some(hexadecimal))]),
+                    "{decimal}"
+                );
+            }
+        }
+    }
+}
diff --git a/crates/reussir-core/src/literal.rs b/crates/reussir-core/src/literal.rs
index f067d577..4ed13d8b 100644
--- a/crates/reussir-core/src/literal.rs
+++ b/crates/reussir-core/src/literal.rs
@@ -360,6 +360,15 @@ pub fn signed_width(n: &Integer) -> u64 {
     magnitude_bits + 1
 }
 
+/// `n` as an MLIR integer attribute of the narrowest signless type holding it
+/// in two's complement ([`signed_width`]), written in hexadecimal: `0x…` or
+/// `-0x…`, then `: iN`. MLIR parses decimal text into an `APInt` with a full
+/// multiplication per digit, cubic in the length (a 100k-digit literal took
+/// minutes), and hexadecimal text by shifts, linear.
+pub fn mlir_integer_attr_text(n: &Integer) -> String {
+    format!("{n:#x} : i{}", signed_width(n))
+}
+
 /// The low 64 bits of `n`, two's complement — the value MLIR's
 /// `DenseI64ArrayAttribute` and friends want for a key that fits its type.
 pub fn low_u64(n: &Integer) -> u64 {
@@ -384,6 +393,13 @@ mod tests {
         assert_eq!(width("-2"), 2);
         assert_eq!(width("127"), 8);
         assert_eq!(width("-128"), 8);
+        let text = |text: &str| mlir_integer_attr_text(&text.parse::<Integer>().unwrap());
+        assert_eq!(text("0"), "0x0 : i1");
+        assert_eq!(text("-1"), "-0x1 : i1");
+        assert_eq!(text("127"), "0x7f : i8");
+        assert_eq!(text("-128"), "-0x80 : i8");
+        assert_eq!(text("-129"), "-0x81 : i9");
+        assert_eq!(text("18446744073709551616"), "0x10000000000000000 : i66");
         assert_eq!(width("128"), 9);
         assert_eq!(width("18446744073709551616"), 66);
     }
diff --git a/tests/integration/frontend/Inputs/bigint_huge_literal.py b/tests/integration/frontend/Inputs/bigint_huge_literal.py
new file mode 100644
index 00000000..c62c22b3
--- /dev/null
+++ b/tests/integration/frontend/Inputs/bigint_huge_literal.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""bigint_huge_literal.py OUT.rr: a program with 50000-digit integer literals.
+
+`p` is 3^104795, which has 50000 decimal digits. The program spells it as a
+`Nat` literal, as a negative `Int` literal, and as two match keys (`p` and
+`p + 1`), and compares them at run time with 3^104795 computed by `ipowi`
+from a 3 the driver supplies.
+"""
+import sys
+
+if hasattr(sys, "set_int_max_str_digits"):
+    sys.set_int_max_str_digits(0)
+
+k = 104795
+p = 3**k
+digits = str(p)
+assert len(digits) == 50000
+lines = [
+    "fn nat(x : u64) -> Nat { x as Nat }",
+    f"fn nat_literal() -> Nat {{ let k : Nat = {digits}; k }}",
+    f"fn int_literal() -> Int {{ let k : Int = -{digits}; k }}",
+    "fn keyed(n : Nat) -> i64 {",
+    "    match n {",
+    f"        {digits} => 1,",
+    f"        {p + 1} => 2,",
+    "        _ => 0",
+    "    }",
+    "}",
+    "fn digit(ok : bool) -> i64 { if ok { 1 } else { 0 } }",
+    "pub fn main(three : u64) -> i64 {",
+    f"    let p = core::intrinsic::bigint::ipowi(nat(three), {k});",
+    "    digit(nat_literal() == p) + digit(int_literal() == int_zero() - (p as Int)) * 10",
+    "        + digit(keyed(p) == 1 && keyed(p + 1) == 2 && keyed(nat(three)) == 0) * 100",
+    "}",
+    "fn int_zero() -> Int { let z : Int = 0; z }",
+    'extern "C" trampoline "reussir_main" = main;',
+]
+open(sys.argv[1], "w").write("\n".join(lines) + "\n")
diff --git a/tests/integration/frontend/bigint_huge_literal.c b/tests/integration/frontend/bigint_huge_literal.c
new file mode 100644
index 00000000..30aa06ff
--- /dev/null
+++ b/tests/integration/frontend/bigint_huge_literal.c
@@ -0,0 +1,16 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+// Driver for bigint_huge_literal.rr: three independent properties, one
+// decimal digit each. The 3 it passes is unknown to the compiled code, so the
+// power it compares the literals with is computed at run time.
+
+extern long long reussir_main(unsigned long long three);
+
+int main(void) { return reussir_main(3) == 111 ? 0 : 1; }
diff --git a/tests/integration/frontend/bigint_huge_literal.rr b/tests/integration/frontend/bigint_huge_literal.rr
new file mode 100644
index 00000000..d6593892
--- /dev/null
+++ b/tests/integration/frontend/bigint_huge_literal.rr
@@ -0,0 +1,13 @@
+// REQUIRES: rcgmp, linux
+// Integer constants and match keys of 50000 decimal digits (3^104795, as a
+// `Nat`, a negative `Int`, and two keys of a `Nat` match) reach MLIR in
+// hexadecimal: MLIR parses decimal integer text with a multiplication per
+// digit, cubic in the length (minutes at this size), and hexadecimal text by
+// shifts. The compile has a time limit, and the program compares every
+// literal with the same power computed at run time.
+
+// RUN: %python %S/Inputs/bigint_huge_literal.py %t.rr
+// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
+// RUN: timeout 120 %rrc %t.rr --package-name bigint --extern core=%t.core.rri -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/bigint_huge_literal.c -o %t.exe -L%library_path -lreussir_rt %rcgmp_runtime %rpath_flag %extra_sys_libs
+// RUN: %t.exe
