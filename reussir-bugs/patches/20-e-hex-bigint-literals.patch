@@ -402,7 +402,7 @@ impl<'c, 'p, 'tcx> Lowerer<'c, 'p, 'tcx> {
                 ArmTest::AtMost(c) => (ArmKind::AtMost, Some(c)),
                 ArmTest::Default => (ArmKind::Default, None),
