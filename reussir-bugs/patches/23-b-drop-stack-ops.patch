diff --git a/include/Reussir/IR/ReussirOps.td b/include/Reussir/IR/ReussirOps.td
index bbfc946c..2da78217 100644
--- a/include/Reussir/IR/ReussirOps.td
+++ b/include/Reussir/IR/ReussirOps.td
@@ -1897,6 +1897,53 @@ def ReussirDtorSuspendOp : ReussirOp<"dtor.suspend", [
   let assemblyFormat = "$callee `(` $object `:` type($object) `)` attr-dict";
 }
 
+def ReussirRcDeferOp : ReussirOp<"rc.defer", [
+    DeclareOpInterfaceMethods<SymbolUserOpInterface>]> {
+  let summary = "Defer the release of a dead box to the thread's drop stack";
+  let description = [{
+    `reussir.rc.defer @release(%box)` hands a shared box whose last
+    reference the caller owns (its count was observed to be one, and is not
+    decremented) to the current thread's stack of pending drops. The drain
+    that runs the stack later calls `@release(%box)`, which must release the
+    box's content and free the box. Drop glue defers while the thread drains
+    (inside a walk that `reussir.drop.run` called, or inside a release the
+    drain called); outside a drain the release runs at once.
+
+    Example:
+    ```mlir
+    reussir.rc.defer @tree.release(%child : !reussir.rc<!tree>)
+    ```
+  }];
+  let arguments = (ins FlatSymbolRefAttr:$release, ReussirRcType:$box);
+  let assemblyFormat =
+      "$release `(` $box `:` qualified(type($box)) `)` attr-dict";
+}
+
+def ReussirDropRunOp : ReussirOp<"drop.run", [
+    DeclareOpInterfaceMethods<SymbolUserOpInterface>]> {
+  let summary = "Run drop glue whose releases defer to the thread's drop stack";
+  let description = [{
+    `reussir.drop.run @walk(%ref)` calls `@walk(%ref)` with the current
+    thread draining its stack of pending drops, so that the boxes the walk
+    releases can be deferred with `reussir.rc.defer` instead of released by
+    recursion. The outermost `drop.run` of a thread then pops the pending
+    releases, last deferred first, including those they defer in turn, until
+    none is left. A nested one (in a release or a foreign hook that the drain
+    runs) only calls the walk and returns before the value's dead members
+    are released; they are released by the running drain. So the native
+    stack stays bounded however deep the dropped value is, for the box edges
+    the type graph shows.
+
+    Example:
+    ```mlir
+    reussir.drop.run @tree.walk(%ref : !reussir.ref<!tree>)
+    ```
+  }];
+  let arguments = (ins FlatSymbolRefAttr:$walk, ReussirRefType:$object);
+  let assemblyFormat =
+      "$walk `(` $object `:` qualified(type($object)) `)` attr-dict";
+}
+
 def ReussirRefAcquireOp
     : ReussirReferenceOp<"acquire", [MemoryEffects<[MemRead, MemWrite]>]> {
   let summary = "Acquire ownership of a reference";
