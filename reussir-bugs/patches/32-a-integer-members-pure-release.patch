diff --git a/tests/integration/conversion/worklist_integer_members.mlir b/tests/integration/conversion/worklist_integer_members.mlir
new file mode 100644
index 00000000..55437c60
--- /dev/null
+++ b/tests/integration/conversion/worklist_integer_members.mlir
@@ -0,0 +1,54 @@
+// REQUIRES: rcgmp
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true' --verify-each | %FileCheck %s
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true drop-order=forward' --verify-each | %FileCheck %s --check-prefix=FORWARD
+
+// An integer member is released in place: an arm of integers is a leaf, and
+// under backward order an arm of integers and boxes continues in its last
+// dead box. An arm with a foreign object keeps the ordered release.
+
+!handle = !reussir.rc<!reussir.ffi_object<"Handle", @handle_drop>>
+!expr_ = !reussir.record<variant "Expr" incomplete>
+!val = !reussir.record<compound "Expr::Val" [value] { !rcgmp.mpz }>
+!var = !reussir.record<compound "Expr::Var" [value] { !handle }>
+!add = !reussir.record<compound "Expr::Add" [value] { !expr_, !rcgmp.mpz, !expr_ }>
+!expr = !reussir.record<variant "Expr" { !val, !var, !add }>
+!token = !reussir.nullable<!reussir.token<align: 8, size: ?>>
+
+module {
+  func.func private @handle_drop(!handle)
+
+  // CHECK-LABEL: REUSSIR_DROP_release_backward{{.*}}: !reussir.rc<!reussir.record<variant "Expr"
+  // CHECK: ^bb0(%{{.*}}"Expr::Val"
+  // CHECK: rcgmp.release
+  // CHECK-NEXT: reussir.rc.reinterpret
+  // CHECK-NEXT: reussir.token.free
+  // CHECK: ^bb0(%{{.*}}"Expr::Var"
+  // CHECK: reussir.drop.defer
+  // CHECK: reussir.token.free
+  // CHECK: ^bb0(%{{.*}}"Expr::Add"
+  // CHECK: rcgmp.release
+  // CHECK: reussir.token.free
+  // CHECK: reussir.rc.defer
+  // CHECK: {reussir.musttail}
+  // CHECK: {reussir.musttail}
+  // CHECK: return
+  // CHECK-LABEL: REUSSIR_DROP_entry_backward{{.*}}: !reussir.ref<!reussir.record<variant "Expr"
+  // CHECK: ^bb0(%{{.*}}"Expr::Val"
+  // CHECK: rcgmp.release
+  // CHECK-NEXT: reussir.scf.yield
+  // CHECK: reussir.drop.run
+  // CHECK: reussir.drop.run
+
+  // FORWARD-LABEL: REUSSIR_DROP_release_forward{{.*}}: !reussir.rc<!reussir.record<variant "Expr"
+  // FORWARD-NOT: rcgmp.release
+  // FORWARD: call @{{.*}}REUSSIR_DROP_walk_forward
+  // FORWARD-LABEL: REUSSIR_DROP_entry_forward{{.*}}: !reussir.ref<!reussir.record<variant "Expr"
+  // FORWARD: ^bb0(%{{.*}}"Expr::Val"
+  // FORWARD: rcgmp.release
+  // FORWARD-NEXT: reussir.scf.yield
+  func.func @expr(%rc: !reussir.rc<!expr>) {
+    %token = reussir.rc.dec(%rc : !reussir.rc<!expr>) : !token
+    reussir.token.free(%token : !token)
+    return
+  }
+}
diff --git a/tests/integration/conversion/worklist_pure_order.c b/tests/integration/conversion/worklist_pure_order.c
new file mode 100644
index 00000000..893d2905
--- /dev/null
+++ b/tests/integration/conversion/worklist_pure_order.c
@@ -0,0 +1,59 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern void *__reussir_allocate(size_t, size_t);
+extern void __reussir_deallocate(void *, size_t, size_t);
+extern void pure_drop(void *);
+
+// A handle with its id, or the box that owns a handle.
+typedef struct Cell {
+  uint32_t count;
+  uintptr_t value;
+} Cell;
+typedef struct Node {
+  uint32_t count;
+  Cell *owner;
+  struct Node *left, *right;
+} Node;
+static uintptr_t events[4], count;
+
+void pure_cleanup(void *box) {
+  Cell *handle = box;
+  if (--handle->count)
+    return;
+  if (handle->value) {
+    if (count >= 4)
+      abort();
+    events[count++] = handle->value;
+  }
+  __reussir_deallocate(handle, 8, sizeof(*handle));
+}
+static Cell *cell(uintptr_t value) {
+  Cell *result = __reussir_allocate(8, sizeof(*result));
+  *result = (Cell){1, value};
+  return result;
+}
+static Node *node(unsigned id, Node *left, Node *right) {
+  Node *result = __reussir_allocate(8, sizeof(*result));
+  *result = (Node){1, cell((uintptr_t)cell(id)), left, right};
+  return result;
+}
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 1;
+  // Both children of the third node hold the fourth.
+  Node *shared = node(4, NULL, NULL);
+  shared->count = 2;
+  pure_drop(node(1, node(2, NULL, NULL), node(3, shared, shared)));
+  uintptr_t expected[] = {1, 2, 3, 4};
+  if (strcmp(argv[1], "backward") == 0)
+    memcpy(expected, (uintptr_t[]){4, 3, 2, 1}, sizeof(expected));
+  if (count != 4 || memcmp(events, expected, sizeof(events)))
+    return 2;
+  Node *chain = NULL;
+  for (unsigned i = 0; i != 100000; ++i)
+    chain = node(0, NULL, chain);
+  pure_drop(chain);
+  return 0;
+}
diff --git a/tests/integration/conversion/worklist_pure_order.mlir b/tests/integration/conversion/worklist_pure_order.mlir
