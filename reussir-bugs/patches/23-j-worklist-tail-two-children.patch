   // Releases the compound `record` at `ref`, in the box `box`, as the walk
-  // does, except the last member box the walk would defer, when no later
-  // member may push work (their drops then have no effect to reorder): it
-  // comes last, after the box's free, by a tail call of its release if dead.
+  // does: members in field order. Of its last two member boxes the walk
+  // would defer, a and b, each that no later member may push work after (for
+  // a also none between a and b) is decremented in its place instead. Then
+  // the box is freed, and the last of them that died continues by a tail
+  // call of its release (the drain would pop it next); a dead a before a
+  // dead b is deferred.
   void releaseCompound(RecordType record, AtomicKind kind, mlir::Value ref,
                        mlir::Value box) {
     size_t n = record.getMembers().size();
@@ -282,41 +341,71 @@ public:
       return ReussirRefProjectOp::create(rewriter, loc, type, ref,
                                          rewriter.getIndexAttr(i));
     };
-    std::optional<size_t> b;
+    auto pushes = [&](size_t from, size_t to) {
+      return llvm::any_of(llvm::seq(from + 1, to), [&](size_t i) {
+        return !field(i) && mayPush(projected(i));
+      });
+    };
+    std::optional<size_t> a, b;
     for (size_t i = 0; i < n; ++i)
       if (!field(i) && isDeferredBox(projected(i)))
-        b = i;
-    for (size_t i = b ? *b + 1 : n; i < n; ++i)
-      if (!field(i) && mayPush(projected(i)))
-        b.reset();
-    for (size_t i = 0; i < n; ++i)
-      if (i != b && !field(i) && !isTriviallyCopyable(projected(i)))
+        a = std::exchange(b, i);
+    if (b && pushes(*b, n))
+      a.reset(), b.reset();
+    if (a && pushes(*a, *b))
+      a.reset();
+    mlir::Value childA, deadA, childB, deadB;
+    for (size_t i = 0; i < n; ++i) {
+      if (field(i) || isTriviallyCopyable(projected(i)))
+        continue;
+      if (i != a && i != b) {
         ReussirRefDropOp::create(rewriter, loc, slot(i));
-    if (!b)
-      return emitBoxFree(box, loc, module, rewriter);
-    mlir::Value child =
-        ReussirRefLoadOp::create(rewriter, loc, projected(*b), slot(*b));
+        continue;
+      }
+      mlir::Value child =
+          ReussirRefLoadOp::create(rewriter, loc, projected(i), slot(i));
+      (i == a ? childA : childB) = child;
+      (i == a ? deadA : deadB) = deadTest(child);
+    }
     emitBoxFree(box, loc, module, rewriter);
-    auto tail = [&](mlir::Value rc) {
-      auto next = release(llvm::cast<RcType>(rc.getType()));
-      emitDecrement(rc, loc, module, rewriter, [&] {
-        auto call = mlir::func::CallOp::create(rewriter, loc, next,
-                                               mlir::ValueRange{rc});
-        call->setAttr(kMustTailCallAttr, rewriter.getUnitAttr());
-      });
+    if (!b)
+      return;
+    // The child's box, its release, and the call or deferral of it.
+    auto unbox = [&](mlir::Value child) -> mlir::Value {
+      if (auto nullable = llvm::dyn_cast<NullableType>(child.getType()))
+        return ReussirNullableCoerceOp::create(rewriter, loc,
+                                               nullable.getPtrTy(), child);
+      return child;
     };
-    auto nullable = llvm::dyn_cast<NullableType>(child.getType());
-    if (!nullable)
-      return tail(child);
-    auto dispatch = ReussirNullableDispatchOp::create(rewriter, loc,
-                                                      mlir::Type{}, child);
+    auto tail = [&](mlir::Value child) {
+      mlir::Value rc = unbox(child);
+      auto call = mlir::func::CallOp::create(
+          rewriter, loc, release(llvm::cast<RcType>(rc.getType())),
+          mlir::ValueRange{rc});
+      call->setAttr(kMustTailCallAttr, rewriter.getUnitAttr());
+    };
+    auto onlyIf = [&](mlir::Value cond, llvm::function_ref<void()> then) {
+      auto branch = mlir::scf::IfOp::create(rewriter, loc, cond, false);
+      mlir::OpBuilder::InsertionGuard guard(rewriter);
+      rewriter.setInsertionPointToStart(branch.thenBlock());
+      then();
+    };
+    auto branch = mlir::scf::IfOp::create(rewriter, loc, deadB, bool(a));
     mlir::OpBuilder::InsertionGuard guard(rewriter);
-    rewriter.createBlock(&dispatch.getNullRegion());
-    ReussirScfYieldOp::create(rewriter, loc, nullptr);
-    auto *present = rewriter.createBlock(&dispatch.getNonNullRegion(), {},
-                                         {nullable.getPtrTy()}, {loc});
-    tail(present->getArgument(0));
-    ReussirScfYieldOp::create(rewriter, loc, nullptr);
+    rewriter.setInsertionPointToStart(branch.thenBlock());
+    if (a)
+      onlyIf(deadA, [&] {
+        mlir::Value rc = unbox(childA);
+        auto next = release(llvm::cast<RcType>(rc.getType()));
+        ReussirRcDeferOp::create(
+            rewriter, loc, mlir::FlatSymbolRefAttr::get(next.getSymNameAttr()),
+            rc);
+      });
+    tail(childB);
+    if (a) {
+      rewriter.setInsertionPointToStart(branch.elseBlock());
+      onlyIf(deadA, [&] { tail(childA); });
+    }
   }
 
   mlir::func::FuncOp release(RcType rc) {
