+// A member between the last two children that may push work keeps the
+// first one deferred in field order; the last continues by a tail call.
+!m_ = !reussir.record<compound "WlMid" incomplete>
+!minl = !reussir.record<compound "WlMidInl" [value] {!reussir.nullable<!reussir.rc<!m_>>}>
+!m = !reussir.record<compound "WlMid" {!reussir.nullable<!reussir.rc<!m_>>, !minl, !reussir.nullable<!reussir.rc<!m_>>}>
