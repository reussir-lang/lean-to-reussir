+  // Decrements the member box `child` (plain or nullable) and answers
+  // whether it died: its count reached zero, and it is the caller's.
+  mlir::Value deadTest(mlir::Value child) {
+    auto i1 = rewriter.getI1Type();
+    // `cond ? value() : false`
+    auto guarded = [&](mlir::Value cond,
+                       llvm::function_ref<mlir::Value()> value) {
+      auto branch = mlir::scf::IfOp::create(rewriter, loc, mlir::TypeRange{i1},
+                                            cond, true, true);
+      mlir::OpBuilder::InsertionGuard guard(rewriter);
+      rewriter.setInsertionPointToStart(branch.thenBlock());
+      mlir::scf::YieldOp::create(rewriter, loc, mlir::ValueRange{value()});
+      rewriter.setInsertionPointToStart(branch.elseBlock());
+      mlir::Value no = mlir::arith::ConstantIntOp::create(rewriter, loc, i1, 0);
+      mlir::scf::YieldOp::create(rewriter, loc, mlir::ValueRange{no});
+      return branch.getResult(0);
+    };
+    if (auto nullable = llvm::dyn_cast<NullableType>(child.getType()))
+      return guarded(ReussirNullableCheckOp::create(rewriter, loc, child), [&] {
+        return deadTest(ReussirNullableCoerceOp::create(
+            rewriter, loc, nullable.getPtrTy(), child));
+      });
+    auto type = llvm::cast<RcType>(child.getType());
+    auto test = [&]() -> mlir::Value {
+      bool atomic = type.getAtomicKind() == AtomicKind::atomic;
+      mlir::Value count =
+          atomic ? ReussirRcFetchSubOp::create(rewriter, loc, child).getRefCount()
+                 : ReussirRcFetchOp::create(rewriter, loc, child).getRefCount();
+      mlir::Value one = mlir::arith::ConstantIndexOp::create(rewriter, loc, 1);
+      mlir::Value unique = mlir::arith::CmpIOp::create(
+          rewriter, loc, mlir::arith::CmpIPredicate::eq, count, one);
+      if (!atomic) {
+        auto branch = mlir::scf::IfOp::create(rewriter, loc, unique, true);
+        mlir::OpBuilder::InsertionGuard guard(rewriter);
+        rewriter.setInsertionPointToStart(branch.elseBlock());
+        ReussirRcSetOp::create(
+            rewriter, loc, child,
+            mlir::arith::SubIOp::create(rewriter, loc, count, one));
+      }
+      return unique;
+    };
+    // An immediate owns no memory (see emitDecrement).
+    if (module->hasAttr(kSpecialPtrTagAttr) && type.mayCarrySpecialPointerTag()) {
+      mlir::Value immediate =
+          ReussirRcIsImmediateOp::create(rewriter, loc, i1, child);
+      mlir::Value yes = mlir::arith::ConstantIntOp::create(rewriter, loc, i1, 1);
+      return guarded(
+          mlir::arith::XOrIOp::create(rewriter, loc, immediate, yes), test);
+    }
+    return test();
+  }
