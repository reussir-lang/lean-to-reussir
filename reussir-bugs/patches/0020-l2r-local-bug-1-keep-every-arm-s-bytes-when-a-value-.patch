From d1fbe33b83742b18c8b1811fc36069d112401d18 Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Fri, 2 Oct 2026 21:41:35 -0400
Subject: [PATCH] l2r-local: bug 1: keep every arm's bytes when a [value] enum
 moves as a value

A variant's payload was converted to the LLVM type of one representative
arm (the last arm with the largest alignment), and [value] variants move
as first-class aggregates of that type: record.variant stores the arm into
an alloca and loads the whole variant, values are passed by value,
spilled and stored in fields. A first-class load or store of a struct
carries only its members' value bits, so another arm's bytes that fall on
the representative's padding or on an i1 field did not survive:
`enum [value] M { A(u8), B(bool) }` read A(42) back as 0 (B's i1 kept
bit 0), a u64 overlapping a nested value enum's tag padding kept one
byte, and a pointer there crashed.

For a [value] variant whose representative does not carry every byte of
its storage (it has padding, an integer narrower than its bytes, or a
floating-point or vector value) and which has more than one arm with
bytes, convert the payload to an array of alignment-sized integers of the
payload's size ([size / align x i<8 * align>]). It has the same size and
alignment, so the variant's size, alignment and payload offset do not
change, and every byte survives the aggregate moves. Every access to an
arm goes through a GEP to the payload member and then uses the arm's own
type (record.coerce, record.variant, rc.create_variant), so field
accesses are unchanged. Representatives that carry all bytes (lean2rr's
Nat and Int: { ptr } against { i64 }) and variants with at most one arm
with bytes keep their type, so their code is unchanged. Fused-header
(shared) variants keep their representative too: they are only accessed
through their boxes. [value] records do not cross the FFI boundary, and
export trampolines take records by pointer, so no calling convention
changes.

The arm's LLVM struct must fit in the payload, which needs the
declaration-order layout to agree with Reussir's (bug 8, the previous
local patch): without it, an arm such as (record of 3 bytes, u16) under
--no-pack-record-members was larger in LLVM than the integer array.

lean2rr emits only unaffected [value] enums (field-less enumerations,
Nat, Int); their LLVM types are the same before and after. Test:
tests/integration/frontend/value_enum_payload_bytes.
---
 .../TypeConverter/TypeConverter.cpp           | 89 +++++++++++++++++--
 .../frontend/value_enum_payload_bytes.c       | 15 ++++
 .../frontend/value_enum_payload_bytes.rr      | 70 +++++++++++++++
 3 files changed, 167 insertions(+), 7 deletions(-)
 create mode 100644 tests/integration/frontend/value_enum_payload_bytes.c
 create mode 100644 tests/integration/frontend/value_enum_payload_bytes.rr

diff --git a/lib/Conversion/TypeConverter/TypeConverter.cpp b/lib/Conversion/TypeConverter/TypeConverter.cpp
index 8b6cd7e6..0ac2d176 100644
--- a/lib/Conversion/TypeConverter/TypeConverter.cpp
+++ b/lib/Conversion/TypeConverter/TypeConverter.cpp
@@ -83,6 +83,68 @@ buildMLIRDataLayout(const mlir::LLVMTypeConverter &converter) {
   return std::make_shared<mlir::DataLayout>(layoutModule);
 }
 
+// Whether a first-class load and store of the LLVM type `type` carry every
+// byte of its storage: no padding, no integer narrower than its bytes (an i1
+// keeps one bit of its byte), and, conservatively, no floating-point or
+// vector values.
+bool carriesAllBytes(mlir::Type type, const mlir::DataLayout &dataLayout) {
+  if (auto intTy = llvm::dyn_cast<mlir::IntegerType>(type))
+    return intTy.getWidth() % 8 == 0;
+  if (llvm::isa<mlir::LLVM::LLVMPointerType>(type))
+    return true;
+  if (auto arrayTy = llvm::dyn_cast<mlir::LLVM::LLVMArrayType>(type)) {
+    mlir::Type element = arrayTy.getElementType();
+    return carriesAllBytes(element, dataLayout) &&
+           dataLayout.getTypeSize(element) %
+                   dataLayout.getTypeABIAlignment(element) ==
+               0;
+  }
+  if (auto structTy = llvm::dyn_cast<mlir::LLVM::LLVMStructType>(type)) {
+    if (structTy.isOpaque() ||
+        (structTy.isIdentified() && !structTy.isInitialized()))
+      return false;
+    uint64_t offset = 0;
+    for (mlir::Type member : structTy.getBody()) {
+      uint64_t align =
+          structTy.isPacked() ? 1 : dataLayout.getTypeABIAlignment(member);
+      if (offset % align != 0 || !carriesAllBytes(member, dataLayout))
+        return false;
+      offset += dataLayout.getTypeSize(member);
+    }
+    return offset == dataLayout.getTypeSize(structTy);
+  }
+  return false;
+}
+
+// A [value] variant's payload is converted to its representative arm (the
+// last arm with the largest alignment), and [value] variants move as
+// first-class aggregates of that type (record.variant, arguments, spills,
+// fields). Another arm's bytes survive such a move only where the
+// representative has value bytes. Unless that holds everywhere, or only one
+// arm has bytes at all, use an array of alignment-sized integers of the
+// payload's size instead: it has the same size and alignment, and every byte
+// survives. Field accesses address the payload member and then use the
+// arm's own type, so they are unaffected. Returns null to keep the
+// representative (also when no integer type has the payload's alignment).
+mlir::Type opaquePayloadType(RecordType type, mlir::Type representative,
+                             llvm::TypeSize size, llvm::Align alignment,
+                             const mlir::DataLayout &dataLayout) {
+  size_t armsWithBytes = 0;
+  for (auto [member, isField] :
+       llvm::zip(type.getMembers(), type.getMemberIsField()))
+    if (member && dataLayout.getTypeSize(getProjectedType(
+                      member, isField, Capability::value)) != 0)
+      ++armsWithBytes;
+  if (armsWithBytes <= 1 || carriesAllBytes(representative, dataLayout))
+    return nullptr;
+  auto word = mlir::IntegerType::get(type.getContext(), alignment.value() * 8);
+  if (dataLayout.getTypeABIAlignment(word) != alignment.value() ||
+      size.getFixedValue() % alignment.value() != 0)
+    return nullptr;
+  return mlir::LLVM::LLVMArrayType::get(word, size.getFixedValue() /
+                                                  alignment.value());
+}
+
 std::optional<llvm::LogicalResult>
 convertRecordType(mlir::LLVMTypeConverter &converter,
                   const mlir::DataLayout &dataLayout, RecordType type,
@@ -112,15 +174,28 @@ convertRecordType(mlir::LLVMTypeConverter &converter,
     if (type.hasFusedHeader())
       members.push_back(mlir::IntegerType::get(type.getContext(), 32));
     members.push_back(type.getTagType());
-    auto [size, _unused, representative] =
+    auto [size, alignment, representative] =
         type.getElementRegionLayoutInfo(dataLayout);
     if (representative) {
-      members.push_back(converter.convertType(representative));
-      auto representativeSize = dataLayout.getTypeSize(representative);
-      if (representativeSize < size)
-        members.push_back(mlir::LLVM::LLVMArrayType::get(
-            mlir::IntegerType::get(type.getContext(), 8),
-            size.getFixedValue() - representativeSize.getFixedValue()));
+      mlir::Type payload = converter.convertType(representative);
+      // Fused-header (shared) variants are accessed through their boxes: a
+      // value of one only exists between its construction and the rc.create
+      // that boxes it, which RcCreateFusion turns into per-field stores.
+      // [value] variants are moved as values.
+      mlir::Type opaque =
+          type.hasFusedHeader()
+              ? mlir::Type{}
+              : opaquePayloadType(type, payload, size, alignment, dataLayout);
+      if (opaque) {
+        members.push_back(opaque);
+      } else {
+        members.push_back(payload);
+        auto representativeSize = dataLayout.getTypeSize(representative);
+        if (representativeSize < size)
+          members.push_back(mlir::LLVM::LLVMArrayType::get(
+              mlir::IntegerType::get(type.getContext(), 8),
+              size.getFixedValue() - representativeSize.getFixedValue()));
+      }
     }
   } else {
     size_t expectedTotalSize = dataLayout.getTypeSize(type);
