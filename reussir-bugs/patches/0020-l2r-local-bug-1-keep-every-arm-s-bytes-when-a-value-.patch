diff --git a/tests/integration/frontend/value_enum_payload_bytes.rr b/tests/integration/frontend/value_enum_payload_bytes.rr
new file mode 100644
index 00000000..ea8e68b6
--- /dev/null
+++ b/tests/integration/frontend/value_enum_payload_bytes.rr
@@ -0,0 +1,70 @@
+// A [value] enum is lowered to `{tag, payload}`. Values move as first-class
+// aggregates (built by record.variant, passed by value, spilled, stored in
+// fields), so the payload's LLVM type must carry every byte of every arm.
+// The representative arm alone does not when it has padding or an i1 field:
+// the other arms' bytes there were lost (A(42) read back through B's i1 as
+// 0, a u64 through a nested enum's tag padding kept one byte, a pointer
+// there crashed). Such payloads are converted to an array of alignment-sized
+// integers; a representative whose bytes are all value bytes is kept.
+
+// RUN: %rrc %s -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/value_enum_payload_bytes.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
+// RUN: %cc %t.opt.o %S/value_enum_payload_bytes.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.opt.exe
+// RUN: %rrc %s -o %t.np.o --relocation-mode pic -Oaggressive --no-pack-record-members
+// RUN: %cc %t.np.o %S/value_enum_payload_bytes.c -o %t.np.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.np.exe
+// RUN: %rrc %s --emit llvm-ir -O none -o %t.ll
+// RUN: %FileCheck %s < %t.ll
+
+enum [value] Flag { A(u8), B(bool) }
+enum [value] N { S(u64) }
+enum [value] Mode { E(u64), J(N) }
+pub struct Big(u64)
+enum [value] Held { E(Big), J(N) }
+enum [value] Pair { E(u64, u64), J(u64, bool) }
+enum [value] Num { Small(u64), Large(Big) }
+struct Bx(Flag)
+struct [value] S3(u8, u8, u8)
+struct [value] Q(S3, u16)
+enum [value] Odd { B(u8, bool), A(Q, u16) }
+
+fn flag(m : Flag) -> u64 { match m { Flag::A(x) => { x as u64 }, Flag::B(v) => { 7 } } }
+fn mode(m : Mode) -> u64 { match m { Mode::E(x) => { x }, Mode::J(n) => { 0 } } }
+fn held(m : Held) -> u64 { match m { Held::E(b) => { b.0 }, Held::J(n) => { 0 } } }
+fn pair(m : Pair) -> u64 { match m { Pair::E(x, y) => { y }, Pair::J(a, b) => { 0 } } }
+fn num(m : Num) -> u64 { match m { Num::Small(x) => { x }, Num::Large(b) => { b.0 } } }
+fn boxed(b : Bx) -> u64 { flag(b.0) }
+fn odd(m : Odd) -> u64 {
+    match m {
+        Odd::A(q, x) => { (q.0.2 as u64) * 100000 + (q.1 as u64) * 1000 + (x as u64) },
+        Odd::B(a, b) => { (a as u64) + (if b { 1 } else { 0 }) }
+    }
+}
+fn id_odd(m : Odd) -> Odd { m }
+
+pub fn main() -> i64 {
+    let flag_ok = if flag(Flag::A{42}) == 42 { 1 } else { 0 };
+    let mode_ok = if mode(Mode::E{123456789}) == 123456789 { 1 } else { 0 };
+    let held_ok = if held(Held::E{Big{3}}) == 3 { 1 } else { 0 };
+    let pair_ok = if pair(Pair::E{1, 123456789}) == 123456789 { 1 } else { 0 };
+    let num_ok = if num(Num::Small{5}) + num(Num::Large{Big{6}}) == 11 { 1 } else { 0 };
+    let boxed_ok = if boxed(Bx{Flag::A{42}}) == 42 { 1 } else { 0 };
+    let odd_ok = if odd(id_odd(Odd::A{Q{S3{7, 8, 9}, 4}, 5})) + odd(id_odd(Odd::B{42, true})) == 904048 { 1 } else { 0 };
+    flag_ok + mode_ok * 10 + held_ok * 100 + pair_ok * 1000 + num_ok * 10000
+        + boxed_ok * 100000 + odd_ok * 1000000
+}
+
+extern "C" trampoline "reussir_main" = main;
+
+// Lossy representatives become integer arrays of the payload's size and
+// alignment; the representatives of Num (a pointer) and Odd (a record
+// without padding) carry every byte and are kept.
+// CHECK-DAG: %_RC4Flag = type { i8, [1 x i8] }
+// CHECK-DAG: %_RC4Mode = type { i8, [2 x i64] }
+// CHECK-DAG: %_RC4Held = type { i8, [2 x i64] }
+// CHECK-DAG: %_RC4Pair = type { i8, [2 x i64] }
+// CHECK-DAG: %_RC3Odd = type { i8, %_RNvC3Odd1A }
+// CHECK-DAG: %_RC3Num = type { i8, %_RNvC3Num5Large }
