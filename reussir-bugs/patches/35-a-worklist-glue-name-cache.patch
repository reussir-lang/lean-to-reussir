@@ -30,12 +30,19 @@
 
 namespace reussir {
 
+// The symbol tables of one expansion run, with the worklist glue already
+// resolved in them by module, signature and role.
+struct DropGlueSymbols {
+  using GlueKey = std::tuple<mlir::ModuleOp, mlir::Type, mlir::Attribute>;
+  mlir::SymbolTableCollection tables;
+  llvm::DenseMap<GlueKey, mlir::func::FuncOp> worklistGlue;
+};
+
 // `symbols`, if given, holds the symbol tables the outlined glue is looked
 // up in (see `createDtorIfNotExists`); it must outlive the patterns.
