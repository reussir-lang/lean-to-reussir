     mlir::RewritePatternSet &patterns, bool outlineRecord,
-    mlir::SymbolTableCollection *symbols = nullptr,
-    bool tailRecursiveDrops = true);
+    DropGlueSymbols *symbols = nullptr, bool tailRecursiveDrops = true);
 
 } // namespace reussir
 
