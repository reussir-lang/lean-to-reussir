diff --git a/lib/Conversion/BasicOpsLowering/DropStackLowering.cpp b/lib/Conversion/BasicOpsLowering/DropStackLowering.cpp
index 0a91ced2..20ef4840 100644
--- a/lib/Conversion/BasicOpsLowering/DropStackLowering.cpp
+++ b/lib/Conversion/BasicOpsLowering/DropStackLowering.cpp
@@ -13,12 +13,15 @@
 // `__reussir_drop_defer(box, release)` and `__reussir_drop_run(ref, walk)`,
 // the function operand passed by address. The runtime calls it back with
 // the C ABI `void(ptr)`, which is the lowered type of every such callee.
+// A box whose first 8 bytes are header with 16 spare bits goes to
+// `__reussir_drop_defer_wide`, which may link it through them.
 //
 //===----------------------------------------------------------------------===//
 
 #include "Reussir/Conversion/BasicOpsLowering.h"
 #include "Reussir/IR/ReussirOps.h"
 #include <mlir/Dialect/LLVMIR/LLVMDialect.h>
+#include <mlir/Interfaces/DataLayoutInterfaces.h>
 
 namespace reussir {
 namespace {
@@ -40,6 +43,29 @@ LLVM::LLVMFuncOp dropStackFunction(Operation *op, StringRef name) {
   return function;
 }
 
+// Whether a box of `type` starts with 8 bytes of header whose upper 16 bits
+// are zero or unused: a fused variant box (the 32-bit count, then the i32
+// tag, below 2^16) or a compound record box whose payload starts at offset
+// 8 or later (the count, then padding). The runtime then may keep its link
+// to the box deferred before it there, and writes count 1 and the upper
+// bits 0 back before the release, which reads neither.
+bool hasWideHeader(RcType type, const LLVMTypeConverter &converter,
+                   Operation *op) {
+  auto record = llvm::dyn_cast<RecordType>(type.getElementType());
+  if (!record || type.getCapability() != Capability::shared)
+    return false;
+  RcBoxType box = type.getInnerBoxType();
+  if (box.isHeaderFused())
+    return record.getMembers().size() <= (1u << 16);
+  if (box.getHeaderTypes().size() != 1)
+    return false;
+  // The box is `{i32, payload}`, not packed: the payload starts at its
+  // alignment (a packed record's is 1).
+  Type payload = converter.convertType(record);
+  return payload &&
+         DataLayout::closest(op).getTypeABIAlignment(payload) >= 8;
+}
+
 template <typename Op>
 struct DropStackCallPattern : ConvertOpToLLVMPattern<Op> {
   StringRef runtime;
@@ -49,7 +75,12 @@ struct DropStackCallPattern : ConvertOpToLLVMPattern<Op> {
   LogicalResult
   matchAndRewrite(Op op, typename Op::Adaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
-    auto callee = dropStackFunction(op, runtime);
+    StringRef name = runtime;
+    if constexpr (std::is_same_v<Op, ReussirRcDeferOp>)
+      if (hasWideHeader(op.getBox().getType(), *this->getTypeConverter(),
+                        op))
+        name = "__reussir_drop_defer_wide";
+    auto callee = dropStackFunction(op, name);
     auto ptr = LLVM::LLVMPointerType::get(op.getContext());
     auto [symbol, object] = [&] {
       if constexpr (std::is_same_v<Op, ReussirRcDeferOp>)
