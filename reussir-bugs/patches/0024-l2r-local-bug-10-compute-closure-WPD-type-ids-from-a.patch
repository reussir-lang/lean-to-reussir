diff --git a/docs/design/closure-wpd.md b/docs/design/closure-wpd.md
index bc93e497..b27377f3 100644
--- a/docs/design/closure-wpd.md
+++ b/docs/design/closure-wpd.md
@@ -16,11 +16,14 @@ type is therefore the one component of the static type that every value
 backed by a given vtable agrees on, and the strongest fact a call site can
 assert about the vtable it is about to dispatch through. That yields the
 whole id scheme: **one type id per closure return type**
-(`reussir.closure.wpd.<b62(blake3(print(c)))>`, built in `ClosureWpd.h`;
-identical return types produce identical ids in any module). Captures fold in
-for free — the frontend materializes a capture as a pre-applied leading
-parameter, so a capturing closure shares the id of every closure with the
-same visible return type.
+(`reussir.closure.wpd.<b62(blake3(text(c)))>`, built in `ClosureWpd.h`, where
+`text(c)` is `c` printed by `printTypeWithRecordBodiesOnce`: the usual form,
+except that each named record's body is written only at its first occurrence
+and later as `<kind "name">`, so a record nested along many paths costs its
+body once; identical return types produce identical ids in any module).
+Captures fold in for free — the frontend materializes a capture as a
+pre-applied leading parameter, so a capturing closure shares the id of every
+closure with the same visible return type.
 
 This maps directly onto LLVM's stock WPD contract:
 
diff --git a/include/Reussir/Conversion/ClosureWpd.h b/include/Reussir/Conversion/ClosureWpd.h
index 9b77f0a4..7f8f6843 100644
--- a/include/Reussir/Conversion/ClosureWpd.h
+++ b/include/Reussir/Conversion/ClosureWpd.h
@@ -22,10 +22,14 @@
 /// minimal scheme under which every vtable observable at a tested site carries
 /// the tested id, which is all `WholeProgramDevirt` requires.
 ///
-/// The id embeds the base-62 BLAKE3 digest of the return type's canonical
-/// textual form (the `Blake3Symbol.h` convention), so identical return types
-/// produce identical ids in any module. Ids are metadata strings, never
-/// symbols, so no mangling scheme applies.
+/// The id embeds the base-62 BLAKE3 digest of the return type's textual form
+/// with each named record's body written once
+/// (`printTypeWithRecordBodiesOnce`; the `Blake3Symbol.h` convention), so
+/// identical return types produce identical ids in any module, and a named
+/// record reached along many paths costs its body once (the canonical form
+/// repeats it once per path, exponentially many for nested records; unnamed
+/// composite types such as closure types are still repeated). Ids are
+/// metadata strings, never symbols, so no mangling scheme applies.
 ///
 /// See docs/design/closure-wpd.md for the full design.
 ///
@@ -65,7 +69,7 @@ inline std::string closureWpdTypeId(ClosureType closureType) {
   if (mlir::Type output = closureType.getOutputType()) {
     std::string text;
     llvm::raw_string_ostream os(text);
-    output.print(os);
+    printTypeWithRecordBodiesOnce(output, os);
     llvm::BLAKE3 hasher;
     hasher.update(text);
     id += base62Digits(blake3Words(hasher));
diff --git a/include/Reussir/IR/ReussirTypes.h b/include/Reussir/IR/ReussirTypes.h
index 377477b0..fd6aa13d 100644
--- a/include/Reussir/IR/ReussirTypes.h
+++ b/include/Reussir/IR/ReussirTypes.h
@@ -55,6 +55,20 @@ mlir::Type getProjectedType(mlir::Type type, bool fieldCap, Capability refCap,
                             AtomicKind parentAtomic = AtomicKind::normal);
 mlir::Type memberStorageType(mlir::MLIRContext *context, mlir::Type rawMember,
                              bool isField, bool memBoxInternal = false);
+// Prints `type` as `type.print(os)` does, except that the body of each named
+// record is written only at its first occurrence: later occurrences print as
+// `<kind "name">`, the form `RecordType::print` already uses for a
+// self-reference. The text still determines the type (a named record's body
+// is fixed by its name, and it is written once). The full form repeats a
+// named record's body once per path that reaches it (exponential for a record
+// nested k levels deep through two members per level); here each named
+// record costs its body once. Only named records are shortened: an unnamed
+// composite type (a closure type, an anonymous record) is still written at
+// each occurrence, so a type that repeats such a type along many paths (for
+// instance `T(i+1) = (T(i)) -> T(i)`) is still exponential, as in the full
+// form. For type identities computed from text (closure WPD type ids); the
+// output is not meant to be parsed back.
+void printTypeWithRecordBodiesOnce(mlir::Type type, llvm::raw_ostream &os);
 class CellType;
 // The `sync` primitive type physically backing a lock-guarded cell:
 // `!sync.mutex<T>` for a mutex cell, `!sync.combining_lock<T>` for a flatlock
diff --git a/lib/IR/ReussirTypes.cpp b/lib/IR/ReussirTypes.cpp
index 018fa528..1e8a1d18 100644
--- a/lib/IR/ReussirTypes.cpp
+++ b/lib/IR/ReussirTypes.cpp
@@ -17,6 +17,7 @@
 #include <bit>
 #include <cstdint>
 #include <llvm/ADT/ArrayRef.h>
+#include <llvm/ADT/DenseSet.h>
 #include <llvm/ADT/STLExtras.h>
 #include <llvm/ADT/StringSwitch.h>
 #include <llvm/ADT/Twine.h>
@@ -39,6 +40,7 @@
 #include <mlir/Interfaces/DataLayoutInterfaces.h>
 #include <optional>
 #include <tuple>
+#include <utility>
 
 #include "Reussir/IR/ReussirDialect.h"
 #include "Reussir/IR/ReussirEnumAttrs.h"
@@ -555,6 +557,20 @@ mlir::Type RecordType::parse(mlir::AsmParser &parser) {
   return result;
 }
 
+namespace {
+// While `printTypeWithRecordBodiesOnce` runs on this thread: the named records
+// whose body it has started to print.
+thread_local llvm::DenseSet<mlir::Type> *recordBodiesPrinted = nullptr;
+} // namespace
+
+void printTypeWithRecordBodiesOnce(mlir::Type type, llvm::raw_ostream &os) {
+  llvm::DenseSet<mlir::Type> printed;
+  llvm::DenseSet<mlir::Type> *outer =
+      std::exchange(recordBodiesPrinted, &printed);
+  type.print(os);
+  recordBodiesPrinted = outer;
+}
+
 void RecordType::print(::mlir::AsmPrinter &printer) const {
   llvm::FailureOr<mlir::AsmPrinter::CyclicPrintReset> cyclicPrintGuard;
   // Start printing the record type.
@@ -565,9 +581,13 @@ void RecordType::print(::mlir::AsmPrinter &printer) const {
   if (getName())
     printer << getName();
 
-  // Current type has already been printed: print as self reference.
+  // Current type has already been printed: print as self reference. Under
+  // `printTypeWithRecordBodiesOnce`, so is a named record whose body was
+  // printed earlier in the same text.
   cyclicPrintGuard = printer.tryStartCyclicPrint(*this);
-  if (failed(cyclicPrintGuard)) {
+  if (failed(cyclicPrintGuard) ||
+      (getName() && recordBodiesPrinted &&
+       !recordBodiesPrinted->insert(*this).second)) {
     printer << '>';
     return;
   }
