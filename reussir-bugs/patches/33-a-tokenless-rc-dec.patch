From 31059c980507181e017a4291a6dced3fe47284c0 Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Thu, 19 Nov 2026 10:53:32 -0500
Subject: [PATCH 17/18] [rc] leave a decrement without a token result
 unexpanded

`reussir.rc.dec` of a shared box is valid without its token result: it is
the form the frontend emits before `reussir-token-instantiation`. The
decrement expansion read the type of that result without a test, so
`reussir-rc-decrement-expansion` and `reussir-acquire-drop-expansion` with
`expand-decrement` crashed (SIGSEGV in the rewrite pattern) when
`reussir-opt` ran them on such an input.

Token instantiation runs before the expansion by design, so the pattern
does not instantiate the token. It now tests for the result and reports a
match failure, as the `array.create` pattern of `reussir-convert-to-std`
does for a missing token. The decrement stays in the module and the pass
succeeds; a later conversion to LLVM reports it as an operation that it
cannot legalize. The pass description names the requirement.

rrc's pipeline instantiates producer tokens before either expansion. A
decrement that takes the new exit crashed before, so no generated code
changes.
---
 include/Reussir/Conversion/Passes.td          |  4 ++
 .../RcDecrementExpansion.cpp                  |  5 +++
 .../rc_dec_expansion_missing_token.mlir       | 42 +++++++++++++++++++
 3 files changed, 51 insertions(+)
 create mode 100644 tests/integration/conversion/rc_dec_expansion_missing_token.mlir

diff --git a/include/Reussir/Conversion/Passes.td b/include/Reussir/Conversion/Passes.td
index 68585ffe..47b23711 100644
--- a/include/Reussir/Conversion/Passes.td
+++ b/include/Reussir/Conversion/Passes.td
@@ -211,6 +211,10 @@ def ReussirRcDecrementExpansionPass : Pass<"reussir-rc-decrement-expansion"> {
     `reussir-rc-decrement-expansion` expands Reussir rc decrement operations.
     This is separated from the ConvertToSTD pass because it may be used in
     early stages of the pipeline.
+
+    The `producers` phase of `reussir-token-instantiation` must run first: a
+    decrement that should produce a token and has no token result is left
+    unexpanded.
   }];
 
   let options = [
diff --git a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
index 796a50a9..f8ffff32 100644
--- a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
+++ b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
@@ -110,6 +110,11 @@ struct RcDecrementExpansionPattern
         mlir::isa<FFIObjectType, ClosureType>(type.getElementType()))
       return mlir::failure();
 
+    // The token result comes from `reussir-token-instantiation`, which runs
+    // first by design. A decrement without it stays unexpanded.
+    if (!op.getNullableToken())
+      return rewriter.notifyMatchFailure(op, "requires token instantiation");
+
     // An atomic box decrements with one acquire-release `rc.fetch_sub`
     // (returning the previous count): the subtraction is already published,
     // so unlike the plain-load scheme below there is nothing to store on the
diff --git a/tests/integration/conversion/rc_dec_expansion_missing_token.mlir b/tests/integration/conversion/rc_dec_expansion_missing_token.mlir
new file mode 100644
index 00000000..f5a162aa
--- /dev/null
+++ b/tests/integration/conversion/rc_dec_expansion_missing_token.mlir
@@ -0,0 +1,42 @@
+// RUN: %reussir-opt %s --reussir-rc-decrement-expansion | %FileCheck %s
+// RUN: %reussir-opt %s \
+// RUN:   --reussir-acquire-drop-expansion='expand-decrement=1 outline-record=1' \
+// RUN:   | %FileCheck %s
+// RUN: %reussir-opt %s --reussir-token-instantiation \
+// RUN:   --reussir-rc-decrement-expansion \
+// RUN:   | %FileCheck %s --check-prefix=TOKEN \
+// RUN:     --implicit-check-not=reussir.rc.dec
+//
+// A decrement gets its token result from `reussir-token-instantiation`, which
+// runs before the expansion. Without that pass the expansion leaves the
+// decrement as it is; with it, the decrement is expanded.
+
+!leaf = !reussir.record<compound "Leaf" { i64, f64 }>
+!v_a = !reussir.record<compound "V::A" [value] { i64 }>
+!v_b = !reussir.record<compound "V::B" [value] { i64, i64 }>
+!v = !reussir.record<variant "V" { !v_a, !v_b }>
+
+module {
+  // CHECK-LABEL: func.func @leaf(
+  // CHECK-NEXT: reussir.rc.dec(%{{.*}} : !reussir.rc<!reussir.record<compound "Leaf" {i64, f64}>>){{ *$}}
+  // CHECK-NEXT: return
+  // TOKEN-LABEL: func.func @leaf(
+  // TOKEN: reussir.rc.fetch
+  // TOKEN: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 24>>) {
+  // TOKEN: } {reussir.expanded_decrement}
+  func.func @leaf(%rc: !reussir.rc<!leaf>) {
+    reussir.rc.dec(%rc : !reussir.rc<!leaf>)
+    return
+  }
+
+  // CHECK-LABEL: func.func @pinned(
+  // CHECK-NEXT: reussir.rc.dec(%{{.*}}) {boundMembers = array<i64: 0>, destructureTag = 0 : index}
+  // CHECK-NEXT: return
+  // TOKEN-LABEL: func.func @pinned(
+  // TOKEN: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 16>>) {
+  // TOKEN: } {reussir.expanded_decrement}
+  func.func @pinned(%rc: !reussir.rc<!v>) {
+    reussir.rc.dec(%rc : !reussir.rc<!v>) {boundMembers = array<i64: 0>, destructureTag = 0 : index}
+    return
+  }
+}
