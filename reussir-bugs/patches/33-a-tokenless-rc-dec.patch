From 74b55900d3f0ee7b43f9465651570edab0415bac Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Wed, 18 Nov 2026 11:06:17 -0500
Subject: [PATCH 16/17] [rc] expand a decrement that has no token result

`reussir.rc.dec` of a shared box is valid without its token result: it is
the form the frontend emits, and `rrc --emit mlir` prints it. The decrement
expansion read the type of that result without a test, so
`reussir-rc-decrement-expansion` and `reussir-acquire-drop-expansion` with
`expand-decrement` crashed (SIGSEGV in the rewrite pattern) on such an
input, for example on frontend MLIR given to `reussir-opt` without
`reussir-token-instantiation` first.

The pattern now gives such a decrement its token through
`replaceWithProduced`, the rewrite that the producer phase of
`reussir-token-instantiation` applies, and expands the rebuilt decrement on
its next visit. The expansion is the last consumer of the destructuring
attributes, so the token type is final there: the output is the same as
with the token pass first.

rrc's pipeline instantiates producer tokens before either expansion, so
it never takes the new branch and its generated code does not change.
---
 include/Reussir/Conversion/Passes.td          |  4 ++
 .../RcDecrementExpansion.cpp                  |  6 ++
 .../rc_dec_expansion_missing_token.mlir       | 67 +++++++++++++++++++
 3 files changed, 77 insertions(+)
 create mode 100644 tests/integration/conversion/rc_dec_expansion_missing_token.mlir

diff --git a/include/Reussir/Conversion/Passes.td b/include/Reussir/Conversion/Passes.td
index 68585ffe..c66b5ff5 100644
--- a/include/Reussir/Conversion/Passes.td
+++ b/include/Reussir/Conversion/Passes.td
@@ -211,6 +211,10 @@ def ReussirRcDecrementExpansionPass : Pass<"reussir-rc-decrement-expansion"> {
     `reussir-rc-decrement-expansion` expands Reussir rc decrement operations.
     This is separated from the ConvertToSTD pass because it may be used in
     early stages of the pipeline.
+
+    A decrement that has no token result yet receives the one that the
+    `producers` phase of `reussir-token-instantiation` gives it, and is then
+    expanded.
   }];
 
   let options = [
diff --git a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
index 796a50a9..adad9d6d 100644
--- a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
+++ b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
@@ -110,6 +110,12 @@ struct RcDecrementExpansionPattern
         mlir::isa<FFIObjectType, ClosureType>(type.getElementType()))
       return mlir::failure();
 
+    // A decrement that `reussir-token-instantiation` has not reached gets its
+    // token here: no later pass pins decrements, so the type is final. The
+    // rebuilt decrement expands on its own visit.
+    if (!op.getNullableToken())
+      return op.replaceWithProduced(rewriter);
+
     // An atomic box decrements with one acquire-release `rc.fetch_sub`
     // (returning the previous count): the subtraction is already published,
     // so unlike the plain-load scheme below there is nothing to store on the
diff --git a/tests/integration/conversion/rc_dec_expansion_missing_token.mlir b/tests/integration/conversion/rc_dec_expansion_missing_token.mlir
new file mode 100644
index 00000000..3e44e0bd
--- /dev/null
+++ b/tests/integration/conversion/rc_dec_expansion_missing_token.mlir
@@ -0,0 +1,67 @@
+// RUN: %reussir-opt %s --reussir-rc-decrement-expansion \
+// RUN:   | %FileCheck %s --implicit-check-not=reussir.rc.dec
+// RUN: %reussir-opt %s \
+// RUN:   --reussir-acquire-drop-expansion='expand-decrement=1 outline-record=1' \
+// RUN:   | %FileCheck %s --check-prefix=OUTLINE \
+// RUN:     --implicit-check-not=reussir.rc.dec
+//
+// A decrement without a token result is the form before
+// `reussir-token-instantiation`. The expansion gives it the token that the
+// producer phase would: the box size, the dynamic size for an unpinned variant
+// with arms of 16 and 24 bytes, and the arm's cell for a pinned one.
+
+!leaf = !reussir.record<compound "Leaf" { i64, f64 }>
+!v_a = !reussir.record<compound "V::A" [value] { i64 }>
+!v_b = !reussir.record<compound "V::B" [value] { i64, i64 }>
+!v = !reussir.record<variant "V" { !v_a, !v_b }>
+
+module {
+  // CHECK-LABEL: func.func @leaf(
+  // CHECK: %[[COUNT:.*]] = reussir.rc.fetch(%[[RC:.*]] : !reussir.rc
+  // CHECK: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 24>>) {
+  // CHECK: reussir.ref.drop
+  // CHECK: %[[TOKEN:.*]] = reussir.rc.reinterpret(%[[RC]] : {{.*}}) : !reussir.token<align : 8, size : 24>
+  // CHECK: %[[SOME:.*]] = reussir.nullable.create(%[[TOKEN]] :
+  // CHECK: scf.yield %[[SOME]]
+  // CHECK: } else {
+  // CHECK: reussir.rc.set(%[[RC]] :
+  // CHECK: %[[NONE:.*]] = reussir.nullable.create : <!reussir.token<align : 8, size : 24>>
+  // CHECK: scf.yield %[[NONE]]
+  // CHECK: } {reussir.expanded_decrement}
+  // OUTLINE-LABEL: func.func @leaf(
+  // OUTLINE: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 24>>) {
+  // OUTLINE: } {reussir.expanded_decrement}
+  func.func @leaf(%rc: !reussir.rc<!leaf>) {
+    reussir.rc.dec(%rc : !reussir.rc<!leaf>)
+    return
+  }
+
+  // CHECK-LABEL: func.func @unpinned(
+  // CHECK: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : ?>>) {
+  // CHECK: reussir.ref.drop
+  // CHECK: } {reussir.expanded_decrement}
+  func.func @unpinned(%rc: !reussir.rc<!v>) {
+    reussir.rc.dec(%rc : !reussir.rc<!v>)
+    return
+  }
+
+  // CHECK-LABEL: func.func @pinned(
+  // CHECK: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 16>>) {
+  // CHECK-NOT: reussir.ref.drop
+  // CHECK: } {reussir.expanded_decrement}
+  func.func @pinned(%rc: !reussir.rc<!v>) {
+    reussir.rc.dec(%rc : !reussir.rc<!v>) {boundMembers = array<i64: 0>, destructureTag = 0 : index}
+    return
+  }
+
+  // The body of a foreign release function, as `rrc --emit mlir` prints it.
+  // CHECK-LABEL: func.func @release(
+  // CHECK: scf.if %{{.*}} -> (!reussir.nullable<!reussir.token<align : 8, size : 24>>) {
+  // CHECK: } {reussir.expanded_decrement}
+  // OUTLINE-LABEL: func.func @release(
+  // OUTLINE: reussir.rc.fetch
+  func.func @release(%rc: !reussir.rc<!leaf>) attributes {reussir.foreign_drop} {
+    reussir.rc.dec(%rc : !reussir.rc<!leaf>)
+    return
+  }
+}
