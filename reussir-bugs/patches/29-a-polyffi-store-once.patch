+// RUN: cd %t/v1 && env REAL_RUSTC=%rustc_path REUSSIR_RUSTC_DEPS=%library_path:crate=. XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/once NO_COMPILE=1 \
+// RUN:   %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir -O aggressive -o %t/once-warm.ll
+// RUN: diff %t/v1.ll %t/once-warm.ll
