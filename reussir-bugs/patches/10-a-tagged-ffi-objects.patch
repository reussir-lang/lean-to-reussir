+// RUN: %reussir-opt %s -verify-diagnostics --split-input-file
+
+// A tagged FFI handle may be an immediate, which has no count: only `rc.inc`
+// and `rc.dec` test for one.
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true>>
+!plain = !reussir.rc<!reussir.ffi_object<"Plain", @plain_drop>>
+
+module {
+  func.func private @word_drop(!word)
+  func.func private @plain_drop(!plain)
+  func.func @allowed(%w : !word, %p : !plain) -> index {
+    reussir.rc.inc(%w : !word)
+    reussir.rc.dec(%w : !word)
+    %c = reussir.rc.fetch(%p : !plain) : index
+    reussir.rc.set(%p : !plain, %c : index)
+    return %c : index
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true>>
+module {
+  func.func private @word_drop(!word)
+  func.func @fetch(%w : !word) -> index {
+    // expected-error @+1 {{'reussir.rc.fetch' op cannot access the count of a tagged FFI object}}
+    %c = reussir.rc.fetch(%w : !word) : index
+    return %c : index
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true> shared atomic>
+module {
+  func.func private @word_drop(!word)
+  func.func @fetch_sub(%w : !word) -> index {
+    // expected-error @+1 {{'reussir.rc.fetch_sub' op cannot access the count of a tagged FFI object}}
+    %c = reussir.rc.fetch_sub(%w : !word) : index
+    return %c : index
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true>>
+module {
+  func.func private @word_drop(!word)
+  func.func @set(%w : !word, %c : index) {
+    // expected-error @+1 {{'reussir.rc.set' op cannot access the count of a tagged FFI object}}
+    reussir.rc.set(%w : !word, %c : index)
+    return
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true>>
+module {
+  func.func private @word_drop(!word)
+  func.func @is_unique(%w : !word) -> i1 {
+    // expected-error @+1 {{'reussir.rc.is_unique' op cannot access the count of a tagged FFI object}}
+    %u = reussir.rc.is_unique(%w : !word) : i1
+    return %u : i1
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true>>
+module {
+  func.func private @word_drop(!word)
+  func.func @assume_unique(%w : !word) {
+    // expected-error @+1 {{'reussir.rc.assume_unique' op cannot access the count of a tagged FFI object}}
+    reussir.rc.assume_unique(%w : !word)
+    return
+  }
+}
+
+// -----
+
+!word = !reussir.rc<!reussir.ffi_object<"Word", @word_drop, tagged = true> shared>
+module {
+  func.func private @word_drop(!word)
+  func.func @defer(%w : !word) {
+    // expected-error @+1 {{'reussir.rc.defer' op cannot access the count of a tagged FFI object}}
