diff --git a/tests/integration/frontend/ffi_tagged_array.rr b/tests/integration/frontend/ffi_tagged_array.rr
new file mode 100644
index 00000000..8ad38dc9
--- /dev/null
+++ b/tests/integration/frontend/ffi_tagged_array.rr
@@ -0,0 +1,62 @@
+// UNSUPPORTED: darwin
+// Arrays of tagged handles that are all immediates, inside records and a
+// recursive enum: no drop order reads a count through an element.
+
+// RUN: %rrc %s -o %t.fwd.o -Onone --drop-order forward --relocation-mode pic
+// RUN: %cc %t.fwd.o %S/ffi_tagged_array.c -o %t.fwd.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.fwd.exe
+// RUN: %rrc %s -o %t.o -Oaggressive --relocation-mode pic
+// RUN: %cc %t.o %S/ffi_tagged_array.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+
+import core::intrinsic::array;
+
+#[ffi(rust = "usize", tagged)]
+pub struct Word;
+
+pub enum Opt { None, Some(Word) }
+pub struct Holder { arr: [Word; ?], tag: u64 }
+pub enum Tree { Leaf, Node([Word; 3], [Opt; ?], Tree, Tree) }
+
+#[ffi(import)]
+fn word(x: u64) -> Word [{ (x as usize) << 1 | 1 }];
+
+#[ffi(import)]
+fn peek(w: Word) -> u64 [{ (w >> 1) as u64 }];
+
+fn tag(h: Holder) -> u64 { h.tag }
+fn discard(t: Tree, k: u64) -> u64 { k }
+
+fn build(n: u64) -> Tree {
+    if n == 0 {
+        Tree::Leaf
+    } else {
+        Tree::Node{
+            array::splat<[Word; 3]>(word(n)),
+            array::splat<[Opt; ?]>(n, Opt::Some{word(n)}),
+            build(n - 1),
+            build(n - 1)
+        }
+    }
+}
+
+fn sum(t: Tree) -> u64 {
+    match t {
+        Tree::Leaf => 0,
+        Tree::Node(a, o, l, r) => peek(array::get(a, 1)) + sum(l) + sum(r)
+    }
+}
+
+pub fn holder(n: u64) -> u64 {
+    let h = Holder { arr: array::splat<[Word; ?]>(n, word(n)), tag: 1 };
+    let g = h;
+    peek(array::get(h.arr, 0)) + tag(g) + tag(h)
+}
+
+pub fn tree(n: u64) -> u64 {
+    let t = build(n);
+    sum(t) + discard(t, 1) + discard(build(n), 5)
+}
+
+extern "C" trampoline "holder" = holder;
+extern "C" trampoline "tree" = tree;
diff --git a/tests/integration/frontend/ffi_tagged_is_unique.rr b/tests/integration/frontend/ffi_tagged_is_unique.rr
