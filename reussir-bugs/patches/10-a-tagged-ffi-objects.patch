+
+#[ffi(import)]
+pub fn word(x : u64) -> Word [{ (x as usize) << 1 | 1 }];
+
+#[ffi(import)]
+pub fn plain(x : u32) -> Plain [{ ::reussir_rt::rc::Rc::new(x) }];
+
+#[ffi(import)]
+pub fn both(w : Word, p : Plain) -> u64 [{ (w >> 1) as u64 + (*p as u64) }];
+
+pub fn main() -> u64 {
