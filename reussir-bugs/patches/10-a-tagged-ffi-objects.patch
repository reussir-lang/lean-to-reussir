diff --git a/tests/integration/conversion/instrument_nonlinear_ffi_tagged.mlir b/tests/integration/conversion/instrument_nonlinear_ffi_tagged.mlir
new file mode 100644
index 00000000..93422c76
--- /dev/null
+++ b/tests/integration/conversion/instrument_nonlinear_ffi_tagged.mlir
@@ -0,0 +1,33 @@
+// RUN: %reussir-opt %s --reussir-instrument-nonlinear-ffi | %FileCheck %s
+
+// A tagged ffi_object may be an immediate (an odd word, not a box), which
+// has no reference count to read: the nonlinear-usage check skips such
+// arguments and still checks untagged ones.
+
+!word = !reussir.rc<!reussir.ffi_object<"::demo::Word", @word_drop, tagged = true>>
+!vec = !reussir.rc<!reussir.ffi_object<"::demo::Vec", @vec_drop>>
+
+module {
+  func.func private @word_drop(!word)
+  func.func private @vec_drop(!vec)
+  func.func private @use_word(!word) -> i64
+  func.func private @use_vec(!vec) -> i64
+  reussir.trampoline import "C" @use_word_ffi = @use_word
+  reussir.trampoline import "C" @use_vec_ffi = @use_vec
+
+  // CHECK-LABEL: func.func @tagged
+  // CHECK-NOT: reussir.rc.fetch
+  // CHECK: call @use_word
+  func.func @tagged(%w: !word) -> i64 {
+    %r = func.call @use_word(%w) : (!word) -> i64
+    return %r : i64
+  }
+
+  // CHECK-LABEL: func.func @untagged
+  // CHECK: reussir.rc.fetch
+  // CHECK: call @use_vec
+  func.func @untagged(%v: !vec) -> i64 {
+    %r = func.call @use_vec(%v) : (!vec) -> i64
+    return %r : i64
+  }
+}
diff --git a/tests/integration/conversion/tagged_ffi_object.mlir b/tests/integration/conversion/tagged_ffi_object.mlir
new file mode 100644
index 00000000..275984dc
--- /dev/null
+++ b/tests/integration/conversion/tagged_ffi_object.mlir
@@ -0,0 +1,68 @@
+// RUN: %reussir-opt %s | %reussir-opt | %FileCheck %s --check-prefix=PARSE
+// RUN: %reussir-opt %s --reussir-attach-native-target --reussir-lowering-basic-ops --convert-to-llvm --reconcile-unrealized-casts | %reussir-translate --mlir-to-llvmir | %FileCheck %s
+
+// A `tagged` ffi_object handle may be an odd immediate word (the foreign
+// side encodes a small value in the handle itself, as Lean boxes scalars):
+// `rc.inc` updates the refcount and `rc.dec` calls the cleanup hook only
+// when the low bit is clear, and nothing is loaded before that test. An
+// untagged ffi_object keeps the unguarded forms.
+
+!tagged = !reussir.rc<!reussir.ffi_object<"::demo::Word", @word_drop, tagged = true>>
+!plain = !reussir.rc<!reussir.ffi_object<"::demo::Box", @box_drop>>
+
+// PARSE: !reussir.ffi_object<"::demo::Word", @word_drop, tagged = true>
+// PARSE: !reussir.ffi_object<"::demo::Box", @box_drop>>
+
+module {
+  func.func private @word_drop(!tagged)
+  func.func private @box_drop(!plain)
+
+  // CHECK-LABEL: define void @inc_tagged(ptr %0)
+  // CHECK-NEXT: %[[RAW:.*]] = ptrtoint ptr %0 to i64
+  // CHECK-NEXT: %[[LOW:.*]] = and i64 %[[RAW]], 1
+  // CHECK-NEXT: %[[BOX:.*]] = icmp eq i64 %[[LOW]], 0
+  // CHECK-NEXT: br i1 %[[BOX]], label %[[INC:.*]], label %[[DONE:.*]]
+  // CHECK: [[INC]]:
+  // CHECK-NEXT: %[[OLD:.*]] = load i32, ptr %0
+  // CHECK-NEXT: %[[NEW:.*]] = add i32 %[[OLD]], 1
+  // CHECK-NEXT: store i32 %[[NEW]], ptr %0
+  // CHECK: br label %[[DONE]]
+  // CHECK: [[DONE]]:
+  // CHECK-NEXT: ret void
+  func.func @inc_tagged(%w: !tagged) {
+    reussir.rc.inc(%w : !tagged)
+    return
+  }
+
+  // CHECK-LABEL: define void @dec_tagged(ptr %0)
+  // CHECK-NEXT: %[[RAW:.*]] = ptrtoint ptr %0 to i64
+  // CHECK-NEXT: %[[LOW:.*]] = and i64 %[[RAW]], 1
+  // CHECK-NEXT: %[[BOX:.*]] = icmp eq i64 %[[LOW]], 0
+  // CHECK-NEXT: br i1 %[[BOX]], label %[[REL:.*]], label %[[DONE:.*]]
+  // CHECK: [[REL]]:
+  // CHECK-NEXT: call void @word_drop(ptr %0)
+  // CHECK-NEXT: br label %[[DONE]]
+  // CHECK: [[DONE]]:
+  // CHECK-NEXT: ret void
+  func.func @dec_tagged(%w: !tagged) {
+    reussir.rc.dec(%w : !tagged)
+    return
+  }
+
+  // CHECK-LABEL: define void @inc_plain(ptr %0)
+  // CHECK-NOT: ptrtoint
+  // CHECK: load i32, ptr %0
+  // CHECK: store i32
+  func.func @inc_plain(%b: !plain) {
+    reussir.rc.inc(%b : !plain)
+    return
+  }
+
+  // CHECK-LABEL: define void @dec_plain(ptr %0)
+  // CHECK-NEXT: call void @box_drop(ptr %0)
+  // CHECK-NEXT: ret void
+  func.func @dec_plain(%b: !plain) {
+    reussir.rc.dec(%b : !plain)
+    return
+  }
+}
diff --git a/tests/integration/frontend/ffi_tagged.rr b/tests/integration/frontend/ffi_tagged.rr
new file mode 100644
index 00000000..2c79d82d
--- /dev/null
+++ b/tests/integration/frontend/ffi_tagged.rr
@@ -0,0 +1,40 @@
+// UNSUPPORTED: darwin
+// `#[ffi(rust = "...", tagged)]`: an opaque record whose handle may be an
+// odd immediate word lowers to a `tagged` ffi_object (reference counting
+// skips immediates); a plain opaque record does not carry the flag.
+
+// RUN: %rrc %s --emit mlir -o - | %FileCheck %s
+// RUN: %rrc %s --emit hir -o - | %FileCheck %s --check-prefix=HIR
+// RUN: %rrc %s --emit mir -o - | %FileCheck %s --check-prefix=MIR
+
+#[ffi(rust = "::reussir_rt::rc::Rc<u64>", tagged)]
+pub struct Word;
+
+#[ffi(rust = "::reussir_rt::rc::Rc<u32>")]
+pub struct Plain;
+
+#[ffi(import)]
+pub fn word(x : u64) -> Word [{ ::reussir_rt::rc::Rc::new(x) }];
+
+#[ffi(import)]
+pub fn plain(x : u32) -> Plain [{ ::reussir_rt::rc::Rc::new(x) }];
+
+#[ffi(import)]
+pub fn both(w : Word, p : Plain) -> u64 [{ *w + (*p as u64) }];
+
+pub fn main() -> u64 {
+    let w = word(3);
+    let p = plain(4);
+    both(w, p) + both(w, p)
+}
+
+extern "C" trampoline "reussir_main" = main;
+
+// CHECK-DAG: !reussir.rc<!reussir.ffi_object<"::reussir_rt::rc::Rc<u64>", @{{.*}}_ffi_drop, tagged = true>>
+// CHECK-DAG: !reussir.rc<!reussir.ffi_object<"::reussir_rt::rc::Rc<u32>", @{{.*}}_ffi_drop>>
+
+// HIR-DAG: { ffi tagged "::reussir_rt::rc::Rc<u64>" }
+// HIR-DAG: { ffi "::reussir_rt::rc::Rc<u32>" }
+
+// MIR-DAG: ffi {{.*}} { "::reussir_rt::rc::Rc<u64>", @{{.*}}_ffi_drop, tagged }
+// MIR-DAG: ffi {{.*}} { "::reussir_rt::rc::Rc<u32>", @{{[A-Za-z0-9_]*}}_ffi_drop }
