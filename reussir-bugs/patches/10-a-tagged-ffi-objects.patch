+// A `tagged` handle may be an immediate, which has no count to read:
+// `core::object::is_unique` rejects it, directly and in a generic's
+// instantiation. The manual retain and release stay: their lowering tests
+// the handle.
+
+// RUN: %not %rrc %s --emit hir -o - 2>&1 | %FileCheck %s
+// RUN: %rrc %S/Inputs/ffi_tagged_is_unique_generic.rr --emit hir -o %t.hir
