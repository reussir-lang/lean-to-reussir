-// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true retcon-drops=true' --verify-each | %FileCheck %s --implicit-check-not=reussir.dtor.suspend
+// RUN: %reussir-opt %s --split-input-file --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true' --verify-each | %FileCheck %s --implicit-check-not=reussir.dtor.suspend
+// RUN: %reussir-opt %s --split-input-file --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true retcon-drops=true' --verify-each | %FileCheck %s --implicit-check-not=reussir.dtor.suspend
 
 // A drop of a Worklist record calls its entry, which walks it under
 // `reussir.drop.run`. The walk releases the members in field order, at once,
@@ -10,7 +10,8 @@
 !empty = !reussir.record<compound "WlEmpty" [value] {}>
 !box = !reussir.record<compound "WlBox" {i64}>
 !node = !reussir.record<compound "WlNode" [value] {!tree_, !box, !tree_}>
-!tree = !reussir.record<variant "WlTree" {!empty, !node}>
+!leaf = !reussir.record<compound "WlLeaf" [value] {!box}>
+!tree = !reussir.record<variant "WlTree" {!empty, !node, !leaf}>
 
 module {
   // CHECK-LABEL: func.func private @{{.*}}WlTreeE.worklist.release(%arg0:
@@ -29,8 +30,19 @@ module {
   // CHECK: reussir.rc.set
   // CHECK: reussir.expanded_decrement
   // CHECK: reussir.rc.defer @{{.*}}WlTreeE.worklist.release(
+  // The entry releases a leaf arm in place and runs the walk for the others.
   // CHECK-LABEL: func.func private @{{.*}}WlTreeE.worklist(
+  // CHECK: reussir.record.dispatch
+  // CHECK: [0] ->
+  // CHECK-NEXT: ^bb0
+  // CHECK-NEXT: reussir.scf.yield
+  // CHECK: [1] ->
+  // CHECK-NEXT: ^bb0
   // CHECK-NEXT: reussir.drop.run @{{.*}}WlTreeE.worklist.walk(
+  // CHECK: [2] ->
+  // CHECK-NOT: reussir.drop.run
+  // CHECK: reussir.expanded_decrement
+  // CHECK: return
   // CHECK-LABEL: func.func @root(
   // CHECK: call @{{.*}}WlTreeE.worklist(
   func.func @root(%ref: !reussir.ref<!tree>) {
@@ -38,3 +50,46 @@ module {
     return
   }
 }
+
+// -----
+
+// An anonymous arm that reaches the cycle (through an anonymous boxed pair)
+// is not a leaf: the entry runs the walk for it.
+!w_ = !reussir.record<variant "WlAnon" incomplete>
+!pair = !reussir.record<compound {!w_, !w_}>
+!w = !reussir.record<variant "WlAnon" {!reussir.record<compound "WlAnonEnd" [value] {}>, !reussir.record<compound [value] {!pair}>}>
+
+module {
+  // CHECK-LABEL: func.func private @{{.*}}WlAnonE.worklist(
+  // CHECK: [1] ->
+  // CHECK-NEXT: ^bb0
+  // CHECK-NEXT: reussir.drop.run @{{.*}}WlAnonE.worklist.walk(
+  func.func @anon_root(%ref: !reussir.ref<!w>) {
+    reussir.ref.drop (%ref : !reussir.ref<!w>)
+    return
+  }
+}
+
+// -----
+
+// A leaf arm may hold the box of a record outside the cycle that holds a
+// Worklist box of another type: that record's own drop releases it.
+!v_ = !reussir.record<variant "WlOther" incomplete>
+!v = !reussir.record<variant "WlOther" {!reussir.record<compound "WlOtherEnd" [value] {}>, !reussir.record<compound "WlOtherNode" [value] {!v_, !v_}>}>
+!s = !reussir.record<compound "WlHolder" {!v}>
+!t_ = !reussir.record<variant "WlLeafy" incomplete>
+!t = !reussir.record<variant "WlLeafy" {!reussir.record<compound "WlLeafyHold" [value] {!s}>, !reussir.record<compound "WlLeafyNode" [value] {!t_, !t_}>}>
+
+module {
+  // CHECK-LABEL: func.func private @{{.*}}WlLeafyE.worklist(
+  // CHECK: [0] ->
+  // CHECK-NOT: reussir.drop.run
+  // CHECK: call @{{.*}}WlHolderE(
+  // CHECK: [1] ->
+  // CHECK-NEXT: ^bb0
+  // CHECK-NEXT: reussir.drop.run @{{.*}}WlLeafyE.worklist.walk(
+  func.func @leafy_root(%ref: !reussir.ref<!t>) {
+    reussir.ref.drop (%ref : !reussir.ref<!t>)
+    return
+  }
+}
