index b8a213da..12a6f8cb 100644
--- a/include/Reussir/Transformation/Passes.td
+++ b/include/Reussir/Transformation/Passes.td
@@ -295,4 +295,32 @@ def ReussirDefaultInlinerPass
               "(counted recursively through nested regions).">];
 }
 
+def ReussirSCCPPass : Pass<"reussir-sccp", "::mlir::ModuleOp"> {
+  let summary = "MLIR's SCCP, interprocedural while the call sites allow";
+  let description = [{
+    `reussir-sccp` runs MLIR's `sccp` on the whole module, across calls,
+    when the module's call sites are within a budget, and on each function
+    alone otherwise.
+
+    The interprocedural analysis is quadratic in the call sites of a
+    callable: each time it finds one more call site of a function, or the
+    arguments of one change, MLIR's data-flow framework visits the function
+    again and walks all of its known call sites (`DeadCodeAnalysis` adding
+    the function's returns as predecessors of each call,
+    `AbstractSparseForwardDataFlowAnalysis` joining each call's arguments
+    into the function's). One function called from 4000 places took 7 s;
+    a lean2rr program with 17,000 functions was still in SCCP after 50
+    minutes. The budget is the sum over callees with a body of the square
+    of their call sites (`max-call-site-pairs`), which is what that cost
+    follows (a declaration is external to the analysis). On
+    each function alone SCCP knows nothing about arguments and results
+    across calls (LLVM's IPSCCP propagates those later) and is linear.
+  }];
+  let options =
+      [Option<"maxCallSitePairs", "max-call-site-pairs", "uint64_t",
+              "uint64_t(1) << 22",
+              "Run SCCP across calls only while the sum over callees of the "
+              "square of their number of call sites is at most this.">];
+}
+
 #endif // REUSSIR_TRANSFORMATION_PASSES_TD
