diff --git a/lib/Transformation/SCCP/SCCP.cpp b/lib/Transformation/SCCP/SCCP.cpp
new file mode 100644
index 00000000..4d92a5ba
--- /dev/null
+++ b/lib/Transformation/SCCP/SCCP.cpp
@@ -0,0 +1,72 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// This file implements the pipeline's SCCP: MLIR's `sccp` on the whole
+/// module while its call sites are within a budget, on each function alone
+/// otherwise (see `reussir-sccp` in Passes.td).
+///
+//===----------------------------------------------------------------------===//
+
+#include "Reussir/Transformation/Passes.h"
+
+#include <llvm/ADT/DenseMap.h>
+#include <mlir/Dialect/Func/IR/FuncOps.h>
+#include <mlir/IR/SymbolTable.h>
+#include <mlir/Interfaces/CallInterfaces.h>
+#include <mlir/Pass/Pass.h>
+#include <mlir/Pass/PassManager.h>
+#include <mlir/Transforms/Passes.h>
+
+namespace reussir {
+
+#define GEN_PASS_DEF_REUSSIRSCCPPASS
+#include "Reussir/Transformation/Passes.h.inc"
+
+namespace {
+
+struct ReussirSCCPPass : public impl::ReussirSCCPPassBase<ReussirSCCPPass> {
+  using Base::Base;
+  void runOnOperation() override {
+    mlir::ModuleOp module = getOperation();
+    // The sum over callees of the square of their call sites, counted
+    // incrementally: the n-th call site of a callee adds n^2 - (n-1)^2.
+    // Only callees with a body count: the analysis treats a declaration as
+    // external and never walks its call sites.
+    mlir::SymbolTable symbols(module);
+    llvm::DenseMap<mlir::SymbolRefAttr, uint64_t> callSites;
+    uint64_t pairs = 0;
+    module.walk([&](mlir::CallOpInterface call) {
+      auto callee = llvm::dyn_cast_if_present<mlir::SymbolRefAttr>(
+          call.getCallableForCallee());
+      if (!callee)
+        return;
+      auto callable = llvm::dyn_cast_if_present<mlir::CallableOpInterface>(
+          symbols.lookup(callee.getRootReference()));
+      if (!callable || !callable.getCallableRegion() ||
+          callable.getCallableRegion()->empty())
+        return;
+      uint64_t &count = callSites[callee];
+      pairs += 2 * count + 1;
+      ++count;
+    });
+
+    mlir::OpPassManager pipeline(mlir::ModuleOp::getOperationName());
+    if (pairs <= maxCallSitePairs)
+      pipeline.addPass(mlir::createSCCPPass());
+    else
+      pipeline.addNestedPass<mlir::func::FuncOp>(mlir::createSCCPPass());
+    if (mlir::failed(runPipeline(pipeline, module)))
+      signalPassFailure();
+  }
+};
+
+} // namespace
+} // namespace reussir
diff --git a/tests/integration/conversion/sccp_call_site_budget.mlir b/tests/integration/conversion/sccp_call_site_budget.mlir
new file mode 100644
index 00000000..c8d88fed
--- /dev/null
+++ b/tests/integration/conversion/sccp_call_site_budget.mlir
@@ -0,0 +1,54 @@
+// `reussir-sccp` runs SCCP across calls while the sum over callees of the
+// square of their call sites is within `max-call-site-pairs`, and on each
+// function alone otherwise. @callee has two call sites (4 pairs); the three
+// calls of the declaration @log do not count.
+
+// RUN: %reussir-opt %s --reussir-sccp | %FileCheck %s --check-prefix=MODULE
+// RUN: %reussir-opt %s '--reussir-sccp=max-call-site-pairs=4' | %FileCheck %s --check-prefix=MODULE
+// RUN: %reussir-opt %s '--reussir-sccp=max-call-site-pairs=3' | %FileCheck %s --check-prefix=FUNCTION
+
+module {
+  // Across calls, the argument is 41 at both call sites and the result 42.
+  // MODULE-LABEL: func.func private @callee
+  // MODULE: %[[C42:.*]] = arith.constant 42 : i64
+  // MODULE: return %[[C42]]
+  // FUNCTION-LABEL: func.func private @callee
+  // FUNCTION: arith.addi
+  func.func private @callee(%x: i64) -> i64 {
+    %one = arith.constant 1 : i64
+    %r = arith.addi %x, %one : i64
+    return %r : i64
+  }
+
+  // MODULE-LABEL: func.func @first
+  // MODULE: %[[C42:.*]] = arith.constant 42 : i64
+  // MODULE: return %[[C42]]
+  // FUNCTION-LABEL: func.func @first
+  // FUNCTION: %[[R:.*]] = call @callee
+  // FUNCTION: return %[[R]]
+  func.func private @log(i64)
+
+  func.func @first() -> i64 {
+    %c = arith.constant 41 : i64
+    func.call @log(%c) : (i64) -> ()
+    func.call @log(%c) : (i64) -> ()
+    func.call @log(%c) : (i64) -> ()
+    %r = func.call @callee(%c) : (i64) -> i64
+    return %r : i64
+  }
+
+  // Within a function the folding happens either way.
+  // MODULE-LABEL: func.func @second
+  // FUNCTION-LABEL: func.func @second
+  // FUNCTION: %[[C43:.*]] = arith.constant 43 : i64
+  // FUNCTION: call @callee(%{{.*}})
+  // FUNCTION: return
+  func.func @second() -> i64 {
+    %c = arith.constant 41 : i64
+    %two = arith.constant 2 : i64
+    %d = arith.addi %c, %two : i64
+    %r = func.call @callee(%c) : (i64) -> i64
+    %s = arith.addi %r, %d : i64
+    return %s : i64
+  }
+}
