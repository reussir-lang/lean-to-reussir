new file mode 100644
index 00000000..d20c20c5
--- /dev/null
+++ b/crates/reussir-rt/src/drop.rs
@@ -0,0 +1,257 @@
+//! Pending releases of the compiler's drop glue.
+//!
+//! Freeing a value releases the cells it holds, and theirs, and so on. Doing
+//! that by recursion takes stack proportional to the depth of the value, so
+//! the drop glue instead hands the members it frees to one stack of pending
+//! work per thread, as Lean's `lean_del` does with its to-do list: a member
+//! whose last reference the glue drops is pushed together with the glue
+//! function that releases it ([`__reussir_drop_defer_wide`],
+//! [`__reussir_drop_defer`]), and the outermost drop empties the stack
+//! ([`__reussir_drop_drain`]), last pushed first. The depth of the native
+//! stack stays bounded however deep the value is, and resources held in
+//! records are released in Lean's order (a record's last member first).
+//!
+//! Like Lean's list, the stack takes no memory per pending cell: consecutive
+//! deferred cells form one entry, a run, linked through the cells
+//! themselves. A deferred cell's count is known to be 1 and nothing else
+//! references it, and the compiler defers through
+//! [`__reussir_drop_defer_wide`] a cell whose first 8 bytes are header: the
+//! 32-bit count, then a 32-bit word that is padding or the variant's tag,
+//! below 2^16. The link to the cell pushed before it takes the count and the
+//! upper 16 bits of that word (48 bits; the tag is kept): the offset in
+//! 8-byte units (40 bits) and its release function (8 bits: the same as
+//! this cell's, or an index in a small per-thread table, emptied whenever
+//! the stack is). Both are set back when the cell is popped. A cell that
+//! cannot be linked starts a new run: one deferred through
+//! [`__reussir_drop_defer`] (no free header bits), an immediate's shared
+//! dummy box (nonzero top byte), one farther than 2^42 bytes from the
+//! previous cell, or a new function with the table full.
+//!
+//! Code that frees other kinds of objects (a host runtime's containers, say)
+//! can share the stack, so that one free releases everything in one order:
+//! [`active`], [`depth`], [`defer_step`] and [`run_step`] push incremental work, which
+//! stays on the stack while it runs, so whatever it pushes is done before its
+//! next step.
+
+use core::cell::{Cell, RefCell};
+
+/// Releases one pending member, given the pointer it was deferred with.
+pub type Release = unsafe extern "C" fn(*mut u8);
+
+/// One step of incremental work on `p`; answers whether the work is done.
+pub type Step = unsafe fn(usize) -> bool;
+
+#[derive(Clone, Copy)]
+enum Work {
+    /// `n` deferred cells, the last pushed at `head`, to be released with
+    /// `release`; every cell of the run but the first pushed links to the
+    /// cell pushed before it (see the module comment).
+    Run { release: Release, head: *mut u8, n: u32 },
+    Step(usize, Step),
+}
+
+const _: () = assert!(core::mem::size_of::<Work>() <= 24);
+
+/// Capacity kept after a drain: the stack shrinks back to this once a large
+/// drop has emptied it.
+const KEEP: usize = 64;
+
+/// A link's release index meaning "the same function as this cell's".
+const SAME: u32 = 0xff;
+
+/// Offsets (in 8-byte units) a link can hold: 40 bits, signed.
+const OFFSET_BITS: u32 = 40;
+
+thread_local! {
+    static PENDING: RefCell<Vec<Work>> = const { RefCell::new(Vec::new()) };
+    static DRAINING: Cell<bool> = const { Cell::new(false) };
+    /// The release functions that links name, by index (at most 255).
+    static RELEASES: RefCell<Vec<Release>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Whether the current thread is emptying its pending stack (work started
+/// now is pushed and done by that drain).
+#[inline]
+pub fn active() -> bool {
+    DRAINING.with(|draining| draining.get())
+}
+
+/// The number of entries on the pending stack. Work pushed while a step runs
+/// (the step is then the top entry) makes a new entry, so a step can tell
+/// whether a release it made pushed work.
+#[inline]
+pub fn depth() -> usize {
+    PENDING.with(|pending| pending.borrow().len())
+}
+
+/// Pushes incremental work: `step(p)` runs, while the entry stays on the
+/// stack, until it answers that it is done.
+pub fn defer_step(p: usize, step: Step) {
+    PENDING.with(|pending| pending.borrow_mut().push(Work::Step(p, step)));
+}
+
+/// Runs incremental work and everything it pushes; inside a drain, only
+/// pushes it.
+pub fn run_step(p: usize, step: Step) {
+    defer_step(p, step);
+    unsafe { __reussir_drop_drain() };
+}
+
+/// The link's index for `prev_release`, the function of the cell linked to,
+/// from a cell released with `release`.
+fn release_index(prev_release: Release, release: Release) -> Option<u32> {
+    if prev_release as usize == release as usize {
+        return Some(SAME);
+    }
+    RELEASES.with(|releases| {
+        let mut releases = releases.borrow_mut();
+        match releases
+            .iter()
+            .rposition(|&known| known as usize == prev_release as usize)
+        {
+            Some(index) => Some(index as u32),
+            None if releases.len() < SAME as usize => {
+                releases.push(prev_release);
+                Some(releases.len() as u32 - 1)
+            }
+            None => None,
+        }
+    })
+}
+
+/// Links `cell`, deferred with `release` and with a wide header, to `prev`,
+/// the head of the run on top, deferred with `prev_release`; answers
+/// whether it did.
+unsafe fn link(cell: *mut u8, release: Release, prev: *mut u8, prev_release: Release) -> bool {
+    let (at, to) = (cell as usize, prev as usize);
+    // An immediate's dummy box (nonzero top byte) is shared: never written.
+    if at >> 56 != 0 || (at | to) & 7 != 0 {
+        return false;
+    }
+    let units = (to as isize).wrapping_sub(at as isize) >> 3;
+    let limit = 1isize << (OFFSET_BITS - 1);
+    if units == 0 || !(-limit..limit).contains(&units) {
+        return false;
+    }
+    let Some(index) = release_index(prev_release, release) else {
+        return false;
+    };
+    let units = units as u64;
+    let words = cell.cast::<u32>();
+    unsafe {
+        words.write(((units as u32 & 0xff_ffff) << 8) | index);
+        let tag = words.add(1).read() & 0xffff;
+        words.add(1).write((((units >> 24) as u32 & 0xffff) << 16) | tag);
+    }
+    true
+}
+
+/// The cell that `cell` links to and the index of its release function;
+/// sets the header back (count 1, the upper half of the tag word 0).
+unsafe fn unlink(cell: *mut u8) -> (*mut u8, u32) {
+    let words = cell.cast::<u32>();
+    let (low, high) = unsafe { (words.read(), words.add(1).read()) };
+    unsafe {
+        words.write(1);
+        words.add(1).write(high & 0xffff);
+    }
+    let raw = (((high >> 16) as u64) << 24) | (low >> 8) as u64;
+    let units = ((raw << (64 - OFFSET_BITS)) as i64) >> (64 - OFFSET_BITS);
+    (cell.wrapping_offset(units as isize * 8), low & 0xff)
+}
+
+fn defer(cell: *mut u8, release: Release, wide: bool) {
+    PENDING.with(|pending| {
+        let mut pending = pending.borrow_mut();
+        if wide
+            && let Some(Work::Run {
+                release: head_release,
+                head,
+                n,
+            }) = pending.last_mut()
+            && *n < u32::MAX
+            && unsafe { link(cell, release, *head, *head_release) }
+        {
+            *head_release = release;
+            *head = cell;
+            *n += 1;
+            return;
+        }
+        pending.push(Work::Run {
+            release,
+            head: cell,
+            n: 1,
+        });
+    });
+}
+
+/// Defers `release(cell)` until the current thread drains its pending work.
+/// `cell` is a box whose count was read as 1 and which nothing else
+/// references (or an immediate's dummy box); the cell is not written.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __reussir_drop_defer(cell: *mut u8, release: Release) {
+    defer(cell, release, false);
+}
+
+/// [`__reussir_drop_defer`] for a cell whose first 8 bytes are header: its
+/// 32-bit count, then padding or a tag below 2^16 as a 32-bit word. The
+/// cell may be linked through them.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __reussir_drop_defer_wide(cell: *mut u8, release: Release) {
+    defer(cell, release, true);
+}
+
+/// Runs the current thread's pending work, last pushed first, until none is
+/// left, including the work it pushes in turn. A call made while the thread
+/// is already draining (from a release) returns at once: the outermost call
+/// runs whatever is pushed meanwhile.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __reussir_drop_drain() {
+    if DRAINING.with(|draining| draining.replace(true)) {
+        return;
+    }
+    loop {
+        let next = PENDING.with(|pending| {
+            let mut pending = pending.borrow_mut();
+            let len = pending.len();
+            match pending.last_mut() {
+                None => None,
+                Some(Work::Run { release, head, n }) => {
+                    let (popped, cell) = (*release, *head);
+                    if *n == 1 {
+                        pending.pop();
+                    } else {
+                        let (prev, index) = unsafe { unlink(cell) };
+                        *head = prev;
+                        if index != SAME {
+                            *release = RELEASES.with(|releases| releases.borrow()[index as usize]);
+                        }
+                        *n -= 1;
+                    }
+                    Some(Ok((popped, cell)))
+                }
+                Some(&mut Work::Step(p, step)) => Some(Err((len - 1, p, step))),
+            }
+        });
+        match next {
+            None => break,
+            Some(Ok((release, cell))) => unsafe { release(cell) },
+            Some(Err((index, p, step))) => {
+                if unsafe { step(p) } {
+                    PENDING.with(|pending| {
+                        pending.borrow_mut().remove(index);
+                    });
+                }
+            }
+        }
+    }
+    // Nothing is pending, so no link names a table entry.
+    RELEASES.with(|releases| releases.borrow_mut().clear());
+    PENDING.with(|pending| {
+        let mut pending = pending.borrow_mut();
+        if pending.capacity() > KEEP {
+            pending.shrink_to(KEEP);
+        }
+    });
+    DRAINING.with(|draining| draining.set(false));
+}
