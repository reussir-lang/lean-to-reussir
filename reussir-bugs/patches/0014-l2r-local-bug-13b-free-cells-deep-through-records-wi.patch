+// `__reussir_drop_defer(cell, &release)`.
+struct ReussirRcDeferReleaseConversionPattern
+    : public mlir::OpConversionPattern<ReussirRcDeferReleaseOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+  // Whether the box's first 8 bytes are header: the 32-bit count, then a
+  // fused tag below 2^16 or padding. The runtime then links the deferred
+  // cell through the count and the word's upper 16 bits.
+  static bool hasWideHeader(RcType rcType, const mlir::DataLayout &layout) {
+    RcBoxType box = rcType.getInnerBoxType();
+    auto record = llvm::dyn_cast<RecordType>(box.getElementType());
+    if (!record || box.isRegional())
+      return false;
+    if (box.isHeaderFused())
+      return record.getMembers().size() <= (1u << 16);
+    return record.isCompound() && layout.getTypeABIAlignment(record) >= 8;
+  }
+
+  mlir::LogicalResult
+  matchAndRewrite(ReussirRcDeferReleaseOp op, OpAdaptor adaptor,
+                  mlir::ConversionPatternRewriter &rewriter) const override {
+    auto ptrTy = mlir::LLVM::LLVMPointerType::get(rewriter.getContext());
+    auto module = op->getParentOfType<mlir::ModuleOp>();
+    llvm::StringRef name =
+        hasWideHeader(op.getRcPtr().getType(),
+                      mlir::DataLayout::closest(op.getOperation()))
+            ? "__reussir_drop_defer_wide"
+            : "__reussir_drop_defer";
+    mlir::LLVM::LLVMFuncOp defer =
+        module.lookupSymbol<mlir::LLVM::LLVMFuncOp>(name);
+    if (!defer) {
+      mlir::OpBuilder::InsertionGuard guard(rewriter);
+      rewriter.setInsertionPointToStart(module.getBody());
+      defer = mlir::LLVM::LLVMFuncOp::create(
+          rewriter, op.getLoc(), name,
+          mlir::LLVM::LLVMFunctionType::get(
+              mlir::LLVM::LLVMVoidType::get(rewriter.getContext()),
+              {ptrTy, ptrTy}));
+      defer.setLinkage(mlir::LLVM::Linkage::External);
+    }
+    mlir::Value release = mlir::LLVM::AddressOfOp::create(
+        rewriter, op.getLoc(), ptrTy, op.getRelease());
+    rewriter.replaceOpWithNewOp<mlir::LLVM::CallOp>(
+        op, defer, mlir::ValueRange{adaptor.getRcPtr(), release});
+    return mlir::success();
+  }
+};
