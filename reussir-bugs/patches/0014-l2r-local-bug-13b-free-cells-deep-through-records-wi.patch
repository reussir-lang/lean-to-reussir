+def ReussirRcDeferReleaseOp : ReussirRcOp<"defer_release", []> {
+  let summary = "Defer the release of a cell to the thread's pending stack";
+  let description = [{
+    `reussir.rc.defer_release` hands a cell the caller owns to the current
+    thread's stack of pending releases (the runtime's `__reussir_drop_defer`):
+    the function `release`, which takes the cell, runs when the outermost drop
+    glue drains the stack (`__reussir_drop_drain`), last deferred first. Drop
+    glue defers the cells it frees so that freeing a deep value takes bounded
+    stack, as Lean's `lean_del` does with its to-do list.
+    ```mlir
+    reussir.rc.defer_release (%cell : !reussir.rc<!list>) release(@free_list)
+    ```
+  }];
+
+  let arguments =
+      (ins Arg<ReussirRcType, "Cell to release", [MemRead, MemWrite]>:$rcPtr,
+          FlatSymbolRefAttr:$release);
+
+  let assemblyFormat = [{
+    `(` $rcPtr `:` qualified(type($rcPtr)) `)` `release` `(` $release `)`
+    attr-dict
+  }];
+}
+
 def ReussirRcCreateOp
     : ReussirRcOp<
           "create", [AttrSizedOperandSegments,
