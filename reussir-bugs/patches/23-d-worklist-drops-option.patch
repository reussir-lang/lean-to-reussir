diff --git a/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp b/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp
new file mode 100644
index 00000000..2690f453
--- /dev/null
+++ b/lib/Conversion/AcquireDropExpansion/WorklistDrop.cpp
@@ -0,0 +1,175 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+//
+// Worklist drops release a `RecordDropKind::Worklist` record through the
+// thread's stack of pending drops (reussir-rt's drop_stack.rs), as Lean's
+// lean_del does. Per record type and atomic kind:
+// - `<dtor>.worklist(ref)`, the entry: `reussir.drop.run` of the walk;
+// - `<dtor>.worklist.walk(ref)`: drops the members in field order, at once,
+//   except member boxes of Worklist records: a box whose count reaches zero
+//   is deferred with `reussir.rc.defer` instead of released by recursion;
+// - `<dtor>.worklist.release(box)`, called by the drain for a deferred box:
+//   the walk of its content, then the box's free.
+// The drain pops the deferred boxes last first. A Worklist value reached
+// through other glue calls its entry, which then only walks (the thread
+// already drains); since glue defers every box edge of its record's cycle,
+// such nesting is bounded by the type graph, not by the value's depth (for
+// the box edges the type graph shows: a recursion through a closure's
+// captures is not seen).
+//
+//===----------------------------------------------------------------------===//
+#include "WorklistDrop.h"
+#include "TailDrop.h"
+#include "Reussir/IR/RecordDrop.h"
+#include "Reussir/Transformation/SpecialPointerTag.h"
+#include <mlir/Dialect/Arith/IR/Arith.h>
+#include <mlir/Dialect/LLVMIR/LLVMAttrs.h>
+#include <mlir/Dialect/SCF/IR/SCF.h>
+
+namespace reussir {
+namespace {
+constexpr llvm::StringLiteral kWorklistGlueAttr = "reussir.worklist_drop";
+
+class WorklistGlue {
+  mlir::ModuleOp module;
+  mlir::PatternRewriter &rewriter;
+  std::optional<mlir::SymbolTable> ownTable;
+  mlir::SymbolTable &table;
+  mlir::Location loc;
+
+  // `<dtor of type, kind><suffix>(arg)`, made with `body(arg)` on first use.
+  mlir::func::FuncOp function(RecordType type, AtomicKind kind,
+                              llvm::StringRef suffix, mlir::Type arg,
+                              llvm::function_ref<void(mlir::Value)> body) {
+    std::string name = (type.getDtorName(kind).getValue() + suffix).str();
+    if (auto existing = table.lookup<mlir::func::FuncOp>(name))
+      return existing;
+    mlir::OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.setInsertionPointToStart(module.getBody());
+    auto function = mlir::func::FuncOp::create(
+        rewriter, loc, name, rewriter.getFunctionType({arg}, {}));
+    function.setPrivate();
+    table.insert(function);
+    function->setAttr("llvm.linkage",
+                      rewriter.getAttr<mlir::LLVM::LinkageAttr>(
+                          mlir::LLVM::linkage::Linkage::LinkonceODR));
+    function->setAttr("llvm.passthrough",
+                      rewriter.getStrArrayAttr({"nounwind"}));
+    inheritSanitizerPassthrough(module, function);
+    function.setArgAttr(0, "llvm.noalias", rewriter.getUnitAttr());
+    function.setArgAttr(0, "llvm.nonnull", rewriter.getUnitAttr());
+    function.setArgAttr(0, "llvm.noundef", rewriter.getUnitAttr());
+    rewriter.setInsertionPointToStart(function.addEntryBlock());
+    rewriter.setInsertionPoint(mlir::func::ReturnOp::create(rewriter, loc));
+    body(function.getArgument(0));
+    return function;
+  }
+  RefType ref(RecordType type, AtomicKind kind) {
+    return RefType::get(type.getContext(), type, Capability::unspecified,
+                        kind);
+  }
+
+public:
+  WorklistGlue(mlir::ModuleOp module, mlir::PatternRewriter &rewriter,
+               mlir::SymbolTableCollection *symbols)
+      : module(module), rewriter(rewriter),
+        table(symbols ? symbols->getSymbolTable(module)
+                      : ownTable.emplace(module)),
+        loc(rewriter.getUnknownLoc()) {}
+
+  mlir::func::FuncOp walk(RecordType type, AtomicKind kind) {
+    auto walk = function(type, kind, ".worklist.walk", ref(type, kind),
+                         [&](mlir::Value arg) {
+                           ReussirRefDropOp::create(rewriter, loc, arg,
+                                                    /*inlined=*/true, nullptr);
+                         });
+    walk->setAttr(kWorklistGlueAttr, rewriter.getUnitAttr());
+    return walk;
+  }
+
+  mlir::func::FuncOp entry(RecordType type, AtomicKind kind) {
+    return function(type, kind, ".worklist", ref(type, kind),
+                    [&](mlir::Value arg) {
+                      auto walkName = walk(type, kind).getSymNameAttr();
+                      ReussirDropRunOp::create(
+                          rewriter, loc, mlir::FlatSymbolRefAttr::get(walkName),
+                          arg);
+                    });
+  }
+
+  mlir::func::FuncOp release(RcType rc) {
+    auto type = llvm::cast<RecordType>(rc.getElementType());
+    AtomicKind kind = rc.getAtomicKind();
+    return function(type, kind, ".worklist.release", rc, [&](mlir::Value box) {
+      mlir::Value payload =
+          ReussirRcBorrowOp::create(rewriter, loc, ref(type, kind), box);
+      mlir::func::CallOp::create(rewriter, loc, walk(type, kind),
+                                 mlir::ValueRange{payload});
+      emitBoxFree(box, loc, module, rewriter);
+    });
+  }
+};
+} // namespace
+
+bool isWorklistDropRecord(mlir::Type type) {
+  auto record = llvm::dyn_cast<RecordType>(type);
+  return record && record.getName() &&
+         record.classifyRecordDrop() == RecordDropKind::Worklist;
+}
+
+mlir::func::FuncOp getWorklistDropEntry(RecordType type, AtomicKind kind,
+                                        mlir::ModuleOp module,
+                                        mlir::PatternRewriter &rewriter,
+                                        mlir::SymbolTableCollection *symbols) {
+  return WorklistGlue(module, rewriter, symbols).entry(type, kind);
+}
+
+bool canDeferMemberRelease(RcType type, mlir::Operation *site) {
+  auto function = site->getParentOfType<mlir::func::FuncOp>();
+  return function && function->hasAttr(kWorklistGlueAttr) &&
+         type.getCapability() == Capability::shared &&
+         isWorklistDropRecord(type.getElementType());
+}
+
+void emitDeferredMemberRelease(mlir::Value rc, mlir::Location loc,
+                               mlir::ModuleOp module,
+                               mlir::PatternRewriter &rewriter,
+                               mlir::SymbolTableCollection *symbols) {
+  auto type = llvm::cast<RcType>(rc.getType());
+  auto release = WorklistGlue(module, rewriter, symbols).release(type);
+  mlir::OpBuilder::InsertionGuard guard(rewriter);
+  // An immediate (a nullary arm under the special-pointer-tag scheme) owns
+  // no memory and its dummy box's count must not be read as unique.
+  if (module->hasAttr(kSpecialPtrTagAttr) && type.mayCarrySpecialPointerTag()) {
+    mlir::Value immediate = ReussirRcIsImmediateOp::create(
+        rewriter, loc, rewriter.getI1Type(), rc);
+    auto branch = mlir::scf::IfOp::create(rewriter, loc, immediate, true);
+    rewriter.setInsertionPointToStart(branch.elseBlock());
+  }
+  bool atomic = type.getAtomicKind() == AtomicKind::atomic;
+  mlir::Value count =
+      atomic ? ReussirRcFetchSubOp::create(rewriter, loc, rc).getRefCount()
+             : ReussirRcFetchOp::create(rewriter, loc, rc).getRefCount();
+  mlir::Value one = mlir::arith::ConstantIndexOp::create(rewriter, loc, 1);
+  mlir::Value unique = mlir::arith::CmpIOp::create(
+      rewriter, loc, mlir::arith::CmpIPredicate::eq, count, one);
+  auto branch = mlir::scf::IfOp::create(rewriter, loc, unique, !atomic);
+  if (!atomic) {
+    rewriter.setInsertionPointToStart(branch.elseBlock());
+    mlir::Value decremented =
+        mlir::arith::SubIOp::create(rewriter, loc, count, one);
+    ReussirRcSetOp::create(rewriter, loc, rc, decremented);
+  }
+  rewriter.setInsertionPointToStart(branch.thenBlock());
+  ReussirRcDeferOp::create(
+      rewriter, loc, mlir::FlatSymbolRefAttr::get(release.getSymNameAttr()),
+      rc);
+}
+} // namespace reussir
