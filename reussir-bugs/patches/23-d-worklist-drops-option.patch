+++ b/tests/integration/conversion/worklist_drop.mlir
@@ -0,0 +1,40 @@
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true' --verify-each | %FileCheck %s --implicit-check-not=reussir.dtor.suspend
+// RUN: %reussir-opt %s --reussir-acquire-drop-expansion='outline-record=true expand-decrement=true worklist-drops=true retcon-drops=true' --verify-each | %FileCheck %s --implicit-check-not=reussir.dtor.suspend
+
+// A drop of a Worklist record calls its entry, which walks it under
+// `reussir.drop.run`. The walk releases the members in field order, at once,
+// except boxes of Worklist records, which it defers once dead; their release
+// walks the content and frees the box. worklist-drops wins over retcon-drops.
+
+!tree_ = !reussir.record<variant "WlTree" incomplete>
+!empty = !reussir.record<compound "WlEmpty" [value] {}>
+!box = !reussir.record<compound "WlBox" {i64}>
+!node = !reussir.record<compound "WlNode" [value] {!tree_, !box, !tree_}>
+!tree = !reussir.record<variant "WlTree" {!empty, !node}>
+
+module {
+  // CHECK-LABEL: func.func private @{{.*}}WlTreeE.worklist.release(%arg0:
+  // CHECK: %[[REF:.*]] = reussir.rc.borrow(%arg0
+  // CHECK: call @{{.*}}WlTreeE.worklist.walk(%[[REF]])
+  // CHECK: reussir.rc.reinterpret(%arg0
+  // CHECK: reussir.token.free
+  // CHECK-LABEL: func.func private @{{.*}}WlTreeE.worklist.walk(
+  // CHECK-SAME: reussir.worklist_drop
+  // CHECK: [1] ->
+  // CHECK: reussir.rc.fetch
+  // CHECK-NEXT: arith.cmpi eq
+  // CHECK-NEXT: scf.if
+  // CHECK-NEXT: reussir.rc.defer @{{.*}}WlTreeE.worklist.release(
+  // CHECK-NEXT: } else {
+  // CHECK: reussir.rc.set
+  // CHECK: reussir.expanded_decrement
+  // CHECK: reussir.rc.defer @{{.*}}WlTreeE.worklist.release(
+  // CHECK-LABEL: func.func private @{{.*}}WlTreeE.worklist(
+  // CHECK-NEXT: reussir.drop.run @{{.*}}WlTreeE.worklist.walk(
+  // CHECK-LABEL: func.func @root(
+  // CHECK: call @{{.*}}WlTreeE.worklist(
+  func.func @root(%ref: !reussir.ref<!tree>) {
+    reussir.ref.drop (%ref : !reussir.ref<!tree>)
+    return
+  }
+}
