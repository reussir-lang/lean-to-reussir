+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+#pragma once
+
+#include "Reussir/IR/ReussirOps.h"
+#include <mlir/Dialect/Func/IR/FuncOps.h>
+
+namespace reussir {
+// Whether `type` is a named record whose drop is `RecordDropKind::Worklist`.
+bool isWorklistDropRecord(mlir::Type type);
+
+// The entry of a Worklist record's drop, `<dtor>.worklist(ref)`.
+mlir::func::FuncOp getWorklistDropEntry(RecordType type, AtomicKind kind,
+                                        mlir::ModuleOp module,
+                                        mlir::PatternRewriter &rewriter,
+                                        mlir::SymbolTableCollection *symbols);
+
+// Whether a member box of `type` dropped at `site` is deferred: `site` is in
+// worklist glue and the box is a shared box of a Worklist record.
+bool canDeferMemberRelease(RcType type, mlir::Operation *site);
+
+// Decrements the member box `rc`, deferring it once its count reaches zero.
+void emitDeferredMemberRelease(mlir::Value rc, mlir::Location loc,
+                               mlir::ModuleOp module,
+                               mlir::PatternRewriter &rewriter,
+                               mlir::SymbolTableCollection *symbols);
+} // namespace reussir
