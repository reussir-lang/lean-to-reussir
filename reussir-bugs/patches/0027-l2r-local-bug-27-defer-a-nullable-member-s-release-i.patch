diff --git a/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp b/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
index 97247a8a..28bd8b76 100644
--- a/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
+++ b/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
@@ -66,9 +66,9 @@ namespace reussir {
 // `drop_in_place` (the glue entry: it drops a record's contents) drains the
 // stack before returning. `drop_and_free`, which only ever runs from that
 // drain, frees a cell whose count was read as 1: per arm it releases the
-// members (deferring the record boxes) but the last non-leaf record box,
-// frees the cell, and then releases that last box directly, by a tail call
-// when its count is 1, so a chain is a loop. Releases outside drop glue
+// members (deferring the record boxes) but the last non-leaf record box
+// (plain or in a `Nullable`), frees the cell, and then releases that last
+// box directly, by a tail call when its count is 1, so a chain is a loop. Releases outside drop glue
 // (whose tokens may be reused) are unchanged.
 
 namespace {
@@ -251,10 +251,20 @@ void emitCellRelease(mlir::PatternRewriter &rewriter, mlir::Location loc,
                                        rewriter.getIndexAttr(idx))
         .getResult();
   };
+  // The member released last, after the cell is freed: the last non-leaf
+  // record box, plain or `Nullable` (whose box would otherwise be deferred
+  // like a plain one), so the members are released in the same order either
+  // way and a chain through either kind of link is a loop.
+  auto isTail = [&](size_t idx) {
+    mlir::Type type = projected(idx);
+    if (auto nullableType = llvm::dyn_cast<NullableType>(type))
+      type = nullableType.getPtrTy();
+    return isDeferredNonLeaf(type);
+  };
   std::optional<size_t> last;
   for (auto [idx, memberTy, memberIsField] : llvm::enumerate(
            payload.getMembers(), payload.getMemberIsField()))
-    if (!memberIsField && isDeferredNonLeaf(projected(idx)))
+    if (!memberIsField && isTail(idx))
       last = idx;
   mlir::Value lastValue;
   if (last)
@@ -283,8 +293,26 @@ void emitCellRelease(mlir::PatternRewriter &rewriter, mlir::Location loc,
   mlir::Value token =
       ReussirRcReinterpretOp::create(rewriter, loc, tokenType, rc);
   ReussirTokenFreeOp::create(rewriter, loc, token);
-  if (lastValue)
+  if (!lastValue)
+    return;
+  auto nullableType = llvm::dyn_cast<NullableType>(lastValue.getType());
+  if (!nullableType) {
     emitLastRelease(rewriter, loc, moduleOp, lastValue);
+    return;
+  }
+  auto dispatcher =
+      ReussirNullableDispatchOp::create(rewriter, loc, mlir::Type{}, lastValue);
+  mlir::Block *nullBlock = rewriter.createBlock(
+      &dispatcher.getNullRegion(), dispatcher.getNullRegion().begin());
+  rewriter.setInsertionPointToStart(nullBlock);
+  ReussirScfYieldOp::create(rewriter, loc, nullptr);
+  mlir::Block *nonNullBlock = rewriter.createBlock(
+      &dispatcher.getNonNullRegion(), dispatcher.getNonNullRegion().begin(),
+      {nullableType.getPtrTy()}, {loc});
+  rewriter.setInsertionPointToStart(nonNullBlock);
+  emitLastRelease(rewriter, loc, moduleOp, nonNullBlock->getArgument(0));
+  ReussirScfYieldOp::create(rewriter, loc, nullptr);
+  rewriter.setInsertionPointAfter(dispatcher);
 }
 
 mlir::func::FuncOp getOrCreateDropAndFree(mlir::ModuleOp moduleOp,
@@ -596,6 +624,18 @@ private:
           &dispatcher.getNonNullRegion(), dispatcher.getNonNullRegion().begin(),
           {nullableType.getPtrTy()}, {op.getLoc()});
       rewriter.setInsertionPointToStart(nonNullBlock);
+      // Inside drop glue, release the box as `rewriteDropRc` releases a plain
+      // rc member: deferred to the pending stack, so a chain linked through
+      // `Nullable` is freed in a loop instead of one frame per link.
+      if (auto func = op->getParentOfType<mlir::func::FuncOp>();
+          func && func->hasAttr(kDropGlueAttr) && isDeferrable(rcType)) {
+        emitDeferredRelease(rewriter, op.getLoc(),
+                            op->getParentOfType<mlir::ModuleOp>(),
+                            nonNullBlock->getArgument(0));
+        ReussirScfYieldOp::create(rewriter, op.getLoc(), nullptr);
+        rewriter.eraseOp(op);
+        return mlir::success();
+      }
       NullableType retNullableTy = nullptr;
       if (decMayProduceToken(rcType)) {
         auto layout = mlir::DataLayout::closest(op.getOperation());
