diff --git a/tests/integration/frontend/drop_long_nullable_chain.rr b/tests/integration/frontend/drop_long_nullable_chain.rr
new file mode 100644
index 00000000..49c85c78
--- /dev/null
+++ b/tests/integration/frontend/drop_long_nullable_chain.rr
@@ -0,0 +1,96 @@
+// Releasing a long chain linked through `Nullable<shared record>` must not
+// recurse once per link. Inside drop glue a nullable member's box is
+// released like a plain rc member: deferred to the thread's pending stack
+// when its count is 1, so the outermost drop glue frees the chain in a loop.
+// Checked with two million links (about 64 MB of stack if each link took a
+// frame, beyond the driver's 8 MB main thread): a shared record linking to
+// itself through a nullable member, the link held in a [value] record inside
+// the box, and that [value] record held in a cell (released through the
+// cell's `field` glue). A nullable member is also released in the same order
+// as a plain one: the last non-leaf box member, plain or nullable, is released
+// last, after the cell is freed (as a tail call, which makes a chain through
+// it a loop), and the others are deferred before. Checked on the glue of Pn
+// (Os, then a Nullable<Ob>) against Pp (Os, then an Ob): both defer Os and
+// release Ob after freeing the cell.
+
+// RUN: %rrc %s -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/drop_long_nullable_chain.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
+// RUN: %cc %t.opt.o %S/drop_long_nullable_chain.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.opt.exe
+// RUN: %rrc %s --emit mlir-llvm -o - | %FileCheck %s --check-prefix=ORDER
+
+import core::intrinsic::cell;
+
+struct N { next: Nullable<N>, v: u64 }
+struct [shared] S(u64)
+struct [value] A { b: Nullable<B>, s: S, n: u64 }
+struct B { a: A, k: u64 }
+struct [value] CA { b: Nullable<CB>, n: u64 }
+struct CB { c: Cell<CA>, k: u64 }
+struct [shared] Lf(u64)
+struct Os { n: Lf, k: u64 }
+struct Ob { n: Lf, k: u64 }
+struct Pn { s: Os, b: Nullable<Ob> }
+struct Pp { s: Os, b: Ob }
+struct Qn { p: Pn, k: u64 }
+struct Qp { p: Pp, k: u64 }
+struct Rr { qn: Qn, qp: Qp, k: u64 }
+
+fn direct(n : u64, acc : Nullable<N>) -> Nullable<N> {
+    if n == 0 { acc } else { direct(n - 1, Nullable::NonNull{N { next: acc, v: n }}) }
+}
+fn first(l : Nullable<N>) -> u64 {
+    match l { Nullable::NonNull(x) => x.v, Nullable::Null => 0 }
+}
+
+fn through_value(n : u64, acc : Nullable<B>) -> Nullable<B> {
+    if n == 0 { acc } else {
+        through_value(n - 1, Nullable::NonNull{B { a: A { b: acc, s: S{n}, n: n * 2 }, k: n }})
+    }
+}
+fn first_k(l : Nullable<B>) -> u64 {
+    match l { Nullable::NonNull(x) => x.k, Nullable::Null => 0 }
+}
+
+fn through_cell(n : u64, acc : Nullable<CB>) -> Nullable<CB> {
+    if n == 0 { acc } else {
+        through_cell(n - 1, Nullable::NonNull{CB { c: cell::alloc(CA { b: acc, n: n }), k: n }})
+    }
+}
+fn cell_chain(n : u64) -> u64 {
+    let c = cell::alloc(CA { b: through_cell(n, Nullable::Null), n: 0 });
+    // The set releases the whole chain through CA's `field` drop glue.
+    cell::set(c, CA { b: Nullable::Null, n: 1 });
+    cell::get(c).n
+}
+
+fn mk_rr(x : u64) -> Rr {
+    Rr { qn: Qn { p: Pn { s: Os { n: Lf{x}, k: 1 }, b: Nullable::NonNull{Ob { n: Lf{x + 1}, k: 2 }} }, k: 0 },
+         qp: Qp { p: Pp { s: Os { n: Lf{x}, k: 1 }, b: Ob { n: Lf{x + 1}, k: 2 } }, k: 0 }, k: 3 }
+}
+fn rr_k(r : Rr) -> u64 { r.k }
+
+pub fn main() -> i64 {
+    let direct_ok = if first(direct(2000000, Nullable::Null)) == 1 { 1 } else { 0 };
+    let value_ok = if first_k(through_value(2000000, Nullable::Null)) == 1 { 1 } else { 0 };
+    let cell_ok = if cell_chain(2000000) == 1 { 1 } else { 0 };
+    let order_ok = if rr_k(mk_rr(5)) == 3 { 1 } else { 0 };
+    direct_ok + value_ok * 10 + cell_ok * 100 + order_ok * 1000
+}
+
+extern "C" trampoline "reussir_main" = main;
+
+// ORDER-LABEL: llvm.func {{.*}}@_RINvNvC4core9intrinsic22drop_and_free_in_drainC2PnE(
+// ORDER: llvm.mlir.addressof @_RINvNvC4core9intrinsic22drop_and_free_in_drainC2OsE
+// ORDER: llvm.call @__reussir_drop_defer
+// ORDER: llvm.call @__reussir_deallocate
+// ORDER: llvm.call @_RINvNvC4core9intrinsic22drop_and_free_in_drainC2ObE(
+// ORDER: llvm.return
+// ORDER-LABEL: llvm.func {{.*}}@_RINvNvC4core9intrinsic22drop_and_free_in_drainC2PpE(
+// ORDER: llvm.mlir.addressof @_RINvNvC4core9intrinsic22drop_and_free_in_drainC2OsE
+// ORDER: llvm.call @__reussir_drop_defer
+// ORDER: llvm.call @__reussir_deallocate
+// ORDER: llvm.call @_RINvNvC4core9intrinsic22drop_and_free_in_drainC2ObE(
+// ORDER: llvm.return
