From b2e0bfd34f55c8b86c710b3a4192cb0bba90ac4a Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Sat, 3 Oct 2026 03:45:46 -0400
Subject: [PATCH 63/63] l2r-local: bug 31: run rrc's driver on a thread with a
 1 GiB stack

The parser grows its own stack (`stacker`), but the stages after it walk
expression trees recursively too, at about a kilobyte per nesting level,
on the process's 8 MiB main thread. A sum of 8000 calls (the program of
bug 11's generator at N = 8000) overflowed it in the elaborator
(`Elaborator::infer_expr` / `infer_binop`, one pair of frames per `+`),
and so did a literal in 100000 nested parentheses: rrc aborted with
"thread 'main' has overflowed its stack" on valid input.

Run the driver on a thread with a 1 GiB stack (named `main`, so panics
and overflow messages read as before; a panic is re-raised on the real
main thread, which exits as before). Only touched pages are committed,
so normal builds use the memory they used. One change covers every
recursive stage instead of a `stacker` call in each walk.

Now the 8000-term sum builds in 1.6 s (-O aggressive), 16000 terms in
6 s and 64000 in 81 s, and the 100000 parentheses in 0.1 s.
Test: frontend/deep_expression.rr (generated by
Inputs/deep_expression.py: both shapes, built, linked and run).
---
 crates/reussir-compiler/src/main.rs           | 20 +++++++++++++-
 .../frontend/Inputs/deep_expression.py        | 20 ++++++++++++++
 tests/integration/frontend/deep_expression.c  | 26 +++++++++++++++++++
 tests/integration/frontend/deep_expression.rr | 11 ++++++++
 4 files changed, 76 insertions(+), 1 deletion(-)
 create mode 100644 tests/integration/frontend/Inputs/deep_expression.py
 create mode 100644 tests/integration/frontend/deep_expression.c
 create mode 100644 tests/integration/frontend/deep_expression.rr

diff --git a/crates/reussir-compiler/src/main.rs b/crates/reussir-compiler/src/main.rs
index 6d273367..56001e34 100644
--- a/crates/reussir-compiler/src/main.rs
+++ b/crates/reussir-compiler/src/main.rs
@@ -3,6 +3,24 @@
 
 use std::process::ExitCode;
 
+/// Stack of the thread the driver runs on. The parser grows its own stack
+/// (`stacker`), but the stages after it walk expression trees recursively
+/// too — elaboration, lowering, the syntax tree's drop in `cstree` — at
+/// about a kilobyte per nesting level: the process's 8 MiB main thread
+/// overflowed on a chain of 8000 `+`. Only touched pages are committed.
+const DRIVER_STACK_SIZE: usize = 1024 * 1024 * 1024;
+
 fn main() -> ExitCode {
-    reussir_compiler::driver::main()
+    // Named `main` so diagnostics (a panic, a stack overflow) read as before.
+    let driver = std::thread::Builder::new()
+        .name("main".into())
+        .stack_size(DRIVER_STACK_SIZE)
+        .spawn(reussir_compiler::driver::main)
+        .expect("failed to spawn the driver thread");
+    match driver.join() {
+        Ok(code) => code,
+        // The panic was reported on the driver thread; exit as a panicking
+        // main thread would.
+        Err(panic) => std::panic::resume_unwind(panic),
+    }
 }
diff --git a/tests/integration/frontend/Inputs/deep_expression.py b/tests/integration/frontend/Inputs/deep_expression.py
new file mode 100644
index 00000000..aed60891
--- /dev/null
+++ b/tests/integration/frontend/Inputs/deep_expression.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""deep_expression.py OUT.rr: a program with deeply nested expressions.
+
+`chain` adds 8000 calls (a left-nested `+` tree 8000 deep); `parens` wraps
+a literal in 100000 parentheses. `deep_expression_check` returns
+chain(1) + parens(): 8000 * 1 + 7999 * 8000 / 2 + 7 = 32004007.
+"""
+import sys
+
+n, d = 8000, 100000
+lines = [
+    "fn f(x : u64, i : u64) -> u64 { x + i }",
+    "fn chain(z : u64) -> u64 {",
+    "    " + " + ".join(f"f(z, {i})" for i in range(n)),
+    "}",
+    "fn parens() -> u64 { " + "(" * d + "7" + ")" * d + " }",
+    "pub fn check(z : u64) -> u64 { chain(z) + parens() }",
+    'extern "C" trampoline "deep_expression_check" = check;',
+]
+open(sys.argv[1], "w").write("\n".join(lines) + "\n")
diff --git a/tests/integration/frontend/deep_expression.c b/tests/integration/frontend/deep_expression.c
new file mode 100644
index 00000000..026fa40c
--- /dev/null
+++ b/tests/integration/frontend/deep_expression.c
@@ -0,0 +1,26 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+// Driver for deep_expression.rr (program from Inputs/deep_expression.py).
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+extern uint64_t deep_expression_check(uint64_t z);
+
+int main(void) {
+  uint64_t result = deep_expression_check(1);
+  if (result != 32004007) {
+    fprintf(stderr, "FAIL: expected 32004007, got %llu\n",
+            (unsigned long long)result);
+    abort();
+  }
+  return 0;
+}
diff --git a/tests/integration/frontend/deep_expression.rr b/tests/integration/frontend/deep_expression.rr
new file mode 100644
index 00000000..edc80f86
--- /dev/null
+++ b/tests/integration/frontend/deep_expression.rr
@@ -0,0 +1,11 @@
+// Deeply nested expressions must not overflow rrc's stack. The parser grows
+// its stack itself, but elaboration, lowering and the syntax tree's drop
+// recurse once per nesting level; on the 8 MiB main thread a chain of 8000
+// `+` overflowed in the elaborator, and 100000 nested parentheses as well.
+// rrc runs its driver on a thread with a 1 GiB stack. The program is
+// generated (Inputs/deep_expression.py); this file only drives it.
+
+// RUN: %python %S/Inputs/deep_expression.py %t.rr
+// RUN: %rrc %t.rr -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/deep_expression.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
