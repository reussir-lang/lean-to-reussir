From ad079b37e14e15c00ca0884bd50332ee589f60dd Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Tue, 6 Oct 2026 17:58:42 -0400
Subject: [PATCH] l2r-local: issue 3: global allocations ask mimalloc for a
 multiple of 16 bytes

ReussirGlobalAlloc gives every Rust allocation 16-byte alignment
(max_align_t, on purpose) through mi_malloc_aligned and
mi_realloc_aligned, and Reussir builds mimalloc with MI_MAX_ALIGN_SIZE=8,
so the alignment is not implied. For a size that is not a multiple of 16
(24 bytes, say), mi_malloc_aligned took a block of the size class only
when its next free block happened to be 16-aligned; otherwise it
allocated size + 15 bytes and moved the pointer, and that marks the page
as holding moved blocks (mi_page_set_has_aligned). Every later free in
the page, of any object (the language heap shares the pages), then took
mimalloc's slow path (mi_free_generic_local, _mi_page_ptr_unalign): in
lean2rr programs 5.2% (monadic-interp) and 4.0% (unionfind) of the
instructions in some runs and none in others of the same executable,
with the pages that got marked.

The global allocator now rounds the size up to a multiple of 16 (alloc,
realloc; the default alloc_zeroed goes through alloc). mimalloc gives
such a size 16-byte alignment from its size class alone: the classes of
multiples of 16 are multiples of 16 (exact up to 64 bytes, even word
counts above), a page's blocks start at a multiple of the block size,
and a block over 64 KiB starts its own page at a 64 KiB boundary. So
mi_malloc_aligned takes the free block or the plain allocation and never
moves a pointer. The alignment is still 16; a Rust allocation of 8, 24
or 40 bytes takes 16, 32 or 48 (mimalloc's default build would do the
same). The language heap (__reussir_*) keeps its 8-byte classes.

Tests (alloc.rs): global_alloc_is_16_aligned (alloc, alloc_zeroed and
realloc of sizes 1 to 144 and some up to 16 MiB, alignments 1 to 16:
16-aligned, contents kept) and global_alloc_takes_whole_blocks (under
mimalloc, each block is a whole block of its rounded size's class; fails
without the rounding).
---
 crates/reussir-rt/src/alloc.rs | 112 ++++++++++++++++++++++++++++++++-
 1 file changed, 109 insertions(+), 3 deletions(-)

diff --git a/crates/reussir-rt/src/alloc.rs b/crates/reussir-rt/src/alloc.rs
index 7db2e906..f36414f0 100644
--- a/crates/reussir-rt/src/alloc.rs
+++ b/crates/reussir-rt/src/alloc.rs
@@ -278,7 +278,8 @@ mod backend {
 /// (16-byte) alignment even for small requests, because platform code that
 /// shares this heap assumes it (notably macOS system frameworks and parts of
 /// Rust's std). So every allocation is forced to at least 16-byte alignment
-/// via the backend's aligned path. `__reussir_*` keep the 8-byte convention
+/// via the backend's aligned path, with its size rounded up to a multiple of
+/// 16 (`global_size`). `__reussir_*` keep the 8-byte convention
 /// (reussir boxes request their own alignment and never escape to that code),
 /// preserving the 8-granular per-constructor win; they also call the backend
 /// *directly*, so the unsized `token<?>` ABI needs no `Layout`.
@@ -288,10 +289,42 @@ pub struct ReussirGlobalAlloc;
 /// provide for any allocation.
 const GLOBAL_MAX_ALIGN: usize = 16;
 
+/// The size a global allocation asks the backend for: the requested size
+/// rounded up to a multiple of `GLOBAL_MAX_ALIGN`.
+///
+/// mimalloc (built with `MI_MAX_ALIGN_SIZE=8`) then gives the 16-byte
+/// alignment from the size class alone: every size class of a multiple of 16
+/// bytes is a multiple of 16 (the classes up to 64 bytes are exact, the
+/// larger ones even word counts), and the blocks of a page start at a
+/// multiple of the block size (`_mi_segment_page_start_from_slice`; a block
+/// over 64 KiB starts its own page, at a 64 KiB boundary).
+/// `mi_malloc_aligned` and `mi_realloc_aligned` take the free block or the
+/// plain allocation (`mi_malloc_is_naturally_aligned`). With the size as
+/// requested (24 bytes, say), `mi_malloc_aligned` took the 24-byte class only
+/// when its next free block happened to be 16-aligned; otherwise it
+/// allocated `size + 15` bytes and moved the pointer, which marks the page
+/// as holding moved blocks (`mi_page_set_has_aligned`): every later free in
+/// that page, of any object (the language heap shares the pages), took
+/// mimalloc's slow path (`mi_free_generic_local`, `_mi_page_ptr_unalign`).
+///
+/// A larger block is allowed: Rust's `dealloc` and `realloc` pass the
+/// requested size back, which the size-recovering backends ignore. The
+/// default `alloc_zeroed` goes through `alloc`. No overflow: a `Layout`'s
+/// size is at most `isize::MAX`.
+#[inline]
+const fn global_size(size: usize) -> usize {
+    size.next_multiple_of(GLOBAL_MAX_ALIGN)
+}
+
 unsafe impl std::alloc::GlobalAlloc for ReussirGlobalAlloc {
     #[inline]
     unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
-        unsafe { backend::alloc(layout.align().max(GLOBAL_MAX_ALIGN), layout.size()) }
+        unsafe {
+            backend::alloc(
+                layout.align().max(GLOBAL_MAX_ALIGN),
+                global_size(layout.size()),
+            )
+        }
     }
     #[inline]
     unsafe fn dealloc(&self, ptr: *mut u8, _layout: std::alloc::Layout) {
@@ -299,7 +332,13 @@ unsafe impl std::alloc::GlobalAlloc for ReussirGlobalAlloc {
     }
     #[inline]
     unsafe fn realloc(&self, ptr: *mut u8, layout: std::alloc::Layout, new_size: usize) -> *mut u8 {
-        unsafe { backend::realloc(ptr, layout.align().max(GLOBAL_MAX_ALIGN), new_size) }
+        unsafe {
+            backend::realloc(
+                ptr,
+                layout.align().max(GLOBAL_MAX_ALIGN),
+                global_size(new_size),
+            )
+        }
     }
 }
 
@@ -455,6 +494,73 @@ mod tests {
         }
     }
 
+    /// The global allocator keeps `max_align_t` (16-byte) alignment for every
+    /// request, through `alloc`, `alloc_zeroed` and `realloc`, whatever the
+    /// requested size and alignment (sizes are rounded up to a multiple of 16:
+    /// `global_size`), and `realloc` keeps the contents.
+    #[test]
+    fn global_alloc_is_16_aligned() {
+        use std::alloc::{GlobalAlloc, Layout};
+        let a = super::ReussirGlobalAlloc;
+        let large: &[usize] = if cfg!(miri) { &[] } else { &[1 << 20, (16 << 20) + 8] };
+        let sizes = (1..=144).chain([255, 1000, 4097, 9000, 70_000]).chain(large.iter().copied());
+        for size in sizes {
+            for align in [1usize, 2, 4, 8, 16] {
+                let layout = Layout::from_size_align(size, align).unwrap();
+                let grown = size + size / 2 + 1;
+                unsafe {
+                    let p = a.alloc(layout);
+                    assert!(!p.is_null());
+                    assert_eq!(p as usize % 16, 0, "alloc {size} align {align}");
+                    p.write_bytes(0xA5, size);
+                    let z = a.alloc_zeroed(layout);
+                    assert!(!z.is_null());
+                    assert_eq!(z as usize % 16, 0, "alloc_zeroed {size} align {align}");
+                    assert!(std::slice::from_raw_parts(z, size).iter().all(|&b| b == 0));
+                    let q = a.realloc(p, layout, grown);
+                    assert!(!q.is_null());
+                    assert_eq!(q as usize % 16, 0, "realloc {size} -> {grown} align {align}");
+                    assert!(std::slice::from_raw_parts(q, size).iter().all(|&b| b == 0xA5));
+                    let r = a.realloc(q, Layout::from_size_align(grown, align).unwrap(), size);
+                    assert!(!r.is_null());
+                    assert_eq!(r as usize % 16, 0, "realloc {grown} -> {size} align {align}");
+                    assert!(std::slice::from_raw_parts(r, size).iter().all(|&b| b == 0xA5));
+                    a.dealloc(r, layout);
+                    a.dealloc(z, layout);
+                }
+            }
+        }
+    }
+
+    /// Under mimalloc, a global allocation is a whole block of the size class
+    /// of its size rounded up to 16: mimalloc did not allocate more and move
+    /// the pointer, which would mark the page and send every later free in it
+    /// to mimalloc's slow path. The blocks stay live, so that the allocations
+    /// come from fresh and partly used pages alike.
+    #[cfg(all(feature = "mimalloc", not(miri)))]
+    #[test]
+    fn global_alloc_takes_whole_blocks() {
+        use libmimalloc_sys as ffi;
+        use std::alloc::{GlobalAlloc, Layout};
+        let a = super::ReussirGlobalAlloc;
+        let mut live = Vec::new();
+        for round in 0..4 {
+            for size in (1..=1024usize).chain([4097, 9000, 40_000]) {
+                let layout = Layout::from_size_align(size, 1 << (round % 4)).unwrap();
+                unsafe {
+                    let p = a.alloc(layout);
+                    assert!(!p.is_null());
+                    let want = ffi::mi_good_size(size.next_multiple_of(16));
+                    assert_eq!(ffi::mi_usable_size(p.cast()), want, "size {size}");
+                    live.push((p, layout));
+                }
+            }
+        }
+        for (p, layout) in live {
+            unsafe { a.dealloc(p, layout) };
+        }
+    }
+
     /// The unsized entry points: free and realloc recover the block from the
     /// pointer alone. Again no content assertion — only that the resized
     /// block is valid and pointer-only-freeable.
-- 
2.43.0

