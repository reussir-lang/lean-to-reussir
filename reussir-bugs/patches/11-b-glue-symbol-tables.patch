+// `symbols` as for createDtorIfNotExists, for the member functions it
+// creates.
 //
 //===----------------------------------------------------------------------===//
 mlir::LogicalResult emitOwnershipAcquisition(mlir::Value value,
                                              mlir::OpBuilder &builder,
                                              mlir::Location loc,
                                              mlir::Value delta = {},
-                                             bool callMemberGlue = false);
+                                             bool callMemberGlue = false,
+                                             mlir::SymbolTableCollection
+                                                 *symbols = nullptr);
 
 /// The memref type `reussir.array.view` produces for an array: identity
 /// layout for a static shape, a fully dynamic strided layout for a
@@ -135,12 +139,16 @@ mlir::LogicalResult emitArrayElementTraversal(
 // own symbol.
 // Outlined drop glue functions carry `kDropGlueAttr`: no token produced in
 // them can be reused, so their member releases free cells directly.
+// Looking the function up builds the module's symbol table, a walk of the
+// whole module; a caller that creates glue for many operations passes
+// `symbols`, whose tables are built once and kept up to date here.
 constexpr llvm::StringLiteral kDropGlueAttr = "reussir.drop_glue";
 mlir::func::FuncOp
 createDtorIfNotExists(mlir::ModuleOp moduleOp, RecordType type,
                       mlir::OpBuilder &builder,
                       AtomicKind kind = AtomicKind::normal,
-                      Capability cap = Capability::unspecified);
+                      Capability cap = Capability::unspecified,
+                      mlir::SymbolTableCollection *symbols = nullptr);
 
 //===----------------------------------------------------------------------===//
 // emitOwnershipAcquisitionFuncIfNotExists
@@ -150,14 +158,16 @@ createDtorIfNotExists(mlir::ModuleOp moduleOp, RecordType type,
 // record type if it doesn't already exist. The function takes a reference to
 // the type and an index delta and performs the acquisition operation. Returns
 // the existing function if one is already present. The RecordType must be a
-// named type. `kind` and `cap` as for createDtorIfNotExists. Members that are
-// named records are acquired by calls to their own functions.
+// named type. `kind`, `cap` and `symbols` as for createDtorIfNotExists.
+// Members that are named records are acquired by calls to their own
+// functions.
 //
 //===----------------------------------------------------------------------===//
 mlir::func::FuncOp emitOwnershipAcquisitionFuncIfNotExists(
     mlir::ModuleOp moduleOp, RecordType type, mlir::OpBuilder &builder,
     AtomicKind kind = AtomicKind::normal,
-    Capability cap = Capability::unspecified);
+    Capability cap = Capability::unspecified,
+    mlir::SymbolTableCollection *symbols = nullptr);
 
 //===----------------------------------------------------------------------===//
 
