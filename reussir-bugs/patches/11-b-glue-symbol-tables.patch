diff --git a/tests/integration/frontend/cell_value_record_glue_order.c b/tests/integration/frontend/cell_value_record_glue_order.c
new file mode 100644
index 00000000..3b6c4ef3
--- /dev/null
+++ b/tests/integration/frontend/cell_value_record_glue_order.c
@@ -0,0 +1,21 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+// Driver for cell_value_record_glue_order.rr: prints glue_order(5), which is
+// (7 + 1 + 70 + 2) + (5 + 2 + 50 + 100 + 4) * 1000 = 161080.
+
+#include <stdint.h>
+#include <stdio.h>
+
+extern uint64_t glue_order_ffi(uint64_t);
+
+int main(void) {
+  printf("%llu\n", (unsigned long long)glue_order_ffi(5));
+  return 0;
+}
diff --git a/tests/integration/frontend/cell_value_record_glue_order.rr b/tests/integration/frontend/cell_value_record_glue_order.rr
new file mode 100644
index 00000000..f7d0643b
--- /dev/null
+++ b/tests/integration/frontend/cell_value_record_glue_order.rr
@@ -0,0 +1,41 @@
+// The acquire/drop expansion keeps one table of the module's symbols for a
+// whole run and looks every outlined glue function up in it. The `field`
+// acquire glue of a [value] record creates the glue of its named [value]
+// members while its body is built; those must be added to the same table.
+// Here Pair's glue is created first (for the Pair cell) and then, for the Quad
+// cell, Quad's glue looks it up as its member's: a stale table created it a
+// second time, and rrc failed with "redefinition of symbol".
+
+// RUN: %rrc %s -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/cell_value_record_glue_order.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe | %FileCheck %s
+// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
+// RUN: %cc %t.opt.o %S/cell_value_record_glue_order.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.opt.exe | %FileCheck %s
+// RUN: %rrc %s -o %t.l2r.o --relocation-mode pic -Oaggressive --reuse-across-call --no-pack-record-members
+// RUN: %cc %t.l2r.o %S/cell_value_record_glue_order.c -o %t.l2r.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.l2r.exe | %FileCheck %s
+
+// CHECK: 161080
+
+import core::intrinsic::cell;
+
+struct [shared] Bg(u64)
+struct [value] Pair { big: Bg, small: u64 }
+struct [value] Quad { x: Pair, y: Pair }
+
+// A Pair cell read before a Quad cell, in one function.
+pub fn glue_order(n : u64) -> u64 {
+    let p = cell::alloc(Pair { big: Bg{n + 2}, small: 1 });
+    let first = cell::get(p);
+    cell::set(p, Pair { big: Bg{(n + 2) * 10}, small: 2 });
+    let second = cell::get(p);
+    let compound = first.big.0 + first.small + second.big.0 + second.small;
+    let q = cell::alloc(Quad { x: Pair { big: Bg{n}, small: 1 }, y: Pair { big: Bg{n + 1}, small: 2 } });
+    let a = cell::get(q);
+    cell::set(q, Quad { x: Pair { big: Bg{n * 10}, small: 3 }, y: Pair { big: Bg{n * 20}, small: 4 } });
+    let b = cell::get(q);
+    let nested = a.x.big.0 + a.y.small + b.x.big.0 + b.y.big.0 + b.y.small;
+    compound + nested * 1000
+}
+extern "C" trampoline "glue_order_ffi" = glue_order;
