@@ -31,8 +32,11 @@ namespace reussir {
 #define GEN_PASS_DECL_REUSSIRACQUIREDROPEXPANSIONPASS
 #include "Reussir/Conversion/Passes.h.inc"
 
+// `symbols`, if given, holds the symbol tables the outlined glue is looked
