From 1eb710b47e4ff941faf9e7304dbc00441ffbd313 Mon Sep 17 00:00:00 2001
From: yekai pan <pyk@seas.upenn.edu>
Date: Tue, 6 Oct 2026 06:02:30 -0400
Subject: [PATCH] l2r-local: issue 13: keep a cell's last record box for last
 only when nothing after it pushes work

drop_and_free (0014, as 0027 amended it) releases the members of a cell
whose count was read as 1: it defers the record boxes to the thread's
pending stack, releases the other managed members through their own drop
glue (ref.drop), frees the cell, and then releases the arm's last
non-leaf record box directly (a tail call when its count is 1), so that a
chain through it is a loop. That box therefore comes out before anything
the cell's other members pushed. A member after it that goes through
ref.drop can push work: a host runtime that shares the stack pushes the
free of its own objects while a drain runs (lean2rr's runtime: arrays,
thunk and task cells, file handles), and a [value] record's glue defers
its boxes. The box's contents were then released before that work, where
Lean's lean_del, which pushes a cell's fields in order and pops the last
first, releases the later member first. In lean2rr, a structure
{i : In, arr : Array Handle} two cells below a freed record closed the
handles of i before those of the array.

emitCellRelease now keeps the last non-leaf record box for last only when
every managed member after it releases quietly: it is trivially copyable,
or it is a leaf box (plain or in a Nullable), freed at once with no
effect. Otherwise no member is kept for last: every record box is
deferred in field order, like the other members, and the drain pops them
last first. A chain whose link is the last managed member (a list, a tree
whose recursive member is last) is still a loop; a chain with a member
through ref.drop after the link is freed through the drain, at the same
constant stack depth.

New lit test frontend/drop_member_order.rr: the glue of five records (an
FFI object, a [value] record, or through Nullable an FFI object after the
box: the box is deferred; a leaf box and a scalar after it, or an FFI
object before it: the box is kept for last), and a chain of two million
cells with a [value] record after the link, freed on an 8 MB stack.
---
 .../AcquireDropExpansion.cpp                  |  34 ++++-
 .../integration/frontend/drop_member_order.c  |  15 ++
 .../integration/frontend/drop_member_order.rr | 132 ++++++++++++++++++
 3 files changed, 177 insertions(+), 4 deletions(-)
 create mode 100644 tests/integration/frontend/drop_member_order.c
 create mode 100644 tests/integration/frontend/drop_member_order.rr

diff --git a/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp b/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
index ceebc855..9298cfd5 100644
--- a/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
+++ b/lib/Conversion/AcquireDropExpansion/AcquireDropExpansion.cpp
@@ -68,8 +68,11 @@ namespace reussir {
 // drain, frees a cell whose count was read as 1: per arm it releases the
 // members (deferring the record boxes) but the last non-leaf record box
 // (plain or in a `Nullable`), frees the cell, and then releases that last
-// box directly, by a tail call when its count is 1, so a chain is a loop. Releases outside drop glue
-// (whose tokens may be reused) are unchanged.
+// box directly, by a tail call when its count is 1, so a chain is a loop.
+// It keeps that box for last only when no member after it is released
+// through its own drop glue (which may push work that the stack must pop
+// before the box); otherwise it defers every record box, in field order.
+// Releases outside drop glue (whose tokens may be reused) are unchanged.
 
 namespace {
 
@@ -255,17 +258,40 @@ void emitCellRelease(mlir::PatternRewriter &rewriter, mlir::Location loc,
   // record box, plain or `Nullable` (whose box would otherwise be deferred
   // like a plain one), so the members are released in the same order either
   // way and a chain through either kind of link is a loop.
-  auto isTail = [&](size_t idx) {
+  auto boxType = [&](size_t idx) {
     mlir::Type type = projected(idx);
     if (auto nullableType = llvm::dyn_cast<NullableType>(type))
       type = nullableType.getPtrTy();
-    return isDeferredNonLeaf(type);
+    return type;
+  };
+  auto isTail = [&](size_t idx) { return isDeferredNonLeaf(boxType(idx)); };
+  // A member whose release pushes nothing and has no effect: nothing
+  // (trivially copyable), or a leaf box (plain or `Nullable`), freed at once.
+  auto releasesQuietly = [&](size_t idx) {
+    return isTriviallyCopyable(projected(idx)) ||
+           (isDeferrable(boxType(idx)) && !isDeferredNonLeaf(boxType(idx)));
   };
   std::optional<size_t> last;
   for (auto [idx, memberTy, memberIsField] : llvm::enumerate(
            payload.getMembers(), payload.getMemberIsField()))
     if (!memberIsField && isTail(idx))
       last = idx;
+  // A member after it that is released through its own drop glue (an FFI
+  // object, a closure, an array, a cell, a [value] record or a box that is not
+  // deferred) may push work onto the pending stack: a host runtime's
+  // container pushes its free, a [value] record defers its boxes. Like
+  // `lean_del`, which pushes a cell's fields in order and pops the last
+  // first, that work must run before the box's contents, but a box released
+  // directly after the free runs before anything this cell pushed. Then no
+  // member is kept for last: every record box is deferred in field order, so
+  // the stack pops the members last first.
+  if (last)
+    for (auto [idx, memberTy, memberIsField] : llvm::enumerate(
+             payload.getMembers(), payload.getMemberIsField()))
+      if (idx > *last && !memberIsField && !releasesQuietly(idx)) {
+        last.reset();
+        break;
+      }
   mlir::Value lastValue;
   if (last)
     lastValue = ReussirRefLoadOp::create(rewriter, loc, projected(*last),
