 class WorklistGlue {
   mlir::ModuleOp module;
   mlir::PatternRewriter &rewriter;
@@ -202,16 +247,127 @@ public:
     });
   }
 
+  // Whether releasing a `type` value may push work onto the drain: it can
+  // reach a Worklist record, a closure or an FFI object (whose hooks may).
+  llvm::DenseMap<mlir::Type, bool> pushes;
+  bool mayPush(mlir::Type root) {
+    return reaches(root, pushes, [](mlir::Type type, Next next) {
+      auto record = llvm::dyn_cast<RecordType>(type);
+      if (llvm::isa<ClosureType, FFIObjectType>(type) ||
+          (record && isWorklist(record)))
+        return true;
+      if (auto rc = llvm::dyn_cast<RcType>(type))
+        next(rc.getElementType());
+      else
+        inner(type, next);
+      return false;
+    });
+  }
+
+  // Releases the compound `record` at `ref`, in the box `box`, as the walk
+  // does, except the last member box the walk would defer, when no later
+  // member may push work (their drops then have no effect to reorder): it
+  // comes last, after the box's free, by a tail call of its release if dead.
+  void releaseCompound(RecordType record, AtomicKind kind, mlir::Value ref,
+                       mlir::Value box) {
+    size_t n = record.getMembers().size();
+    auto field = [&](size_t i) { return record.getMemberIsField()[i]; };
+    auto projected = [&](size_t i) {
+      return getProjectedType(record.getMembers()[i], false,
+                              Capability::unspecified, kind);
+    };
+    auto slot = [&](size_t i) -> mlir::Value {
+      auto type = RefType::get(record.getContext(), projected(i),
+                               Capability::unspecified, kind);
+      return ReussirRefProjectOp::create(rewriter, loc, type, ref,
+                                         rewriter.getIndexAttr(i));
+    };
+    std::optional<size_t> b;
+    for (size_t i = 0; i < n; ++i)
+      if (!field(i) && isDeferredBox(projected(i)))
+        b = i;
+    for (size_t i = b ? *b + 1 : n; i < n; ++i)
+      if (!field(i) && mayPush(projected(i)))
+        b.reset();
+    for (size_t i = 0; i < n; ++i)
+      if (i != b && !field(i) && !isTriviallyCopyable(projected(i)))
+        ReussirRefDropOp::create(rewriter, loc, slot(i));
+    if (!b)
+      return emitBoxFree(box, loc, module, rewriter);
+    mlir::Value child =
+        ReussirRefLoadOp::create(rewriter, loc, projected(*b), slot(*b));
+    emitBoxFree(box, loc, module, rewriter);
+    auto tail = [&](mlir::Value rc) {
+      auto next = release(llvm::cast<RcType>(rc.getType()));
+      emitDecrement(rc, loc, module, rewriter, [&] {
+        auto call = mlir::func::CallOp::create(rewriter, loc, next,
+                                               mlir::ValueRange{rc});
+        call->setAttr(kMustTailCallAttr, rewriter.getUnitAttr());
+      });
+    };
+    auto nullable = llvm::dyn_cast<NullableType>(child.getType());
+    if (!nullable)
+      return tail(child);
+    auto dispatch = ReussirNullableDispatchOp::create(rewriter, loc,
+                                                      mlir::Type{}, child);
+    mlir::OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.createBlock(&dispatch.getNullRegion());
+    ReussirScfYieldOp::create(rewriter, loc, nullptr);
+    auto *present = rewriter.createBlock(&dispatch.getNonNullRegion(), {},
+                                         {nullable.getPtrTy()}, {loc});
+    tail(present->getArgument(0));
+    ReussirScfYieldOp::create(rewriter, loc, nullptr);
+  }
+
   mlir::func::FuncOp release(RcType rc) {
     auto type = llvm::cast<RecordType>(rc.getElementType());
     AtomicKind kind = rc.getAtomicKind();
-    return function(type, kind, ".worklist.release", rc, [&](mlir::Value box) {
-      mlir::Value payload =
-          ReussirRcBorrowOp::create(rewriter, loc, ref(type, kind), box);
-      mlir::func::CallOp::create(rewriter, loc, walk(type, kind),
-                                 mlir::ValueRange{payload});
-      emitBoxFree(box, loc, module, rewriter);
-    });
+    // Wasm has tail calls only with a feature the module does not record.
+    auto triple = module->getAttrOfType<mlir::StringAttr>(
+        mlir::LLVM::LLVMDialect::getTargetTripleAttrName());
+    bool tails = !triple || !llvm::Triple(triple.getValue()).isWasm();
+    auto release =
+        function(type, kind, ".worklist.release", rc, [&](mlir::Value box) {
+          mlir::Value payload =
+              ReussirRcBorrowOp::create(rewriter, loc, ref(type, kind), box);
+          if (!tails) {
+            mlir::func::CallOp::create(rewriter, loc, walk(type, kind),
+                                       mlir::ValueRange{payload});
+            return emitBoxFree(box, loc, module, rewriter);
+          }
+          if (!type.isVariant())
+            return releaseCompound(type, kind, payload, box);
+          llvm::SmallVector<mlir::Attribute> tags;
+          for (size_t i = 0; i < type.getMembers().size(); ++i)
+            tags.push_back(rewriter.getDenseI64ArrayAttr({int64_t(i)}));
+          auto dispatch = ReussirRecordDispatchOp::create(
+              rewriter, loc, mlir::Type{}, payload,
+              rewriter.getArrayAttr(tags), tags.size());
+          mlir::OpBuilder::InsertionGuard guard(rewriter);
+          for (auto [i, member, field] : llvm::enumerate(
+                   type.getMembers(), type.getMemberIsField())) {
+            auto armType = getProjectedType(member, field,
+                                            Capability::unspecified, kind);
+            auto *arm = rewriter.createBlock(
+                &dispatch.getRegions()[i], {},
+                {RefType::get(type.getContext(), armType,
+                              Capability::unspecified, kind)},
+                {loc});
+            auto record = llvm::dyn_cast<RecordType>(armType);
+            if (!field && record && record.isCompound()) {
+              releaseCompound(record, kind, arm->getArgument(0), box);
+            } else {
+              if (!field && !isTriviallyCopyable(armType))
+                ReussirRefDropOp::create(rewriter, loc, arm->getArgument(0),
+                                         /*inlined=*/true, nullptr);
+              emitBoxFree(box, loc, module, rewriter);
+            }
+            ReussirScfYieldOp::create(rewriter, loc, nullptr);
+          }
+        });
+    if (tails)
+      release->setAttr(kWorklistGlueAttr, rewriter.getUnitAttr());
+    return release;
   }
 };
