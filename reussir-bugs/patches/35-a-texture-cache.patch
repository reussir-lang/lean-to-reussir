@@ -150,6 +502,24 @@ std::unique_ptr<llvm::MemoryBuffer> compileRustSourceToBitcode(
                  << cwd << "\n";
     return nullptr;
   }
+  // rustc's options, without the source and output files: the cache key
+  // leaves out these temporary files, whose random names reach the output
+  // only as the crate's name, the module's source file name and the file
+  // names of panic locations, random anyway
+  llvm::SmallVector<llvm::StringRef, 24> options = {
+      "-A", "warnings", "--crate-type", "cdylib", "--emit=llvm-bc"};
+  for (const std::string &depsPath : rustcDepsPaths) {
+    options.push_back("-L");
+    options.push_back(depsPath);
+  }
+  for (auto arg : additionalArgs)
+    options.push_back(arg);
+  std::optional<CacheEntry> cacheEntry =
+      cacheEntryFor(sourceCode, options, rustcPath, rustcDepsPaths);
+  if (cacheEntry)
+    if (std::unique_ptr<llvm::MemoryBuffer> cached =
+            readCacheEntry(cacheEntry->path))
+      return cached;
   // Create a temporary file for the source code
   llvm::SmallString<32> srcFilePath;
   llvm::SmallString<32> resultBitcodeFilePath;
@@ -180,16 +550,9 @@ std::unique_ptr<llvm::MemoryBuffer> compileRustSourceToBitcode(
     srcStream.flush();
   }
   // Prepare rustc command
-  llvm::SmallVector<llvm::StringRef, 24> args = {
-      "rustc",          "-A",           "warnings",
-      srcFilePath,      "--crate-type", "cdylib",
-      "--emit=llvm-bc", "-o",           resultBitcodeFilePath};
-  for (const std::string &depsPath : rustcDepsPaths) {
-    args.push_back("-L");
-    args.push_back(depsPath);
-  }
-  for (auto arg : additionalArgs)
-    args.push_back(arg);
+  llvm::SmallVector<llvm::StringRef, 24> args = {"rustc", srcFilePath, "-o",
+                                                 resultBitcodeFilePath};
+  llvm::append_range(args, options);
   // Execute rustc
   std::string executionError;
   int code =
@@ -221,6 +584,10 @@ std::unique_ptr<llvm::MemoryBuffer> compileRustSourceToBitcode(
     buffer = std::move(*bufferOrErr);
 #endif
   }
+  // Not stored if a file the key was computed from changed meanwhile: rustc
+  // may have read the new one.
+  if (cacheEntry && cacheEntry->current())
+    writeCacheEntry(cacheEntry->path, buffer->getBuffer());
   return buffer;
 }
 
diff --git a/tests/integration/frontend/polyffi_cache.rr b/tests/integration/frontend/polyffi_cache.rr
new file mode 100644
index 00000000..c9621186
--- /dev/null
+++ b/tests/integration/frontend/polyffi_cache.rr
@@ -0,0 +1,44 @@
+// UNSUPPORTED: windows
+// The texture bitcode cache (REUSSIR_FFI_CACHE_DIR; lib/RustCompiler): a
+// build stores the bitcode of each texture there, a second build takes every
+// texture from the cache, and an entry that does not match its digest, or a
+// build with other rustc options, is a miss. %t/rustc runs the real rustc,
+// but fails every compilation while NO_COMPILE is set; it still answers
+// `-vV`, and the environment is not part of the key.
+
+// RUN: rm -rf %t && mkdir -p %t
+// RUN: printf '#!/bin/sh\n' > %t/rustc
+// RUN: printf 'if [ -n "$NO_COMPILE" ] && [ "$1" != -vV ]; then exit 1; fi\n' \
+// RUN:   >> %t/rustc
+// RUN: printf 'exec "$REAL_RUSTC" "$@"\n' >> %t/rustc
+// RUN: chmod +x %t/rustc
