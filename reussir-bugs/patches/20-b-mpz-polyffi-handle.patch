diff --git a/tests/integration/frontend/bigint_ffi_generic.rr b/tests/integration/frontend/bigint_ffi_generic.rr
new file mode 100644
index 00000000..4a47d0c0
--- /dev/null
+++ b/tests/integration/frontend/bigint_ffi_generic.rr
@@ -0,0 +1,195 @@
+// UNSUPPORTED: darwin
+// `Nat` and `Int` as type arguments of the polymorphic FFI. A Rust
+// `Vec<Nat>` holds owned handles (`reussir_rt::rcgmp::Mpz`), whose clones
+// retain and whose drops release; a parameter declared as a generic
+// instantiated at `Nat` moves into the body, which may store it, and a
+// generic result moves out to the caller. A parameter declared `Nat` stays
+// the borrowed raw handle of `bigint_ffi.rr`. Heap values make a missed or
+// doubled release visible; the sanitizer variant
+// (`sanitizer/bigint-ffi-generic-asan.rr`) checks the balance.
+
+// The absent patterns run as their own prefix over the same textures.
+// REQUIRES: rcgmp
+// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
+// RUN: %rrc %s --package-name bigintffigeneric --extern core=%t.core.rri --emit mlir --no-source-locations -o %t.texture.mlir
+// RUN: %FileCheck %s --check-prefix=TEXTURE --input-file=%t.texture.mlir
+// RUN: %FileCheck %s --check-prefix=ABSENT --input-file=%t.texture.mlir
+// RUN: %rrc %s --package-name bigintffigeneric --extern core=%t.core.rri -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/bigint_ffi_generic.c -o %t.exe -L%library_path -lreussir_rt %rcgmp_runtime %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+
+extern "rust" [{
+    use reussir_rt::collections::btree_set::BTreeSet as RSet;
+    use reussir_rt::collections::vec::Vec as RVec;
+    use reussir_rt::rcgmp::Mpz;
+    unsafe extern "C" {
+        fn rcgmp_mpz_retain(value: *mut ::std::ffi::c_void, atomic: u32) -> *mut ::std::ffi::c_void;
+    }
+}];
+
+#[ffi(rust = "::reussir_rt::collections::vec::Vec")]
+pub struct Vec<T>;
+
+#[ffi(rust = "::reussir_rt::collections::btree_set::BTreeSet")]
+pub struct Set<T : Ord>;
+
+// `[:T:]` spells the type argument as the vector does.
+#[ffi(import)]
+fn new<T>() -> Vec<T> [{ RVec::<[:T:]>::new() }];
+
+#[ffi(import)]
+fn push<T>(v : Vec<T>, x : T) -> Vec<T> [{ v.push(x) }];
+
+#[ffi(import)]
+fn get<T>(v : Vec<T>, i : u64) -> T [{ v.get(i as usize).unwrap() }];
+
+#[ffi(import)]
+fn set<T>(v : Vec<T>, i : u64, x : T) -> Vec<T> [{ v.set(i as usize, x) }];
+
+#[ffi(import)]
+fn len<T>(v : Vec<T>) -> u64 [{ v.len() as u64 }];
+
+// Clones the vector on the Rust side, then pushes its first element onto the
+// clone: the copy-on-write push clones every element, and the original drops
+// here, releasing its reference to each.
+#[ffi(import)]
+fn duplicate<T>(v : Vec<T>) -> Vec<T> [{
+    let w = v.clone();
+    let first = w.get(0).unwrap();
+    w.push(first)
+}];
+
+// Returns one argument and drops the other.
+#[ffi(import)]
+fn pick<T>(first : bool, a : T, b : T) -> T [{ if first { a } else { b } }];
+
+// Four parameters take the nontrivial boundary: the arguments come packed in
+// one struct.
+#[ffi(import)]
+fn pick3<T>(which : u64, a : T, b : T, c : T) -> T [{
+    match which { 0 => a, 1 => b, _ => c }
+}];
+
+// A declared `Nat` is the borrowed raw handle: storing it takes a reference.
+#[ffi(import)]
+fn push_nat(v : Vec<Nat>, n : Nat) -> Vec<Nat> [{
+    v.push(unsafe { Mpz::from_raw(rcgmp_mpz_retain(n, 0)) })
+}];
+
+// A declared `Nat` result hands over one reference as the raw handle.
+#[ffi(import)]
+fn get_nat(v : Vec<Nat>, i : u64) -> Nat [{ v.get(i as usize).unwrap().into_raw() }];
+
+#[ffi(import)]
+fn set_new<T : Ord>() -> Set<T> [{ RSet::new() }];
+
+#[ffi(import)]
+fn insert<T : Ord>(s : Set<T>, x : T) -> Set<T> [{ s.insert(x) }];
+
+#[ffi(import)]
+fn size<T : Ord>(s : Set<T>) -> u64 [{ s.len() as u64 }];
+
+#[ffi(import)]
+fn first<T : Ord>(s : Set<T>) -> T [{ s.first().unwrap() }];
+
+#[ffi(import)]
+fn last<T : Ord>(s : Set<T>) -> T [{ s.last().unwrap() }];
+
+fn nat(x : u64) -> Nat { x as Nat }
+
+fn int(x : i64) -> Int { x as Int }
+
+fn digit(ok : bool) -> i64 { if ok { 1 } else { 0 } }
+
+// Heap and immediate elements pushed, read back, and replaced; a replaced
+// element is released by the vector.
+fn vec_ok(big : Nat, odd : Nat) -> bool {
+    let v = push(push(push(new<Nat>(), big), 7), odd);
+    let read = len(v) == 3 && get(v, 0) == 1267650600228229401496703205376 && get(v, 1) == 7
+        && get(v, 2) == 147808829414345923316083210206383297601;
+    let w = set(set(v, 1, odd + 7), 0, 5);
+    read && get(w, 0) == 5 && get(w, 1) == 147808829414345923316083210206383297608
+        && get(w, 2) == 147808829414345923316083210206383297601
+}
+
+// The copy-on-write clone on the Rust side shares the elements, and the
+// original vector stays readable.
+fn duplicate_ok(big : Nat) -> bool {
+    let v = push(push(new<Nat>(), big + 1), big);
+    let w = duplicate(v);
+    len(v) == 2 && len(w) == 3 && get(w, 2) == 1267650600228229401496703205377
+        && get(v, 0) == 1267650600228229401496703205377 && get(w, 1) == 1267650600228229401496703205376
+}
+
+// A generic texture returning one of its `T`s and dropping the other (a
+// uniquely owned heap value, freed there), at `Nat` and at `Int`; a vector of
+// `Int`s holding negative heap values.
+fn generic_ok(big : Nat, one : Int) -> bool {
+    let negative = int(0) - (big as Int) * one;
+    let ints = push(push(new<Int>(), negative), int(-3) * one);
+    pick(true, big, nat(9)) == 1267650600228229401496703205376 && pick(false, big + 2, nat(9)) == 9
+        && pick(true, nat(9), big + 2) == 9
+        && pick3(2, big + 2, nat(5), big + 4) == 1267650600228229401496703205380
+        && pick3(1, big + 2, nat(5), big + 4) == 5
+        && pick(false, int(4) * one, negative) == -1267650600228229401496703205376
+        && get(ints, 0) == -1267650600228229401496703205376 && get(ints, 1) == -3
+}
+
+// A declared `Nat` parameter stored by the body, and a declared `Nat` result.
+fn declared_ok(big : Nat) -> bool {
+    let v = push_nat(push_nat(new<Nat>(), big), 11);
+    get_nat(v, 0) == 1267650600228229401496703205376 && get_nat(v, 1) == 11 && get(v, 0) == get_nat(v, 0)
+}
+
+// A Rust set orders the integers by value: two equal heap values built apart
+// are one element.
+fn set_ok(big : Nat, two : Nat) -> bool {
+    let other = core::intrinsic::bigint::ipowi(two * 2, 50);
+    let s = insert(insert(insert(insert(set_new<Nat>(), big), 7), other), 5);
+    size(s) == 3 && first(s) == 5 && last(s) == 1267650600228229401496703205376
+}
+
+// Many elements through repeated growth.
+fn fill(v : Vec<Nat>, x : Nat, n : u64) -> Vec<Nat> {
+    if n == 0 { v } else { fill(push(v, x), x * 3, n - 1) }
+}
+
+fn total(v : Vec<Nat>, i : u64, acc : Nat) -> Nat {
+    if i == len(v) { acc } else { total(v, i + 1, acc + get(v, i)) }
+}
+
+fn growth_ok(one : u64) -> bool {
+    // 1 + 3 + ... + 3^99 = (3^100 - 1) / 2
+    let v = fill(new<Nat>(), nat(one), 100);
+    total(v, 0, 0) == (core::intrinsic::bigint::ipowi(nat(3 * one), 100) - 1) / 2
+}
+
+pub fn main(one : u64) -> i64 {
+    let big = core::intrinsic::bigint::ipowi(nat(2 * one), 100);
+    let odd = core::intrinsic::bigint::ipowi(nat(3 * one), 80);
+    digit(vec_ok(big, odd)) + digit(duplicate_ok(big)) * 10
+        + digit(generic_ok(big, one as Int)) * 100 + digit(declared_ok(big)) * 1000
+        + digit(set_ok(big, nat(2 * one))) * 10000 + digit(growth_ok(one)) * 100000
+}
+
+extern "C" trampoline "reussir_main" = main;
+
+// A type argument and a generic instantiated at `Nat` are the owned handle,
+// and their wrappers release nothing after the body.
+// TEXTURE-DAG: RVec::<::reussir_rt::rcgmp::Mpz>::new()
+// TEXTURE-DAG: (r#v: ::reussir_rt::collections::vec::Vec<::reussir_rt::rcgmp::Mpz>, r#x: ::reussir_rt::rcgmp::Mpz) -> ::reussir_rt::collections::vec::Vec<::reussir_rt::rcgmp::Mpz>
+// TEXTURE-DAG: r#a: ::reussir_rt::rcgmp::Mpz, r#b: ::reussir_rt::rcgmp::Mpz) -> ::reussir_rt::rcgmp::Mpz
+// TEXTURE-DAG: ::reussir_rt::collections::btree_set::BTreeSet<::reussir_rt::rcgmp::Mpz>
+// TEXTURE-DAG: struct __ReussirArgs(u64, ::reussir_rt::rcgmp::Mpz, ::reussir_rt::rcgmp::Mpz, ::reussir_rt::rcgmp::Mpz)
+// A declared `Nat` stays the raw handle, which the wrapper releases.
+// TEXTURE-DAG: r#n: *mut ::std::ffi::c_void) -> ::reussir_rt::collections::vec::Vec<::reussir_rt::rcgmp::Mpz>
+// TEXTURE-DAG: rcgmp_mpz_release(r#n, 0)
+// TEXTURE-DAG: r#i: u64) -> *mut ::std::ffi::c_void
+
+// Only `push_nat`'s wrapper releases a handle; no other spells one.
+// ABSENT-NOT: rcgmp_mpz_release(r#x
+// ABSENT-NOT: rcgmp_mpz_release(r#a
+// ABSENT-NOT: rcgmp_mpz_release(r#b
+// ABSENT-NOT: rcgmp_mpz_release(r#v
+// ABSENT-NOT: Vec<*mut ::std::ffi::c_void>
+// ABSENT-NOT: BTreeSet<*mut ::std::ffi::c_void>
