diff --git a/tests/integration/frontend/bigint_ffi_phantom.rr b/tests/integration/frontend/bigint_ffi_phantom.rr
new file mode 100644
index 00000000..241aef3a
--- /dev/null
+++ b/tests/integration/frontend/bigint_ffi_phantom.rr
@@ -0,0 +1,24 @@
+// UNSUPPORTED: darwin
+// `Nat` reaches the texture only as a type argument that no signature,
+// expression or record of the program mentions: the texture spells the owned
+// handle, so the program still defines the handle's glue.
+
+// REQUIRES: rcgmp
+// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
+// RUN: %rrc %s --package-name phantom --extern core=%t.core.rri --emit mir -o - | %FileCheck %s
+// RUN: %rrc %s --package-name phantom --extern core=%t.core.rri -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/bigint_ffi_phantom.c -o %t.exe -L%library_path -lreussir_rt %rcgmp_runtime %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+
+#[ffi(import)]
+fn probe<T>(x: u64) -> u64 [{
+    let v: ::std::vec::Vec<[:T:]> = ::std::hint::black_box(::std::vec::Vec::new());
+    let w = ::std::hint::black_box(v.clone());
+    (v.len() + w.len()) as u64 + x
+}];
+
+pub fn main(x: u64) -> u64 { probe<Nat>(x) }
+
+extern "C" trampoline "reussir_main" = main;
+
+// CHECK: ffi glue @__reussir_rcgmp_ffi_acquire @__reussir_rcgmp_ffi_release : Nat;
