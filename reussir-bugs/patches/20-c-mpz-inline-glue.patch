diff --git a/lib/IR/ReussirOps.cpp b/lib/IR/ReussirOps.cpp
index de733efc..27ec6750 100644
--- a/lib/IR/ReussirOps.cpp
+++ b/lib/IR/ReussirOps.cpp
@@ -4804,6 +4804,15 @@ mlir::LogicalResult resolveDropOrder(mlir::ModuleOp module,
 }
 
 void qualifyFfiSymbols(mlir::ModuleOp module, llvm::Module &translated) {
+  // Definitions that every linked image binds to its own copy.
+  if (auto hidden =
+          module->getAttrOfType<mlir::ArrayAttr>("reussir.hidden_symbols"))
+    for (auto attribute : hidden) {
+      auto symbol = llvm::cast<mlir::FlatSymbolRefAttr>(attribute);
+      auto *value = translated.getNamedValue(symbol.getValue());
+      if (value && !value->isDeclaration())
+        value->setVisibility(llvm::GlobalValue::HiddenVisibility);
+    }
   auto symbols = module->getAttrOfType<mlir::ArrayAttr>("reussir.ffi_symbols");
   if (!symbols)
     return;
diff --git a/tests/integration/codegen/hidden_symbols.mlir b/tests/integration/codegen/hidden_symbols.mlir
new file mode 100644
index 00000000..18bbf7d2
--- /dev/null
+++ b/tests/integration/codegen/hidden_symbols.mlir
@@ -0,0 +1,15 @@
+// RUN: %reussir-translate --reussir-to-llvmir %s | %FileCheck %s
+// The definitions named by `reussir.hidden_symbols` get hidden visibility, so
+// that every linked image binds its own copy; a declaration stays as it is.
+module attributes {reussir.hidden_symbols = [@glue, @other]} {
+  llvm.func weak_odr @glue() {
+    llvm.return
+  }
+  llvm.func @other()
+  llvm.func @plain() {
+    llvm.return
+  }
+  // CHECK-DAG: define weak_odr hidden void @glue()
+  // CHECK-DAG: declare void @other()
+  // CHECK-DAG: define void @plain()
+}
