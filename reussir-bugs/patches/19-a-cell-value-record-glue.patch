+++ b/tests/integration/frontend/cell_value_record.rr
@@ -0,0 +1,77 @@
+// A Cell of a [value] record with counted members: get acquires the slot's
+// record and set releases it, both through the slot's `field` reference. The
+// record's outlined acquire and drop functions for a reference of unspecified
+// capability do not accept it: get and set call the `field` variants
+// (acquire_in_place_field, drop_in_place_field), which call the `field`
+// variants of nested [value] records, so a record nested along many paths
+// costs its glue once.
+
+// RUN: %rrc %s -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/cell_value_record.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
+// RUN: %cc %t.opt.o %S/cell_value_record.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.opt.exe
+// RUN: %rrc %s --emit mlir-llvm -o - | %FileCheck %s --check-prefix=GLUE
+
+import core::intrinsic::cell;
+
