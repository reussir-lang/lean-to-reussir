+pub fn main(zero : i64, one : i64) -> i64 {
+    let nzero = nat(zero as u64);
+    let seven = nat((7 * one) as u64);
+    let nbig = core::intrinsic::bigint::ipowi(nat((2 * one) as u64), 100);
+    let ibig = core::intrinsic::bigint::ipowi(int(2 * one), 100);
+    digit(nat_small(nzero, seven)) + digit(nat_heap(nzero, seven, nbig)) * 10
+        + digit(int_truncated(int(zero), int(one))) * 100
+        + digit(int_euclidean(int(zero), int(one))) * 1000
+        + digit(int_floored(int(zero), int(one))) * 10000
+        + digit(int_heap(int(zero), ibig)) * 100000 + digit(folded()) * 1000000
+        + digit(int_minimum(int(one))) * 10000000 + digit(int_heap_heap(int(one))) * 100000000
+}
