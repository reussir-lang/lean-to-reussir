+    core::intrinsic::bigint::divsi_lean(n, z) == 0 && core::intrinsic::bigint::remsi_lean(n, z) == -7
+        && core::intrinsic::bigint::edivsi_lean(n, z) == 0 && core::intrinsic::bigint::emodsi_lean(n, z) == -7
+        && core::intrinsic::bigint::floordivsi_lean(n, z) == 0
+        && core::intrinsic::bigint::floormodsi_lean(n, z) == -7
+        && core::intrinsic::bigint::remsi_lean(h, z) == -1267650600228229401496703205376
+        && core::intrinsic::bigint::emodsi_lean(n, 2) == 1
