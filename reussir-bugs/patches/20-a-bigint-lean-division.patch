+// The divisions of `Nat`s are `nonnegative`: their immediates untag by a
+// logical shift and divide unsigned. An `Int` division divides signed. Each
+// function's checks run as their own prefix, independent of the order of the
+// functions.
+pub fn nat_div(x : Nat, m : Nat) -> Nat { x / m }
+
+pub fn nat_rem(x : Nat, m : Nat) -> Nat { core::intrinsic::bigint::remsi_lean(x, m) }
+
+pub fn int_div(x : Int, m : Int) -> Int { x / m }
