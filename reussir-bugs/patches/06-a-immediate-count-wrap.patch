 .../RcDecrementExpansion.cpp                  | 54 +++++++++++++++++++
 .../rc_dec_expansion_immediates.mlir          | 43 +++++++++++++++
 .../special_pointer_tag_lowering.mlir         | 18 +++++++
 4 files changed, 140 insertions(+), 14 deletions(-)
 create mode 100644 tests/integration/conversion/rc_dec_expansion_immediates.mlir

