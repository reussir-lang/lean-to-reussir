diff --git a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
index fc194dac..95882417 100644
--- a/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
+++ b/lib/Conversion/RcDecrementExpansion/RcDecrementExpansion.cpp
@@ -43,6 +43,7 @@
 #include "Reussir/IR/ReussirEnumAttrs.h"
 #include "Reussir/IR/ReussirOps.h"
 #include "Reussir/IR/ReussirTypes.h"
+#include "Reussir/Transformation/SpecialPointerTag.h"
 
 namespace reussir {
 
@@ -55,6 +56,34 @@ namespace reussir {
 
 namespace {
 
+// Under the special-pointer-tag scheme a nullary constructor is an immediate
+// pointing at a static per-tag dummy box. Increments of an immediate land on
+// the dummy's 32-bit count (the LLVM lowering keeps rc.inc unguarded), so
+// after 2^32 references the count wraps and a decrement reads 1. Its unique
+// branch must then release nothing and produce no token (the dummy is not
+// heap memory). Returns the nullary tags the value may be the immediate of,
+// to be tested on that branch: none for types without immediates, and none
+// for a destructuring decrement of an arm with members.
+llvm::SmallVector<int64_t> immediateTagsToGuard(ReussirRcDecOp op) {
+  RcType type = op.getRcPtr().getType();
+  auto module = op->getParentOfType<mlir::ModuleOp>();
+  if (!module || !module->hasAttr(kSpecialPtrTagAttr) ||
+      !type.mayCarrySpecialPointerTag())
+    return {};
+  auto variant = llvm::cast<RecordType>(type.getElementType());
+  llvm::SmallVector<int64_t> tags;
+  if (op.isVariantDestructuring()) {
+    size_t tag = op.getDestructureTagAttr().getValue().getZExtValue();
+    if (variant.isNullaryArm(tag))
+      tags.push_back(static_cast<int64_t>(tag));
+    return tags;
+  }
+  for (size_t tag = 0, n = variant.getMembers().size(); tag < n; ++tag)
+    if (variant.isNullaryArm(tag))
+      tags.push_back(static_cast<int64_t>(tag));
+  return tags;
+}
+
 struct RcDecrementExpansionPattern
     : public mlir::OpRewritePattern<ReussirRcDecOp> {
   using mlir::OpRewritePattern<ReussirRcDecOp>::OpRewritePattern;
@@ -102,6 +131,31 @@ struct RcDecrementExpansionPattern
