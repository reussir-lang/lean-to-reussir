@@ -0,0 +1,42 @@
+// Releasing a long chain of cells at once must not recurse once per cell. A
+// member release inside drop glue calls the member type's drop_and_free,
+// which deallocates the cell before releasing the members that continue the
+// chain (boxes of the same recursive group), the last one about to be freed
+// as a tail call, so the release of a chain is a loop wherever the chain
+// member sits. Two million cells would need about 64 MB of stack the old
+// way, far beyond the driver's 8 MB main thread. Checked: a list, a right
+// and a left tree spine, and a snoc list whose last member is another box.
+
+// RUN: %rrc %s -o %t.o --relocation-mode pic
+// RUN: %cc %t.o %S/drop_long_list.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.exe
+// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
+// RUN: %cc %t.opt.o %S/drop_long_list.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
+// RUN: %t.opt.exe
+// RUN: %rrc %s --emit llvm-ir -o %t.ll
+// RUN: %FileCheck %s < %t.ll
+
+enum L { Cons(u64, L), Nil }
