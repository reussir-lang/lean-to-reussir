@@ -145,6 +487,16 @@ private:
 
   mlir::LogicalResult rewriteDropRc(RcType rcType, ReussirRefDropOp op,
                                     mlir::PatternRewriter &rewriter) const {
+    if (auto func = op->getParentOfType<mlir::func::FuncOp>();
+        func && func->hasAttr(kDropGlueAttr) &&
+        releasesThroughDropAndFree(rcType)) {
+      mlir::Value loaded =
+          ReussirRefLoadOp::create(rewriter, op.getLoc(), rcType, op.getRef());
+      emitGlueRelease(rewriter, op.getLoc(),
+                      op->getParentOfType<mlir::ModuleOp>(), loaded);
+      rewriter.eraseOp(op);
+      return mlir::success();
+    }
     // Replace drop of ref rc with load then dec
     NullableType nullableType = nullptr;
     if (decMayProduceToken(rcType)) {
