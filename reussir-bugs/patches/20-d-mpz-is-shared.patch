diff --git a/crates/reussir-backend/src/rcgmp.rs b/crates/reussir-backend/src/rcgmp.rs
index a46f374b..5cbc323d 100644
--- a/crates/reussir-backend/src/rcgmp.rs
+++ b/crates/reussir-backend/src/rcgmp.rs
@@ -73,6 +73,35 @@ pub fn release<'c>(value: Value<'c, '_>, location: Location<'c>) -> Operation<'c
         .expect("valid rcgmp.release")
 }
 
+/// `rcgmp.bridge.mpz.is_immediate <value>`: whether a handle is an
+/// immediate, from its tag alone.
+pub fn is_immediate<'c>(
+    context: &'c Context,
+    value: Value<'c, '_>,
+    location: Location<'c>,
+) -> Operation<'c> {
+    OperationBuilder::new("rcgmp.bridge.mpz.is_immediate", location)
+        .add_operands(&[value])
+        .add_results(&[IntegerType::new(context, 1).into()])
+        .build()
+        .expect("valid rcgmp.bridge.mpz.is_immediate")
+}
+
+/// `rcgmp.bridge.mpz.is_unique <value>`: whether a heap integer, which the
+/// caller holds a reference of, has no other reference; false for an
+/// immortal. `value` must not be an immediate.
+pub fn is_unique<'c>(
+    context: &'c Context,
+    value: Value<'c, '_>,
+    location: Location<'c>,
+) -> Operation<'c> {
+    OperationBuilder::new("rcgmp.bridge.mpz.is_unique", location)
+        .add_operands(&[value])
+        .add_results(&[IntegerType::new(context, 1).into()])
+        .build()
+        .expect("valid rcgmp.bridge.mpz.is_unique")
+}
+
 /// A binary operation consuming both operands.
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub enum Binary {
diff --git a/crates/reussir-codegen/src/lower/expr.rs b/crates/reussir-codegen/src/lower/expr.rs
index 0b4a2ff2..5117f413 100644
--- a/crates/reussir-codegen/src/lower/expr.rs
+++ b/crates/reussir-codegen/src/lower/expr.rs
@@ -576,11 +576,9 @@ impl<'c, 'p, 'tcx> Lowerer<'c, 'p, 'tcx> {
     /// generated foreign wrappers' `Clone`/`Drop` impls, so the symbols must
     /// stay external for the linked bitcode to resolve them. For `Nat` /
     /// `Int` (`reussir_rt::rcgmp::Mpz`) they are `rcgmp.retain` and
-    /// `rcgmp.release`, whose lowering tests for an immediate inline.
-    pub(super) fn ffi_rc_glue_pair(
-        &self,
-        glue: &mir::FfiRcGlue<'tcx>,
-    ) -> Result<[Operation<'c>; 2]> {
+    /// `rcgmp.release`, whose lowering tests for an immediate inline, and a
+    /// third function answers `Mpz::is_shared` (`rcgmp_is_unique_glue`).
+    pub(super) fn ffi_rc_glue(&self, glue: &mir::FfiRcGlue<'tcx>) -> Result<Vec<Operation<'c>>> {
         let loc = Location::unknown(self.context);
         let ty = self.tys.mlir_ty(glue.ty)?;
         // The rcgmp glue has fixed names, which every module using `Nat` or
@@ -621,10 +619,65 @@ impl<'c, 'p, 'tcx> Lowerer<'c, 'p, 'tcx> {
                 loc,
             ))
         };
-        Ok([
+        let mut functions = vec![
             build(self.program.symbol(glue.acquire), true)?,
             build(self.program.symbol(glue.release), false)?,
-        ])
+        ];
+        if glue.ty.bigint().is_some() {
+            functions.push(self.rcgmp_is_unique_glue(ty, &attributes)?);
+        }
+        Ok(functions)
+    }
+
+    /// `__reussir_rcgmp_ffi_is_unique(x) -> u8`: 1 when the borrowed handle
+    /// `x` is an immediate or the only reference of a heap integer, 0 when
+    /// another reference holds it or it is immortal (`rcgmp.bridge.mpz.
+    /// is_unique`, which only a heap handle may take). It returns a byte
+    /// rather than an `i1`, as the borrowed comparison entries do, so that
+    /// the C ABI's value is defined.
+    fn rcgmp_is_unique_glue(
+        &self,
+        ty: Type<'c>,
+        attributes: &[(Identifier<'c>, Attribute<'c>)],
+    ) -> Result<Operation<'c>> {
+        let loc = Location::unknown(self.context);
+        let i1: Type<'c> = IntegerType::new(self.context, 1).into();
+        let byte: Type<'c> = IntegerType::new(self.context, 8).into();
+        let block = Block::new(&[(ty, loc)]);
+        let arg: Value<'c, '_> = block
+            .argument(0)
+            .map_err(|e| LoweringError(format!("missing glue argument: {e}").into()))?
+            .into();
+        let immediate = self.append(&block, rcgmp::is_immediate(self.context, arg, loc));
+        let then_block = Block::new(&[]);
+        let unique = self.append(
+            &then_block,
+            arith::constant(self.context, IntegerAttribute::new(i1, 1).into(), loc),
+        );
+        then_block.append_operation(scf::r#yield(&[unique], loc));
+        let then_region = Region::new();
+        then_region.append_block(then_block);
+        let else_block = Block::new(&[]);
+        let unique = self.append(&else_block, rcgmp::is_unique(self.context, arg, loc));
+        else_block.append_operation(scf::r#yield(&[unique], loc));
+        let else_region = Region::new();
+        else_region.append_block(else_block);
+        let unique = self.append(
+            &block,
+            scf::r#if(immediate, &[i1], then_region, else_region, loc),
+        );
+        let result = self.append(&block, arith::extui(unique, byte, loc));
+        block.append_operation(func::r#return(&[result], loc));
+        let region = Region::new();
+        region.append_block(block);
+        Ok(func::func(
+            self.context,
+            StringAttribute::new(self.context, reussir_core::full::ffi::RCGMP_IS_UNIQUE),
+            TypeAttribute::new(FunctionType::new(self.context, &[ty], &[byte]).into()),
+            region,
+            attributes,
+            loc,
+        ))
     }
 
     /// Build one borrowed comparison entry. The foreign caller retains both
