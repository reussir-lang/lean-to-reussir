       refcntPtr = adaptor.getRcPtr();
+      if (taggedCont)
+        refcntPtr = taggedBoxAddress(
+            rewriter, op.getLoc(), refcntPtr,
+            static_cast<const mlir::LLVMTypeConverter *>(getTypeConverter())
+                ->getIndexType());
     } else {
       RcBoxType rcBoxType = rcPtrTy.getInnerBoxType();
       // GEP [0].1
