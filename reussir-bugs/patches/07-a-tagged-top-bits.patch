+++ b/include/Reussir/IR/ReussirTypes.td
@@ -741,7 +741,10 @@ def ReussirFFIObjectType : ReussirType<"FFIObject", "ffi_object",
     operation may access the refcount. The foreign type must be a
     pointer-sized scalar that promises neither alignment nor
     dereferenceability: an integer or a raw pointer, not a reference, a
-    `Box`, or an `Option` of one.
+    `Box`, or an `Option` of one. On 64-bit targets the foreign side may keep
+    data in the top 16 bits of a handle that is not an immediate: `rc.inc`
+    clears them before it accesses the refcount, and the cleanup hook gets
+    the handle unchanged.
   }];
   let parameters = (ins "::mlir::StringAttr":$ffiName,
       "::mlir::FlatSymbolRefAttr":$cleanupHook,
@@ -754,6 +757,12 @@ def ReussirFFIObjectType : ReussirType<"FFIObject", "ffi_object",
   ];
   let assemblyFormat =
       "`<` $ffiName `,` $cleanupHook (`,` `tagged` `=` $tagged^)? `>`";
+  let extraClassDeclaration = [{
+    /// The address width of a tagged handle on 64-bit targets; the bits
+    /// above it belong to the foreign side. Assumes that every box lies
+    /// below 2^48 and carries no address tag of its own (TBI, MTE).
+    static constexpr unsigned TAGGED_ADDRESS_BITS = 48;
+  }];
 }
 
 def ReussirStrType : ReussirType<"Str", "str",
diff --git a/lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp b/lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp
index 7f8a8128..e757203e 100644
--- a/lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp
+++ b/lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp
@@ -299,6 +299,23 @@ void endRealBoxGuard(mlir::ConversionPatternRewriter &rewriter,
   rewriter.setInsertionPointToStart(contBlock);
 }
 
+// The box address of a tagged FFI handle that is not an immediate: the
+// handle without the top bits, which belong to the foreign side on 64-bit
+// targets.
+mlir::Value taggedBoxAddress(mlir::ConversionPatternRewriter &rewriter,
+                             mlir::Location loc, mlir::Value ptr,
+                             mlir::Type indexTy) {
+  auto intTy = llvm::cast<mlir::IntegerType>(indexTy);
+  if (intTy.getWidth() != 64)
+    return ptr;
+  mlir::Value mask = mlir::LLVM::ConstantOp::create(
+      rewriter, loc, intTy,
+      rewriter.getIntegerAttr(
+          intTy, llvm::APInt::getLowBitsSet(
+                     64, FFIObjectType::TAGGED_ADDRESS_BITS)));
+  return mlir::LLVM::PtrMaskOp::create(rewriter, loc, ptr.getType(), ptr, mask);
+}
+
 void ensureRuntimeFunctions(mlir::ModuleOp module,
                             const mlir::LLVMTypeConverter &converter);
 
@@ -1732,6 +1749,11 @@ struct ReussirRcIncConversionPattern
     // the struct.
