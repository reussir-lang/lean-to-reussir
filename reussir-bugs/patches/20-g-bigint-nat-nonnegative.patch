@@ -0,0 +1,38 @@
+// The divisions of `Nat`s are `nonnegative`: their immediates untag by a
+// logical shift and divide unsigned. An `Int` division divides signed. Each
+// function's checks run as their own prefix, independent of the order of the
+// functions.
+
+// REQUIRES: rcgmp
+// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
+// RUN: %rrc %s --package-name bigint --extern core=%t.core.rri -t llvm-ir -Oaggressive -o %t.ll
+// RUN: %FileCheck %s --check-prefix=NATDIV --input-file=%t.ll
+// RUN: %FileCheck %s --check-prefix=NATREM --input-file=%t.ll
+// RUN: %FileCheck %s --check-prefix=INTDIV --input-file=%t.ll
+
+pub fn nat_div(x : Nat, m : Nat) -> Nat { x / m }
+
+pub fn nat_rem(x : Nat, m : Nat) -> Nat { core::intrinsic::bigint::remsi_lean(x, m) }
+
+pub fn int_div(x : Int, m : Int) -> Int { x / m }
+
+// NATDIV: define {{.*}}@{{.*}}7nat_div(
+// NATDIV-NOT: sdiv
+// NATDIV: lshr i64 %{{[0-9]+}}, 2
+// NATDIV: udiv i64
+// NATDIV-NOT: sdiv
+// NATDIV: {{^}}}
+
+// NATREM: define {{.*}}@{{.*}}7nat_rem(
+// NATREM-NOT: srem
+// NATREM: lshr i64 %{{[0-9]+}}, 2
+// NATREM: urem i64
+// NATREM-NOT: srem
+// NATREM: {{^}}}
+
+// INTDIV: define {{.*}}@{{.*}}7int_div(
+// INTDIV-NOT: udiv
+// INTDIV: ashr i64 %{{[0-9]+}}, 2
+// INTDIV: sdiv i64
+// INTDIV-NOT: udiv
+// INTDIV: {{^}}}
