+; A call of `mix` in a block reached once in 2001 runs of the function: a
+; call site LLVM judges cold. The cost model alone keeps the call (cost 70,
+; threshold 45); with the attribute, the texture is inlined.
+; O3-LABEL: define i64 @deep(
+; O3-NOT: call {{.*}}@mix
+; O3: call i64 @slow(
+; O3-NOT: call {{.*}}@mix
+; NOPASS-LABEL: define i64 @deep(
+; NOPASS: call i64 @mix(i64 %n)
+define i64 @deep(i64 %n) {
+entry:
+  %c = icmp ult i64 %n, 3
+  br i1 %c, label %rare, label %done, !prof !0
+
+rare:
+  %r = call i64 @mix(i64 %n)
+  ret i64 %r
+
+done:
+  ret i64 %n
+}
