diff --git a/tests/integration/frontend/ffi_import_inline_cold.rr b/tests/integration/frontend/ffi_import_inline_cold.rr
new file mode 100644
index 00000000..8cf49077
--- /dev/null
+++ b/tests/integration/frontend/ffi_import_inline_cold.rr
@@ -0,0 +1,63 @@
+// UNSUPPORTED: darwin, windows
+// A small texture is inlined at a call site that LLVM judges cold: its
+// import trampoline and its boundary function are `alwaysinline`
+// (ImportTrampolineInlinePass). Without the attribute, LLVM inlines a
+// trampoline at such a site only below a cost of 45; `mix` costs more
+// (about 70), so the call in `deep`, under seven conditions that LLVM's
+// branch heuristics expect false, stayed a call. %t/rustc compiles the
+// textures for the CPU rrc compiles for: with other target features, LLVM
+// inlines no texture at all.
+
+// RUN: rm -rf %t && mkdir -p %t
+// RUN: printf '#!/bin/sh\nexec "$REAL_RUSTC" "$@" -C target-cpu=native -C target-feature=-outline-atomics\n' > %t/rustc
+// RUN: chmod +x %t/rustc
+// RUN: env REAL_RUSTC=%rustc_path %rrc %s --polyffi-rust-path %t/rustc \
+// RUN:   --emit llvm-ir -O aggressive -o %t/aggressive.ll
+// RUN: %FileCheck %s --implicit-check-not='call {{.*}}@_RC3mix(' < %t/aggressive.ll
+// RUN: env REAL_RUSTC=%rustc_path %rrc %s --polyffi-rust-path %t/rustc \
+// RUN:   --emit llvm-ir -O default -o %t/default.ll
+// RUN: %FileCheck %s --implicit-check-not='call {{.*}}@_RC3mix(' < %t/default.ll
+
+// CHECK: define {{.*}} @_RC3mix(i64 {{.*}}#[[TRAMPOLINE:[0-9]+]]
+// CHECK: define weak_odr {{.*}} @_RC3mix_ffi(i64 {{.*}}#[[BOUNDARY:[0-9]+]]
+// CHECK-DAG: attributes #[[TRAMPOLINE]] = { {{.*}}alwaysinline{{.*}}"reussir-import-boundary"="_RC3mix_ffi"
+// CHECK-DAG: attributes #[[BOUNDARY]] = { {{.*}}alwaysinline
+
+#[ffi(import)]
+fn say(x : u64) [{ println!("{}", x) }];
+#[ffi(import)]
+fn seed() -> u64 [{ std::hint::black_box(20u64) }];
+#[ffi(import)]
+fn mix(x : u64) -> u64 [{
+    {
+        #[cold]
+        #[inline(never)]
+        fn slow(x: u64) -> u64 { std::hint::black_box(x) }
+        let y = x.wrapping_mul(0x9E3779B97F4A7C15) ^ (x >> 7);
+        let z = y.wrapping_add(x >> 11).wrapping_mul(0xBF58476D1CE4E5B9);
+        if z & 1023 == 0 { slow(z) } else { z.rotate_left(13) ^ (z >> 3) ^ (z >> 29) }
+    }
+}];
+
+fn deep(n : u64) -> u64 {
+    if n % 2 != 0 { n } else {
+        if n % 3 != 0 { n + 1 } else {
+            if n % 5 != 0 { n + 2 } else {
+                if n % 7 != 0 { n + 3 } else {
+                    if n % 11 != 0 { n + 4 } else {
+                        if n % 13 != 0 { n + 5 } else {
+                            if n % 17 != 0 { n + 6 } else { mix(n) }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[main]
+fn main() {
+    let s = seed();
+    say(mix(s));
+    say(deep(s * 25525 + 510510));
+}
diff --git a/tests/integration/llvmpass/import_trampoline_inline.ll b/tests/integration/llvmpass/import_trampoline_inline.ll
new file mode 100644
index 00000000..c4833588
--- /dev/null
+++ b/tests/integration/llvmpass/import_trampoline_inline.ll
@@ -0,0 +1,254 @@
+; RUN: %reussir-llvm-opt --passes=reussir-import-trampoline-inline %s -o - \
+; RUN:   | %FileCheck %s
+; RUN: %reussir-llvm-opt --passes='reussir-import-trampoline-inline,default<O3>' \
+; RUN:   %s -o - | %FileCheck %s --check-prefix=O3
+; RUN: %reussir-llvm-opt --passes='default<O3>' %s -o - \
+; RUN:   | %FileCheck %s --check-prefix=NOPASS
+
+; An import trampoline (the function Reussir code calls) packs its arguments
+; and calls its texture's boundary function (`*_ffi`, from the texture's
+; bitcode); the attribute "reussir-import-boundary" names that function.
+; When the boundary function's inline cost is at most the inline threshold
+; (here LLVM's default, 225) and LLVM may inline it, both functions become
+; `alwaysinline`; otherwise both stay as they are.
+
+declare i64 @slow(i64) cold noinline
+declare i64 @ext_c(i64)
+
+; A small texture: some arithmetic and a cold call. Its cost (about 70) is
+; above the threshold of a cold call site (45).
+; CHECK: define weak_odr i64 @mix_ffi(i64 %x) #[[MIX_FFI:[0-9]+]] {
+define weak_odr i64 @mix_ffi(i64 %x) nounwind {
+start:
+  %y0 = mul i64 %x, -7046029254386353131
+  %s7 = lshr i64 %x, 7
+  %y = xor i64 %y0, %s7
+  %s11 = lshr i64 %x, 11
+  %z0 = add i64 %y, %s11
+  %z = mul i64 %z0, -4658895280553007687
+  %low = and i64 %z, 1023
+  %rare = icmp eq i64 %low, 0
+  br i1 %rare, label %slow, label %fast
+
+slow:
+  %r = call i64 @slow(i64 %z)
+  ret i64 %r
+
+fast:
+  %rot = call i64 @llvm.fshl.i64(i64 %z, i64 %z, i64 13)
+  %s3 = lshr i64 %z, 3
+  %s29 = lshr i64 %z, 29
+  %t = xor i64 %rot, %s3
+  %u = xor i64 %t, %s29
+  ret i64 %u
+}
+
+; CHECK: define i64 @mix(i64 %x) #[[MIX:[0-9]+]] {
+define i64 @mix(i64 %x) "reussir-import-boundary"="mix_ffi" {
+  %r = call i64 @mix_ffi(i64 %x)
+  ret i64 %r
+}
+
+; A small texture behind the packed boundary: the arguments in one stack
+; slot, the result in another.
+; CHECK: define weak_odr void @pair_ffi(ptr %ret, ptr %args) #[[PAIR_FFI:[0-9]+]] {
+define weak_odr void @pair_ffi(ptr %ret, ptr %args) nounwind willreturn {
+start:
+  %a = load i64, ptr %args, align 8
+  %bp = getelementptr inbounds { i64, double }, ptr %args, i64 0, i32 1
+  %b = load double, ptr %bp, align 8
+  %af = sitofp i64 %a to double
+  %s = fmul double %af, %b
+  %t = fadd double %s, %b
+  %u = fdiv double %t, %af
+  store double %u, ptr %ret, align 8
+  ret void
+}
+
+; CHECK: define double @pair(i64 %a, double %b) #[[PAIR:[0-9]+]] {
+define double @pair(i64 %a, double %b) "reussir-import-boundary"="pair_ffi" {
+  %ret = alloca double, align 8
+  %args = alloca { i64, double }, align 8
+  store i64 %a, ptr %args, align 8
+  %bp = getelementptr inbounds { i64, double }, ptr %args, i64 0, i32 1
+  store double %b, ptr %bp, align 8
+  call void @pair_ffi(ptr %ret, ptr %args)
+  %r = load double, ptr %ret, align 8
+  ret double %r
+}
+
