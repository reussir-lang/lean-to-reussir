diff --git a/docs/design/polymorphic-ffi.md b/docs/design/polymorphic-ffi.md
index a9ef111a..ee4070aa 100644
--- a/docs/design/polymorphic-ffi.md
+++ b/docs/design/polymorphic-ffi.md
@@ -308,6 +308,22 @@ the space. `translateToModule` links the
 gathered bitcode into the final LLVM module. The JIT/REPL path does not
 gather polyffi modules yet and rejects programs containing them.
 
+Each import trampoline names its boundary function in the LLVM function
+attribute `reussir-import-boundary`. At `-O default` and `-O aggressive`,
+the first pass of the LLVM pipeline, `ImportTrampolineInlinePass`
+(`lib/LLVMPass/AllocationSimplication/ImportTrampolineInline.cpp`), takes
+the inline cost of the linked boundary function at its call in the
+trampoline. When that cost is at most the pipeline's inline threshold (225;
+250 at `-O aggressive`) and LLVM may inline the call, the boundary function
+and the trampoline both become `alwaysinline`, so the texture is inlined at
+every call site. Without the attribute, LLVM inlines at a call site that it
+judges cold (rare relative to the caller's entry) only below a cost of 45,
+and `inlinehint` does not change that threshold: a texture inlined at an
+ordinary call site stayed a call, with its argument packing, at a cold one.
+Larger textures, textures LLVM judges `cold`, `noinline` ones and textures
+compiled for other target features keep the cost model's decision, and
+`-O size` runs no such pass.
+
 ## Implementation map
 
 * surface/parsing: `crates/reussir-syntax` (`ExternSourceStmt`, foreign
@@ -327,4 +343,5 @@ gather polyffi modules yet and rejects programs containing them.
   `ffi_object` types, polyffi/trampoline emission, lifecycle glue, borrowed
   comparison entries, and hook functions);
 * MLIR: `reussir.trampoline` import direction materializes the native
-  marshaling body (`lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp`).
+  marshaling body (`lib/Conversion/BasicOpsLowering/BasicOpsLowering.cpp`)
+  and names the boundary function for `ImportTrampolineInlinePass`.
diff --git a/include/Reussir/LLVMPass/ImportTrampolineInline.h b/include/Reussir/LLVMPass/ImportTrampolineInline.h
new file mode 100644
index 00000000..4b3e89da
--- /dev/null
+++ b/include/Reussir/LLVMPass/ImportTrampolineInline.h
@@ -0,0 +1,51 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// This pass marks small polymorphic-FFI textures `alwaysinline`, together
+/// with their import trampolines.
+///
+/// An import trampoline (`rewriteImport` in BasicOpsLowering.cpp) only packs
+/// its arguments and calls the texture's boundary function, which the linked
+/// texture bitcode defines. Neither carries an inline attribute of its own, so
+/// LLVM inlines them into a caller by its cost model alone, and at a call site
+/// it judges cold (rare relative to the caller's entry) only below the
+/// cold-call-site threshold (45): a texture that LLVM inlines at an ordinary
+/// call site stays a call there, with its argument packing. When the boundary
+/// function's inline cost (measured at its one call, in the trampoline) is at
+/// most `threshold` (the backend passes the default pipeline's own inline
+/// threshold) and LLVM could inline it, both functions get `alwaysinline`:
+/// the texture is then inlined at every call site, as at an ordinary one.
+/// Larger textures keep the cost model's decision.
+///
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include <llvm/IR/PassManager.h>
+
+namespace reussir::llvmpass {
+
+/// The string function attribute that marks an import trampoline; its value
+/// is the name of the boundary function the trampoline calls.
+inline constexpr const char *kImportBoundaryAttr = "reussir-import-boundary";
+
+class ImportTrampolineInlinePass
+    : public llvm::PassInfoMixin<ImportTrampolineInlinePass> {
+public:
+  explicit ImportTrampolineInlinePass(int threshold) : threshold(threshold) {}
+  llvm::PreservedAnalyses run(llvm::Module &module,
+                              llvm::ModuleAnalysisManager &);
+
+private:
+  int threshold;
+};
+
+} // namespace reussir::llvmpass
