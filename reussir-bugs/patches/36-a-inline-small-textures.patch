diff --git a/lib/LLVMPass/AllocationSimplication/ImportTrampolineInline.cpp b/lib/LLVMPass/AllocationSimplication/ImportTrampolineInline.cpp
new file mode 100644
index 00000000..d83ba6fc
--- /dev/null
+++ b/lib/LLVMPass/AllocationSimplication/ImportTrampolineInline.cpp
@@ -0,0 +1,112 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the Reussir Project, dual licensed under the Apache License v2.0 or
+// the MIT License.
+// See https://github.com/reussir-lang/reussir/blob/main/LICENSE for license
+// information.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// This file implements the marking of small polymorphic-FFI textures and
+/// their import trampolines as `alwaysinline` (see the header).
+///
+//===----------------------------------------------------------------------===//
+
+#include "Reussir/LLVMPass/ImportTrampolineInline.h"
+
+#include <optional>
+
+#include <llvm/Analysis/AssumptionCache.h>
+#include <llvm/Analysis/InlineCost.h>
+#include <llvm/Analysis/TargetLibraryInfo.h>
+#include <llvm/Analysis/TargetTransformInfo.h>
+#include <llvm/IR/Attributes.h>
+#include <llvm/IR/Function.h>
+#include <llvm/IR/InstIterator.h>
+#include <llvm/IR/Instructions.h>
+#include <llvm/IR/Module.h>
+
+namespace reussir::llvmpass {
+namespace {
+
+/// The trampoline's call of its boundary function, if there is one.
+llvm::CallBase *boundaryCall(llvm::Function &trampoline,
+                             llvm::Function &boundary) {
+  for (llvm::Instruction &inst : llvm::instructions(trampoline))
+    if (auto *call = llvm::dyn_cast<llvm::CallBase>(&inst))
+      if (call->getCalledFunction() == &boundary)
+        return call;
+  return nullptr;
+}
+
+} // namespace
+
+llvm::PreservedAnalyses
+ImportTrampolineInlinePass::run(llvm::Module &module,
+                                llvm::ModuleAnalysisManager &mam) {
+  auto &fam =
+      mam.getResult<llvm::FunctionAnalysisManagerModuleProxy>(module)
+          .getManager();
+  auto getAssumptionCache = [&](llvm::Function &f) -> llvm::AssumptionCache & {
+    return fam.getResult<llvm::AssumptionAnalysis>(f);
+  };
+  auto getTLI = [&](llvm::Function &f) -> const llvm::TargetLibraryInfo & {
+    return fam.getResult<llvm::TargetLibraryAnalysis>(f);
+  };
+
+  bool changed = false;
+  for (llvm::Function &trampoline : module) {
+    llvm::Attribute marker = trampoline.getFnAttribute(kImportBoundaryAttr);
+    if (!marker.isStringAttribute() || trampoline.isDeclaration())
+      continue;
+    // `alwaysinline` and `noinline` exclude each other (optnone implies
+    // noinline).
+    if (trampoline.hasFnAttribute(llvm::Attribute::NoInline))
+      continue;
+    // The boundary function has a body only when the texture's bitcode is
+    // linked in; a boundary defined elsewhere (a C function) cannot be
+    // measured.
+    llvm::Function *boundary = module.getFunction(marker.getValueAsString());
+    if (!boundary || boundary->isDeclaration())
+      continue;
+    llvm::CallBase *call = boundaryCall(trampoline, *boundary);
+    if (!call)
+      continue;
+    // A texture that LLVM judges cold (it only reaches cold code) stays out
+    // of line.
+    if (boundary->hasFnAttribute(llvm::Attribute::Cold))
+      continue;
+    llvm::TargetTransformInfo &tti =
+        fam.getResult<llvm::TargetIRAnalysis>(*boundary);
+    // LLVM's own legality checks for this call: incompatible target features
+    // or other attributes, `noinline`, a boundary that the linker may replace
+    // (`weak`, `linkonce`; the textures' `weak_odr` is not). Success means the
+    // boundary is `alwaysinline` already.
+    std::optional<llvm::InlineResult> decision =
+        llvm::getAttributeBasedInliningDecision(*call, boundary, tti, getTLI);
+    if (decision && !decision->isSuccess())
+      continue;
+    if (!decision) {
+      if (!llvm::isInlineViable(*boundary).isSuccess())
+        continue;
+      // The cost of inlining the boundary function into the trampoline:
+      // its body, less what the call itself costs. The packed arguments
+      // live in the trampoline's stack slots, which the analysis counts as
+      // free once inlined (SROA).
+      std::optional<int> cost =
+          llvm::getInliningCostEstimate(*call, tti, getAssumptionCache,
+                                        /*GetBFI=*/nullptr, getTLI);
+      if (!cost || *cost > threshold)
+        continue;
+      boundary->addFnAttr(llvm::Attribute::AlwaysInline);
+    }
+    trampoline.addFnAttr(llvm::Attribute::AlwaysInline);
+    changed = true;
+  }
+  return changed ? llvm::PreservedAnalyses::none()
+                 : llvm::PreservedAnalyses::all();
+}
+
+} // namespace reussir::llvmpass
