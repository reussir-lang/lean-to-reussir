// Bug 7, variant: the bug07-phantom-reuse-donor.rr program with its key
// comparisons made FFI calls (`less`). The call before the branch stops patch
// 0007's fusion (fuseArm's scan stops at a call), so this shows what token
// reuse does on a build that has 0006 but where 0007 cannot fire.
// Output: "<size> <size> ratio <t(ins) / t(ins_b)>", as in bug07.
// Measured 2026-10-02 on l2r-local (loaded machine) with
//   rrc bug07b-call-before-branch.rr -O aggressive --no-pack-record-members
//       --reuse-across-call [--nullary-variant-encoding E]
//       --token-reuse-remarks OUT.json  (+ the polymorphic-FFI flags):
//   default (TBI) and arch-independent: ratio 1.34-2.08; TokenReuse sees one
//     token at each rebuild in ins (t's cell) and reuses it (ensure, score 2);
//   boxed (no immediates, so no 0006 guard): ratio 5.61-11.37; three tokens
//     available, and the rebuilds take a phantom donor (realloc, score 0).
#[ffi(import)]
fn less(a : u64, b : u64) -> bool [{ a < b }];
enum Tr { Leaf, Node(Tr, u64, Tr) }
fn ins(t : Tr, k : u64) -> Tr {
    match t {
        Tr::Leaf => { Tr::Node{Tr::Leaf{}, k, Tr::Leaf{}} },
        Tr::Node(l, x, r) => {
            let c : bool = less(k, x);
            if c { Tr::Node{ins(l, k), x, r} }
            else { if less(x, k) { Tr::Node{l, x, ins(r, k)} } else { t } }
        }
    }
}
fn ins_b(t : Tr, k : u64) -> Tr {
    match t {
        Tr::Leaf => { Tr::Node{Tr::Leaf{}, k, Tr::Leaf{}} },
        Tr::Node(l, x, r) => {
            let c : bool = less(k, x);
            if c { Tr::Node{ins_b(l, k), x, r} }
            else { if less(x, k) { Tr::Node{l, x, ins_b(r, k)} } else { Tr::Node{l, x, r} } }
        }
    }
}
fn size(t : Tr) -> u64 {
    match t { Tr::Leaf => { 0 }, Tr::Node(l, x, r) => { size(l) + 1 + size(r) } }
}
fn loop_(t : Tr, i : u64, n : u64) -> Tr {
    if i == n { t } else { loop_(ins(t, (i * 7919) % 100003), i + 1, n) }
}
fn loop_b(t : Tr, i : u64, n : u64) -> Tr {
    if i == n { t } else { loop_b(ins_b(t, (i * 7919) % 100003), i + 1, n) }
}
#[ffi(import)]
fn now() -> u64 [{ std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos() as u64 }];
#[ffi(import)]
fn report(a : u64, b : u64, ta : u64, tb : u64) [{ println!("{} {} ratio {:.2}", a, b, ta as f64 / tb as f64) }];
#[main]
fn main() {
    let t0 = now();
    let a = size(loop_(loop_(Tr::Leaf{}, 0, 100003), 0, 3000000));
    let t1 = now();
    let b = size(loop_b(loop_b(Tr::Leaf{}, 0, 100003), 0, 3000000));
    let t2 = now();
    report(a, b, t1 - t0, t2 - t1);
}
