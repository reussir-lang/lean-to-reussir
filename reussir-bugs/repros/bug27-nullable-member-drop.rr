// Issue 27 (missing feature): releasing a long chain linked through a Nullable
// member recurses once per link and overflows the stack. Inside drop glue a
// plain member box is released through the thread's pending stack (patches
// 0013-0015), so a chain is freed in a loop; a Nullable<shared record> member
// was released by a plain rc.dec (AcquireDropExpansion.cpp,
// rewriteDropNullable), which recurses into the next link's glue.
// `build(n)` makes a chain of n `B` cells, each linking to the next through
// `A [value] { b: Nullable<B>, .. }`; `first_k` reads the head, and the
// chain is released when its last reference goes.
// Expected (n = 1000000, 8 MB stack): prints 1. Reussir ef922049 with
// patches 0013-0015 (91da4f80): the program aborts, "thread 'main' has
// overflowed its stack" (drop_in_place::<A> recursing), at -O default and
// -O aggressive; the same chain through a plain shared enum frees 3000000
// links.
struct [shared] S(u64)
struct [value] A { b: Nullable<B>, s: S, n: u64 }
struct B { a: A, k: u64 }

#[ffi(import)]
fn say(x : u64) [{ println!("{}", x) }];
#[ffi(import)]
fn links() -> u64 [{ std::hint::black_box(1000000u64) }];

fn build(n : u64, acc : Nullable<B>) -> Nullable<B> {
    if n == 0 { acc } else {
        build(n - 1, Nullable::NonNull{B { a: A { b: acc, s: S{n}, n: n * 2 }, k: n }})
    }
}
fn first_k(l : Nullable<B>) -> u64 {
    match l { Nullable::NonNull(x) => x.k, Nullable::Null => 0 }
}

#[main]
fn main() { say(first_k(build(links(), Nullable::Null))); }
