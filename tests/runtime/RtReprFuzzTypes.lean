def Tr.map {α β : Type} (f : α → β) : Tr α → Tr β
  | .leaf => .leaf
  | .node l k r => .node (l.map f) (f k) (r.map f)
def Tr.mirror {α : Type} : Tr α → Tr α
  | .leaf => .leaf
  | .node l k r => .node r.mirror k l.mirror
def Tr.toList {α : Type} : Tr α → List α
  | .leaf => []
  | .node l k r => l.toList ++ [k] ++ r.toList
structure Pkg where
  α : Type
