@[noinline] def pk (p : Pkg) : String := p.s (p.f (p.f p.v)) ++ " | " ++ p.s p.v
def goX {α β : Type} (n : Nat) (x : α) (b : β) (f : α → α) (k : α → String) : String :=
  match n with
  | 0 => k (f x) ++ " / " ++ k x
  | n+1 => goX n x (b, b) f k
def goA {α β : Type} (n : Nat) (x : Array α) (b : β) (f : α → α) (k : α → String) : String :=
  match n with
  | 0 => let y := x.map f; String.intercalate "; " ((match x[0]? with | some h => y.push h | none => y).toList.map k) ++ s!" #{y.size}"
  | n+1 => goA n x (b, b) f k
def goL {α β : Type} (n : Nat) (x : List α) (b : β) (f : α → α) (k : α → String) : String :=
  match n with
  | 0 => String.intercalate "; " ((x.map f ++ x).map k)
  | n+1 => goL n x (b, b) f k
def goR {α β : Type} (n : Nat) (r : IO.Ref α) (b : β) (f : α → α) : IO Unit :=
  match n with
  | 0 => r.modify f
  | n+1 => goR n r (b, b) f

