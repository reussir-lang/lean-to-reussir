/-! Runtime test: a declaration that starts past column 100000 of its line
still starts before the declarations of the next line. -/

def t (s : String) (n : Nat) : Nat := dbgTrace s fun _ => n

def before : Nat := t "before" 0

def long : String := ""  def after : Nat := t "after (same long line)" 1
def next : Nat := t "next (line after the long one)" 2

def main : IO Unit := IO.println s!"{before} {long.length} {after} {next}"
