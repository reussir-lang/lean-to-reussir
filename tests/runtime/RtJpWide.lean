/-! Runtime test: a join point with many jumps is not copied to each of
them (translation plan §5.6, J1'). An 800-arm `match` on a number, each arm
setting a three-constructor state (any other number returns early), then
three `match`es on the state. Lean makes every arm jump straight to an
alternative of the next `match`; the early return keeps those join points
from being J2. Each is small, but when only one copy was bounded, it was
copied into all 800 arms: 11.7 MB of .rr, and rrc ran out of memory at
16 GB. lean2rr now bounds what all the copies add, so these join points
are outlined (0.6 MB of .rr). -/

inductive RtJpWideS where
  | a
  | b
  | c

@[noinline] def run (sel : Nat) (x0 : Nat) : Nat := Id.run do
  let mut s : RtJpWideS := .a
  let mut x := x0
  match sel with
  | 0 => x := x * 2 + 0; s := .a
  | 1 => x := x * 3 + 1; s := .b
  | 2 => x := x * 4 + 2; s := .c
