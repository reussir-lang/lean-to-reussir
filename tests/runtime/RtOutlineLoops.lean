/-! Runtime test: functions long enough for lean2rr to cut into parts
(`Outline`, translation plan §10 "Build time"), recursive ones included,
whose loops must stay loops: `RtOutlineLoops.pipe` runs the self-recursive
loops with a 1 MiB stack (`LEAN_STACK_SIZE_KB=1024`), where a loop through
the parts that used stack per iteration would overflow.
- `loopMatch`: a self-recursive function whose body is a 40-arm literal
  match (40 nested `if`s), every arm a tail call;
- `ioLoop`: a recursive IO function with 300 statements (each bind nests a
  match) ending in its tail call;
- `longLets`: a recursive function with a straight-line body of about 900
  `Nat` operations;
- `ping`/`pong`: mutual recursion with deep bodies, the tail calls to each
  other in the parts;
- `letMatch`: a 40-arm match as the value of a `let`, not in tail position.
-/
set_option maxRecDepth 100000
set_option maxHeartbeats 0

partial def loopMatch (n acc : Nat) : Nat :=
  if n == 0 then acc else
  match n % 41 with
  | 0 => loopMatch (n - 1) (acc + 0)
  | 1 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 2 => loopMatch (n - 1) (acc + n % 3)
  | 3 => loopMatch (n - 1) ((acc + 9) % 999983)
  | 4 => loopMatch (n - 1) (acc + 4)
  | 5 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 6 => loopMatch (n - 1) (acc + n % 7)
  | 7 => loopMatch (n - 1) ((acc + 49) % 999983)
  | 8 => loopMatch (n - 1) (acc + 8)
  | 9 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 10 => loopMatch (n - 1) (acc + n % 11)
  | 11 => loopMatch (n - 1) ((acc + 121) % 999983)
  | 12 => loopMatch (n - 1) (acc + 12)
  | 13 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 14 => loopMatch (n - 1) (acc + n % 15)
  | 15 => loopMatch (n - 1) ((acc + 225) % 999983)
  | 16 => loopMatch (n - 1) (acc + 16)
  | 17 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 18 => loopMatch (n - 1) (acc + n % 19)
  | 19 => loopMatch (n - 1) ((acc + 361) % 999983)
  | 20 => loopMatch (n - 1) (acc + 20)
  | 21 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 22 => loopMatch (n - 1) (acc + n % 23)
  | 23 => loopMatch (n - 1) ((acc + 529) % 999983)
  | 24 => loopMatch (n - 1) (acc + 24)
  | 25 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 26 => loopMatch (n - 1) (acc + n % 27)
  | 27 => loopMatch (n - 1) ((acc + 729) % 999983)
  | 28 => loopMatch (n - 1) (acc + 28)
  | 29 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 30 => loopMatch (n - 1) (acc + n % 31)
  | 31 => loopMatch (n - 1) ((acc + 961) % 999983)
  | 32 => loopMatch (n - 1) (acc + 32)
  | 33 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 34 => loopMatch (n - 1) (acc + n % 35)
  | 35 => loopMatch (n - 1) ((acc + 1225) % 999983)
  | 36 => loopMatch (n - 1) (acc + 36)
  | 37 => loopMatch (n - 1) (acc * 3 % 1000003)
  | 38 => loopMatch (n - 1) (acc + n % 39)
  | 39 => loopMatch (n - 1) ((acc + 1521) % 999983)
  | _ => loopMatch (n - 1) (acc + 5)

