    | 16 => n * 19 + 16
    | 17 => n * 20 + 17
    | 18 => n * 21 + 18
    | 19 => n * 22 + 19
    | 20 => n * 23 + 20
    | 21 => n * 24 + 21
    | 22 => n * 25 + 22
    | 23 => n * 26 + 23
    | 24 => n * 27 + 24
    | 25 => n * 28 + 25
    | 26 => n * 29 + 26
    | 27 => n * 30 + 27
    | 28 => n * 31 + 28
    | 29 => n * 32 + 29
    | 30 => n * 33 + 30
    | 31 => n * 34 + 31
    | 32 => n * 35 + 32
    | 33 => n * 36 + 33
    | 34 => n * 37 + 34
    | 35 => n * 38 + 35
    | 36 => n * 39 + 36
    | 37 => n * 40 + 37
    | 38 => n * 41 + 38
    | 39 => n * 42 + 39
    | _ => n
  v * 2 + 1

def main (args : List String) : IO Unit := do
  match args with
  | ["loops", n] =>
    -- Run with a 1 MiB stack: constant stack per iteration.
    let n := n.toNat!
    IO.println s!"loopMatch: {loopMatch n 1}"
    let r ← IO.mkRef 0
    ioLoop r (n / 100)
    IO.println s!"ioLoop: {← r.get}"
    IO.println s!"longLets: {longLets 5 (n / 30)}"
  | _ =>
    IO.println s!"ping: {ping 100000 3}"
    let mut s := 0
    for i in [0:1000] do s := s + letMatch i
    IO.println s!"letMatch: {s}"
