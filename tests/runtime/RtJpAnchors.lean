@[noinline] def few (sel : Nat) (x0 : Nat) : Nat := Id.run do
  let mut x := x0
  match sel with
  | 0 => x := x * 2 + 1
  | 1 => x := x * 3 + 2
  | 2 => x := x * 5 + 3
  | 3 => x := x + 4
  | _ => return 7
  if x % 3 == 0 then x := x * 2 + 1 else if x % 3 == 1 then x := x * 3 + 2 else x := x + 5
  if x % 4 == 0 then x := x * 5 + 3 else if x % 4 == 1 then x := x * 7 + 4 else x := x + 6
  if x % 5 == 0 then x := x * 11 + 5 else if x % 5 == 1 then x := x * 13 + 6 else x := x + 7
  if x % 6 == 0 then x := x * 17 + 7 else if x % 6 == 1 then x := x * 19 + 8 else x := x + 8
  if x % 7 == 0 then return x + 1000 else if x % 7 == 1 then return x + 2000 else return x

def main : IO Unit := do
  let mut t := 0
  let mut u := 0
