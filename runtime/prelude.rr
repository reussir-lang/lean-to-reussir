// lean2rr runtime prelude.
//
// Prepended to every program lean2rr generates. A Lean extern whose C
// symbol is `lean_xxx` is implemented here by the function `lean_xxx`, on
// lean2rr's representation types, with the semantics of Lean's own C
// runtime (lean.h and src/runtime/*.cpp of Lean 4.34). `l2r_*` functions
// are primitives for lean2rr-generated glue (externs over Lean-defined
// types) and internal helpers. See runtime/README.md.
//
// Fast paths are plain Reussir code (inlined into the program); slow paths
// call small `#[ffi(import)]` textures, which call into the `leanrt` Rust
// crate (runtime/leanrt). Every call consumes its arguments.
//
// Conventions for FFI imports: only integers, floats, bool, opaque types and
// shared records cross the boundary; functions without a result return a
// dummy `u64`; no `str` parameters in hot paths (only literals use them).

extern "rust" [{
    extern crate leanrt;
    use leanrt::string::Utf8;
    use reussir_rt::rc::Rc;
}];

// ===========================================================================
// Runtime types

// Unit-like values (erased values, `PUnit`, the IO world). Reussir's own
// `unit` is result-only and cannot be stored or passed.
enum [value] L2RUnit {
    u
}

// A Lean `String`: valid UTF-8 bytes and the number of characters (Lean's
// `m_length`, kept by every operation), copy-on-write; one block like
// Lean's string object (`leanrt::string`).
#[ffi(rust = "::leanrt::string::LStr")]
pub struct LStr;

// A Lean `Nat` / `Int`: one word, Lean's own encoding (leanrt::nat). An odd
// word is a small value: `lean_box(n)` for a `Nat` below 2^63,
// `lean_box((unsigned)(int)i)` for an `Int` in the `int32` range. An even
// word is a reference to a big number, one block with the limbs inline
// (`leanrt::big`). `tagged` (local Reussir patch 0050): Reussir copies and
// drops them like any shared handle but counts only the even words, so a
// small value costs no allocation and its copy or drop is a bit test.
#[ffi(rust = "::leanrt::nat::LNat", tagged)]
pub struct Nat;

#[ffi(rust = "::leanrt::nat::LInt", tagged)]
pub struct Int;

// A Lean `Array` (and `ByteArray` = RVec<u8>, `FloatArray` = RVec<f64>):
// a copy-on-write vector, updated in place when unique. One block: the
// count, the size, the capacity and the elements (`leanrt::drop::Vec`,
// `leanrt::array`), freed without recursion (`leanrt::drop`).
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct RVec<T>;

// A shared runtime cell: a 0-or-1 element vector, mutated in place through
// every alias (empty after `take`). No longer used by generated code:
// references are lean2rr-generated records around a Reussir `Cell`
// (`l2r_rc_*` below), and promises hold an `LCell`.
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct LRef<T>;

// A mutable cell holding one value, mutated in place through every alias:
// the state of a `Thunk` or `Task` (lean2rr generates the state type).
// One allocation: the count and the value. (`leanrt::drop::Cell` wraps
// Reussir's `Rc`.)
#[ffi(rust = "::leanrt::drop::Cell")]
pub struct LCell<T>;

// A runtime object (`Rc<Box<dyn Any>>`): a file handle (`IO.FS.Handle`), a
// `Std.Sync` mutex or condition variable, a timer, socket or operation of
// the event loop (all `lcAny` in mono code).
#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LHandle;

// ===========================================================================
// Process, panics, unreachable code

#[ffi(import)]
fn l2r_exit(code : u32) -> unit [{ leanrt::io::exit(code as i32) }];

// `IO.Process.exit` (the status is a `UInt8`): what other threads would
// have done by now goes first (`sched::effect`).
#[ffi(import)]
fn l2r_process_exit(code : u8) -> u64 [{ { leanrt::sched::effect(); leanrt::io::exit(code as i32) } }];

// `IO.Process.forceExit` (`std::_Exit`): no flushing, no exit handlers.
#[ffi(import)]
fn l2r_process_force_exit(code : u8) -> u64 [{ { extern "C" { fn _exit(code: i32) -> !; } unsafe { _exit(code as i32) } } }];

#[ffi(import)]
fn l2r_argc() -> u64 [{ (leanrt::rt::args().len() as u64).saturating_sub(1) }];

#[ffi(import)]
fn l2r_argv(i : u64) -> LStr [{ leanrt::string::from_bytes_lossy(&leanrt::rt::args()[i as usize + 1]) }];

// Top-level `error e`: `uncaught exception: <e.toString>`, exit 1.
#[ffi(import)]
fn l2r_uncaught_exception(msg : LStr) -> unit [{ leanrt::uncaught_exception(msg.utf8()) }];

// `lean_internal_panic` messages, by code (no `str` arguments on hot paths).
#[ffi(import)]
fn l2r_internal_panic(code : u64) -> u64 [{
    leanrt::internal_panic(match code {
        0 => "unreachable code has been reached",
        1 => "Nat.pow exponent is too big",
        2 => "Nat.shiftl exponent is too big",
        3 => "Nat.shiftr exponent is too big",
        4 => "out of memory",
        5 => "executed 'sorry'",
        6 => "integer overflow in runtime computation",
        _ => "internal error",
    })
}];

fn l2r_unreachable<T>() -> T {
    let ignored = l2r_internal_panic(0);
    core::intrinsic::panic::panic<T>()
}

// Releases `x` out of line. A wildcard arm that rrc copies into several
// constructors releases the values of wide enums it holds with it
// (Lower/Code, sinkWildcardHeld), where rrc would expand each release in
// line, a match over the variants, in every copy. Kept out of rrc's
// inliner, which would put the expansion back.
#[transform_anchor]
fn l2r_sink<T>(x : T) -> u64 { 0 }

fn l2r_internal_panic_at<T>(code : u64) -> T {
    let ignored = l2r_internal_panic(code);
    core::intrinsic::panic::panic<T>()
}

// Runtime diagnostics go where native Lean's `io_eprintln` sends them: to
// the *current* stderr stream (`IO.setStderr`), through
// `l2r_stderr_put(s)`, which lean2rr defines in every program (it writes
// with the stream's `putStr`, ignoring errors). Messages printed right
// before the process dies (abort-mode panics, internal panics, uncaught
// exceptions, stack overflow) go to descriptor 2, as natively.

// `lean_panic_impl`'s lines: the message, then (unless `LEAN_BACKTRACE=0`)
// `backtrace:` and the frames (none here). Natively one `io_eprintln` per
// line; written here with one `putStr` (the same bytes). Under
// `LEAN_ABORT_ON_PANIC` this does not return: `leanrt::panic_msg` flushes
// stdout, writes the message to descriptor 2 (`std::cerr`) and aborts.
#[ffi(import)]
fn l2r_panic_text(msg : LStr) -> LStr [{
    {
        if std::env::var_os("LEAN_ABORT_ON_PANIC").is_some() {
            leanrt::panic_msg(msg.utf8());
        }
        let mut t = msg.utf8().to_vec();
        t.push(b'\n');
        if std::env::var("LEAN_BACKTRACE").map(|v| v != "0").unwrap_or(true) {
            t.extend_from_slice(b"backtrace:\n(stack trace unavailable)\n");
        }
        leanrt::rc_release(msg);
        leanrt::string::from_bytes(&t)
    }
}];

fn l2r_panic_str(msg : LStr) -> u64 { l2r_stderr_put(l2r_panic_text(msg)) }

// Messages the C runtime itself panics with, by code.
#[ffi(import)]
fn l2r_panic_code_text(code : u64) -> LStr [{
    leanrt::string::from_bytes(match code {
        0 => "Error: index out of bounds".as_bytes(),
        1 => "Error: invalid `String.Pos` at `String.get!`".as_bytes(),
        _ => "Error".as_bytes(),
    })
}];

// These panics come from inside the prelude's array and string helpers,
// which the stream code behind `l2r_stderr_put` itself uses. A Reussir-level
// call cycle there crashes rrc's TokenReusePass under `--reuse-across-call`
// (a Reussir bug), so the message reaches `l2r_stderr_put` from Rust,
// through the program's `l2r_stderr_put_c` trampoline
// (`leanrt::io::diag_put`; descriptor 2 without one).
fn l2r_panic_code(code : u64) -> u64 { l2r_diag_put(l2r_panic_text(l2r_panic_code_text(code))) }

#[ffi(import)]
fn l2r_diag_put(s : LStr) -> u64 [{ { leanrt::io::diag_put(s); 0 } }];

// `panicCore {α} [Inhabited α] (msg : String) : α`.
fn lean_panic_fn_borrowed<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

fn lean_panic_fn<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

// `sorryAx`: `INTERNAL PANIC: executed 'sorry'`.
fn lean_sorry<T>(b : bool) -> T { l2r_internal_panic_at<T>(5) }

// ===========================================================================
// Nat
//
// A `Nat` is one word (leanrt::nat), as natively: an odd word is a small
// value `(n << 1) | 1` (n < 2^63), an even word a reference to a big number
// (n >= 2^63). Every value has exactly one form, so two small words are
// equal exactly when the values are, and a small value is below every big
// one. Fast paths work on the words inline; everything that involves a big
// number is a call to leanrt::nat (GMP).
//
// Ownership of words: `l2r_nat_raw(n)` turns `n` into its word, which then
// owns `n`'s reference (Reussir no longer counts it). A small word owns
// nothing and may be used freely; a big word must reach exactly one owner
// on every path: back into a handle (`l2r_nat_of_raw`), a `_raw` slow path
// (which consumes its words), or `l2r_nat_drop_raw`. A function that takes
// a `Nat` turns it into its word once: no reference counting at all on its
// small path.

#[ffi(import)]
fn l2r_nat_raw(n : Nat) -> u64 [{ n.into_raw() }];
#[ffi(import)]
fn l2r_nat_of_raw(w : u64) -> Nat [{ unsafe { leanrt::nat::LNat::from_raw(w) } }];
// Release the big number a word owns (nothing for a small word); 0.
#[ffi(import)]
fn l2r_nat_drop_raw(w : u64) -> u64 [{ { drop(unsafe { leanrt::nat::LNat::from_raw(w) }); 0 } }];

// A value below 2^63.
fn l2r_nat_small(x : u64) -> Nat { l2r_nat_of_raw((x << 1) | 1) }

#[ffi(import)]
fn l2r_nat_big_of_u64(x : u64) -> Nat [{ leanrt::nat::nat_big_of_u64(x) }];

// `lean_usize_to_nat`: any word.
fn l2r_nat_of_u64(x : u64) -> Nat {
    if (x >> 63) == 0 { l2r_nat_small(x) } else { l2r_nat_big_of_u64(x) }
}

// Big literals (lean2rr emits them for values >= 2^63, see `natLiteral`).
#[ffi(import)]
fn lean_cstr_to_nat(s : str) -> Nat [{ leanrt::nat::nat_of_decimal((*s).as_bytes()) }];
// A big `Nat` literal: its decimal digits (from the string literal table).
#[ffi(import)]
fn l2r_nat_of_decimal_lstr(s : LStr) -> Nat [{ { let r = leanrt::nat::nat_of_decimal(&s.utf8()[..]); leanrt::rc_release(s); r } }];

fn lean_unsigned_to_nat(x : u32) -> Nat { l2r_nat_small(x as u64) }

// Slow paths: raw words in (consumed), a normalized `Nat` out.
#[ffi(import)]
fn l2r_nat_add_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_add(a, b) }];
#[ffi(import)]
fn l2r_nat_sub_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_sub(a, b) }];
#[ffi(import)]
fn l2r_nat_mul_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_mul(a, b) }];
#[ffi(import)]
fn l2r_nat_div_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_div(a, b) }];
#[ffi(import)]
fn l2r_nat_mod_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_mod(a, b) }];
#[ffi(import)]
fn l2r_nat_cmp_raw(a : u64, b : u64) -> i64 [{ leanrt::nat::nat_cmp(a, b) }];
#[ffi(import)]
fn l2r_nat_eq_raw(a : u64, b : u64) -> bool [{ leanrt::nat::nat_eq(a, b) }];
#[ffi(import)]
fn l2r_nat_land_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_land(a, b) }];
#[ffi(import)]
fn l2r_nat_lor_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_lor(a, b) }];
#[ffi(import)]
fn l2r_nat_xor_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_xor(a, b) }];
#[ffi(import)]
fn l2r_nat_shiftl_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_shiftl(a, b) }];
#[ffi(import)]
fn l2r_nat_shiftr_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_shiftr(a, b) }];
#[ffi(import)]
fn l2r_nat_pow_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_pow(a, b) }];
#[ffi(import)]
fn l2r_nat_low_raw(a : u64) -> u64 [{ leanrt::nat::nat_low_u64(a) }];
#[ffi(import)]
fn l2r_u64_mul_hi(x : u64, y : u64) -> u64 [{ leanrt::big::u64_mul_hi(x, y) }];
// `x ^ e` for x >= 2 and e < 64, or 0 when it overflows a word.
#[ffi(import)]
fn l2r_u64_pow_checked(x : u64, e : u64) -> u64 [{ x.checked_pow(e as u32).unwrap_or(0) }];

// Words of two small values `2m+1`, `2n+1`: their sum minus one is
// `2(m+n)+1`, small exactly when it does not carry out of the word.
// Both words are odd exactly when `s` and `x` are (`s` is odd when `x` and
// `y` have the same parity). The test is not `x & y & 1`: LLVM then shares
// `y & 1` with the low-bit test of Reussir's `rc.inc` of `y` (a field just
// read from a cell, patch 0050's guard) and keeps it in a callee-saved
// register across the calls in between, which grew cfold's recursive
// `constFolding` frame from 80 to 96 bytes (peak memory at n = 23:
// 1074 MB instead of 946).
fn lean_nat_add(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    let s = x + (y - 1);
    if (s & x & 1) == 1 {
        if s >= x { l2r_nat_of_raw(s) } else { l2r_nat_add_raw(x, y) }
    } else { l2r_nat_add_raw(x, y) }
}

fn lean_nat_succ(a : Nat) -> Nat { lean_nat_add(a, l2r_nat_small(1)) }

// Truncated: `m - n = 0` for m < n.
fn lean_nat_sub(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        if x < y { l2r_nat_small(0) } else { l2r_nat_of_raw((x - y) + 1) }
    } else { l2r_nat_sub_raw(x, y) }
}

fn lean_nat_pred(a : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 {
        if x == 1 { l2r_nat_small(0) } else { l2r_nat_of_raw(x - 2) }
    } else { l2r_nat_sub_raw(x, 3) }
}

// Both factors below 2^31: the product is below 2^62. Otherwise the high
// word of the product decides (`umulh`), as natively. Both small: the
// parity test of `lean_nat_add` (not `x & y & 1`, see there).
fn lean_nat_mul(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    let s = x + (y - 1);
    if (s & x & 1) == 1 {
        let m = x >> 1;
        let n = y >> 1;
        let p = m * n;
        if (m | n) < 2147483648 { l2r_nat_of_raw((p << 1) | 1) } else {
            if l2r_u64_mul_hi(m, n) == 0 && (p >> 63) == 0 { l2r_nat_of_raw((p << 1) | 1) } else { l2r_nat_mul_raw(x, y) }
        }
    } else { l2r_nat_mul_raw(x, y) }
}

// `m / 0 = 0`.
fn lean_nat_div(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let n = y >> 1;
        if n == 0 { l2r_nat_small(0) } else { l2r_nat_small((x >> 1) / n) }
    } else { l2r_nat_div_raw(x, y) }
}

fn lean_nat_div_exact(a : Nat, b : Nat) -> Nat { lean_nat_div(a, b) }

// `m % 0 = m`.
fn lean_nat_mod(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let n = y >> 1;
        if n == 0 { l2r_nat_of_raw(x) } else { l2r_nat_small((x >> 1) % n) }
    } else { l2r_nat_mod_raw(x, y) }
}

// Three-way comparison: -1, 0, 1.
fn l2r_nat_cmp(a : Nat, b : Nat) -> i64 {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        if x < y { 0 - 1 } else { if x == y { 0 } else { 1 } }
    } else { l2r_nat_cmp_raw(x, y) }
}

fn lean_nat_dec_eq(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x == y } else { l2r_nat_eq_raw(x, y) }
}

fn lean_nat_eq(a : Nat, b : Nat) -> bool { lean_nat_dec_eq(a, b) }
fn lean_nat_ne(a : Nat, b : Nat) -> bool { !lean_nat_dec_eq(a, b) }

fn lean_nat_dec_lt(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x < y } else { l2r_nat_cmp_raw(x, y) < 0 }
}

fn lean_nat_dec_le(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x <= y } else { l2r_nat_cmp_raw(x, y) <= 0 }
}

fn lean_nat_lt(a : Nat, b : Nat) -> bool { lean_nat_dec_lt(a, b) }
fn lean_nat_le(a : Nat, b : Nat) -> bool { lean_nat_dec_le(a, b) }

// Bitwise operations on two small words act on the values (as natively:
// `(2m+1) & (2n+1) = 2(m & n) + 1`, likewise `|`; `^` clears the tag bit).
fn lean_nat_land(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw(x & y) } else { l2r_nat_land_raw(x, y) }
}

fn lean_nat_lor(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw(x | y) } else { l2r_nat_lor_raw(x, y) }
}

fn lean_nat_lxor(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw((x ^ y) | 1) } else { l2r_nat_xor_raw(x, y) }
}

// `Nat.shiftLeft`: 0 stays 0; otherwise a shift amount above 2^32 - 1 is an
// internal panic (as `lean_nat_shiftl`; leanrt::nat::nat_shiftl).
fn lean_nat_shiftl(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let m = x >> 1;
        let s = y >> 1;
        if s < 63 {
            let r = m << s;
            if (r >> s) == m && (r >> 63) == 0 { l2r_nat_small(r) } else { l2r_nat_shiftl_raw(x, y) }
        } else { l2r_nat_shiftl_raw(x, y) }
    } else { l2r_nat_shiftl_raw(x, y) }
}

// `Nat.shiftRight`: a big shift amount gives 0; a big value shifted by more
// than 2^32 - 1 panics unless every bit is shifted out.
fn lean_nat_shiftr(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let s = y >> 1;
        if s < 63 { l2r_nat_small((x >> 1) >> s) } else { l2r_nat_small(0) }
    } else { l2r_nat_shiftr_raw(x, y) }
}

#[ffi(import)]
fn l2r_nat_log2_big(a : u64) -> Nat [{ leanrt::nat::nat_log2(a) }];

fn lean_nat_log2(a : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 {
        let m = x >> 1;
        if m == 0 { l2r_nat_small(0) } else { l2r_nat_small(63 - core::intrinsic::math::ctlz(m)) }
    } else { l2r_nat_log2_big(x) }
}

// `Nat.pow`: an exponent above 2^32 - 1 is an internal panic, whatever the
// base (leanrt::nat::nat_pow; the fast path takes exponents below 2^32).
fn lean_nat_pow(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 && (y >> 33) == 0 {
        let m = x >> 1;
        let e = y >> 1;
        if e == 0 { l2r_nat_small(1) } else {
            if m < 2 { l2r_nat_of_raw(x) } else {
                if e < 64 {
                    let r = l2r_u64_pow_checked(m, e);
                    if r != 0 && (r >> 63) == 0 { l2r_nat_small(r) } else { l2r_nat_pow_raw(x, y) }
                } else { l2r_nat_pow_raw(x, y) }
            }
        }
    } else { l2r_nat_pow_raw(x, y) }
}

#[ffi(import)]
fn lean_nat_gcd(a : Nat, b : Nat) -> Nat [{ leanrt::nat::nat_gcd(a.into_raw(), b.into_raw()) }];

// One shared empty string (a new reference, no allocation): the
// placeholder of a string parameter that is never read (lean2rr's
// Opt/StateMachines).
#[ffi(import)]
fn l2r_str_shared_empty() -> LStr [{ leanrt::string::shared_empty() }];

// Decimal representation (`Nat.repr`); lean2rr replaces Lean's `Nat.repr`
// and `Nat.reprFast` with it (the former builds big numbers digit by digit).
// Below 128, as natively (`Nat.reprFast` reads the closed term
// `Nat.reprArray`), the same shared string every time.
#[ffi(import)]
fn l2r_nat_repr(a : Nat) -> LStr [{ leanrt::nat::nat_repr(a.into_raw()) }];

#[ffi(import)]
fn l2r_nat_repr_small(x : u64) -> LStr [{ leanrt::string::repr_small(x) }];

fn lean_system_platform_nbits(u : L2RUnit) -> Nat { l2r_nat_small(64) }

// The value modulo 2^64 (`UInt64.ofNat`, `USize.ofNat`, ...).
