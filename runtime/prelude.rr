// `ByteArray.copySlice`, converting the offsets in C's order (a source
// offset past the end returns `dest` before the others are looked at).
fn lean_byte_array_copy_slice(src : RVec<u8>, so : Nat, dest : RVec<u8>, d : Nat, len : Nat, exact : bool) -> RVec<u8> {
