// ===========================================================================
// Debugging, platform

// `dbgTrace msg f`: print `msg` to stderr, then `f ()`.
fn lean_dbg_trace<T>(msg : LStr, f : L2RUnit -> T) -> T {
    let ignored = l2r_diag_println(msg);
    f(L2RUnit::u{})
}

// `dbgTraceIfShared msg a`: prints `shared RC <msg>` when `a` is a heap
// object that another reference also holds (`leanrt::is_shared`, by the
// storage type: the count of a runtime handle, of leanrt's strings, arrays
// and cells, of a Reussir record and of a big `Nat` or `Int`; a one-word box
// (`LAny`) answers for its payload; small numbers, scalars and nullary
// constructors, Reussir immediates, never are).
// This must be an FFI import (lean2rr then passes values that cannot cross
// the boundary in fresh wrappers, which are never shared), so the message
// reaches the current stderr stream from Rust (`leanrt::io::diag_put`). The
// pieces below (`l2r_shared_check<S>(a)`, `l2r_last_shared()`,
// `l2r_shared_rc_text`) allow the same from Reussir code.
#[ffi(import)]
fn lean_dbg_trace_if_shared<T>(msg : LStr, a : T) -> T [{
    {
        if leanrt::is_shared::<[:T:]>(&a) {
            leanrt::io::diag_put(leanrt::string::from_bytes(&lean_runtime::io::debug::shared_rc_line(msg.utf8())));
        }
        leanrt::rc_release(msg);
        a
    }
}];

#[ffi(import)]
fn l2r_shared_check<T>(a : T) -> T [{ { leanrt::set_last_shared(leanrt::is_shared::<[:T:]>(&a)); a } }];

#[ffi(import)]
fn l2r_last_shared() -> bool [{ leanrt::last_shared() }];

#[ffi(import)]
fn l2r_shared_rc_text(msg : LStr) -> LStr [{
    {
        let line = lean_runtime::io::debug::shared_rc_line(msg.utf8());
        leanrt::rc_release(msg);
        leanrt::string::from_bytes(&line)
    }
}];

// `Void.mk` (`runST`'s initial world): the world has no representation.
fn lean_void_mk<T>(x : T) -> L2RUnit { L2RUnit::u{} }

fn lean_dbg_stack_trace<T>(f : L2RUnit -> T) -> T { f(L2RUnit::u{}) }

#[ffi(import)]
fn l2r_sleep_ms(ms : u32) -> u64 [{ { leanrt::task::sleep_ms(ms); 0 } }];

fn lean_dbg_sleep<T>(ms : u32, f : L2RUnit -> T) -> T {
    let ignored = l2r_sleep_ms(ms);
    f(L2RUnit::u{})
}

// `ptrAddrUnsafe` (lean2rr's `addrOf`). Native pointer identity is not
// emulated: a heap value answers the address of its cell in its own
// representation (`l2r_ptr_addr_obj`, `l2r_ptr_addr_rec`), a scalar a word
// computed from its value: `lean_box(n) = 2n+1` for `UInt8/16/32`, `Char`,
// `Bool` and enumerations (their index), `1` for `Unit`; the bits of a
// `UInt64` or `Float`. A `Nat` or `Int` answers its word, which is native
// Lean's: its boxed scalar when small (a `Nat` below 2^63, an `Int` in the
// `int32` range), else the pointer to its big number object. Equal answers
// mean the same cell or equal values (`ptrEq` as a shortcut for equality
// stays right). `l2r_addr_fresh` (a number answered only once: even, in
// [2^62, 2^63), so never a scalar's word or a pointer) serves values with
// neither.

fn l2r_addr_word(w : u64) -> u64 { w + w + 1 }

#[ffi(import)]
fn l2r_addr_fresh() -> u64 [{ leanrt::fresh_addr() }];

// A `Nat` is represented as natively: a small one is its boxed scalar
// `2n+1`, a big one the pointer to its object; either way, its word.
fn l2r_addr_nat(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x } else { let d = l2r_nat_drop_raw(x); x }
}

// An `Int` is represented as natively: a small one (the `int32` range) is
// its boxed scalar, a big one the pointer to its object; either way, its
// word.
fn l2r_addr_int(i : Int) -> u64 {
    let w = l2r_int_raw(i);
    if (w & 1) == 1 { w } else { let d = l2r_int_drop_raw(w); w }
}

// A heap value's handle pointer, whatever its count: the address is the
// identity even when this call holds the last reference (`ptrEq a b`
// where `a`'s own call released the other reference to the same cell:
// both were live when the comparison started, so their cells differ
// unless they are the same).
#[ffi(import)]
fn l2r_ptr_addr_obj<T>(a : T) -> u64 [{
    {
        let size = ::std::mem::size_of::<[:T:]>();
        if size == ::std::mem::size_of::<usize>() {
            let p = unsafe { *(&a as *const [:T:] as *const usize) };
            p as u64
        } else {
            leanrt::fresh_addr()
        }
    }
}];

// The same for a shared Reussir record (a generated struct or enum, a
// function value, a `Box`). The reference the call received is given back
// inline when others remain (a record's count is the `u32` at its address;
// static cells and immediates, tagged in the top byte or with an immortal
// count, and a last reference go through the record's release), so that
// the call costs no out-of-line release: `ptrEq` in a traversal
// (`Expr.replace`) spent 40% of its time there. A one-word box (`LAny`,
// an opaque type whose word is not an address) answers `l2r_any_addr`'s
// address and is released as a box (lean2rr's `addrOf` and `boxSink` call
// this texture at `Box`).
#[ffi(import)]
fn l2r_ptr_addr_rec<T>(a : T) -> u64 [{
    {
        if ::std::any::type_name::<[:T:]>() == "leanrt::any::LAny" {
            let b: leanrt::any::LAny = unsafe { ::std::mem::transmute_copy(&a) };
            ::std::mem::forget(a);
            let r = b.addr();
            drop(b);
            r
        } else {
            let p = unsafe { *(&a as *const [:T:] as *const usize) };
            if (p >> 56) == 0 {
                let c = unsafe { *(p as *const u32) };
                if c > 1 && c < leanrt::drop::IMMORTAL {
                    unsafe { *(p as *mut u32) = c - 1 };
                    ::std::mem::forget(a);
                }
            }
            p as u64
        }
    }
}];

// The release, after a call, of an argument the callee only borrows
// natively (lean2rr's Lower/Borrow): an effectful FFI call, so it stays
// after the call. Returns 0.
#[ffi(import)]
fn l2r_release_after<T>(x : T) -> u64 [{ { drop(x); 0 } }];

// A shared record or array used at another Reussir type with the same
// layout (lean2rr's `retypable`: instantiations differing only in phantom
// positions, isomorphic inductives read through `unsafeCast`): the same
// object, reinterpreted. Their drop and copy glue do the same.
#[ffi(import)]
fn l2r_retype<S, D>(x : S) -> D [{ unsafe { ::std::mem::transmute::<[:S:], [:D:]>(x) } }];

// Sharing is not observable here: answering "shared" / "not a scalar" only
// makes such code take its general path.
fn lean_is_exclusive_obj<T>(a : T) -> bool { false }
fn lean_is_scalar<T>(a : T) -> bool { false }
fn lean_sharecommon_quick<T>(a : T) -> T { a }

// Payload primitives of the `Runtime.*` BaseIO externs (memory-management
// hints without observable effect here). Where a value can hold a task,
// lean2rr first walks it for `Runtime.markPersistent` and waits for its
// tasks (`l2r_persist_T`, as native `lean_mark_persistent`).
fn l2r_runtime_mark_persistent<T>(a : T) -> T { a }
fn l2r_runtime_mark_multi_threaded<T>(a : T) -> T { a }
fn l2r_runtime_forget<T>(a : T) -> L2RUnit { L2RUnit::u{} }
fn l2r_runtime_hold<T>(a : T) -> L2RUnit { L2RUnit::u{} }
// `IO.initializing` (lean-runtime's flag): true while the module
// initializers run; lean2rr's entry calls `l2r_set_initializing(true)`
// before them and `(false)` after (`lean_io_mark_end_initialization`).
#[ffi(import)]
fn l2r_io_initializing() -> bool [{ leanrt::rt::initializing() }];
#[ffi(import)]
fn l2r_set_initializing(b : bool) -> u64 [{ { leanrt::rt::set_initializing(b); 0 } }];
fn l2r_io_set_heartbeats(n : Nat) -> L2RUnit { L2RUnit::u{} }

// The toolchain facts (`Lean.githash`, `Lean.version.specialDesc`,
// `System.Platform.target`) are lean-runtime's (`semantics::toolchain`): the
// Lean 4.34.0 toolchain's, the target triple the program is built for.
#[ffi(import)]
fn l2r_toolchain_githash() -> LStr [{ leanrt::string::from_bytes(sem::toolchain::GITHASH.as_bytes()) }];
fn lean_get_githash(u : L2RUnit) -> LStr { l2r_toolchain_githash() }

// The platform queries. leanrt builds only for Linux with glibc on aarch64
// and x86-64 (`leanrt::rt`'s target guard), so Windows, macOS and
// Emscripten are false, Linux (`isLinux`, new in Lean 4.34) is true, and
// `numBits` (`lean_system_platform_nbits`) is 64 (`USize` is `u64` here).
fn lean_system_platform_windows(u : L2RUnit) -> bool { false }
fn lean_system_platform_osx(u : L2RUnit) -> bool { false }
fn lean_system_platform_linux(u : L2RUnit) -> bool { true }
fn lean_system_platform_emscripten(u : L2RUnit) -> bool { false }
fn lean_internal_is_stage0(u : L2RUnit) -> bool { false }
fn lean_internal_has_llvm_backend(u : L2RUnit) -> bool { false }
fn lean_version_get_major(u : L2RUnit) -> Nat { l2r_nat_small(4) }
fn lean_version_get_minor(u : L2RUnit) -> Nat { l2r_nat_small(34) }
fn lean_version_get_patch(u : L2RUnit) -> Nat { l2r_nat_small(0) }
fn lean_version_get_is_release(u : L2RUnit) -> bool { true }
#[ffi(import)]
fn l2r_toolchain_special_desc() -> LStr [{ leanrt::string::from_bytes(sem::toolchain::SPECIAL_DESC.as_bytes()) }];
fn lean_version_get_special_desc(u : L2RUnit) -> LStr { l2r_toolchain_special_desc() }
#[ffi(import)]
fn l2r_platform_target() -> LStr [{ leanrt::string::from_bytes(sem::toolchain::PLATFORM_TARGET.as_bytes()) }];
fn lean_system_platform_target(u : L2RUnit) -> LStr { l2r_platform_target() }

#[ffi(import)]
fn l2r_hardware_concurrency() -> u32 [{ leanrt::sched::hardware_concurrency() }];
fn lean_internal_get_hardware_concurrency(u : L2RUnit) -> u32 { l2r_hardware_concurrency() }

// ===========================================================================
// IO primitives
//
// Convention: an IO/BaseIO extern `lean_io_xxx` whose result cannot fail
// has a payload primitive `l2r_io_xxx` taking the same passed arguments and
// returning the payload; lean2rr wraps it in `EST.Out.ok`/`ST.Out`
// (`wrapIOResult`).

fn l2r_io_mono_ms_now() -> Nat { l2r_nat_of_u64(l2r_io_mono_ms_now_u64()) }
fn l2r_io_mono_nanos_now() -> Nat { l2r_nat_of_u64(l2r_io_mono_nanos_now_u64()) }
fn l2r_io_get_num_heartbeats() -> Nat { l2r_nat_small(0) }
fn l2r_io_check_canceled() -> bool { l2r_task_check_canceled() }
fn l2r_io_get_tid() -> u64 { l2r_io_get_tid_u64() }

// `IO.getTID` (lean-runtime's `io::env::get_tid`: `gettid`, plus, inside a
// task, the number of the worker thread it natively runs on).
#[ffi(import)]
fn l2r_io_get_tid_u64() -> u64 [{ lean_runtime::io::env::get_tid() }];

#[ffi(import)]
fn l2r_io_mono_ms_now_u64() -> u64 [{ leanrt::io::mono_ms_polled() }];

#[ffi(import)]
fn l2r_io_mono_nanos_now_u64() -> u64 [{ leanrt::io::mono_nanos_polled() }];

// The system clock in nanoseconds since the Unix epoch (`lean_shim_realtime_nanos`:
// lean2rr's shim builds `Std.Time.Timestamp.now` from it).
fn l2r_shim_realtime_nanos() -> Int { l2r_int_of_i64(l2r_shim_realtime_nanos_i64()) }
#[ffi(import)]
fn l2r_shim_realtime_nanos_i64() -> i64 [{ leanrt::io::realtime_nanos_polled() }];


#[ffi(import)]
fn l2r_io_process_get_pid() -> u32 [{ lean_runtime::io::env::get_pid() }];

// ===========================================================================
// Files and the file system (IO.FS)
//
// A handle (`IO.FS.Handle`, `lcAny` in mono code) is `LHandle`: a shared,
// buffered file, closed when the last reference goes away. Fallible
// primitives record their outcome in a last-error slot (each context's
// own, exchanged at each switch); lean2rr's
// glue for an `IO` extern calls the primitive, then
//   l2r_io_finish(v, |v| EST.Out.ok(v), mkError)
// where `mkError kind errno fname details` builds the `IO.Error` with the
// `lean_mk_io_error_*` constructor numbered `kind` (runtime/README.md).

// (`LHandle` is declared with the runtime types.)

#[ffi(import)]
fn l2r_io_ok() -> bool [{ leanrt::fs::ok() }];
#[ffi(import)]
fn l2r_io_errno() -> u32 [{ leanrt::fs::errno() }];
#[ffi(import)]
fn l2r_io_error_kind() -> u32 [{ leanrt::fs::error_kind() }];
#[ffi(import)]
fn l2r_io_error_fname() -> LStr [{ leanrt::fs::error_fname() }];
#[ffi(import)]
fn l2r_io_error_details() -> LStr [{ leanrt::fs::error_details() }];

fn l2r_io_error_with<E>(mk : u32 -> (u32 -> (LStr -> (LStr -> E)))) -> E {
    mk(l2r_io_error_kind())(l2r_io_errno())(l2r_io_error_fname())(l2r_io_error_details())
}

// The result of the primitive just called: `ok v`, or the error it recorded.
fn l2r_io_finish<T, R>(v : T, ok : T -> R, err : u32 -> (u32 -> (LStr -> (LStr -> R)))) -> R {
    if l2r_io_ok() { ok(v) } else { l2r_io_error_with(err) }
}

// `IO.getRandomBytes n` (an IO error when `/dev/urandom` cannot be read).
#[ffi(import)]
fn l2r_fs_get_random_bytes(n : u64) -> RVec<u8> [{ leanrt::fs::get_random_bytes(n) }];

// `IO.FS.Handle.mk path mode` (mode = constructor index of `IO.FS.Mode`:
// read, write, writeNew, readWrite, append).
#[ffi(import)]
fn l2r_fs_open(path : LStr, mode : u8) -> LHandle [{ { let h = leanrt::fs::open_file(path.utf8(), mode); leanrt::rc_release(path); h } }];
#[ffi(import)]
fn l2r_fs_put_str(h : LHandle, s : LStr) -> u64 [{ { leanrt::fs::owned::put_str(h, s); 0 } }];
#[ffi(import)]
fn l2r_fs_write(h : LHandle, b : RVec<u8>) -> u64 [{ { leanrt::fs::owned::write(h, b); 0 } }];
#[ffi(import)]
fn l2r_fs_flush(h : LHandle) -> u64 [{ { leanrt::fs::owned::flush(h); 0 } }];
#[ffi(import)]
fn l2r_fs_read(h : LHandle, n : u64) -> RVec<u8> [{ leanrt::fs::owned::read(h, n) }];
#[ffi(import)]
fn l2r_fs_get_line(h : LHandle) -> LStr [{ leanrt::fs::owned::get_line(h) }];
#[ffi(import)]
fn l2r_fs_is_tty(h : LHandle) -> bool [{ leanrt::fs::owned::is_tty(h) }];
#[ffi(import)]
fn l2r_fs_rewind(h : LHandle) -> u64 [{ { leanrt::fs::owned::rewind(h); 0 } }];
#[ffi(import)]
fn l2r_fs_truncate(h : LHandle) -> u64 [{ { leanrt::fs::owned::truncate(h); 0 } }];
#[ffi(import)]
fn l2r_fs_lock(h : LHandle, exclusive : bool) -> u64 [{ { leanrt::fs::owned::lock(h, exclusive); 0 } }];
#[ffi(import)]
fn l2r_fs_try_lock(h : LHandle, exclusive : bool) -> bool [{ leanrt::fs::owned::try_lock(h, exclusive) }];
#[ffi(import)]
fn l2r_fs_unlock(h : LHandle) -> u64 [{ { leanrt::fs::owned::unlock(h); 0 } }];
#[ffi(import)]
fn l2r_fs_remove_file(p : LStr) -> u64 [{ { leanrt::fs::remove_file(p.utf8()); leanrt::rc_release(p); 0 } }];
#[ffi(import)]
fn l2r_fs_create_dir(p : LStr) -> u64 [{ { leanrt::fs::create_dir(p.utf8()); leanrt::rc_release(p); 0 } }];
#[ffi(import)]
fn l2r_fs_remove_dir(p : LStr) -> u64 [{ { leanrt::fs::remove_dir(p.utf8()); leanrt::rc_release(p); 0 } }];
#[ffi(import)]
fn l2r_fs_rename(a : LStr, b : LStr) -> u64 [{ { leanrt::fs::rename_file(a.utf8(), b.utf8()); leanrt::rc_release(a); leanrt::rc_release(b); 0 } }];
#[ffi(import)]
fn l2r_fs_hard_link(a : LStr, b : LStr) -> u64 [{ { leanrt::fs::hard_link(a.utf8(), b.utf8()); leanrt::rc_release(a); leanrt::rc_release(b); 0 } }];
#[ffi(import)]
fn l2r_fs_set_access_rights(p : LStr, mode : u32) -> u64 [{ { leanrt::fs::set_access_rights(p.utf8(), mode); leanrt::rc_release(p); 0 } }];
#[ffi(import)]
fn l2r_fs_real_path(p : LStr) -> LStr [{ { let r = leanrt::fs::real_path(p.utf8()); leanrt::rc_release(p); r } }];
// Entry names in `readdir` order, without `.` and `..` (lean2rr builds the
// `IO.FS.DirEntry`s with `root := p`).
#[ffi(import)]
fn l2r_fs_read_dir(p : LStr) -> RVec<LStr> [{
    { let v = leanrt::fs::read_dir(p.utf8()); leanrt::rc_release(p); leanrt::array::from_vec(v) }
}];
// `System.FilePath.metadata` (`follow`) / `symlinkMetadata`: [accessed sec
// (i64 bits), accessed nsec, modified sec (i64 bits), modified nsec,
// byteSize, type, numLinks] with type the `IO.FS.FileType` constructor index
// (dir, file, symlink, other).
#[ffi(import)]
fn l2r_fs_metadata(p : LStr, follow : bool) -> RVec<u64> [{
    { let v = leanrt::fs::metadata(p.utf8(), follow); leanrt::rc_release(p); leanrt::array::from_slice(&v[..]) }
}];
// `Handle.isEof` / `Handle.isTty` are `BaseIO` (they cannot fail): payload
// primitives named after the extern symbols.
#[ffi(import)]
fn l2r_io_prim_handle_is_eof(h : LHandle) -> bool [{ leanrt::fs::owned::is_eof(h) }];
#[ffi(import)]
fn l2r_io_prim_handle_is_tty(h : LHandle) -> bool [{ leanrt::fs::owned::is_tty(h) }];
// `IO.currentDir` / `IO.appPath` (user errors) and
// `IO.Process.getCurrentDir` / `setCurrentDir` (errno errors).
#[ffi(import)]
fn l2r_fs_current_dir() -> LStr [{ leanrt::fs::current_dir() }];
#[ffi(import)]
fn l2r_fs_app_path() -> LStr [{ leanrt::fs::app_path() }];
#[ffi(import)]
fn l2r_fs_process_get_current_dir() -> LStr [{ leanrt::fs::process_current_dir() }];
#[ffi(import)]
fn l2r_fs_process_set_current_dir(p : LStr) -> u64 [{ { leanrt::fs::set_current_dir(p.utf8()); leanrt::rc_release(p); 0 } }];
// `IO.FS.createTempFile : IO (Handle × FilePath)`: the handle, then (on
// success) `l2r_fs_temp_file_path()` is the new file's path.
// `IO.FS.createTempDir : IO FilePath`.
#[ffi(import)]
fn l2r_fs_create_tempfile() -> LHandle [{ leanrt::fs::create_temp_file() }];
#[ffi(import)]
fn l2r_fs_temp_file_path() -> LStr [{ leanrt::fs::temp_file_path() }];
#[ffi(import)]
fn l2r_fs_create_tempdir() -> LStr [{ leanrt::fs::create_temp_dir() }];

// ---- Child processes (IO.Process) ----
//
// `IO.Process.spawn args`: the fields of `SpawnArgs` — `args` is Lean's
// `Array String` as it is (an array of boxes, each string read in place),
// `modes` is
// stdin | stdout << 8 | stderr << 16 (`IO.Process.Stdio` constructor
// indices: piped, inherit, null), `cwd`/`has_cwd` the `Option FilePath`,
// the `env` array as parallel arrays of names, values and whether the value
// is `some` (set) or `none` (unset). Returns the pid (fallible: last-error
// protocol, errors without a file name); the child's `stdin`/`stdout`/
// `stderr` fields are then `l2r_proc_end(0/1/2)` (a handle for piped
// streams, a closed handle otherwise). A `Child` needs its pid and whether
// it was spawned with `setsid` for `wait`/`tryWait`/`kill`/`pid`.
#[ffi(import)]
fn l2r_proc_spawn(cmd : LStr, args : RVec<LAny>, cwd : LStr, has_cwd : bool, env_names : RVec<LStr>, env_values : RVec<LStr>, env_set : RVec<bool>, modes : u32, inherit_env : bool, setsid : bool) -> u32 [{
    {
        let pid = leanrt::proc::with_args(&cmd, &args, &cwd, has_cwd, &env_names, &env_values, &env_set, inherit_env, setsid, |a| leanrt::proc::spawn(a, modes));
        leanrt::rc_release(cmd);
        leanrt::rc_release(cwd);
        leanrt::array::release(args);
        leanrt::array::release(env_names);
        leanrt::array::release(env_values);
        leanrt::array::release(env_set);
        pid
    }
}];
#[ffi(import)]
fn l2r_proc_end(i : u64) -> LHandle [{ leanrt::proc::take_end(i) }];
// `Child.wait`: the exit code (128 + signal when killed); fallible.
#[ffi(import)]
fn l2r_proc_wait(pid : u32) -> u32 [{ leanrt::proc::wait(pid) }];
// `Child.tryWait`: `(1 << 32) | code` once exited, 0 while running; fallible.
#[ffi(import)]
fn l2r_proc_try_wait(pid : u32) -> u64 [{ leanrt::proc::try_wait(pid) }];
// `IO.Process.output args input?` (lean-runtime's `io::process::output`):
// the `SpawnArgs` fields but the stdio modes (stdin is `null`, or `piped`
// when `has_input`: `input` is then written, flushed and closed; stdout and
// stderr are `piped` and read to end of file together), then the exit
// code; fallible, with Lean's errors in Lean's order (stderr's read or
// UTF-8 error before `wait`, stdout's after). On success the outputs are
// `l2r_proc_output_str(1)` and `(2)`, valid UTF-8.
#[ffi(import)]
fn l2r_proc_output(cmd : LStr, args : RVec<LAny>, cwd : LStr, has_cwd : bool, env_names : RVec<LStr>, env_values : RVec<LStr>, env_set : RVec<bool>, inherit_env : bool, setsid : bool, input : LStr, has_input : bool) -> u32 [{
    {
        let code = leanrt::proc::with_args(&cmd, &args, &cwd, has_cwd, &env_names, &env_values, &env_set, inherit_env, setsid,
            |a| leanrt::proc::output(a, if has_input { Some(input.utf8()) } else { None }));
        leanrt::rc_release(cmd);
        leanrt::rc_release(cwd);
        leanrt::rc_release(input);
        leanrt::array::release(args);
        leanrt::array::release(env_names);
        leanrt::array::release(env_values);
        leanrt::array::release(env_set);
        code
    }
}];
#[ffi(import)]
fn l2r_proc_output_str(which : u64) -> LStr [{ leanrt::proc::take_output(which) }];
// `Child.kill`: SIGKILL (to the process group after `setsid`); fallible.
#[ffi(import)]
fn l2r_proc_kill(pid : u32, setsid : bool) -> u64 [{ { leanrt::proc::kill_child(pid, setsid); 0 } }];

// `timeit msg act` (`lean_io_timeit`): run the IO action (`f` applied to
// the world), then print `msg <t>ms` (or `<t>s` from one second on, 3
// significant digits as C++'s `setprecision(3)`) to stderr.
#[ffi(import)]
fn l2r_timeit_start() -> u64 [{ leanrt::io::mono_nanos() }];

// `msg <t>ms` (or `<t>s` from one second on, 3 significant digits as C++'s
// `setprecision(3)`) and a newline: lean-runtime's `io::time::timeit_line`.
#[ffi(import)]
fn l2r_timeit_text(msg : LStr, start : u64) -> LStr [{ leanrt::io::timeit_text(msg, start) }];

fn l2r_io_timeit_with<R>(msg : LStr, act : L2RUnit -> R) -> R {
    let t = l2r_timeit_start();
    let r = act(L2RUnit::u{});
    let ignored = l2r_stderr_put(l2r_timeit_text(msg, t));
    r
}

// `allocprof msg act`: runs the action, then prints what a Lean runtime
// built without `RUNTIME_STATS` prints.
fn l2r_io_allocprof_with<R>(msg : LStr, act : L2RUnit -> R) -> R {
    let r = act(L2RUnit::u{});
    let ignored = l2r_stderr_put(l2r_allocprof_text(msg));
    r
}

// lean-runtime's `io::debug::ALLOCPROF_NOTE` after the message.
#[ffi(import)]
fn l2r_allocprof_text(msg : LStr) -> LStr [{ leanrt::io::allocprof_text(msg) }];

// `IO.getEnv name : BaseIO (Option String)` (lean-runtime's
// `io::env::get_env`).
#[ffi(import)]
fn l2r_getenv_has(name : LStr) -> bool [{ leanrt::fs::getenv_has(name) }];
#[ffi(import)]
fn l2r_getenv_value(name : LStr) -> LStr [{ leanrt::fs::getenv_value(name) }];
fn l2r_io_getenv_with<O>(name : LStr, none : O, some : LStr -> O) -> O {
    if l2r_getenv_has(name) { some(l2r_getenv_value(name)) } else { none }
}
