}];
#[ffi(import)]
fn l2r_shim_tcp_connect(s : LHandle, a : RVec<u8>, r : LPromise) -> LHandle [{
    { let o = leanrt::net::tcp_connect(&s, leanrt::array::as_slice(&a), r); leanrt::array::release(a); leanrt::rc_release(s); o }
}];
#[ffi(import)]
