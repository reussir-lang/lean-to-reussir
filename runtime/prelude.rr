fn l2r_shim_tcp_bind(s : LHandle, a : RVec<u8>) -> u32 [{
    { let r = leanrt::net::tcp_bind(&s, leanrt::array::as_slice(&a)) as u32; leanrt::array::release(a); leanrt::rc_release(s); r }
}];
#[ffi(import)]
fn l2r_shim_tcp_listen(s : LHandle, backlog : u32) -> u32 [{
