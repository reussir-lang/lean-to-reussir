fn lean_intarr_fget(v : LIntArr, i : Nat) -> Int { l2r_intarr_get_word(v, l2r_nat_raw(i)) }
fn lean_intarr_fget_borrowed(v : LIntArr, i : Nat) -> Int { l2r_intarr_get_word(v, l2r_nat_raw(i)) }
