// ===========================================================================
// Standard streams
//
// lean2rr builds each `IO.FS.Stream` field as a closure over these
// primitives (fd 0 = stdin, 1 = stdout, 2 = stderr). They are the handle
// operations on models of glibc's stdin/stdout/stderr `FILE`s
// (leanrt::cfile): stdout buffered, stderr unbuffered, all finished at exit
// as natively. putStr/write/flush/read/getLine record their outcome in the
// last-error slot (use `l2r_io_finish`, as for files): EPIPE, EBADF (also
// for the wrong direction), EINVAL on streams closed at startup; isTty
// cannot fail.

#[ffi(import)]
fn l2r_stream_putStr(fd : u64, s : LStr) -> u64 [{ { leanrt::io::stream_put(fd, &s); leanrt::rc_release(s); 0 } }];

#[ffi(import)]
fn l2r_stream_write(fd : u64, b : RVec<u8>) -> u64 [{ { leanrt::io::stream_put(fd, leanrt::array::as_slice(&b)); leanrt::array::release(b); 0 } }];

#[ffi(import)]
fn l2r_stream_flush(fd : u64) -> u64 [{ { leanrt::io::stream_flush(fd); 0 } }];

#[ffi(import)]
fn l2r_stream_read(fd : u64, n : u64) -> RVec<u8> [{ leanrt::array::bytes_of_string(Rc::new(leanrt::io::stream_read(fd, n))) }];

#[ffi(import)]
fn l2r_stream_getLine(fd : u64) -> LStr [{ leanrt::string::from_bytes_lossy(&leanrt::io::stream_get_line(fd)) }];

#[ffi(import)]
fn l2r_stream_isTty(fd : u64) -> bool [{ leanrt::io::is_tty(fd) }];

// `IO.eprintln` helper.
fn l2r_eprintln(s : LStr) -> u64 { l2r_stream_putStr(2, lean_string_push(s, 10)) }

// A runtime diagnostic line (`dbgTrace`, `timeit`, `allocprof`):
// `io_eprintln`, to the current stderr stream.
fn l2r_diag_println(s : LStr) -> u64 { l2r_stderr_put(lean_string_push(s, 10)) }

// ===========================================================================
// ST.Ref / IO.Ref
//
// A reference is a shared cell (`LRef<T>`); all aliases see updates. The
// `lean_st_*` externs return BaseIO results, so lean2rr wraps these
// primitives.

#[ffi(import)]
fn l2r_ref_new<T>(v : T) -> LRef<T> [{ leanrt::array::from_rc(Rc::new(vec![v])) }];

#[ffi(import)]
fn l2r_ref_get<T>(r : LRef<T>) -> T [{
    {
        let c = leanrt::array::into_rc(r);
        let v = c.first().cloned().expect("leanrt: read of an empty ST.Ref (after take)");
        v
    }
}];

#[ffi(import)]
fn l2r_ref_set<T>(r : LRef<T>, v : T) -> u64 [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        cell.clear();
        cell.push(v);
        0
    }
}];

#[ffi(import)]
fn l2r_ref_swap<T>(r : LRef<T>, v : T) -> T [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        let old = cell.pop().expect("leanrt: swap of an empty ST.Ref (after take)");
        cell.push(v);
        old
    }
}];

// `ST.Prim.Ref.take`: move the value out, leaving the cell empty until the
// next `set` (so the value stays uniquely referenced, as in Lean).
#[ffi(import)]
fn l2r_ref_take<T>(r : LRef<T>) -> T [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        cell.pop().expect("leanrt: take of an empty ST.Ref")
    }
}];

// An empty cell, and whether a cell is empty.
#[ffi(import)]
fn l2r_ref_empty<T>() -> LRef<T> [{ leanrt::array::from_rc(leanrt::alloc::rc_new(leanrt::alloc::vec_with_capacity(1))) }];

#[ffi(import)]
fn l2r_ref_is_empty<T>(r : LRef<T>) -> bool [{
    { let c = leanrt::array::into_rc(r); let e = c.is_empty(); leanrt::rc_release(c); e }
}];

// ---- IO.Promise (`IO.Promise α` as `LRef<E>`, empty until resolved) ----
//
// Tasks run eagerly (translation plan §6), so reading a promise's result
// happens after every resolution that can precede it; an unresolved promise
// reads as dropped (`none`).

fn l2r_promise_new<T>() -> LRef<T> { l2r_ref_empty<T>() }

// `Promise.resolve v p`: only the first resolution counts.
fn l2r_promise_resolve<T>(v : T, p : LRef<T>) -> L2RUnit {
    let r = if l2r_ref_is_empty(p) { l2r_ref_set(p, v) } else { 0 };
    L2RUnit::u{}
}

// `Promise.result?` (the task's value; lean2rr wraps it in its `Task`).
fn l2r_promise_result_with<T, O>(p : LRef<T>, none : O, some : T -> O) -> O {
    if l2r_ref_is_empty(p) { none } else { some(l2r_ref_get(p)) }
}

// `Option.getOrBlock!` on `none`: Lean's forced panic message, then block
// forever (as natively).
#[ffi(import)]
fn l2r_promise_dropped() -> u64 [{ leanrt::promise_dropped() }];

fn l2r_option_get_or_block_none<T>() -> T {
    let ignored = l2r_promise_dropped();
    l2r_unreachable<T>()
}

#[ffi(import)]
fn l2r_ref_ptr_eq<T>(a : LRef<T>, b : LRef<T>) -> bool [{
    {
        let (x, y) = (leanrt::array::into_rc(a), leanrt::array::into_rc(b));
        std::ptr::eq(&*x as *const std::vec::Vec<[:T:]>, &*y as *const std::vec::Vec<[:T:]>)
    }
}];

// ===========================================================================
// Once-cells (constants and closed terms)
//
// A slot stores one reference forever. `T` is a pointer-sized (or smaller)
// boundary type; lean2rr boxes other values in a one-field shared struct.

#[ffi(import)]
fn l2r_once_has(slot : u64) -> bool [{ leanrt::once::has(slot) }];

#[ffi(import)]
fn l2r_once_get<T>(slot : u64) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let raw = leanrt::once::get_raw(slot);
        let p: ::std::mem::ManuallyDrop<[:T:]> = unsafe { ::std::mem::transmute_copy(&raw) };
        (*p).clone()
    }
}];

#[ffi(import)]
fn l2r_once_set<T>(slot : u64, v : T) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let keep = ::std::mem::ManuallyDrop::new(v.clone());
        let mut raw: usize = 0;
        unsafe {
            ::std::ptr::copy_nonoverlapping(&*keep as *const [:T:] as *const u8, &mut raw as *mut usize as *mut u8, ::std::mem::size_of::<[:T:]>())
        };
        leanrt::once::set_raw(slot, raw);
        v
    }
}];

// Mutable global cells (e.g. the current standard streams for
// `IO.setStdout`/`setStderr`/`setStdin`), in the same slot numbering as the
// once-cells: `l2r_once_has`/`l2r_once_get` read them, `l2r_once_set`
// initializes them, and `l2r_cell_swap` replaces the value and returns the
// previous one.
#[ffi(import)]
fn l2r_cell_swap<T>(slot : u64, v : T) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let keep = ::std::mem::ManuallyDrop::new(v);
        let mut raw: usize = 0;
        unsafe {
            ::std::ptr::copy_nonoverlapping(&*keep as *const [:T:] as *const u8, &mut raw as *mut usize as *mut u8, ::std::mem::size_of::<[:T:]>())
        };
        let old = leanrt::once::swap_raw(slot, raw);
        let p: [:T:] = unsafe { ::std::mem::transmute_copy(&old) };
        p
    }
}];

// Empty a set cell, moving its value (and reference) to the caller.
#[ffi(import)]
fn l2r_once_take<T>(slot : u64) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let raw = leanrt::once::take_raw(slot);
        let p: [:T:] = unsafe { ::std::mem::transmute_copy(&raw) };
        p
    }
}];

// Stream contexts: natively each thread has its own current standard
// streams. `l2r_std_push(base)` sets the cells `base..base+2` aside (empty,
// so they are rebuilt as the process's streams on first use) when a task
// starts; `l2r_std_pop(base)` puts them back when it ends (lean2rr's
// `l2r_std_leave` first empties them, releasing the task's streams).
#[ffi(import)]
fn l2r_std_push(base : u64) -> u64 [{ { leanrt::once::push_context(base, 3); 0 } }];

#[ffi(import)]
fn l2r_std_pop(base : u64) -> u64 [{ { leanrt::once::pop_context(base, 3); 0 } }];

// ===========================================================================
// Thunks and tasks
//
// A `Thunk α` or `Task α` is an `LCell<S>` whose state type `S` lean2rr
// generates per value type: `enum S { pending(L2RUnit -> α), busy, done(α),
// conv(L2RUnit -> α, L2RBox, u64) }` (a shared enum; `conv` is a thunk or
// task converted from another representation: its computation, the original
// cell, and for a task the original's identity). lean2rr also generates the functions that force the
// state (`l2r_thunk_get_S`, `l2r_task_get_S`, ...): a thunk runs its closure
// on first `get` and keeps the value; a task stays pending until it is
// needed or `main` returns, except a pure task created while no task is
// pending or running, which is computed at once. `leanrt::task` keeps the
// queue of pending tasks and answers questions about their state.

#[ffi(import)]
fn l2r_lcell_new<T>(v : T) -> LCell<T> [{ Rc::new(v) }];

#[ffi(import)]
fn l2r_lcell_get<T>(c : LCell<T>) -> T [{ c.data_ref().clone() }];

#[ffi(import)]
fn l2r_lcell_set<T>(c : LCell<T>, v : T) -> u64 [{
    {
        let mut c = c;
        unsafe { *c.data_mut() = v };
        0
    }
}];

// Store `v`, returning the previous value (its reference moves out, so a
// uniquely held state can be reused by the caller).
#[ffi(import)]
fn l2r_lcell_swap<T>(c : LCell<T>, v : T) -> T [{
    {
        let mut c = c;
        unsafe { ::std::mem::replace(c.data_mut(), v) }
    }
}];

// Queue a pending IO task (the queue keeps a reference until it runs).
#[ffi(import)]
fn l2r_task_register<S>(c : LCell<S>, tag : u64) -> u64 [{
    {
        let c = ::std::mem::ManuallyDrop::new(c);
        let p: usize = unsafe { ::std::mem::transmute_copy(&*c) };
        leanrt::task::register(p, tag);
        0
    }
}];

// A task starts / stops running (for `IO.checkCanceled` and the task's
// state); `begin` removes it from the queue and drops the queue's reference.
#[ffi(import)]
fn l2r_task_begin<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        if leanrt::task::begin(p) {
            drop(unsafe { ::std::ptr::read(&c) });
        }
        drop(c);
        0
    }
}];

// A running task stops without finishing (a `bind` task that now waits for
// the task it continues as).
#[ffi(import)]
fn l2r_task_suspend<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        leanrt::task::suspend(p);
        drop(c);
        0
    }
}];

#[ffi(import)]
fn l2r_task_end<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        leanrt::task::end(p);
        drop(c);
        0
    }
}];

// A task's identity for the runtime (`leanrt::task`): the address of its
// cell, or, for a task converted to another representation, the address it
// records (see lean2rr's `l2r_task_addr_S`).
#[ffi(import)]
fn l2r_lcell_addr<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        drop(c);
        p as u64
    }
}];

#[ffi(import)]
fn l2r_task_cancel_at(a : u64) -> u64 [{ { leanrt::task::cancel(a as usize); 0 } }];

// Task `dep` was created depending on task `src`, with `sync := true` or
// not (for its start and its cancellation).
#[ffi(import)]
fn l2r_task_depend_at(src : u64, dep : u64, sync : bool) -> u64 [{ { leanrt::task::depend(src as usize, dep as usize, sync); 0 } }];

// 0 waiting, 1 running, 2 finished.
#[ffi(import)]
fn l2r_task_status_at(a : u64) -> u8 [{ leanrt::task::status(a as usize) }];

// `IO.getTaskState`: as `l2r_task_status_at`, or 3: run the task first.
#[ffi(import)]
fn l2r_task_query_at(a : u64) -> u8 [{ leanrt::task::query(a as usize) }];

#[ffi(import)]
fn l2r_task_deferring() -> bool [{ leanrt::task::deferring() }];

#[ffi(import)]
fn l2r_task_eager_pure() -> bool [{ leanrt::task::eager_pure() }];

#[ffi(import)]
fn l2r_task_manager_start() -> u64 [{ { leanrt::task::start(); 0 } }];

#[ffi(import)]
fn l2r_task_shutdown() -> u64 [{ { leanrt::task::shutdown(); 0 } }];

// The next queued task when `main` has returned: its tag (`u64::MAX` if
// none), then the cell itself (with the queue's reference).
#[ffi(import)]
fn l2r_task_next_tag() -> u64 [{ leanrt::task::next_tag() }];

#[ffi(import)]
fn l2r_task_take<S>() -> LCell<S> [{ unsafe { ::std::mem::transmute_copy(&leanrt::task::take()) } }];

#[ffi(import)]
fn l2r_task_check_canceled() -> bool [{ leanrt::task::check_canceled() }];

#[ffi(import)]
fn l2r_hang() -> u64 [{ leanrt::task::hang() }];

// A thunk forced by its own computation, or a cycle of tasks waiting for
// each other: native Lean waits forever.
fn l2r_lazy_cycle<T>() -> T {
    let ignored = l2r_hang();
    l2r_unreachable<T>()
}

// ===========================================================================
// Debugging, platform

// `dbgTrace msg f`: print `msg` to stderr, then `f ()`.
fn lean_dbg_trace<T>(msg : LStr, f : L2RUnit -> T) -> T {
    let ignored = l2r_diag_println(msg);
    f(L2RUnit::u{})
}

// `dbgTraceIfShared msg a`: prints `shared RC <msg>` when `a` is a heap
// object whose reference count is not 1 (scalars never are). Reference-counted
// storage types (runtime handles and Reussir records) have their u32 count at
// offset 0 of the object they point to. Nullary constructors are Reussir
// immediates, scalars in Lean: a pointer with a nonzero top byte (the `tbi`
// encoding) or to a dummy box with an immortal count (>= 2^31).
// This must be an FFI import (lean2rr then passes values that cannot cross
// the boundary in fresh wrappers, which are never shared: native Lean's
// small `Nat`s are scalars), so the message reaches the current stderr
// stream from Rust (`leanrt::io::diag_put`). The pieces below
// (`l2r_shared_check<S>(a)`, `l2r_last_shared()`, `l2r_shared_rc_text`)
// allow the same from Reussir code.
#[ffi(import)]
fn lean_dbg_trace_if_shared<T>(msg : LStr, a : T) -> T [{
    {
        let name = ::std::any::type_name::<[:T:]>();
        let boxed = name.starts_with("reussir_rt::") && ::std::mem::size_of::<[:T:]>() == ::std::mem::size_of::<usize>();
        let p = if boxed { unsafe { *(&a as *const [:T:] as *const usize) } } else { 0 };
        let shared = boxed && (p >> 56) == 0 && {
            let c = unsafe { *(p as *const u32) };
            c != 1 && c < 0x8000_0000
        };
        if shared {
            let mut line = b"shared RC ".to_vec();
            line.extend_from_slice(&msg[..msg.iter().position(|&b| b == 0).unwrap_or(msg.len())]);
            line.push(b'\n');
            leanrt::io::diag_put(leanrt::string::from_bytes(&line));
        }
        leanrt::rc_release(msg);
        a
    }
}];

#[ffi(import)]
fn l2r_shared_check<T>(a : T) -> T [{
    {
        let name = ::std::any::type_name::<[:T:]>();
        let boxed = name.starts_with("reussir_rt::") && ::std::mem::size_of::<[:T:]>() == ::std::mem::size_of::<usize>();
        let p = if boxed { unsafe { *(&a as *const [:T:] as *const usize) } } else { 0 };
        let shared = boxed && (p >> 56) == 0 && {
            let c = unsafe { *(p as *const u32) };
            c != 1 && c < 0x8000_0000
        };
        leanrt::set_last_shared(shared);
        a
    }
}];

#[ffi(import)]
fn l2r_last_shared() -> bool [{ leanrt::last_shared() }];

#[ffi(import)]
fn l2r_shared_rc_text(msg : LStr) -> LStr [{
    {
        let mut line = b"shared RC ".to_vec();
        line.extend_from_slice(&msg[..msg.iter().position(|&b| b == 0).unwrap_or(msg.len())]);
        line.push(b'\n');
        leanrt::rc_release(msg);
        leanrt::string::from_bytes(&line)
    }
}];

// `Void.mk` (`runST`'s initial world): the world has no representation.
fn lean_void_mk<T>(x : T) -> L2RUnit { L2RUnit::u{} }

fn lean_dbg_stack_trace<T>(f : L2RUnit -> T) -> T { f(L2RUnit::u{}) }

#[ffi(import)]
fn l2r_sleep_ms(ms : u32) -> u64 [{ { leanrt::task::sleep_ms(ms); 0 } }];

fn lean_dbg_sleep<T>(ms : u32, f : L2RUnit -> T) -> T {
    let ignored = l2r_sleep_ms(ms);
    f(L2RUnit::u{})
}

// `ptrAddrUnsafe` of a value lean2rr may have wrapped or converted for the
// call (a heap value passed as it is goes to `l2r_ptr_addr_obj` below):
// the bits for scalars, the pointer for heap objects
// (runtime handles and Reussir records). Lean uses equal addresses as a
// shortcut for equal values, so an address must never be shared by unequal
// values. An object whose count is 1 here dies with this call (the texture
// holds the only reference): it cannot be the same object as any other live
// value, and a later object may reuse its memory (lean2rr builds wrappers
// such as `ElemBox{x}` at the call for values that cannot cross the FFI
// boundary). It, and any other type, gets a fresh odd number (never equal,
// which only makes such code take its general path). Nullary constructors
// (Reussir immediates: nonzero top byte, or an immortal count) keep their
// pointer.
#[ffi(import)]
fn lean_ptr_addr<T>(a : T) -> u64 [{
    {
        let name = ::std::any::type_name::<[:T:]>();
        let size = ::std::mem::size_of::<[:T:]>();
        let scalar = matches!(name, "u8" | "u16" | "u32" | "u64" | "i8" | "i16" | "i32" | "i64" | "usize" | "isize" | "bool" | "char" | "f32" | "f64");
        let handle = size == ::std::mem::size_of::<usize>() && name.starts_with("reussir_rt::");
        if scalar {
            let mut w: u64 = 0;
            unsafe { ::std::ptr::copy_nonoverlapping(&a as *const [:T:] as *const u8, &mut w as *mut u64 as *mut u8, size) };
            w
        } else if handle {
            let p = unsafe { *(&a as *const [:T:] as *const usize) };
            let dying = (p >> 56) == 0 && unsafe { *(p as *const u32) } == 1;
            if dying { leanrt::fresh_addr() } else { p as u64 }
        } else {
            leanrt::fresh_addr()
        }
    }
}];

// `ptrAddrUnsafe` of a heap value that lean2rr passes as it is (not a
// wrapper built for the call): its handle pointer, whatever its count. The
// value is the Lean object itself, so its address is its identity even when
// this call holds its last reference (`ptrEq a b` where `a`'s own call
// released the other reference to the same object).
#[ffi(import)]
fn l2r_ptr_addr_obj<T>(a : T) -> u64 [{
    {
        let size = ::std::mem::size_of::<[:T:]>();
        if size == ::std::mem::size_of::<usize>() {
            unsafe { *(&a as *const [:T:] as *const usize) as u64 }
        } else {
            leanrt::fresh_addr()
        }
    }
}];

// Sharing is not observable here: answering "shared" / "not a scalar" only
// makes such code take its general path.
fn lean_is_exclusive_obj<T>(a : T) -> bool { false }
fn lean_is_scalar<T>(a : T) -> bool { false }
fn lean_sharecommon_quick<T>(a : T) -> T { a }

