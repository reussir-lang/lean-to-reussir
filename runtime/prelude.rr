// ===========================================================================
// String
//
// Positions are `Nat` byte offsets. A `Nat::Big` position is never valid;
// the functions below reproduce what Lean's C code does with non-scalar
// positions (Lean's scalars stop at 2^63, which matters for `extract`).

#[ffi(import)]
fn lean_mk_string(s : str) -> LStr [{ leanrt::string::from_bytes((*s).as_bytes()) }];

#[ffi(import)]
fn lean_string_of_usize(n : u64) -> LStr [{ leanrt::string::of_u64(n) }];

#[ffi(import)]
fn lean_string_append(a : LStr, b : LStr) -> LStr [{ leanrt::string::append(a, b) }];

#[ffi(import)]
fn lean_string_push(s : LStr, c : u32) -> LStr [{ leanrt::string::push(s, c) }];

#[ffi(import)]
fn l2r_string_size(s : LStr) -> u64 [{ { let r = s.len() as u64; leanrt::rc_release(s); r } }];

#[ffi(import)]
fn l2r_string_length(s : LStr) -> u64 [{ { let r = leanrt::string::length(&s); leanrt::rc_release(s); r } }];

fn lean_string_utf8_byte_size(s : LStr) -> Nat { Nat::Small{l2r_string_size(s)} }
fn lean_string_length(s : LStr) -> Nat { Nat::Small{l2r_string_length(s)} }
fn lean_string_size(s : LStr) -> Nat { Nat::Small{l2r_string_size(s) + 1} }
fn lean_string_len(s : LStr) -> Nat { Nat::Small{l2r_string_length(s)} }

#[ffi(import)]
fn l2r_string_get(s : LStr, i : u64) -> u32 [{ { let r = leanrt::string::get(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_get_opt(s : LStr, i : u64) -> u32 [{ { let r = leanrt::string::get_opt(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_get_fast(s : LStr, i : u64) -> u32 [{ { let r = leanrt::string::get_fast(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_next(s : LStr, i : u64) -> u64 [{ { let r = leanrt::string::next(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_next_fast(s : LStr, i : u64) -> u64 [{ { let r = leanrt::string::next_fast(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_prev(s : LStr, i : u64) -> u64 [{ { let r = leanrt::string::prev(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_is_valid_pos(s : LStr, i : u64) -> bool [{ { let r = leanrt::string::is_valid_pos(&s, i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_extract(s : LStr, b : u64, e : u64) -> LStr [{ leanrt::string::extract(s, b, e) }];
#[ffi(import)]
fn l2r_string_set(s : LStr, i : u64, c : u32) -> LStr [{ leanrt::string::set(s, i, c) }];
#[ffi(import)]
fn l2r_string_get_byte(s : LStr, i : u64) -> u8 [{ { let r = s.get(i as usize).copied().unwrap_or(0); leanrt::rc_release(s); r } }];

// `String.Pos.Raw.get`: the character at byte `p`, or `'A'`.
fn lean_string_utf8_get(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get(s, i),
        Nat::Big(_) => 65
    }
}

// `String.Pos.Raw.get?`: 0x110000 encodes `none` (lean2rr's glue builds
// the `Option Char`).
fn l2r_string_utf8_get_opt(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get_opt(s, i),
        Nat::Big(_) => 1114112
    }
}

// `String.Pos.Raw.get!`: panics (C message) and returns `'A'`.
fn lean_string_utf8_get_bang(s : LStr, p : Nat) -> u32 {
    let c = l2r_string_utf8_get_opt(s, p);
    if c == 1114112 { let ignored = l2r_panic_code(1); 65 } else { c }
}

fn lean_string_utf8_get_fast(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get_fast(s, i),
        Nat::Big(_) => 65
    }
}

// `String.Pos.Raw.next`: `p + 1` at or past the end.
fn lean_string_utf8_next(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => {
            let r = l2r_string_next(s, i);
            if r == 0 { lean_nat_add(p, Nat::Small{1}) } else { Nat::Small{r} }
        },
        Nat::Big(_) => lean_nat_add(p, Nat::Small{1})
    }
}

fn lean_string_utf8_next_fast(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => Nat::Small{l2r_string_next_fast(s, i)},
        Nat::Big(_) => lean_nat_add(p, Nat::Small{1})
    }
}

fn lean_string_utf8_prev(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => Nat::Small{l2r_string_prev(s, i)},
        Nat::Big(_) => lean_nat_sub(p, Nat::Small{1})
    }
}

fn lean_string_utf8_at_end(s : LStr, p : Nat) -> bool {
    match p {
        Nat::Small(i) => i >= l2r_string_size(s),
        Nat::Big(_) => true
    }
}

fn lean_string_is_valid_pos(s : LStr, p : Nat) -> bool {
    match p {
        Nat::Small(i) => l2r_string_is_valid_pos(s, i),
        Nat::Big(_) => false
    }
}

// Lean treats positions >= 2^63 as non-scalars, for which `extract`
// returns the whole string.
fn l2r_nat_is_lean_scalar(p : Nat) -> bool {
    match p {
        Nat::Small(i) => (i >> 63) == 0,
        Nat::Big(_) => false
    }
}

fn lean_string_utf8_extract(s : LStr, b : Nat, e : Nat) -> LStr {
    if l2r_nat_is_lean_scalar(b) && l2r_nat_is_lean_scalar(e) {
        l2r_string_extract(s, lean_usize_of_nat(b), lean_usize_of_nat(e))
    } else { s }
}

fn lean_string_utf8_set(s : LStr, p : Nat, c : u32) -> LStr {
    match p {
        Nat::Small(i) => l2r_string_set(s, i, c),
        Nat::Big(_) => s
    }
}

fn lean_string_get_byte_fast(s : LStr, i : Nat) -> u8 { l2r_string_get_byte(s, lean_usize_of_nat(i)) }
fn lean_string_uget_byte_fast(s : LStr, i : u64) -> u8 { l2r_string_get_byte(s, i) }

#[ffi(import)]
fn lean_string_dec_eq(a : LStr, b : LStr) -> bool [{ { let r = *a == *b; leanrt::rc_release(a); leanrt::rc_release(b); r } }];
#[ffi(import)]
fn lean_string_dec_lt(a : LStr, b : LStr) -> bool [{ { let r = leanrt::string::dec_lt(&a, &b); leanrt::rc_release(a); leanrt::rc_release(b); r } }];
#[ffi(import)]
fn lean_string_lt(a : LStr, b : LStr) -> bool [{ { let r = leanrt::string::dec_lt(&a, &b); leanrt::rc_release(a); leanrt::rc_release(b); r } }];
fn lean_string_eq(a : LStr, b : LStr) -> bool { lean_string_dec_eq(a, b) }
fn lean_string_ne(a : LStr, b : LStr) -> bool { !lean_string_dec_eq(a, b) }
// `String.compare`: 0 = lt, 1 = eq, 2 = gt (lean2rr maps it to `Ordering`).
#[ffi(import)]
fn l2r_string_compare(a : LStr, b : LStr) -> u8 [{ { let r = leanrt::string::compare(&a, &b); leanrt::rc_release(a); leanrt::rc_release(b); r } }];
#[ffi(import)]
fn lean_string_hash(s : LStr) -> u64 [{ { let r = leanrt::string::hash(&s); leanrt::rc_release(s); r } }];

// `String.toUTF8` / `String.ofByteArray` / `String.fromUTF8`: a string and
// a byte array share their representation, so these do not copy.
#[ffi(import)]
fn lean_string_to_utf8(s : LStr) -> RVec<u8> [{ leanrt::array::bytes_of_string(s) }];
#[ffi(import)]
fn lean_string_from_utf8_unchecked(b : RVec<u8>) -> LStr [{ leanrt::array::string_of_bytes(b) }];
#[ffi(import)]
fn lean_string_validate_utf8(b : RVec<u8>) -> bool [{ { let r = leanrt::string::validate(leanrt::array::as_slice(&b)); leanrt::array::release(b); r } }];
// `String.fromUTF8!`-style lossy decoding (`lean_decode_lossy_utf8`).
#[ffi(import)]
fn lean_decode_lossy_utf8(b : RVec<u8>) -> LStr [{ leanrt::string::from_bytes_lossy(leanrt::array::as_slice(&b)) }];

#[ffi(import)]
fn l2r_string_memcmp(a : LStr, b : LStr, ls : u64, rs : u64, len : u64) -> bool [{ { let r = leanrt::string::memcmp(&a, &b, ls, rs, len); leanrt::rc_release(a); leanrt::rc_release(b); r } }];

fn lean_string_memcmp(a : LStr, b : LStr, ls : Nat, rs : Nat, len : Nat) -> bool {
    l2r_string_memcmp(a, b, lean_usize_of_nat(ls), lean_usize_of_nat(rs), lean_usize_of_nat(len))
}

// Slices (`String.Slice` is a Lean structure; lean2rr's glue passes its
// string and byte bounds).
#[ffi(import)]
fn l2r_slice_hash(s : LStr, b : u64, e : u64) -> u64 [{
    leanrt::string::hash(s.get(b as usize..e as usize).unwrap_or(&[]))
}];
#[ffi(import)]
fn l2r_slice_dec_lt(s1 : LStr, b1 : u64, e1 : u64, s2 : LStr, b2 : u64, e2 : u64) -> bool [{
    s1.get(b1 as usize..e1 as usize).unwrap_or(&[]) < s2.get(b2 as usize..e2 as usize).unwrap_or(&[])
}];
// `ByteSlice.beq` (`lean_byteslice_beq`) on the fields `byteArray`,
// `start`, `stop` of both slices (`start ≤ stop ≤ size` by the structure's
// proofs).
#[ffi(import)]
fn l2r_byteslice_beq(a : RVec<u8>, sa : u64, ea : u64, b : RVec<u8>, sb : u64, eb : u64) -> bool [{
    {
        let x = leanrt::array::as_slice(&a).get(sa as usize..ea as usize).unwrap_or(&[]);
        let y = leanrt::array::as_slice(&b).get(sb as usize..eb as usize).unwrap_or(&[]);
        let r = x == y;
        leanrt::array::release(a);
        leanrt::array::release(b);
        r
    }
}];

// ---- Glue helpers for externs over Lean-defined types ----
//
// The prelude cannot name generated types (`List Char`, `Ordering`,
// `Option Char`, ...), so these helpers are generic in the result type and
// take its constructors as arguments: lean2rr's glue for such an extern is a
// call passing the constructor values (nullary constructors as values,
// others as curried closures).

// `String.compare a b` (`lean_string_compare`).
fn l2r_string_compare_with<O>(a : LStr, b : LStr, lt : O, eq : O, gt : O) -> O {
    let r = l2r_string_compare(a, b);
    if r == 0 { lt } else { if r == 1 { eq } else { gt } }
}

// `String.toList`/`String.data` (`lean_string_data`): the characters of a
// valid UTF-8 string, built from the end.
fn l2r_string_to_list<L>(s : LStr, nil : L, cons : u32 -> (L -> L)) -> L {
    l2r_string_to_list_go(s, l2r_string_size(s), nil, cons)
}

fn l2r_string_to_list_go<L>(s : LStr, i : u64, acc : L, cons : u32 -> (L -> L)) -> L {
    if i == 0 { acc } else {
        let j = l2r_string_prev(s, i);
        l2r_string_to_list_go(s, j, cons(l2r_string_get_fast(s, j))(acc), cons)
    }
}

// `String.Pos.Raw.get?` (`lean_string_utf8_get_opt`).
fn l2r_string_utf8_get_opt_with<O>(s : LStr, p : Nat, none : O, some : u32 -> O) -> O {
    let c = l2r_string_utf8_get_opt(s, p);
    if c == 1114112 { none } else { some(c) }
}

// `Array.toList` (`lean_array_to_list`), built from the end. `E` is the
// array's storage type; `cons` takes the stored element (lean2rr unboxes
// inside the closure when the array stores boxes).
fn l2r_array_to_list<E, L>(a : RVec<E>, nil : L, cons : E -> (L -> L)) -> L {
    l2r_array_to_list_go(a, l2r_array_size(a), nil, cons)
}

fn l2r_array_to_list_go<E, L>(a : RVec<E>, i : u64, acc : L, cons : E -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_array_to_list_go(a, i - 1, cons(l2r_array_get(a, i - 1))(acc), cons) }
}

// `Float.frExp` (`lean_float_frexp`): `mk` builds the `Float × Int`.
fn l2r_float_frexp_with<P>(x : f64, mk : f64 -> (Int -> P)) -> P {
    mk(l2r_float_frexp_mant(x))(l2r_float_frexp_exp(x))
}

fn l2r_float32_frexp_with<P>(x : f32, mk : f32 -> (Int -> P)) -> P {
    mk(l2r_float32_frexp_mant(x))(l2r_float32_frexp_exp(x))
}

fn lean_string_pos_sub(a : Nat, b : Nat) -> Nat { lean_nat_sub(a, b) }
fn lean_string_pos_min(a : Nat, b : Nat) -> Nat { if lean_nat_dec_le(a, b) { a } else { b } }

// ---- `String.Internal.*` (implemented by exported Lean definitions) ----

#[ffi(import)]
fn l2r_string_drop(s : LStr, n : u64) -> LStr [{ leanrt::string::drop(s, n) }];
#[ffi(import)]
fn l2r_string_drop_right(s : LStr, n : u64) -> LStr [{ leanrt::string::drop_right(s, n) }];
#[ffi(import)]
fn lean_string_isprefixof(p : LStr, s : LStr) -> bool [{ { let r = leanrt::string::is_prefix_of(&p, &s); leanrt::rc_release(p); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_pos_of(s : LStr, c : u32) -> u64 [{ { let r = leanrt::string::pos_of(&s, c); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn lean_string_contains(s : LStr, c : u32) -> bool [{ { let r = leanrt::string::contains(&s, c); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_pushn(s : LStr, c : u32, n : u64) -> LStr [{ leanrt::string::pushn(s, c, n) }];
#[ffi(import)]
fn lean_string_trim(s : LStr) -> LStr [{ leanrt::string::trim(s) }];
#[ffi(import)]
fn lean_string_capitalize(s : LStr) -> LStr [{ leanrt::string::capitalize(s) }];
#[ffi(import)]
fn l2r_string_offset_of_pos(s : LStr, p : u64) -> u64 [{ { let r = leanrt::string::offset_of_pos(&s, p); leanrt::rc_release(s); r } }];

fn lean_string_drop(s : LStr, n : Nat) -> LStr { l2r_string_drop(s, l2r_nat_sat_u64(n)) }
fn lean_string_dropright(s : LStr, n : Nat) -> LStr { l2r_string_drop_right(s, l2r_nat_sat_u64(n)) }
fn lean_string_posof(s : LStr, c : u32) -> Nat { Nat::Small{l2r_string_pos_of(s, c)} }
fn lean_string_front(s : LStr) -> u32 { l2r_string_get(s, 0) }
fn lean_string_isempty(s : LStr) -> bool { l2r_string_size(s) == 0 }
fn lean_string_offsetofpos(s : LStr, p : Nat) -> Nat { Nat::Small{l2r_string_offset_of_pos(s, l2r_nat_sat_u64(p))} }

fn lean_string_pushn(s : LStr, c : u32, n : Nat) -> LStr {
    match n {
        Nat::Small(k) => l2r_string_pushn(s, c, k),
        Nat::Big(_) => l2r_internal_panic_at<LStr>(4)
    }
}

// A `Nat` as a `u64`, saturating (for counts and positions where every
// value beyond the string behaves alike).
fn l2r_nat_sat_u64(n : Nat) -> u64 {
    match n {
        Nat::Small(x) => x,
        Nat::Big(_) => 18446744073709551615
    }
}

fn lean_string_any(s : LStr, p : u32 -> bool) -> bool { l2r_string_any_from(s, p, 0, l2r_string_size(s)) }

fn l2r_string_any_from(s : LStr, p : u32 -> bool, i : u64, n : u64) -> bool {
    if i >= n { false } else {
        if p(l2r_string_get_fast(s, i)) { true } else { l2r_string_any_from(s, p, l2r_string_next_fast(s, i), n) }
    }
}

// `String.Internal.foldl (f : String → Char → String) (init : String) (s : String)`.
fn lean_string_foldl(f : LStr -> (u32 -> LStr), init : LStr, s : LStr) -> LStr {
    l2r_string_foldl_from(f, init, s, 0, l2r_string_size(s))
}

fn l2r_string_foldl_from(f : LStr -> (u32 -> LStr), acc : LStr, s : LStr, i : u64, n : u64) -> LStr {
    if i >= n { acc } else {
        let acc2 = f(acc)(l2r_string_get_fast(s, i));
        l2r_string_foldl_from(f, acc2, s, l2r_string_next_fast(s, i), n)
    }
}

// `String.Internal.nextWhile s p i`: advance while `p` holds and not at the end.
fn lean_string_nextwhile(s : LStr, p : u32 -> bool, i : Nat) -> Nat {
    match i {
        Nat::Small(k) => Nat::Small{l2r_string_next_while(s, p, k, l2r_string_size(s))},
        Nat::Big(_) => i
    }
}

fn l2r_string_next_while(s : LStr, p : u32 -> bool, i : u64, n : u64) -> u64 {
    if i >= n { i } else {
        if p(l2r_string_get(s, i)) { l2r_string_next_while(s, p, l2r_string_next(s, i), n) } else { i }
    }
}

// ===========================================================================
// Array
//
// `RVec<E>` where `E` is the element's storage type (lean2rr boxes element
// types that cannot cross the FFI boundary). Indices are `Nat`; `Nat::Big`
// indices are always out of bounds.

#[ffi(import)]
fn l2r_array_empty<T>() -> RVec<T> [{ leanrt::array::empty() }];
#[ffi(import)]
fn l2r_array_with_capacity<T>(n : u64, elem : u64) -> RVec<T> [{ leanrt::array::with_capacity_checked(n, elem) }];
#[ffi(import)]
fn l2r_array_size<T>(v : RVec<T>) -> u64 [{ { let r = leanrt::array::size(&v); leanrt::array::release(v); r } }];
// Element `i`, which must be in bounds.
#[ffi(import)]
fn l2r_array_get<T>(v : RVec<T>, i : u64) -> T [{ { let r = leanrt::array::get(&v, i); leanrt::array::release(v); r } }];
#[ffi(import)]
fn l2r_array_push<T>(v : RVec<T>, x : T) -> RVec<T> [{ leanrt::array::push(v, x) }];
#[ffi(import)]
fn l2r_array_set<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> [{ leanrt::array::set(v, i, x) }];
#[ffi(import)]
fn l2r_array_pop<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::pop(v) }];
#[ffi(import)]
fn l2r_array_swap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> [{ leanrt::array::swap(v, i, j) }];
#[ffi(import)]
fn l2r_array_replicate<T>(n : u64, x : T) -> RVec<T> [{ leanrt::array::replicate(n, x) }];
#[ffi(import)]
fn l2r_array_append<T>(a : RVec<T>, b : RVec<T>) -> RVec<T> [{ leanrt::array::append(a, b) }];
#[ffi(import)]
fn l2r_array_extract<T>(v : RVec<T>, b : u64, e : u64) -> RVec<T> [{ leanrt::array::extract(v, b, e) }];
#[ffi(import)]
fn l2r_array_truncate<T>(v : RVec<T>, n : u64) -> RVec<T> [{ leanrt::array::truncate(v, n) }];
#[ffi(import)]
fn l2r_array_reverse<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::reverse(v) }];

fn lean_mk_empty_array<T>() -> RVec<T> { l2r_array_empty<T>() }

// A capacity that is not a Lean scalar (>= 2^63) is an out-of-memory panic;
// `elem` is the native element size (for Lean's allocation-size checks).
fn l2r_mk_empty_with_capacity<T>(n : Nat, elem : u64) -> RVec<T> {
    match n {
        Nat::Small(k) => if (k >> 63) == 0 { l2r_array_with_capacity<T>(k, elem) } else { l2r_internal_panic_at<RVec<T>>(4) },
        Nat::Big(_) => l2r_internal_panic_at<RVec<T>>(4)
    }
}

fn lean_mk_empty_array_with_capacity<T>(n : Nat) -> RVec<T> { l2r_mk_empty_with_capacity<T>(n, 8) }

fn lean_array_get_size<T>(v : RVec<T>) -> Nat { Nat::Small{l2r_array_size(v)} }
fn lean_array_size<T>(v : RVec<T>) -> u64 { l2r_array_size(v) }

fn lean_array_fget<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get(v, lean_usize_of_nat(i)) }
fn lean_array_fget_borrowed<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get(v, lean_usize_of_nat(i)) }
fn lean_array_uget<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }
fn lean_array_uget_borrowed<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }

// Whether `i` is a valid index of an array of size `n`.
fn l2r_index_ok(i : Nat, n : u64) -> bool {
    match i {
        Nat::Small(k) => k < n,
        Nat::Big(_) => false
    }
}

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default.
fn lean_array_get<T>(dflt : T, v : RVec<T>, i : Nat) -> T {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_get(v, lean_usize_of_nat(i)) } else {
        let ignored = l2r_panic_code(0);
        dflt
    }
}

fn lean_array_get_borrowed<T>(dflt : T, v : RVec<T>, i : Nat) -> T { lean_array_get(dflt, v, i) }

fn lean_array_fset<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> { l2r_array_set(v, lean_usize_of_nat(i), x) }
fn lean_array_uset<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> { l2r_array_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_array_set<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_set(v, lean_usize_of_nat(i), x) } else {
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_array_push<T>(v : RVec<T>, x : T) -> RVec<T> { l2r_array_push(v, x) }
fn lean_array_pop<T>(v : RVec<T>) -> RVec<T> { l2r_array_pop(v) }

fn lean_array_fswap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    l2r_array_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j))
}

fn lean_array_uswap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> { l2r_array_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_array_swap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    let n = l2r_array_size(v);
    if l2r_index_ok(i, n) && l2r_index_ok(j, n) { l2r_array_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) } else { v }
}

// `Array.replicate n x`.
fn lean_mk_array<T>(n : Nat, x : T) -> RVec<T> {
    match n {
        Nat::Small(k) => l2r_array_replicate(k, x),
        Nat::Big(_) => l2r_internal_panic_at<RVec<T>>(4)
    }
}

// ---- Array Nat / Array Int ----
//
// One tagged word per element (leanrt::tagvec) instead of a heap box per
// element. lean2rr represents `Array Nat` as `LNatArr` and `Array Int` as
// `LIntArr`, and calls `lean_natarr_xxx` / `l2r_natarr_xxx` (`intarr`) in
// place of `lean_array_xxx<E>` / `l2r_array_xxx<E>`.

#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LNatArr;

#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LIntArr;

// The big value of an (even) word returned by `l2r_natarr_word_owned` /
// `l2r_intarr_word_owned`, taking over the reference the word owns.
#[ffi(import)]
fn l2r_big_of_owned_word(w : u64) -> LBig [{ leanrt::tagvec::big_of_owned_word(w) }];

// BEGIN GENERATED: tagarr (runtime/gen_tagarr.py)

// ---- Array Nat (LNatArr) ----

#[ffi(import)]
fn l2r_natarr_empty() -> LNatArr [{ leanrt::tagvec::empty() }];
#[ffi(import)]
fn l2r_natarr_with_capacity(n : u64) -> LNatArr [{ leanrt::tagvec::with_capacity(n) }];
#[ffi(import)]
fn l2r_natarr_replicate_word(n : u64, w : u64) -> LNatArr [{ leanrt::tagvec::replicate_word(n, w) }];
#[ffi(import)]
fn l2r_natarr_replicate_big(n : u64, b : LBig) -> LNatArr [{ leanrt::tagvec::replicate_big(n, b) }];
#[ffi(import)]
fn l2r_natarr_size(a : LNatArr) -> u64 [{ { let r = leanrt::tagvec::size(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_natarr_word(a : LNatArr, i : u64) -> u64 [{ { let r = leanrt::tagvec::word(&a, i); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_natarr_big(a : LNatArr, i : u64) -> LBig [{ { let r = leanrt::tagvec::big(&a, i); leanrt::rc_release(a); r } }];
// The word at `i`; a big word owns a reference (see `l2r_big_of_owned_word`).
#[ffi(import)]
fn l2r_natarr_word_owned(a : LNatArr, i : u64) -> u64 [{ { let r = leanrt::tagvec::word_owned(&a, i); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_natarr_set_word(a : LNatArr, i : u64, w : u64) -> LNatArr [{ leanrt::tagvec::set_word(a, i, w) }];
#[ffi(import)]
fn l2r_natarr_set_big(a : LNatArr, i : u64, b : LBig) -> LNatArr [{ leanrt::tagvec::set_big(a, i, b) }];
#[ffi(import)]
fn l2r_natarr_push_word(a : LNatArr, w : u64) -> LNatArr [{ leanrt::tagvec::push_word(a, w) }];
#[ffi(import)]
fn l2r_natarr_push_big(a : LNatArr, b : LBig) -> LNatArr [{ leanrt::tagvec::push_big(a, b) }];
#[ffi(import)]
fn l2r_natarr_pop(a : LNatArr) -> LNatArr [{ leanrt::tagvec::pop(a) }];
#[ffi(import)]
fn l2r_natarr_swap(a : LNatArr, i : u64, j : u64) -> LNatArr [{ leanrt::tagvec::swap(a, i, j) }];
#[ffi(import)]
fn l2r_natarr_append(a : LNatArr, b : LNatArr) -> LNatArr [{ leanrt::tagvec::append(a, b) }];
#[ffi(import)]
fn l2r_natarr_extract(a : LNatArr, s : u64, e : u64) -> LNatArr [{ leanrt::tagvec::extract(a, s, e) }];
#[ffi(import)]
fn l2r_natarr_truncate(a : LNatArr, n : u64) -> LNatArr [{ leanrt::tagvec::truncate(a, n) }];
#[ffi(import)]
fn l2r_natarr_reverse(a : LNatArr) -> LNatArr [{ leanrt::tagvec::reverse(a) }];


// Small values below 2^63 are stored as `(v << 1) | 1`; all others as big
// numbers (normalized back to `Nat::Small` when read, for values below 2^64).
// The array is consumed once (a second use in one branch would make Reussir
// release it out of line in the other): a big word comes back owning a
// reference.
fn l2r_natarr_get(a : LNatArr, i : u64) -> Nat {
    let w = l2r_natarr_word_owned(a, i);
    if (w & 1) == 1 { Nat::Small{w >> 1} } else { l2r_nat_norm(l2r_big_of_owned_word(w)) }
}

fn l2r_natarr_set(a : LNatArr, i : u64, x : Nat) -> LNatArr {
    match x {
        Nat::Small(v) => if (v >> 63) == 0 { l2r_natarr_set_word(a, i, (v << 1) | 1) } else { l2r_natarr_set_big(a, i, l2r_big_of_u64(v)) },
        Nat::Big(b) => l2r_natarr_set_big(a, i, b)
    }
}

fn l2r_natarr_push(a : LNatArr, x : Nat) -> LNatArr {
    match x {
        Nat::Small(v) => if (v >> 63) == 0 { l2r_natarr_push_word(a, (v << 1) | 1) } else { l2r_natarr_push_big(a, l2r_big_of_u64(v)) },
        Nat::Big(b) => l2r_natarr_push_big(a, b)
    }
}

fn l2r_natarr_replicate(n : u64, x : Nat) -> LNatArr {
    match x {
        Nat::Small(v) => if (v >> 63) == 0 { l2r_natarr_replicate_word(n, (v << 1) | 1) } else { l2r_natarr_replicate_big(n, l2r_big_of_u64(v)) },
        Nat::Big(b) => l2r_natarr_replicate_big(n, b)
    }
}


fn lean_mk_empty_natarr() -> LNatArr { l2r_natarr_empty() }

fn lean_mk_empty_natarr_with_capacity(n : Nat) -> LNatArr {
    match n {
        Nat::Small(c) => if (c >> 63) == 0 { l2r_natarr_with_capacity(c) } else { l2r_internal_panic_at<LNatArr>(4) },
        Nat::Big(_) => l2r_internal_panic_at<LNatArr>(4)
    }
}

fn lean_natarr_get_size(v : LNatArr) -> Nat { Nat::Small{l2r_natarr_size(v)} }
fn lean_natarr_size(v : LNatArr) -> u64 { l2r_natarr_size(v) }
fn lean_natarr_fget(v : LNatArr, i : Nat) -> Nat { l2r_natarr_get(v, lean_usize_of_nat(i)) }
fn lean_natarr_fget_borrowed(v : LNatArr, i : Nat) -> Nat { l2r_natarr_get(v, lean_usize_of_nat(i)) }
fn lean_natarr_uget(v : LNatArr, i : u64) -> Nat { l2r_natarr_get(v, i) }
fn lean_natarr_uget_borrowed(v : LNatArr, i : u64) -> Nat { l2r_natarr_get(v, i) }

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default.
fn lean_natarr_get(dflt : Nat, v : LNatArr, i : Nat) -> Nat {
    if l2r_index_ok(i, l2r_natarr_size(v)) { l2r_natarr_get(v, lean_usize_of_nat(i)) } else {
        let ignored = l2r_panic_code(0);
        dflt
    }
}

fn lean_natarr_get_borrowed(dflt : Nat, v : LNatArr, i : Nat) -> Nat { lean_natarr_get(dflt, v, i) }
fn lean_natarr_fset(v : LNatArr, i : Nat, x : Nat) -> LNatArr { l2r_natarr_set(v, lean_usize_of_nat(i), x) }
fn lean_natarr_uset(v : LNatArr, i : u64, x : Nat) -> LNatArr { l2r_natarr_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_natarr_set(v : LNatArr, i : Nat, x : Nat) -> LNatArr {
    if l2r_index_ok(i, l2r_natarr_size(v)) { l2r_natarr_set(v, lean_usize_of_nat(i), x) } else {
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_natarr_push(v : LNatArr, x : Nat) -> LNatArr { l2r_natarr_push(v, x) }
fn lean_natarr_pop(v : LNatArr) -> LNatArr { l2r_natarr_pop(v) }
fn lean_natarr_fswap(v : LNatArr, i : Nat, j : Nat) -> LNatArr { l2r_natarr_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) }
fn lean_natarr_uswap(v : LNatArr, i : u64, j : u64) -> LNatArr { l2r_natarr_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_natarr_swap(v : LNatArr, i : Nat, j : Nat) -> LNatArr {
    let n = l2r_natarr_size(v);
    if l2r_index_ok(i, n) && l2r_index_ok(j, n) { l2r_natarr_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) } else { v }
}

// `Array.replicate n x`.
fn lean_mk_natarr(n : Nat, x : Nat) -> LNatArr {
    match n {
        Nat::Small(c) => l2r_natarr_replicate(c, x),
        Nat::Big(_) => l2r_internal_panic_at<LNatArr>(4)
    }
}

// `Array.toList` glue (see `l2r_array_to_list`).
fn l2r_natarr_to_list<L>(a : LNatArr, nil : L, cons : Nat -> (L -> L)) -> L {
    l2r_natarr_to_list_go(a, l2r_natarr_size(a), nil, cons)
}

fn l2r_natarr_to_list_go<L>(a : LNatArr, i : u64, acc : L, cons : Nat -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_natarr_to_list_go(a, i - 1, cons(l2r_natarr_get(a, i - 1))(acc), cons) }
}


