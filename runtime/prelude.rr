        0 => leanrt::sys::pid(false), 1 => leanrt::sys::pid(true), 2 => leanrt::sys::hrtime(),
        3 => leanrt::sys::memory(0), 4 => leanrt::sys::memory(1), 5 => leanrt::sys::memory(2), _ => leanrt::sys::memory(3)
    }
}];
