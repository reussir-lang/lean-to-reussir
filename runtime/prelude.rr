// lean2rr runtime prelude.
//
// Prepended to every program lean2rr generates. A Lean extern whose C
// symbol is `lean_xxx` is implemented here by the function `lean_xxx`, on
// lean2rr's representation types, with the semantics of Lean's own C
// runtime (lean.h and src/runtime/*.cpp of Lean 4.33). `l2r_*` functions
// are primitives for lean2rr-generated glue (externs over Lean-defined
// types) and internal helpers. See runtime/README.md.
//
// Fast paths are plain Reussir code (inlined into the program); slow paths
// call small `#[ffi(import)]` textures, which call into the `leanrt` Rust
// crate (runtime/leanrt). Every call consumes its arguments.
//
// Conventions for FFI imports: only integers, floats, bool, opaque types and
// shared records cross the boundary; functions without a result return a
// dummy `u64`; no `str` parameters in hot paths (only literals use them).

extern "rust" [{
    extern crate leanrt;
    use leanrt::string::Utf8;
    use reussir_rt::rc::Rc;
    use reussir_rt::collections::vec::Vec as RVecImpl;
}];

// ===========================================================================
// Runtime types

// Unit-like values (erased values, `PUnit`, the IO world). Reussir's own
// `unit` is result-only and cannot be stored or passed.
enum [value] L2RUnit {
    u
}

// A Lean `String`: valid UTF-8 bytes and the number of characters (Lean's
// `m_length`, kept by every operation), copy-on-write.
#[ffi(rust = "::reussir_rt::rc::Rc<(::std::vec::Vec<u8>, u64)>")]
pub struct LStr;

// A big number: (negative?, magnitude limbs), little-endian 64-bit limbs,
// normalized. Shared by `Nat` (never negative) and `Int`.
#[ffi(rust = "::reussir_rt::rc::Rc<(bool, ::std::vec::Vec<u64>)>")]
pub struct LBig;

// A Lean `Array` (and `ByteArray` = RVec<u8>, `FloatArray` = RVec<f64>):
// a copy-on-write vector, updated in place when unique. The Rust type wraps
// Reussir's vector so that freeing nested containers does not recurse
// (`leanrt::drop`).
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct RVec<T>;

// A mutable reference cell (`ST.Ref`/`IO.Ref`): a shared 0-or-1 element
// vector, mutated in place through every alias (empty after `take`).
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct LRef<T>;

// A mutable cell holding one value, mutated in place through every alias:
// the state of a `Thunk` or `Task` (lean2rr generates the state type).
// One allocation: the count and the value. (`leanrt::drop::Cell` wraps
// Reussir's `Rc`, as `RVec` does.)
#[ffi(rust = "::leanrt::drop::Cell")]
pub struct LCell<T>;

// A runtime object (`Rc<Box<dyn Any>>`): a file handle (`IO.FS.Handle`), a
// `Std.Sync` mutex or condition variable, a timer, socket or operation of
// the event loop (all `lcAny` in mono code).
#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LHandle;

// A Lean `Nat`. Invariant: `Big` only holds values >= 2^64.
enum [value] Nat {
    Small(u64),
    Big(LBig)
}

// A Lean `Int`. Invariant: `Big` only holds values outside the i64 range.
enum [value] Int {
    Small(i64),
    Big(LBig)
}

// ===========================================================================
// Process, panics, unreachable code

#[ffi(import)]
fn l2r_exit(code : u32) -> unit [{ leanrt::io::exit(code as i32) }];

// `IO.Process.exit` (the status is a `UInt8`): what other threads would
// have done by now goes first (`sched::effect`).
#[ffi(import)]
fn l2r_process_exit(code : u8) -> u64 [{ { leanrt::sched::effect(); leanrt::io::exit(code as i32) } }];

// `IO.Process.forceExit` (`std::_Exit`): no flushing, no exit handlers.
#[ffi(import)]
fn l2r_process_force_exit(code : u8) -> u64 [{ { extern "C" { fn _exit(code: i32) -> !; } unsafe { _exit(code as i32) } } }];

#[ffi(import)]
fn l2r_argc() -> u64 [{ (leanrt::rt::args().len() as u64).saturating_sub(1) }];

#[ffi(import)]
fn l2r_argv(i : u64) -> LStr [{ leanrt::string::from_bytes_lossy(&leanrt::rt::args()[i as usize + 1]) }];

// Top-level `error e`: `uncaught exception: <e.toString>`, exit 1.
#[ffi(import)]
fn l2r_uncaught_exception(msg : LStr) -> unit [{ leanrt::uncaught_exception(msg.utf8()) }];

// `lean_internal_panic` messages, by code (no `str` arguments on hot paths).
#[ffi(import)]
fn l2r_internal_panic(code : u64) -> u64 [{
    leanrt::internal_panic(match code {
        0 => "unreachable code has been reached",
        1 => "Nat.pow exponent is too big",
        2 => "Nat.shiftl exponent is too big",
        3 => "Nat.shiftr exponent is too big",
        4 => "out of memory",
        5 => "executed 'sorry'",
        6 => "integer overflow in runtime computation",
        _ => "internal error",
    })
}];

fn l2r_unreachable<T>() -> T {
    let ignored = l2r_internal_panic(0);
    core::intrinsic::panic::panic<T>()
}

// Releases `x` out of line. A wildcard arm that rrc copies into several
// constructors releases the values of wide enums it holds with it
// (Lower/Code, sinkWildcardHeld), where rrc would expand each release in
// line, a match over the variants, in every copy. Kept out of rrc's
// inliner, which would put the expansion back.
#[transform_anchor]
fn l2r_sink<T>(x : T) -> u64 { 0 }

fn l2r_internal_panic_at<T>(code : u64) -> T {
    let ignored = l2r_internal_panic(code);
    core::intrinsic::panic::panic<T>()
}

// Runtime diagnostics go where native Lean's `io_eprintln` sends them: to
// the *current* stderr stream (`IO.setStderr`), through
// `l2r_stderr_put(s)`, which lean2rr defines in every program (it writes
// with the stream's `putStr`, ignoring errors). Messages printed right
// before the process dies (abort-mode panics, internal panics, uncaught
// exceptions, stack overflow) go to descriptor 2, as natively.

// `lean_panic_impl`'s lines: the message, then (unless `LEAN_BACKTRACE=0`)
// `backtrace:` and the frames (none here). Natively one `io_eprintln` per
// line; written here with one `putStr` (the same bytes). Under
// `LEAN_ABORT_ON_PANIC` this does not return: `leanrt::panic_msg` flushes
// stdout, writes the message to descriptor 2 (`std::cerr`) and aborts.
#[ffi(import)]
fn l2r_panic_text(msg : LStr) -> LStr [{
    {
        if std::env::var_os("LEAN_ABORT_ON_PANIC").is_some() {
            leanrt::panic_msg(msg.utf8());
        }
        let mut t = msg.utf8().to_vec();
        t.push(b'\n');
        if std::env::var("LEAN_BACKTRACE").map(|v| v != "0").unwrap_or(true) {
            t.extend_from_slice(b"backtrace:\n(stack trace unavailable)\n");
        }
        leanrt::rc_release(msg);
        leanrt::string::from_bytes(&t)
    }
}];

fn l2r_panic_str(msg : LStr) -> u64 { l2r_stderr_put(l2r_panic_text(msg)) }

// Messages the C runtime itself panics with, by code.
#[ffi(import)]
fn l2r_panic_code_text(code : u64) -> LStr [{
    leanrt::string::from_bytes(match code {
        0 => "Error: index out of bounds".as_bytes(),
        1 => "Error: invalid `String.Pos` at `String.get!`".as_bytes(),
        _ => "Error".as_bytes(),
    })
}];

// These panics come from inside the prelude's array and string helpers,
// which the stream code behind `l2r_stderr_put` itself uses. A Reussir-level
// call cycle there crashes rrc's TokenReusePass under `--reuse-across-call`
// (a Reussir bug), so the message reaches `l2r_stderr_put` from Rust,
// through the program's `l2r_stderr_put_c` trampoline
// (`leanrt::io::diag_put`; descriptor 2 without one).
fn l2r_panic_code(code : u64) -> u64 { l2r_diag_put(l2r_panic_text(l2r_panic_code_text(code))) }

#[ffi(import)]
fn l2r_diag_put(s : LStr) -> u64 [{ { leanrt::io::diag_put(s); 0 } }];

// `panicCore {α} [Inhabited α] (msg : String) : α`.
fn lean_panic_fn_borrowed<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

fn lean_panic_fn<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

// `sorryAx`: `INTERNAL PANIC: executed 'sorry'`.
fn lean_sorry<T>(b : bool) -> T { l2r_internal_panic_at<T>(5) }

// ===========================================================================
// Nat
//
// Small values are unboxed words; arithmetic checks for overflow and falls
// back to the bignum routines in leanrt::big (GMP). Results that may fall
// back into the word range are normalized by `l2r_nat_norm`.

#[ffi(import)]
fn l2r_big_of_u64(x : u64) -> LBig [{ leanrt::big::of_u64(x) }];
#[ffi(import)]
fn l2r_big_of_limbs2(lo : u64, hi : u64) -> LBig [{ leanrt::big::of_limbs2(lo, hi) }];
#[ffi(import)]
fn l2r_big_is_u64(a : LBig) -> bool [{ { let r = leanrt::big::is_u64(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_big_low(a : LBig) -> u64 [{ { let r = leanrt::big::low_limb(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_big_of_decimal(s : str) -> LBig [{ leanrt::big::of_decimal(&*s) }];
// A big `Nat` literal: its decimal digits (from the string literal table).
#[ffi(import)]
fn l2r_big_of_decimal_lstr(s : LStr) -> LBig [{ { let r = leanrt::big::of_decimal(unsafe { ::std::str::from_utf8_unchecked(&s.utf8()[..]) }); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_big_to_lstr(a : LBig) -> LStr [{ leanrt::string::from_vec(leanrt::big::to_decimal(&a)) }];
#[ffi(import)]
fn l2r_big_add(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_add(a, b) }];
#[ffi(import)]
fn l2r_big_add_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_add_u64(a, y) }];
#[ffi(import)]
fn l2r_u64_add_overflow(x : u64, y : u64) -> LBig [{ leanrt::big::u64_add_overflow(x, y) }];
#[ffi(import)]
fn l2r_big_sub(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_sub(a, b) }];
#[ffi(import)]
fn l2r_big_sub_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_sub_u64(a, y) }];
#[ffi(import)]
fn l2r_big_mul(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_mul(a, b) }];
#[ffi(import)]
fn l2r_big_mul_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_mul_u64(a, y) }];
#[ffi(import)]
fn l2r_u64_mul_wide(x : u64, y : u64) -> LBig [{ leanrt::big::u64_mul_wide(x, y) }];
#[ffi(import)]
fn l2r_u64_mul_hi(x : u64, y : u64) -> u64 [{ leanrt::big::u64_mul_hi(x, y) }];
#[ffi(import)]
fn l2r_big_div(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_div(a, b) }];
#[ffi(import)]
fn l2r_big_div_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_div_u64(a, y) }];
#[ffi(import)]
fn l2r_big_mod(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_mod(a, b) }];
#[ffi(import)]
fn l2r_big_mod_u64(a : LBig, y : u64) -> u64 [{ leanrt::big::nat_mod_u64(a, y) }];
#[ffi(import)]
fn l2r_big_cmp(a : LBig, b : LBig) -> i64 [{ leanrt::big::nat_cmp(a, b) }];
#[ffi(import)]
fn l2r_big_eq(a : LBig, b : LBig) -> bool [{ leanrt::big::nat_eq(a, b) }];
#[ffi(import)]
fn l2r_big_land(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_land(a, b) }];
#[ffi(import)]
fn l2r_big_land_u64(a : LBig, y : u64) -> u64 [{ leanrt::big::nat_land_u64(a, y) }];
#[ffi(import)]
fn l2r_big_lor(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_lor(a, b) }];
#[ffi(import)]
fn l2r_big_lor_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_lor_u64(a, y) }];
#[ffi(import)]
fn l2r_big_xor(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_xor(a, b) }];
#[ffi(import)]
fn l2r_big_xor_u64(a : LBig, y : u64) -> LBig [{ leanrt::big::nat_xor_u64(a, y) }];
#[ffi(import)]
fn l2r_big_shl(a : LBig, s : u64) -> LBig [{ leanrt::big::nat_shl(a, s) }];
#[ffi(import)]
fn l2r_big_shr(a : LBig, s : u64) -> LBig [{ leanrt::big::nat_shr(a, s) }];
#[ffi(import)]
fn l2r_big_log2(a : LBig) -> u64 [{ leanrt::big::nat_log2(a) }];
#[ffi(import)]
fn l2r_big_pow(a : LBig, e : u64) -> LBig [{ leanrt::big::nat_pow(a, e) }];
#[ffi(import)]
fn l2r_big_gcd(a : LBig, b : LBig) -> LBig [{ leanrt::big::nat_gcd(a, b) }];
// `x ^ e` for x >= 2 and e < 64, or 0 when it overflows.
#[ffi(import)]
fn l2r_u64_pow_checked(x : u64, e : u64) -> u64 [{ x.checked_pow(e as u32).unwrap_or(0) }];

fn l2r_nat_norm(b : LBig) -> Nat {
    if l2r_big_is_u64(b) { Nat::Small{l2r_big_low(b)} } else { Nat::Big{b} }
}

fn l2r_nat_to_big(n : Nat) -> LBig {
    match n {
        Nat::Small(x) => l2r_big_of_u64(x),
        Nat::Big(b) => b
    }
}

// Big literals (lean2rr emits them for values >= 2^63).
fn lean_cstr_to_nat(s : str) -> Nat { l2r_nat_norm(l2r_big_of_decimal(s)) }

fn lean_unsigned_to_nat(x : u32) -> Nat { Nat::Small{x as u64} }

fn lean_nat_add(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => {
                    let s = x + y;
                    if s < x { Nat::Big{l2r_u64_add_overflow(x, y)} } else { Nat::Small{s} }
                },
                Nat::Big(bb) => Nat::Big{l2r_big_add_u64(bb, x)}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => Nat::Big{l2r_big_add_u64(ba, y)},
                Nat::Big(bb) => Nat::Big{l2r_big_add(ba, bb)}
            }
        }
    }
}

fn lean_nat_succ(a : Nat) -> Nat { lean_nat_add(a, Nat::Small{1}) }

fn lean_nat_sub(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => if x < y { Nat::Small{0} } else { Nat::Small{x - y} },
                Nat::Big(_) => Nat::Small{0}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => l2r_nat_norm(l2r_big_sub_u64(ba, y)),
                Nat::Big(bb) => l2r_nat_norm(l2r_big_sub(ba, bb))
            }
        }
    }
}

fn lean_nat_pred(a : Nat) -> Nat {
    match a {
        Nat::Small(x) => if x == 0 { Nat::Small{0} } else { Nat::Small{x - 1} },
        Nat::Big(ba) => l2r_nat_norm(l2r_big_sub_u64(ba, 1))
    }
}

fn l2r_u64_mul(x : u64, y : u64) -> Nat {
    if (x | y) < 4294967296 { Nat::Small{x * y} } else {
        let hi = l2r_u64_mul_hi(x, y);
        if hi == 0 { Nat::Small{x * y} } else { Nat::Big{l2r_big_of_limbs2(x * y, hi)} }
    }
}

fn lean_nat_mul(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => l2r_u64_mul(x, y),
                Nat::Big(bb) => if x == 0 { Nat::Small{0} } else { Nat::Big{l2r_big_mul_u64(bb, x)} }
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => if y == 0 { Nat::Small{0} } else { Nat::Big{l2r_big_mul_u64(ba, y)} },
                Nat::Big(bb) => Nat::Big{l2r_big_mul(ba, bb)}
            }
        }
    }
}

fn lean_nat_div(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => if y == 0 { Nat::Small{0} } else { Nat::Small{x / y} },
                Nat::Big(_) => Nat::Small{0}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => if y == 0 { Nat::Small{0} } else { l2r_nat_norm(l2r_big_div_u64(ba, y)) },
                Nat::Big(bb) => l2r_nat_norm(l2r_big_div(ba, bb))
            }
        }
    }
}

fn lean_nat_div_exact(a : Nat, b : Nat) -> Nat { lean_nat_div(a, b) }

fn lean_nat_mod(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => if y == 0 { a } else { Nat::Small{x % y} },
                Nat::Big(_) => a
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => if y == 0 { a } else { Nat::Small{l2r_big_mod_u64(ba, y)} },
                Nat::Big(bb) => l2r_nat_norm(l2r_big_mod(ba, bb))
            }
        }
    }
}

// Three-way comparison: -1, 0, 1. `Big` values exceed every `Small` one.
fn l2r_nat_cmp(a : Nat, b : Nat) -> i64 {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => if x < y { 0 - 1 } else { if x == y { 0 } else { 1 } },
                Nat::Big(_) => 0 - 1
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(_) => 1,
                Nat::Big(bb) => l2r_big_cmp(ba, bb)
            }
        }
    }
}

fn lean_nat_dec_eq(a : Nat, b : Nat) -> bool {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => x == y,
                Nat::Big(_) => false
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(_) => false,
                Nat::Big(bb) => l2r_big_eq(ba, bb)
            }
        }
    }
}

fn lean_nat_eq(a : Nat, b : Nat) -> bool { lean_nat_dec_eq(a, b) }
fn lean_nat_ne(a : Nat, b : Nat) -> bool { !lean_nat_dec_eq(a, b) }

fn lean_nat_dec_lt(a : Nat, b : Nat) -> bool {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => x < y,
                Nat::Big(_) => true
            }
        },
        Nat::Big(_) => l2r_nat_cmp(a, b) < 0
    }
}

fn lean_nat_dec_le(a : Nat, b : Nat) -> bool {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => x <= y,
                Nat::Big(_) => true
            }
        },
        Nat::Big(_) => l2r_nat_cmp(a, b) <= 0
    }
}

fn lean_nat_lt(a : Nat, b : Nat) -> bool { lean_nat_dec_lt(a, b) }
fn lean_nat_le(a : Nat, b : Nat) -> bool { lean_nat_dec_le(a, b) }

fn lean_nat_land(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => Nat::Small{x & y},
                Nat::Big(bb) => Nat::Small{l2r_big_land_u64(bb, x)}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => Nat::Small{l2r_big_land_u64(ba, y)},
                Nat::Big(bb) => l2r_nat_norm(l2r_big_land(ba, bb))
            }
        }
    }
}

fn lean_nat_lor(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => Nat::Small{x | y},
                Nat::Big(bb) => Nat::Big{l2r_big_lor_u64(bb, x)}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => Nat::Big{l2r_big_lor_u64(ba, y)},
                Nat::Big(bb) => Nat::Big{l2r_big_lor(ba, bb)}
            }
        }
    }
}

fn lean_nat_lxor(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => Nat::Small{x ^ y},
                Nat::Big(bb) => Nat::Big{l2r_big_xor_u64(bb, x)}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => Nat::Big{l2r_big_xor_u64(ba, y)},
                Nat::Big(bb) => l2r_nat_norm(l2r_big_xor(ba, bb))
            }
        }
    }
}

// `Nat.shiftLeft`: 0 stays 0; otherwise a shift amount above 2^32 - 1 is an
// internal panic (as `lean_nat_shiftl`).
fn lean_nat_shiftl(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            if x == 0 { a } else {
                match b {
                    Nat::Small(s) => {
                        if s < 64 {
                            if ((x >> (63 - s)) >> 1) == 0 { Nat::Small{x << s} } else { Nat::Big{l2r_big_shl(l2r_big_of_u64(x), s)} }
                        } else {
                            if s > 4294967295 { l2r_internal_panic_at<Nat>(2) } else { Nat::Big{l2r_big_shl(l2r_big_of_u64(x), s)} }
                        }
                    },
                    Nat::Big(_) => l2r_internal_panic_at<Nat>(2)
                }
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(s) => if s > 4294967295 { l2r_internal_panic_at<Nat>(2) } else { Nat::Big{l2r_big_shl(ba, s)} },
                Nat::Big(_) => l2r_internal_panic_at<Nat>(2)
            }
        }
    }
}

// `Nat.shiftRight`: a big shift amount gives 0; a big value shifted by more
// than 2^32 - 1 panics unless every bit is shifted out.
fn lean_nat_shiftr(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(s) => if s < 64 { Nat::Small{x >> s} } else { Nat::Small{0} },
                Nat::Big(_) => Nat::Small{0}
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(s) => {
                    if s > 4294967295 {
                        if l2r_big_log2(ba) >= s { l2r_internal_panic_at<Nat>(3) } else { Nat::Small{0} }
                    } else {
                        l2r_nat_norm(l2r_big_shr(ba, s))
                    }
                },
                Nat::Big(_) => Nat::Small{0}
            }
        }
    }
}

fn lean_nat_log2(a : Nat) -> Nat {
    match a {
        Nat::Small(x) => if x == 0 { Nat::Small{0} } else { Nat::Small{63 - core::intrinsic::math::ctlz(x)} },
        Nat::Big(ba) => Nat::Small{l2r_big_log2(ba)}
    }
}

// `Nat.pow`: an exponent above 2^32 - 1 is an internal panic, whatever the base.
fn lean_nat_pow(a : Nat, b : Nat) -> Nat {
    match b {
        Nat::Small(e) => if e > 4294967295 { l2r_internal_panic_at<Nat>(1) } else { l2r_nat_pow_u64(a, e) },
        Nat::Big(_) => l2r_internal_panic_at<Nat>(1)
    }
}

fn l2r_nat_pow_u64(a : Nat, e : u64) -> Nat {
    if e == 0 { Nat::Small{1} } else {
        match a {
            Nat::Small(x) => {
                if x < 2 { a } else {
                    if e < 64 {
                        let r = l2r_u64_pow_checked(x, e);
                        if r == 0 { Nat::Big{l2r_big_pow(l2r_big_of_u64(x), e)} } else { Nat::Small{r} }
                    } else {
                        Nat::Big{l2r_big_pow(l2r_big_of_u64(x), e)}
                    }
                }
            },
            Nat::Big(ba) => Nat::Big{l2r_big_pow(ba, e)}
        }
    }
}

fn l2r_u64_gcd(x : u64, y : u64) -> u64 {
    if y == 0 { x } else { l2r_u64_gcd(y, x % y) }
}

fn lean_nat_gcd(a : Nat, b : Nat) -> Nat {
    match a {
        Nat::Small(x) => {
            match b {
                Nat::Small(y) => Nat::Small{l2r_u64_gcd(x, y)},
                Nat::Big(bb) => if x == 0 { b } else { Nat::Small{l2r_u64_gcd(x, l2r_big_mod_u64(bb, x))} }
            }
        },
        Nat::Big(ba) => {
            match b {
                Nat::Small(y) => if y == 0 { a } else { Nat::Small{l2r_u64_gcd(y, l2r_big_mod_u64(ba, y))} },
                Nat::Big(bb) => l2r_nat_norm(l2r_big_gcd(ba, bb))
            }
        }
    }
}

// `Nat.repr n` for `n < 128`: as natively (`Nat.reprFast` reads the
// closed term `Nat.reprArray`), the same shared string every time.
#[ffi(import)]
fn l2r_nat_repr_small(x : u64) -> LStr [{ leanrt::string::repr_small(x) }];

// Decimal representation (`Nat.repr`); lean2rr replaces Lean's `Nat.repr`
// and `Nat.reprFast` with it (the former builds big numbers digit by digit).
fn l2r_nat_repr(a : Nat) -> LStr {
    match a {
        Nat::Small(x) => if x < 128 { l2r_nat_repr_small(x) } else { lean_string_of_usize(x) },
        Nat::Big(ba) => l2r_big_to_lstr(ba)
    }
}

fn lean_system_platform_nbits(u : L2RUnit) -> Nat { Nat::Small{64} }

// ===========================================================================
// Int
//
// Small values are unboxed i64s; overflow falls back to leanrt::big. Mixed
// operations convert the small operand to a big number (rare in practice).

#[ffi(import)]
fn l2r_big_of_i64(x : i64) -> LBig [{ leanrt::big::of_i64(x) }];
#[ffi(import)]
fn l2r_big_fits_i64(a : LBig) -> bool [{ { let r = leanrt::big::fits_i64(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_big_to_i64(a : LBig) -> i64 [{ { let r = leanrt::big::to_i64(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_big_low_twos(a : LBig) -> u64 [{ { let r = leanrt::big::low_u64_twos(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_big_is_neg(a : LBig) -> bool [{ { let r = leanrt::big::is_neg(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_bigint_add(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_add(a, b) }];
#[ffi(import)]
fn l2r_bigint_sub(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_sub(a, b) }];
#[ffi(import)]
fn l2r_bigint_mul(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_mul(a, b) }];
#[ffi(import)]
fn l2r_bigint_neg(a : LBig) -> LBig [{ leanrt::big::int_neg(a) }];
#[ffi(import)]
fn l2r_bigint_tdiv(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_tdiv(a, b) }];
#[ffi(import)]
fn l2r_bigint_tmod(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_tmod(a, b) }];
#[ffi(import)]
fn l2r_bigint_ediv(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_ediv(a, b) }];
#[ffi(import)]
fn l2r_bigint_emod(a : LBig, b : LBig) -> LBig [{ leanrt::big::int_emod(a, b) }];
#[ffi(import)]
fn l2r_bigint_cmp(a : LBig, b : LBig) -> i64 [{ leanrt::big::int_cmp(a, b) }];
#[ffi(import)]
fn l2r_bigint_eq(a : LBig, b : LBig) -> bool [{ leanrt::big::int_eq(a, b) }];
#[ffi(import)]
fn l2r_bigint_abs(a : LBig) -> LBig [{ leanrt::big::int_abs(a) }];
#[ffi(import)]
fn l2r_i64_mul_overflows(x : i64, y : i64) -> bool [{ x.checked_mul(y).is_none() }];

fn l2r_int_norm(b : LBig) -> Int {
    if l2r_big_fits_i64(b) { Int::Small{l2r_big_to_i64(b)} } else { Int::Big{b} }
}

fn l2r_int_to_big(i : Int) -> LBig {
    match i {
        Int::Small(x) => l2r_big_of_i64(x),
        Int::Big(b) => b
    }
}

fn l2r_i64_min() -> i64 { 0 - 9223372036854775807 - 1 }

// `2^63` (the result of negating i64::MIN) as a big number.
fn l2r_int_two63() -> Int { Int::Big{l2r_big_of_u64(9223372036854775808)} }

fn lean_int64_to_int(x : i64) -> Int { Int::Small{x} }
fn lean_int_to_int(x : i32) -> Int { Int::Small{x as i64} }

// Literals are unsigned digit strings (negative ones are `Int.neg`).
fn lean_cstr_to_int(s : str) -> Int { lean_nat_to_int(lean_cstr_to_nat(s)) }

// `Int.ofNat`.
fn lean_nat_to_int(n : Nat) -> Int {
    match n {
        Nat::Small(x) => if (x >> 63) == 0 { Int::Small{x as i64} } else { Int::Big{l2r_big_of_u64(x)} },
        Nat::Big(b) => Int::Big{b}
    }
}

// `Int.negSucc n = -(n + 1)`.
fn lean_int_neg_succ_of_nat(n : Nat) -> Int {
    match n {
        Nat::Small(x) => if (x >> 63) == 0 { Int::Small{(0 - (x as i64)) - 1} } else { lean_int_neg(lean_nat_to_int(lean_nat_add(n, Nat::Small{1}))) },
        Nat::Big(_) => lean_int_neg(lean_nat_to_int(lean_nat_add(n, Nat::Small{1})))
    }
}

fn lean_int_neg(a : Int) -> Int {
    match a {
        Int::Small(x) => if x == l2r_i64_min() { l2r_int_two63() } else { Int::Small{0 - x} },
        Int::Big(b) => l2r_int_norm(l2r_bigint_neg(b))
    }
}

fn lean_int_add(a : Int, b : Int) -> Int {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => {
                    let s = x + y;
                    if ((x ^ s) & (y ^ s)) < 0 { l2r_int_norm(l2r_bigint_add(l2r_big_of_i64(x), l2r_big_of_i64(y))) } else { Int::Small{s} }
                },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_add(l2r_big_of_i64(x), bb))
            }
        },
        Int::Big(ba) => l2r_int_norm(l2r_bigint_add(ba, l2r_int_to_big(b)))
    }
}

fn lean_int_sub(a : Int, b : Int) -> Int {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => {
                    let s = x - y;
                    if ((x ^ y) & (x ^ s)) < 0 { l2r_int_norm(l2r_bigint_sub(l2r_big_of_i64(x), l2r_big_of_i64(y))) } else { Int::Small{s} }
                },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_sub(l2r_big_of_i64(x), bb))
            }
        },
        Int::Big(ba) => l2r_int_norm(l2r_bigint_sub(ba, l2r_int_to_big(b)))
    }
}

// In (-2^31, 2^31): the product of two such values cannot overflow.
fn l2r_i64_is_half(x : i64) -> bool { ((x + 2147483647) as u64) < 4294967295 }

fn lean_int_mul(a : Int, b : Int) -> Int {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => {
                    if l2r_i64_is_half(x) && l2r_i64_is_half(y) { Int::Small{x * y} } else {
                        if l2r_i64_mul_overflows(x, y) { Int::Big{l2r_bigint_mul(l2r_big_of_i64(x), l2r_big_of_i64(y))} } else { Int::Small{x * y} }
                    }
                },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_mul(l2r_big_of_i64(x), bb))
            }
        },
        Int::Big(ba) => l2r_int_norm(l2r_bigint_mul(ba, l2r_int_to_big(b)))
    }
}

// Whether an Int is zero (`Big` never is).
fn l2r_int_is_zero(a : Int) -> bool {
    match a {
        Int::Small(x) => x == 0,
        Int::Big(_) => false
    }
}

// `Int.tdiv` (C `/`, truncation); `x / 0 = 0`.
fn lean_int_div(a : Int, b : Int) -> Int {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => if y == 0 { Int::Small{0} } else { if y == 0 - 1 { lean_int_neg(a) } else { Int::Small{x / y} } },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_tdiv(l2r_big_of_i64(x), bb))
            }
        },
        Int::Big(ba) => if l2r_int_is_zero(b) { Int::Small{0} } else { l2r_int_norm(l2r_bigint_tdiv(ba, l2r_int_to_big(b))) }
    }
}

fn lean_int_div_exact(a : Int, b : Int) -> Int { lean_int_div(a, b) }

// `Int.tmod` (C `%`, sign of the dividend); `x % 0 = x`.
fn lean_int_mod(a : Int, b : Int) -> Int {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => if y == 0 { a } else { if y == 0 - 1 { Int::Small{0} } else { Int::Small{x % y} } },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_tmod(l2r_big_of_i64(x), bb))
            }
        },
        Int::Big(ba) => if l2r_int_is_zero(b) { a } else { l2r_int_norm(l2r_bigint_tmod(ba, l2r_int_to_big(b))) }
    }
}

// `Int.ediv` (Euclidean, as lean.h); `x / 0 = 0`.
fn lean_int_ediv(a : Int, b : Int) -> Int {
    match a {
        Int::Small(n) => {
            match b {
                Int::Small(d) => {
                    if d == 0 { Int::Small{0} } else {
                        if d == 0 - 1 { lean_int_neg(a) } else {
                            let q = n / d;
                            let r = n % d;
                            if r < 0 { if d > 0 { Int::Small{q - 1} } else { Int::Small{q + 1} } } else { Int::Small{q} }
                        }
                    }
                },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_ediv(l2r_big_of_i64(n), bb))
            }
        },
        Int::Big(ba) => if l2r_int_is_zero(b) { Int::Small{0} } else { l2r_int_norm(l2r_bigint_ediv(ba, l2r_int_to_big(b))) }
    }
}

// `Int.emod` (Euclidean, never negative for d != 0); `x % 0 = x`.
fn lean_int_emod(a : Int, b : Int) -> Int {
    match a {
        Int::Small(n) => {
            match b {
                Int::Small(d) => {
                    if d == 0 { a } else {
                        if d == 0 - 1 { Int::Small{0} } else {
                            let r = n % d;
                            if r < 0 { if d > 0 { Int::Small{r + d} } else { Int::Small{r - d} } } else { Int::Small{r} }
                        }
                    }
                },
                Int::Big(bb) => l2r_int_norm(l2r_bigint_emod(l2r_big_of_i64(n), bb))
            }
        },
        Int::Big(ba) => if l2r_int_is_zero(b) { a } else { l2r_int_norm(l2r_bigint_emod(ba, l2r_int_to_big(b))) }
    }
}

// Three-way comparison: -1, 0, 1.
fn l2r_int_cmp(a : Int, b : Int) -> i64 {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => if x < y { 0 - 1 } else { if x == y { 0 } else { 1 } },
                Int::Big(bb) => if l2r_big_is_neg(bb) { 1 } else { 0 - 1 }
            }
        },
        Int::Big(ba) => {
            match b {
                Int::Small(_) => if l2r_big_is_neg(ba) { 0 - 1 } else { 1 },
                Int::Big(bb) => l2r_bigint_cmp(ba, bb)
            }
        }
    }
}

fn lean_int_dec_eq(a : Int, b : Int) -> bool {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => x == y,
                Int::Big(_) => false
            }
        },
        Int::Big(ba) => {
            match b {
                Int::Small(_) => false,
                Int::Big(bb) => l2r_bigint_eq(ba, bb)
            }
        }
    }
}

fn lean_int_dec_lt(a : Int, b : Int) -> bool {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => x < y,
                Int::Big(_) => l2r_int_cmp(a, b) < 0
            }
        },
        Int::Big(_) => l2r_int_cmp(a, b) < 0
    }
}

fn lean_int_dec_le(a : Int, b : Int) -> bool {
    match a {
        Int::Small(x) => {
            match b {
                Int::Small(y) => x <= y,
                Int::Big(_) => l2r_int_cmp(a, b) <= 0
            }
        },
        Int::Big(_) => l2r_int_cmp(a, b) <= 0
    }
}

fn lean_int_eq(a : Int, b : Int) -> bool { lean_int_dec_eq(a, b) }
fn lean_int_ne(a : Int, b : Int) -> bool { !lean_int_dec_eq(a, b) }
fn lean_int_lt(a : Int, b : Int) -> bool { lean_int_dec_lt(a, b) }
fn lean_int_le(a : Int, b : Int) -> bool { lean_int_dec_le(a, b) }

fn lean_int_dec_nonneg(a : Int) -> bool {
    match a {
        Int::Small(x) => x >= 0,
        Int::Big(b) => !l2r_big_is_neg(b)
    }
}

// `unsafeCast` between `Int` and scalars (lean2rr's `wordOf`/`ofWord`):
// natively a small `Int` is the boxed scalar of its 32 bits, which
// `lean_unbox` reads; a big one is an object (its "word" an address; here
// the low bits of its two's complement value).
fn l2r_int_word(i : Int) -> u64 {
    match i {
        Int::Small(x) => if ((x as i32) as i64) == x { (x as u32) as u64 } else { x as u64 },
        Int::Big(b) => l2r_big_low_twos(b)
    }
}

// The `Int` whose boxed scalar is word `w` (`lean_scalar_to_int64`: its low
// 32 bits, signed).
fn l2r_int_of_word(w : u64) -> Int { Int::Small{((w as u32) as i32) as i64} }

// `unsafeCast (i : Int) : Nat`: a small `Int` is read as the `Nat` of its 32
// bits, a big number object as a `Nat` of its magnitude.
fn l2r_int_cast_nat(i : Int) -> Nat {
    match i {
        Int::Small(x) => if ((x as i32) as i64) == x { Nat::Small{(x as u32) as u64} } else { lean_nat_abs(Int::Small{x}) },
        Int::Big(b) => lean_nat_abs(Int::Big{b})
    }
}

// `Int.natAbs`.
fn lean_nat_abs(a : Int) -> Nat {
    match a {
        Int::Small(x) => if x < 0 { Nat::Small{(0 - x) as u64} } else { Nat::Small{x as u64} },
        Int::Big(b) => l2r_nat_norm(l2r_bigint_abs(b))
    }
}

// `Int.toNat` (0 for negative values).
fn lean_int_to_nat(a : Int) -> Nat {
    if lean_int_dec_nonneg(a) { lean_nat_abs(a) } else { Nat::Small{0} }
}

#[ffi(import)]
fn l2r_string_of_i64(x : i64) -> LStr [{ leanrt::string::of_i64(x) }];

// Decimal representation (`Int.repr`); see `l2r_nat_repr`. Natively
// `Int.repr (ofNat m) = Nat.repr m`: a shared string below 128.
fn l2r_int_repr(a : Int) -> LStr {
    match a {
        Int::Small(x) => if x >= 0 && x < 128 { l2r_nat_repr_small(x as u64) } else { l2r_string_of_i64(x) },
        Int::Big(b) => l2r_big_to_lstr(b)
    }
}

