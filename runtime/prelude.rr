// lean2rr runtime prelude.
//
// Prepended to every program lean2rr generates. A Lean extern whose C
// symbol is `lean_xxx` is implemented here by the function `lean_xxx`, on
// lean2rr's representation types, with the semantics of Lean's own C
// runtime (lean.h and src/runtime/*.cpp of Lean 4.34). `l2r_*` functions
// are primitives for lean2rr-generated glue (externs over Lean-defined
// types) and internal helpers. See runtime/README.md.
//
// Fast paths are plain Reussir code (inlined into the program); slow paths
// call small `#[ffi(import)]` textures, which call into the `leanrt` Rust
// crate (runtime/leanrt). Every call consumes its arguments. Lean's runtime
// rules (hashes, string positions, float and fixed-width integer rules,
// libm, the `Nat`/`Int` rules over leanrt's GMP numbers, the array edge
// rules, panics and the text of numbers) are the shared crate
// lean-runtime's (`sem::...`, `lean_runtime::semantics`), which lean2rr
// shares with another Lean translator: the prelude and leanrt only convert
// lean2rr's values to its views and back. Inline Reussir code is kept for
// single operations (an add, a cast, a comparison, a bit copy) and the
// small-`Nat`/`Int` fast paths.
//
// Conventions for FFI imports: only integers, floats, bool, opaque types and
// shared records cross the boundary; functions without a result return a
// dummy `u64`; no `str` parameters in hot paths (only literals use them).

extern "rust" [{
    extern crate leanrt;
    extern crate lean_runtime;
    use lean_runtime::semantics as sem;
    use leanrt::string::Utf8;
    use reussir_rt::rc::Rc;
}];

// ===========================================================================
// Runtime types

// Unit-like values (erased values, `PUnit`, the IO world). Reussir's own
// `unit` is result-only and cannot be stored or passed.
enum [value] L2RUnit {
    u
}

// A Lean `String`: valid UTF-8 bytes and the number of characters (Lean's
// `m_length`, kept by every operation), copy-on-write; one block like
// Lean's string object (`leanrt::string`).
#[ffi(rust = "::leanrt::string::LStr")]
pub struct LStr;

// A Lean `Nat` / `Int`: one word, Lean's own encoding (leanrt::nat). An odd
// word is a small value: `lean_box(n)` for a `Nat` below 2^63,
// `lean_box((unsigned)(int)i)` for an `Int` in the `int32` range. An even
// word is a reference to a big number, one block with the limbs inline
// (`leanrt::big`). `tagged` (local Reussir patch 41-a): Reussir copies and
// drops them like any shared handle but counts only the even words, so a
// small value costs no allocation and its copy or drop is a bit test.
#[ffi(rust = "::leanrt::nat::LNat", tagged)]
pub struct Nat;

#[ffi(rust = "::leanrt::nat::LInt", tagged)]
pub struct Int;

// A Lean `Array` (and `ByteArray` = RVec<u8>, `FloatArray` = RVec<f64>):
// a copy-on-write vector, updated in place when unique. One block: the
// count, the size, the capacity and the elements (`leanrt::drop::Vec`,
// `leanrt::array`), freed without recursion (`leanrt::drop`).
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct RVec<T>;

// A shared runtime cell: a 0-or-1 element vector, mutated in place through
// every alias (empty after `take`). No longer used by generated code:
// references are lean2rr-generated records around a Reussir `Cell`
// (`l2r_rc_*` below), and promises hold an `LCell`.
#[ffi(rust = "::leanrt::drop::Vec")]
pub struct LRef<T>;

// A mutable cell holding one value, mutated in place through every alias:
// the state of a `Thunk` or `Task` (lean2rr generates the state type).
// One allocation: the count and the value. (`leanrt::drop::Cell` wraps
// Reussir's `Rc`.)
#[ffi(rust = "::leanrt::drop::Cell")]
pub struct LCell<T>;

// A runtime object (`Rc<Box<dyn Any>>`): a file handle (`IO.FS.Handle`), a
// `Std.Sync` mutex or condition variable, a timer, socket or operation of
// the event loop (all `lcAny` in mono code).
#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LHandle;

// ===========================================================================
// The one-word box (`LAny`, leanrt::any)
//
// A value whose type is not known at compile time, in one word, as Lean's
// `lean_object*`: lean2rr's uniform type `Box` (LowerBase, "The box API").
// An odd word is an immediate `(v << 1) | 1`
// (scalars, unit = `box(0)` = word 1, a small `Nat`/`Int`, which is its own
// word, a nullary constructor as its variant index). An even word owns a
// reference to a counted object: the low 48 bits are its address, the top
// 16 bits the number of the payload's type (1 to 15: leanrt's kinds,
// `leanrt::any::NUM_*`; 16 and up: the program's). `tagged` (local Reussir
// patches 41-a and 38-a): Reussir copies an even word by incrementing the
// count at the address without the top 16 bits, in line, and drops it
// through the drop hook, which sends the last reference of a program
// payload to the program's release of its type through the drop worklist
// (`leanrt::any::release_last`: the payload's cell, deferred with
// `l2r_any_rel_<num>_c`, a trampoline the program exports for each payload
// type and installs in leanrt's table before `main`, `l2r_any_init_c`).
//
// Words: `l2r_any_raw(a)` turns a box into its word, which then owns the
// reference; an even word must reach exactly one owner on every path
// (`l2r_any_of_raw`, `l2r_any_raw_as<T>`, `l2r_any_drop_raw`), as for
// `Nat` words.
#[ffi(rust = "::leanrt::any::LAny", tagged)]
pub struct LAny;

#[ffi(import)]
fn l2r_any_raw(a : LAny) -> u64 [{ a.into_raw() }];
#[ffi(import)]
fn l2r_any_of_raw(w : u64) -> LAny [{ unsafe { leanrt::any::LAny::from_raw(w) } }];
// Release the reference a word owns (nothing for an immediate); 0.
#[ffi(import)]
fn l2r_any_drop_raw(w : u64) -> u64 [{ { drop(unsafe { leanrt::any::LAny::from_raw(w) }); 0 } }];

// Immediates: `v` below 2^63.
fn l2r_any_imm(v : u64) -> LAny { l2r_any_of_raw((v << 1) | 1) }
fn l2r_any_unit() -> LAny { l2r_any_of_raw(1) }
fn l2r_any_raw_is_imm(w : u64) -> bool { (w & 1) == 1 }
fn l2r_any_raw_imm(w : u64) -> u64 { w >> 1 }
fn l2r_any_raw_num(w : u64) -> u64 { w >> 48 }
// The value of an immediate box (a pointer: `l2r_unreachable`).
fn l2r_any_as_imm(a : LAny) -> u64 {
    let w = l2r_any_raw(a);
    if (w & 1) == 1 { w >> 1 } else { l2r_any_mismatch(w, 0) }
}
#[ffi(import)]
fn l2r_any_mismatch(w : u64, num : u64) -> u64 [{ leanrt::any::mismatch(w, num) }];

// A box's word read at a type held as an immediate (see
// `l2r_view_take_word`): the immediate's value; any other word is a
// mismatch.
fn l2r_any_word_imm(w : u64) -> u64 { if (w & 1) == 1 { w >> 1 } else { l2r_any_mismatch(w, 0) } }
fn l2r_any_word_as_bool(w : u64) -> bool { l2r_any_word_imm(w) != 0 }
fn l2r_any_word_as_u8(w : u64) -> u8 { l2r_any_word_imm(w) as u8 }
fn l2r_any_word_as_u16(w : u64) -> u16 { l2r_any_word_imm(w) as u16 }
fn l2r_any_word_as_u32(w : u64) -> u32 { l2r_any_word_imm(w) as u32 }
fn l2r_any_of_bool(b : bool) -> LAny { if b { l2r_any_of_raw(3) } else { l2r_any_of_raw(1) } }
fn l2r_any_as_bool(a : LAny) -> bool { l2r_any_as_imm(a) != 0 }
fn l2r_any_of_u8(x : u8) -> LAny { l2r_any_imm(x as u64) }
fn l2r_any_as_u8(a : LAny) -> u8 { l2r_any_as_imm(a) as u8 }
fn l2r_any_of_u16(x : u16) -> LAny { l2r_any_imm(x as u64) }
fn l2r_any_as_u16(a : LAny) -> u16 { l2r_any_as_imm(a) as u16 }
fn l2r_any_of_u32(x : u32) -> LAny { l2r_any_imm(x as u64) }
fn l2r_any_as_u32(a : LAny) -> u32 { l2r_any_as_imm(a) as u32 }
#[ffi(import)]
fn l2r_any_of_f32(x : f32) -> LAny [{ leanrt::any::LAny::imm(x.to_bits() as u64) }];
#[ffi(import)]
fn l2r_any_as_f32(a : LAny) -> f32 [{ f32::from_bits(leanrt::any::as_u64(a) as u32) }];
// `UInt64`/`USize`: an immediate below 2^63, a cell from there.
#[ffi(import)]
fn l2r_any_of_u64(x : u64) -> LAny [{ leanrt::any::of_u64(x) }];
#[ffi(import)]
fn l2r_any_as_u64(a : LAny) -> u64 [{ leanrt::any::as_u64(a) }];
// `Float`: a cell.
#[ffi(import)]
fn l2r_any_of_f64(x : f64) -> LAny [{ leanrt::any::of_f64(x) }];
#[ffi(import)]
fn l2r_any_as_f64(a : LAny) -> f64 [{ leanrt::any::as_f64(a) }];

// A counted value boxed as payload `num`: a Reussir record or enum (a
// nullary variant becomes the immediate of its index), an opaque type of
// this prelude (`LStr`, `RVec`, `LCell`, `LHandle`), a `Nat` or `Int` (their
// own words). leanrt's own kinds keep their fixed numbers whatever `num`
// says: `Nat`, `Int`, `LStr`, `RVec<LAny>`, the arrays of scalars
// `RVec<u8>`, `RVec<f64>`, `RVec<u16>`, `RVec<u32>`, `RVec<u64>`,
// `RVec<f32>` (7 to 12: `ByteArray`, `FloatArray`, lean2rr's compact
// arrays), and `LRef<LAny>`, the same Rust type as `RVec<LAny>` (number 6,
// and `box(0)` unboxes to an empty one; generated code does not use
// `LRef`); a `u64`/`i64` or `f64` boxes as `l2r_any_of_u64`/
// `l2r_any_of_f64` do. The address is checked (48 bits).
#[ffi(import)]
fn l2r_any_of<T>(x : T, num : u64) -> LAny [{ leanrt::any::of(x, num) }];
// A function value (a generated function-value enum): a nullary variant
// becomes the immediate `(num << 32) | index`, which keeps its type.
#[ffi(import)]
fn l2r_any_of_fn<T>(x : T, num : u64) -> LAny [{ leanrt::any::of_typed(x, num) }];
// A counted value whose handle is always a pointer, boxed as payload `num`:
// a Reussir record, an enum without nullary variants, an opaque handle
// (lean2rr's `boxValue` picks it). As `l2r_any_of`, without the tests for
// a nullary variant's immediate (the `tbi` top byte, the `immortal`
// dummy's count) that `leanrt::any::of` makes for a Reussir type. The
// handle's word is read as a pointer and exposed, as `leanrt::any` does.
#[ffi(import)]
fn l2r_any_of_ptr<T>(x : T, num : u64) -> LAny [{ {
    const { assert!(std::mem::size_of::<[:T:]>() == 8) };
    let p: *mut u8 = unsafe { std::mem::transmute_copy(&x) };
    std::mem::forget(x);
    unsafe { leanrt::any::of_ptr(p.expose_provenance() as u64, num) }
} }];
// The payload of a box at payload `num`. Lean's `box(0)` (word 1) read at
// one of leanrt's kinds is its zero (`0`, `0.0`, `""`, `#[]`), as the `b0`
// arm of the old enum `L2RBox` gave; a `Nat` or `Int` also decodes its own
// immediates. Anything else is `l2r_unreachable` (a panic, never a wrong
// read), with one exception, the safety net of the compact arrays: an
// array of scalars (7 to 12) unboxed at `RVec<LAny>` is converted to an
// array of boxes (`leanrt::any`, `boxes_of_compact`; never expected,
// reported under `L2R_DEBUG_ARRAY_CONVERT`).
//
// The rule for generated unboxes at a program type `T` (a record, an enum,
// a function value, a reference, an `LCell`): split the word first, since
// only the program can make `T`'s zero and its nullary variants. For
// `enum T { c_0(u64), c_1, c_2 }` (payload number 25):
//
//     fn l2r_unbox_T(a : LAny) -> T {
//         let w : u64 = l2r_any_raw(a);
//         if l2r_any_raw_is_imm(w) {
//             match l2r_any_raw_imm(w) {
//                 0 => { l2r_zero_T() },      // box(0): T's zero (c_0 is not nullary)
//                 1 => { T::c_1{} },
//                 2 => { T::c_2{} },
//                 _ => { l2r_unreachable<T>() }
//             }
//         } else { l2r_any_raw_as<T>(w, 25) }
//     }
//
// Word 1 is index 0: `box(0)` is the zero of `T`, or its variant 0 when
// that one is nullary (the 0 arm is then `T::c_0{}`; Lean's `lean_box(0)`
// is that constructor). A type without nullary variants has only the 0
// arm and the unreachable one. `l2r_any_as<T>` at a program type panics
// on any immediate, `box(0)` included.
#[ffi(import)]
fn l2r_any_as<T>(a : LAny, num : u64) -> T [{ leanrt::any::as_(a, num) }];
#[ffi(import)]
fn l2r_any_raw_as<T>(w : u64, num : u64) -> T [{ unsafe { leanrt::any::raw_as(w, num) } }];
// An even word's payload, unchecked: a generated match on the number
// (`boxTake`), after its dispatch.
#[ffi(import)]
fn l2r_any_raw_take<T>(w : u64) -> T [{ unsafe { leanrt::any::raw_take(w) } }];

// `ptrAddrUnsafe` of a box: its payload's address (an immediate: its word,
// as natively); and whether it is the only reference (`isExclusive`).
#[ffi(import)]
fn l2r_any_addr(a : LAny) -> u64 [{ { let r = a.addr(); drop(a); r } }];
#[ffi(import)]
fn l2r_any_is_exclusive(a : LAny) -> bool [{ { let r = a.is_exclusive(); drop(a); r } }];

// ===========================================================================
// Process, panics, unreachable code

// The end of the process after `main` has returned (lean-runtime's exit
// sequence, after the io layer's dedicated tasks).
#[ffi(import)]
fn l2r_exit(code : u32) -> unit [{ leanrt::io::main_exit(code as i32) }];

// `IO.Process.exit` (the status is a `UInt8`): lean-runtime's
// `io::panic::process_exit`, an effect point (what other threads would have
// done by now goes first) and the exit.
#[ffi(import)]
fn l2r_process_exit(code : u8) -> u64 [{ lean_runtime::io::panic::process_exit(code, &mut lean_runtime::io::panic::Native) }];

// `IO.Process.forceExit` (`std::_Exit`): no flushing, no exit handlers,
// once the streams this context handed off are written (`leanrt::io`).
#[ffi(import)]
fn l2r_process_force_exit(code : u8) -> u64 [{ leanrt::io::force_exit(code as i32) }];

#[ffi(import)]
fn l2r_argc() -> u64 [{ (leanrt::rt::args().len() as u64).saturating_sub(1) }];

#[ffi(import)]
fn l2r_argv(i : u64) -> LStr [{ leanrt::string::from_bytes_lossy(&leanrt::rt::args()[i as usize + 1]) }];

// Top-level `error e`: `uncaught exception: <e.toString>`, exit 1.
#[ffi(import)]
fn l2r_uncaught_exception(msg : LStr) -> unit [{ leanrt::uncaught_exception(msg.utf8()) }];

// `lean_internal_panic` (lean-runtime's `sem::panic::InternalPanic`), by
// code (no `str` arguments on hot paths): 0 unreachable code (also
// lean2rr's `l2r_internal_panic_at<T>(0)`), 4 out of memory (no caller
// since an array capacity that is not a word gives the empty array,
// lean-runtime's LB-37), 5 `sorry`.
#[ffi(import)]
fn l2r_internal_panic(code : u64) -> u64 [{
    leanrt::lean_internal_panic(match code {
        4 => sem::panic::InternalPanic::OutOfMemory,
        5 => sem::panic::InternalPanic::Sorry,
        _ => sem::panic::InternalPanic::Unreachable,
    })
}];

fn l2r_unreachable<T>() -> T {
    let ignored = l2r_internal_panic(0);
    core::intrinsic::panic::panic<T>()
}

// Releases `x` out of line. A wildcard arm that rrc copies into several
// constructors releases the values of wide enums it holds with it
// (Lower/Code, sinkWildcardHeld), where rrc would expand each release in
// line, a match over the variants, in every copy. Kept out of rrc's
// inliner, which would put the expansion back.
#[transform_anchor]
fn l2r_sink<T>(x : T) -> u64 { 0 }

// Releases `x` here, in line: a use that keeps `x` alive until this point
// (Reussir releases a value that one branch does not use at the start of
// that branch). `get!` releases its default after the read's take with it.
fn l2r_consume<T>(x : T) -> u64 { 0 }

fn l2r_internal_panic_at<T>(code : u64) -> T {
    let ignored = l2r_internal_panic(code);
    core::intrinsic::panic::panic<T>()
}

// Runtime diagnostics go where native Lean's `io_eprintln` sends them: to
// the *current* stderr stream (`IO.setStderr`), through
// `l2r_stderr_put(s)`, which lean2rr defines in every program (it writes
// with the stream's `putStr`, ignoring errors). Messages printed right
// before the process dies (abort-mode panics, internal panics, uncaught
// exceptions, stack overflow) go to descriptor 2, as natively.

// `lean_panic_impl`'s lines (lean-runtime's `io::panic::report`): the
// message, then (unless `LEAN_BACKTRACE=0`) `backtrace:` and the frames
// (none here). Natively one `io_eprintln` per line; written here with one
// `putStr` (the same bytes). Under `LEAN_ABORT_ON_PANIC` this does not
// return: `leanrt::panic_text` flushes stdout, writes the lines to
// descriptor 2 (`std::cerr`) and aborts.
#[ffi(import)]
fn l2r_panic_text(msg : LStr) -> LStr [{ leanrt::panic_text(msg) }];

fn l2r_panic_str(msg : LStr) -> u64 { l2r_stderr_put(l2r_panic_text(msg)) }

// Messages the C runtime itself panics with (lean-runtime's), by code: 0
// an array index out of bounds, 1 `String.Pos.Raw.get!` past the end.
#[ffi(import)]
fn l2r_panic_code_text(code : u64) -> LStr [{
    leanrt::string::from_bytes(match code {
        0 => sem::array::INDEX_OUT_OF_BOUNDS.as_bytes(),
        _ => sem::string::GET_BANG_PANIC.as_bytes(),
    })
}];

// These panics come from inside the prelude's array and string helpers,
// which the stream code behind `l2r_stderr_put` itself uses. A Reussir-level
// call cycle there crashes rrc's TokenReusePass under `--reuse-across-call`
// (a Reussir bug), so the message reaches `l2r_stderr_put` from Rust,
// through the program's `l2r_stderr_put_c` trampoline
// (`leanrt::io::diag_put`; descriptor 2 without one).
fn l2r_panic_code(code : u64) -> u64 { l2r_diag_put(l2r_panic_text(l2r_panic_code_text(code))) }

#[ffi(import)]
fn l2r_diag_put(s : LStr) -> u64 [{ { leanrt::io::diag_put(s); 0 } }];

// `panicCore {α} [Inhabited α] (msg : String) : α`.
fn lean_panic_fn_borrowed<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

fn lean_panic_fn<T>(dflt : T, msg : LStr) -> T {
    let ignored = l2r_panic_str(msg);
    dflt
}

// `sorryAx`: `INTERNAL PANIC: executed 'sorry'`.
fn lean_sorry<T>(b : bool) -> T { l2r_internal_panic_at<T>(5) }

// ===========================================================================
// Nat
//
// A `Nat` is one word (leanrt::nat), as natively: an odd word is a small
// value `(n << 1) | 1` (n < 2^63), an even word a reference to a big number
// (n >= 2^63). Every value has exactly one form, so two small words are
// equal exactly when the values are, and a small value is below every big
// one. Fast paths work on the words inline; everything that involves a big
// number is a call to leanrt::nat, which runs lean-runtime's rules
// (`sem::nat`) on leanrt's GMP numbers.
//
// Ownership of words: `l2r_nat_raw(n)` turns `n` into its word, which then
// owns `n`'s reference (Reussir no longer counts it). A small word owns
// nothing and may be used freely; a big word must reach exactly one owner
// on every path: back into a handle (`l2r_nat_of_raw`), a `_raw` slow path
// (which consumes its words), or `l2r_nat_drop_raw`. A function that takes
// a `Nat` turns it into its word once: no reference counting at all on its
// small path.

#[ffi(import)]
fn l2r_nat_raw(n : Nat) -> u64 [{ n.into_raw() }];
#[ffi(import)]
fn l2r_nat_of_raw(w : u64) -> Nat [{ unsafe { leanrt::nat::LNat::from_raw(w) } }];
// Release the big number a word owns (nothing for a small word); 0.
#[ffi(import)]
fn l2r_nat_drop_raw(w : u64) -> u64 [{ { drop(unsafe { leanrt::nat::LNat::from_raw(w) }); 0 } }];

// A value below 2^63.
fn l2r_nat_small(x : u64) -> Nat { l2r_nat_of_raw((x << 1) | 1) }

#[ffi(import)]
fn l2r_nat_big_of_u64(x : u64) -> Nat [{ leanrt::nat::nat_big_of_u64(x) }];

// `lean_usize_to_nat`: any word.
fn l2r_nat_of_u64(x : u64) -> Nat {
    if (x >> 63) == 0 { l2r_nat_small(x) } else { l2r_nat_big_of_u64(x) }
}

// Big literals (lean2rr emits them for values >= 2^63, see `natLiteral`).
#[ffi(import)]
fn lean_cstr_to_nat(s : str) -> Nat [{ leanrt::nat::nat_of_decimal((*s).as_bytes()) }];
// A big `Nat` literal: its decimal digits (from the string literal table).
#[ffi(import)]
fn l2r_nat_of_decimal_lstr(s : LStr) -> Nat [{ { let r = leanrt::nat::nat_of_decimal(&s.utf8()[..]); leanrt::rc_release(s); r } }];

fn lean_unsigned_to_nat(x : u32) -> Nat { l2r_nat_small(x as u64) }

// Slow paths: raw words in (consumed), a normalized `Nat` out.
#[ffi(import)]
fn l2r_nat_add_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_add(a, b) }];
#[ffi(import)]
fn l2r_nat_sub_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_sub(a, b) }];
#[ffi(import)]
fn l2r_nat_mul_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_mul(a, b) }];
#[ffi(import)]
fn l2r_nat_div_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_div(a, b) }];
#[ffi(import)]
fn l2r_nat_mod_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_mod(a, b) }];
#[ffi(import)]
fn l2r_nat_cmp_raw(a : u64, b : u64) -> i64 [{ leanrt::nat::nat_cmp(a, b) }];
#[ffi(import)]
fn l2r_nat_eq_raw(a : u64, b : u64) -> bool [{ leanrt::nat::nat_eq(a, b) }];
#[ffi(import)]
fn l2r_nat_land_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_land(a, b) }];
#[ffi(import)]
fn l2r_nat_lor_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_lor(a, b) }];
#[ffi(import)]
fn l2r_nat_xor_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_xor(a, b) }];
#[ffi(import)]
fn l2r_nat_shiftl_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_shiftl(a, b) }];
#[ffi(import)]
fn l2r_nat_shiftr_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_shiftr(a, b) }];
#[ffi(import)]
fn l2r_nat_pow_raw(a : u64, b : u64) -> Nat [{ leanrt::nat::nat_pow(a, b) }];
#[ffi(import)]
fn l2r_nat_low_raw(a : u64) -> u64 [{ leanrt::nat::nat_low_u64(a) }];
#[ffi(import)]
fn l2r_u64_mul_hi(x : u64, y : u64) -> u64 [{ leanrt::big::u64_mul_hi(x, y) }];
// `x ^ e` for x >= 2 and e < 64, or 0 when it overflows a word.
#[ffi(import)]
fn l2r_u64_pow_checked(x : u64, e : u64) -> u64 [{ x.checked_pow(e as u32).unwrap_or(0) }];

// Words of two small values `2m+1`, `2n+1`: their sum minus one is
// `2(m+n)+1`, small exactly when it does not carry out of the word.
// Both words are odd exactly when `s` and `x` are (`s` is odd when `x` and
// `y` have the same parity). The test is not `x & y & 1`: LLVM then shares
// `y & 1` with the low-bit test of Reussir's `rc.inc` of `y` (a field just
// read from a cell, patch 41-a's guard) and keeps it in a callee-saved
// register across the calls in between, which grew cfold's recursive
// `constFolding` frame from 80 to 96 bytes (peak memory at n = 23:
// 1074 MB instead of 946).
fn lean_nat_add(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    let s = x + (y - 1);
    if (s & x & 1) == 1 {
        if s >= x { l2r_nat_of_raw(s) } else { l2r_nat_add_raw(x, y) }
    } else { l2r_nat_add_raw(x, y) }
}

fn lean_nat_succ(a : Nat) -> Nat { lean_nat_add(a, l2r_nat_small(1)) }

// Truncated: `m - n = 0` for m < n.
fn lean_nat_sub(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        if x < y { l2r_nat_small(0) } else { l2r_nat_of_raw((x - y) + 1) }
    } else { l2r_nat_sub_raw(x, y) }
}

fn lean_nat_pred(a : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 {
        if x == 1 { l2r_nat_small(0) } else { l2r_nat_of_raw(x - 2) }
    } else { l2r_nat_sub_raw(x, 3) }
}

// Both factors below 2^31: the product is below 2^62. Otherwise the high
// word of the product decides (`umulh`), as natively. Both small: the
// parity test of `lean_nat_add` (not `x & y & 1`, see there).
fn lean_nat_mul(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    let s = x + (y - 1);
    if (s & x & 1) == 1 {
        let m = x >> 1;
        let n = y >> 1;
        let p = m * n;
        if (m | n) < 2147483648 { l2r_nat_of_raw((p << 1) | 1) } else {
            if l2r_u64_mul_hi(m, n) == 0 && (p >> 63) == 0 { l2r_nat_of_raw((p << 1) | 1) } else { l2r_nat_mul_raw(x, y) }
        }
    } else { l2r_nat_mul_raw(x, y) }
}

// `m / 0 = 0`.
fn lean_nat_div(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let n = y >> 1;
        if n == 0 { l2r_nat_small(0) } else { l2r_nat_small((x >> 1) / n) }
    } else { l2r_nat_div_raw(x, y) }
}

fn lean_nat_div_exact(a : Nat, b : Nat) -> Nat { lean_nat_div(a, b) }

// `m % 0 = m`.
fn lean_nat_mod(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let n = y >> 1;
        if n == 0 { l2r_nat_of_raw(x) } else { l2r_nat_small((x >> 1) % n) }
    } else { l2r_nat_mod_raw(x, y) }
}

// Three-way comparison: -1, 0, 1.
fn l2r_nat_cmp(a : Nat, b : Nat) -> i64 {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        if x < y { 0 - 1 } else { if x == y { 0 } else { 1 } }
    } else { l2r_nat_cmp_raw(x, y) }
}

fn lean_nat_dec_eq(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x == y } else { l2r_nat_eq_raw(x, y) }
}

fn lean_nat_eq(a : Nat, b : Nat) -> bool { lean_nat_dec_eq(a, b) }
fn lean_nat_ne(a : Nat, b : Nat) -> bool { !lean_nat_dec_eq(a, b) }

fn lean_nat_dec_lt(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x < y } else { l2r_nat_cmp_raw(x, y) < 0 }
}

fn lean_nat_dec_le(a : Nat, b : Nat) -> bool {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { x <= y } else { l2r_nat_cmp_raw(x, y) <= 0 }
}

fn lean_nat_lt(a : Nat, b : Nat) -> bool { lean_nat_dec_lt(a, b) }
fn lean_nat_le(a : Nat, b : Nat) -> bool { lean_nat_dec_le(a, b) }

// Bitwise operations on two small words act on the values (as natively:
// `(2m+1) & (2n+1) = 2(m & n) + 1`, likewise `|`; `^` clears the tag bit).
fn lean_nat_land(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw(x & y) } else { l2r_nat_land_raw(x, y) }
}

fn lean_nat_lor(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw(x | y) } else { l2r_nat_lor_raw(x, y) }
}

fn lean_nat_lxor(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 { l2r_nat_of_raw((x ^ y) | 1) } else { l2r_nat_xor_raw(x, y) }
}

// `Nat.shiftLeft`: small results inline; the rest is lean-runtime's rule
// (`sem::nat::shiftl`, leanrt::nat::nat_shiftl): any shift amount (LB-12
// lifted), a result too big for GMP an internal panic.
fn lean_nat_shiftl(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let m = x >> 1;
        let s = y >> 1;
        if s < 63 {
            let r = m << s;
            if (r >> s) == m && (r >> 63) == 0 { l2r_nat_small(r) } else { l2r_nat_shiftl_raw(x, y) }
        } else { l2r_nat_shiftl_raw(x, y) }
    } else { l2r_nat_shiftl_raw(x, y) }
}

// `Nat.shiftRight`: small values inline; the rest is lean-runtime's rule
// (`sem::nat::shiftr`): a big shift amount gives 0, and any shift of a big
// value is computed (LB-04 lifted).
fn lean_nat_shiftr(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 {
        let s = y >> 1;
        if s < 63 { l2r_nat_small((x >> 1) >> s) } else { l2r_nat_small(0) }
    } else { l2r_nat_shiftr_raw(x, y) }
}

#[ffi(import)]
fn l2r_nat_log2_big(a : u64) -> Nat [{ leanrt::nat::nat_log2(a) }];

fn lean_nat_log2(a : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 {
        let m = x >> 1;
        if m == 0 { l2r_nat_small(0) } else { l2r_nat_small(63 - core::intrinsic::math::ctlz(m)) }
    } else { l2r_nat_log2_big(x) }
}

// `Nat.pow`: small results inline (exponents below 2^32); the rest is
// lean-runtime's rule (`sem::nat::pow`, leanrt::nat::nat_pow): any exponent
// (LB-11 lifted), a result too big for GMP an internal panic.
fn lean_nat_pow(a : Nat, b : Nat) -> Nat {
    let x = l2r_nat_raw(a);
    let y = l2r_nat_raw(b);
    if (x & y & 1) == 1 && (y >> 33) == 0 {
        let m = x >> 1;
        let e = y >> 1;
        if e == 0 { l2r_nat_small(1) } else {
            if m < 2 { l2r_nat_of_raw(x) } else {
                if e < 64 {
                    let r = l2r_u64_pow_checked(m, e);
                    if r != 0 && (r >> 63) == 0 { l2r_nat_small(r) } else { l2r_nat_pow_raw(x, y) }
                } else { l2r_nat_pow_raw(x, y) }
            }
        }
    } else { l2r_nat_pow_raw(x, y) }
}

#[ffi(import)]
fn lean_nat_gcd(a : Nat, b : Nat) -> Nat [{ leanrt::nat::nat_gcd(a.into_raw(), b.into_raw()) }];

// One shared empty string (a new reference, no allocation): the
// placeholder of a string parameter that is never read (lean2rr's
// Opt/StateMachines).
#[ffi(import)]
fn l2r_str_shared_empty() -> LStr [{ leanrt::string::shared_empty() }];

// Decimal representation (`Nat.repr`); lean2rr replaces Lean's `Nat.repr`
// and `Nat.reprFast` with it (the former builds big numbers digit by digit).
// Below 128, as natively (`Nat.reprFast` reads the closed term
// `Nat.reprArray`), the same shared string every time.
#[ffi(import)]
fn l2r_nat_repr(a : Nat) -> LStr [{ leanrt::nat::nat_repr(a.into_raw()) }];

#[ffi(import)]
fn l2r_nat_repr_small(x : u64) -> LStr [{ leanrt::string::repr_small(x) }];

fn lean_system_platform_nbits(u : L2RUnit) -> Nat { l2r_nat_small(64) }

// The value modulo 2^64 (`UInt64.ofNat`, `USize.ofNat`, ...).
fn l2r_nat_low(a : Nat) -> u64 {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 { x >> 1 } else { l2r_nat_low_raw(x) }
}

// Whether word `w` (of a `Nat`) is an index below `n` (a big word never is).
fn l2r_word_index_ok(w : u64, n : u64) -> bool { (w & 1) == 1 && (w >> 1) < n }

// A `Nat` size or offset as lean-runtime's array rules take it: its value,
// or `u64::MAX` for 2^64 or more (`l2r_nat_sat_raw` releases a big word).
#[ffi(import)]
fn l2r_nat_sat_raw(a : u64) -> u64 [{ leanrt::nat::nat_sat_u64(a) }];

fn l2r_nat_sat(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x >> 1 } else { l2r_nat_sat_raw(x) }
}

// `Array.replicate`'s size (`lean_mk_array`): a big `n` is checked by
// lean-runtime's `sem::array::replicate_len` (a small one by the
// allocation, `leanrt::array::check_alloc`).
#[ffi(import)]
fn l2r_replicate_len_raw(a : u64) -> u64 [{ leanrt::nat::nat_replicate_len(a) }];

fn l2r_replicate_len(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x >> 1 } else { l2r_replicate_len_raw(x) }
}

// ===========================================================================
// Int
//
// An `Int` is one word as well, Lean's own encoding (leanrt::nat): a value
// in the `int32` range is the odd word `lean_box((unsigned)(int)i)`, its
// 32-bit two's complement pattern zero-extended, shifted and tagged (so a
// `Nat` below 2^31 and the `Int` of the same value have the same word); an
// even word is a reference to a big number (any value outside `int32`).
// `l2r_int_val` reads a small word (`lean_scalar_to_int64`). Ownership of
// words as for `Nat`.

#[ffi(import)]
fn l2r_int_raw(i : Int) -> u64 [{ i.into_raw() }];
#[ffi(import)]
fn l2r_int_of_raw(w : u64) -> Int [{ unsafe { leanrt::nat::LInt::from_raw(w) } }];
#[ffi(import)]
fn l2r_int_drop_raw(w : u64) -> u64 [{ { drop(unsafe { leanrt::nat::LInt::from_raw(w) }); 0 } }];

// The value of a small word.
fn l2r_int_val(w : u64) -> i64 { (((w >> 1) as u32) as i32) as i64 }

// Whether `v` is in the small range, `int32`.
fn l2r_int_is_tag_small(v : i64) -> bool { ((v + 2147483648) as u64) < 4294967296 }

// A value in the `int32` range.
fn l2r_int_small(v : i64) -> Int { l2r_int_of_raw((((v as u32) as u64) << 1) | 1) }

#[ffi(import)]
fn l2r_int_big_of_i64(v : i64) -> Int [{ leanrt::nat::int_big_of_i64(v) }];

fn l2r_int_of_i64(v : i64) -> Int {
    if l2r_int_is_tag_small(v) { l2r_int_small(v) } else { l2r_int_big_of_i64(v) }
}

#[ffi(import)]
fn l2r_int_neg_raw(a : u64) -> Int [{ leanrt::nat::int_neg(a) }];
#[ffi(import)]
fn l2r_int_add_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_add(a, b) }];
#[ffi(import)]
fn l2r_int_sub_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_sub(a, b) }];
#[ffi(import)]
fn l2r_int_mul_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_mul(a, b) }];
#[ffi(import)]
fn l2r_int_div_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_div(a, b) }];
#[ffi(import)]
fn l2r_int_mod_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_mod(a, b) }];
#[ffi(import)]
fn l2r_int_ediv_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_ediv(a, b) }];
#[ffi(import)]
fn l2r_int_emod_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_emod(a, b) }];
#[ffi(import)]
fn l2r_int_cmp_raw(a : u64, b : u64) -> i64 [{ leanrt::nat::int_cmp(a, b) }];
#[ffi(import)]
fn l2r_int_eq_raw(a : u64, b : u64) -> bool [{ leanrt::nat::int_eq(a, b) }];
#[ffi(import)]
fn l2r_int_is_neg_raw(a : u64) -> bool [{ leanrt::nat::int_is_neg(a) }];
#[ffi(import)]
fn l2r_int_low_twos_raw(a : u64) -> u64 [{ leanrt::nat::int_low_twos(a) }];
#[ffi(import)]
fn l2r_int_nat_abs_raw(a : u64) -> Nat [{ leanrt::nat::int_nat_abs(a) }];
#[ffi(import)]
fn l2r_nat_to_int_raw(a : u64) -> Int [{ leanrt::nat::nat_to_int(a) }];
#[ffi(import)]
fn l2r_nat_neg_succ_raw(a : u64) -> Int [{ leanrt::nat::nat_neg_succ(a) }];

fn lean_int64_to_int(x : i64) -> Int { l2r_int_of_i64(x) }
fn lean_int_to_int(x : i32) -> Int { l2r_int_small(x as i64) }

// Literals are unsigned digit strings (negative ones are `Int.neg`).
fn lean_cstr_to_int(s : str) -> Int { lean_nat_to_int(lean_cstr_to_nat(s)) }

// `Int.ofNat`: a small `Nat` below 2^31 has the same word as its `Int`
// (`lean_nat_to_int`); a big `Nat` is the same object.
fn lean_nat_to_int(n : Nat) -> Int {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 && (x >> 32) == 0 { l2r_int_of_raw(x) } else { l2r_nat_to_int_raw(x) }
}

// `Int.negSucc n = -(n + 1)`: small for n below 2^31.
fn lean_int_neg_succ_of_nat(n : Nat) -> Int {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 && (x >> 32) == 0 { l2r_int_small((0 - ((x >> 1) as i64)) - 1) } else { l2r_nat_neg_succ_raw(x) }
}

fn lean_int_neg(a : Int) -> Int {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { l2r_int_of_i64(0 - l2r_int_val(x)) } else { l2r_int_neg_raw(x) }
}

// On two small values the i64 arithmetic cannot overflow (as `lean_int_add`
// etc.); the result is small when it is in the `int32` range.
fn lean_int_add(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) + l2r_int_val(y)) } else { l2r_int_add_raw(x, y) }
}

fn lean_int_sub(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) - l2r_int_val(y)) } else { l2r_int_sub_raw(x, y) }
}

fn lean_int_mul(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) * l2r_int_val(y)) } else { l2r_int_mul_raw(x, y) }
}

// `Int.div` (T-division, C's `/`); `x / 0 = 0`.
fn lean_int_div(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let j = l2r_int_val(y);
        if j == 0 { l2r_int_small(0) } else { l2r_int_of_i64(l2r_int_val(x) / j) }
    } else { l2r_int_div_raw(x, y) }
}

fn lean_int_div_exact(a : Int, b : Int) -> Int { lean_int_div(a, b) }

// `Int.mod` (T-remainder, C's `%`, sign of the dividend); `x % 0 = x`.
fn lean_int_mod(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let j = l2r_int_val(y);
        if j == 0 { l2r_int_of_raw(x) } else { l2r_int_small(l2r_int_val(x) % j) }
    } else { l2r_int_mod_raw(x, y) }
}

// `Int.ediv` (Euclidean, as lean.h); `x / 0 = 0`.
fn lean_int_ediv(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let n = l2r_int_val(x);
        let d = l2r_int_val(y);
        if d == 0 { l2r_int_small(0) } else {
            let q = n / d;
            let r = n % d;
            if r < 0 { if d > 0 { l2r_int_of_i64(q - 1) } else { l2r_int_of_i64(q + 1) } } else { l2r_int_of_i64(q) }
        }
    } else { l2r_int_ediv_raw(x, y) }
}

// `Int.emod` (Euclidean, never negative for d != 0); `x % 0 = x`.
fn lean_int_emod(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let n = l2r_int_val(x);
        let d = l2r_int_val(y);
        if d == 0 { l2r_int_of_raw(x) } else {
            let r = n % d;
            if r < 0 { if d > 0 { l2r_int_of_i64(r + d) } else { l2r_int_of_i64(r - d) } } else { l2r_int_small(r) }
        }
    } else { l2r_int_emod_raw(x, y) }
}

// Three-way comparison: -1, 0, 1.
fn l2r_int_cmp(a : Int, b : Int) -> i64 {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let p = l2r_int_val(x);
        let q = l2r_int_val(y);
        if p < q { 0 - 1 } else { if p == q { 0 } else { 1 } }
    } else { l2r_int_cmp_raw(x, y) }
}

// Every value has one form: a big number is never in the `int32` range
// (leanrt::nat normalizes every result: `LInt::of_big`, `LInt::of_i64`). So
// a small and a big word are never equal: only two big words call leanrt.
// The big word of a mixed pair is released here (the one even word).
fn lean_int_dec_eq(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { x == y } else {
        if ((x | y) & 1) == 1 {
            let w = if (x & 1) == 1 { y } else { x };
            let d = l2r_int_drop_raw(w);
            false
        } else { l2r_int_eq_raw(x, y) }
    }
}

fn lean_int_dec_lt(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_val(x) < l2r_int_val(y) } else { l2r_int_cmp_raw(x, y) < 0 }
}

fn lean_int_dec_le(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_val(x) <= l2r_int_val(y) } else { l2r_int_cmp_raw(x, y) <= 0 }
}

