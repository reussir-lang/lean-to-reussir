#[ffi(import)]
fn l2r_int_cmp_raw(a : u64, b : u64) -> i64 [{ leanrt::nat::int_cmp(a, b) }];
#[ffi(import)]
fn l2r_int_eq_raw(a : u64, b : u64) -> bool [{ leanrt::nat::int_eq(a, b) }];
#[ffi(import)]
fn l2r_int_is_neg_raw(a : u64) -> bool [{ leanrt::nat::int_is_neg(a) }];
#[ffi(import)]
fn l2r_int_low_twos_raw(a : u64) -> u64 [{ leanrt::nat::int_low_twos(a) }];
#[ffi(import)]
fn l2r_int_nat_abs_raw(a : u64) -> Nat [{ leanrt::nat::int_nat_abs(a) }];
#[ffi(import)]
fn l2r_nat_to_int_raw(a : u64) -> Int [{ leanrt::nat::nat_to_int(a) }];
#[ffi(import)]
fn l2r_nat_neg_succ_raw(a : u64) -> Int [{ leanrt::nat::nat_neg_succ(a) }];

fn lean_int64_to_int(x : i64) -> Int { l2r_int_of_i64(x) }
fn lean_int_to_int(x : i32) -> Int { l2r_int_small(x as i64) }

// Literals are unsigned digit strings (negative ones are `Int.neg`).
fn lean_cstr_to_int(s : str) -> Int { lean_nat_to_int(lean_cstr_to_nat(s)) }

// `Int.ofNat`: a small `Nat` below 2^31 has the same word as its `Int`
// (`lean_nat_to_int`); a big `Nat` is the same object.
fn lean_nat_to_int(n : Nat) -> Int {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 && (x >> 32) == 0 { l2r_int_of_raw(x) } else { l2r_nat_to_int_raw(x) }
}

// `Int.negSucc n = -(n + 1)`: small for n below 2^31.
fn lean_int_neg_succ_of_nat(n : Nat) -> Int {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 && (x >> 32) == 0 { l2r_int_small((0 - ((x >> 1) as i64)) - 1) } else { l2r_nat_neg_succ_raw(x) }
}

fn lean_int_neg(a : Int) -> Int {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { l2r_int_of_i64(0 - l2r_int_val(x)) } else { l2r_int_neg_raw(x) }
}

// On two small values the i64 arithmetic cannot overflow (as `lean_int_add`
// etc.); the result is small when it is in the `int32` range.
fn lean_int_add(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) + l2r_int_val(y)) } else { l2r_int_add_raw(x, y) }
}

fn lean_int_sub(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) - l2r_int_val(y)) } else { l2r_int_sub_raw(x, y) }
}

fn lean_int_mul(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_of_i64(l2r_int_val(x) * l2r_int_val(y)) } else { l2r_int_mul_raw(x, y) }
}

// `Int.div` (T-division, C's `/`); `x / 0 = 0`.
fn lean_int_div(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let j = l2r_int_val(y);
        if j == 0 { l2r_int_small(0) } else { l2r_int_of_i64(l2r_int_val(x) / j) }
    } else { l2r_int_div_raw(x, y) }
}

fn lean_int_div_exact(a : Int, b : Int) -> Int { lean_int_div(a, b) }

// `Int.mod` (T-remainder, C's `%`, sign of the dividend); `x % 0 = x`.
fn lean_int_mod(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let j = l2r_int_val(y);
        if j == 0 { l2r_int_of_raw(x) } else { l2r_int_small(l2r_int_val(x) % j) }
    } else { l2r_int_mod_raw(x, y) }
}

// `Int.ediv` (Euclidean, as lean.h); `x / 0 = 0`.
fn lean_int_ediv(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let n = l2r_int_val(x);
        let d = l2r_int_val(y);
        if d == 0 { l2r_int_small(0) } else {
            let q = n / d;
            let r = n % d;
            if r < 0 { if d > 0 { l2r_int_of_i64(q - 1) } else { l2r_int_of_i64(q + 1) } } else { l2r_int_of_i64(q) }
        }
    } else { l2r_int_ediv_raw(x, y) }
}

// `Int.emod` (Euclidean, never negative for d != 0); `x % 0 = x`.
fn lean_int_emod(a : Int, b : Int) -> Int {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let n = l2r_int_val(x);
        let d = l2r_int_val(y);
        if d == 0 { l2r_int_of_raw(x) } else {
            let r = n % d;
            if r < 0 { if d > 0 { l2r_int_of_i64(r + d) } else { l2r_int_of_i64(r - d) } } else { l2r_int_small(r) }
        }
    } else { l2r_int_emod_raw(x, y) }
}

// Three-way comparison: -1, 0, 1.
fn l2r_int_cmp(a : Int, b : Int) -> i64 {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 {
        let p = l2r_int_val(x);
        let q = l2r_int_val(y);
        if p < q { 0 - 1 } else { if p == q { 0 } else { 1 } }
    } else { l2r_int_cmp_raw(x, y) }
}

// Every value has one form: a big number is never in the `int32` range
// (leanrt::nat normalizes every result: `LInt::of_big`, `LInt::of_i64`). So
// a small and a big word are never equal: only two big words call leanrt.
// The big word of a mixed pair is released here (the one even word).
fn lean_int_dec_eq(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { x == y } else {
        if ((x | y) & 1) == 1 {
            let w = if (x & 1) == 1 { y } else { x };
            let d = l2r_int_drop_raw(w);
            false
        } else { l2r_int_eq_raw(x, y) }
    }
}

fn lean_int_dec_lt(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_val(x) < l2r_int_val(y) } else { l2r_int_cmp_raw(x, y) < 0 }
}

fn lean_int_dec_le(a : Int, b : Int) -> bool {
    let x = l2r_int_raw(a);
    let y = l2r_int_raw(b);
    if (x & y & 1) == 1 { l2r_int_val(x) <= l2r_int_val(y) } else { l2r_int_cmp_raw(x, y) <= 0 }
}

fn lean_int_eq(a : Int, b : Int) -> bool { lean_int_dec_eq(a, b) }
fn lean_int_ne(a : Int, b : Int) -> bool { !lean_int_dec_eq(a, b) }
fn lean_int_lt(a : Int, b : Int) -> bool { lean_int_dec_lt(a, b) }
fn lean_int_le(a : Int, b : Int) -> bool { lean_int_dec_le(a, b) }

fn lean_int_dec_nonneg(a : Int) -> bool {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { l2r_int_val(x) >= 0 } else { !l2r_int_is_neg_raw(x) }
}

// The value modulo 2^64 in two's complement (`Int64.ofInt`, ...).
fn l2r_int_low_twos(a : Int) -> u64 {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { l2r_int_val(x) as u64 } else { l2r_int_low_twos_raw(x) }
}

// `unsafeCast` between `Int` and scalars (lean2rr's `wordOf`/`ofWord`): a
// small `Int` is the boxed scalar of its 32 bits, which `lean_unbox` reads;
// a big one is an object (its "word" an address; here the low bits of its
// two's complement value).
fn l2r_int_word(a : Int) -> u64 {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { x >> 1 } else { l2r_int_low_twos_raw(x) }
}

// The `Int` whose boxed scalar is word `w` (`lean_scalar_to_int64`: its low
// 32 bits, signed).
fn l2r_int_of_word(w : u64) -> Int { l2r_int_small(((w as u32) as i32) as i64) }

// `Int.natAbs`.
fn lean_nat_abs(a : Int) -> Nat {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 {
        let i = l2r_int_val(x);
        if i < 0 { l2r_nat_small((0 - i) as u64) } else { l2r_nat_small(i as u64) }
    } else { l2r_int_nat_abs_raw(x) }
}

// `unsafeCast (i : Int) : Nat`: a small `Int` is read as the `Nat` of its
// 32 bits (the same word), a big number object as a `Nat` of its magnitude.
fn l2r_int_cast_nat(a : Int) -> Nat {
    let x = l2r_int_raw(a);
    if (x & 1) == 1 { l2r_nat_of_raw(x) } else { l2r_int_nat_abs_raw(x) }
}

// `Int.toNat` (0 for negative values).
fn lean_int_to_nat(a : Int) -> Nat {
    if lean_int_dec_nonneg(a) { lean_nat_abs(a) } else { l2r_nat_small(0) }
}

// Decimal representation (`Int.repr`); see `l2r_nat_repr`. Natively
// `Int.repr (ofNat m) = Nat.repr m`: a shared string below 128.
#[ffi(import)]
fn l2r_int_repr(a : Int) -> LStr [{ leanrt::nat::int_repr(a.into_raw()) }];

