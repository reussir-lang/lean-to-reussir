#[ffi(import)]
fn l2r_shim_tcp_nodelay(s : LHandle) -> u32 [{ { let r = leanrt::net::tcp_nodelay(&s) as u32; leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_shim_tcp_keepalive(s : LHandle, enable : u32, delay : u32) -> u32 [{
