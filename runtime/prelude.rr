fn l2r_nat_to_size_t(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x >> 1 } else { l2r_nat_to_size_t_raw(x) }
}

// `ByteArray.copySlice`, converting the offsets in C's order (a source
// offset past the end returns `dest` before the others are looked at).
fn lean_byte_array_copy_slice(src : RVec<u8>, so : Nat, dest : RVec<u8>, d : Nat, len : Nat, exact : bool) -> RVec<u8> {
    let s = l2r_nat_to_size_t(so);
    if s > l2r_array_size(src) { dest } else {
        let n = l2r_nat_to_size_t(len);
        let o = l2r_nat_to_size_t(d);
        l2r_byte_array_copy_slice(src, s, dest, o, n, exact)
