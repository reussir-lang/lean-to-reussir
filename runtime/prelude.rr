        4 => leanrt::sys::tmpdir(), 5 => leanrt::sys::passwd(), 6 => leanrt::sys::environ_all(), 7 => leanrt::sys::hostname(),
        8 => leanrt::sys::uname_all(), 9 => leanrt::sys::rusage(), 10 => leanrt::sys::exepath(),
