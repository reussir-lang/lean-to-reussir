// `ByteArray.copySlice` (lean-runtime's `sem::array::copy_slice`, in the
// texture; a source offset past the end returns `dest` inline): the offsets
// and the length are passed saturated (`l2r_nat_sat`), so ones of 2^64 or
// more give the definition's result (LB-06 lifted; natively
// `lean_nat_to_size_t` ends with `out of memory`).
fn lean_byte_array_copy_slice(src : RVec<u8>, so : Nat, dest : RVec<u8>, d : Nat, len : Nat, exact : bool) -> RVec<u8> {
    let s = l2r_nat_sat(so);
    if s > l2r_array_size(src) { dest } else {
        let n = l2r_nat_sat(len);
        let o = l2r_nat_sat(d);
        l2r_byte_array_copy_slice(src, s, dest, o, n, exact)
    }
}
