// `Float.scaleB x i`: Lean's small Ints are 32-bit, so `i` outside the i32
// range takes the big-number branch of `lean_float_scaleb`: 0 when `x == 0`
// or `i < 0`, else `x * inf`.
fn lean_float_scaleb(a : f64, b : Int) -> f64 {
    match b {
        Int::Small(n) => if n >= 0 - 2147483648 && n <= 2147483647 { l2r_float_scalbn(a, n as i32) } else { l2r_float_scaleb_big(a, n < 0) },
        Int::Big(bb) => l2r_float_scaleb_big(a, l2r_big_is_neg(bb))
    }
}

fn l2r_float_scaleb_big(a : f64, neg : bool) -> f64 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { a * inf }
}

fn lean_float32_scaleb(a : f32, b : Int) -> f32 {
    match b {
        Int::Small(n) => if n >= 0 - 2147483648 && n <= 2147483647 { l2r_float32_scalbn(a, n as i32) } else { l2r_float32_scaleb_big(a, n < 0) },
        Int::Big(bb) => l2r_float32_scaleb_big(a, l2r_big_is_neg(bb))
    }
}

fn l2r_float32_scaleb_big(a : f32, neg : bool) -> f32 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { ((a as f64) * inf) as f32 }
}

