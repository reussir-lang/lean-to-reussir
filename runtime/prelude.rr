// Small values in [-2^62, 2^62) are stored as `(v << 1) | 1`; all others as
// big numbers (normalized back to `Int::Small` when read).
fn l2r_int_is_tag_small(v : i64) -> bool { ((v + 4611686018427387904) as u64) < 9223372036854775808 }

fn l2r_intarr_get(a : LIntArr, i : u64) -> Int {
    let w = l2r_intarr_word_owned(a, i);
    if (w & 1) == 1 { Int::Small{(w as i64) >> 1} } else { l2r_int_norm(l2r_big_of_owned_word(w)) }
}

fn l2r_intarr_set(a : LIntArr, i : u64, x : Int) -> LIntArr {
    match x {
        Int::Small(v) => if l2r_int_is_tag_small(v) { l2r_intarr_set_word(a, i, ((v << 1) | 1) as u64) } else { l2r_intarr_set_big(a, i, l2r_big_of_i64(v)) },
        Int::Big(b) => l2r_intarr_set_big(a, i, b)
    }
}

fn l2r_intarr_push(a : LIntArr, x : Int) -> LIntArr {
    match x {
        Int::Small(v) => if l2r_int_is_tag_small(v) { l2r_intarr_push_word(a, ((v << 1) | 1) as u64) } else { l2r_intarr_push_big(a, l2r_big_of_i64(v)) },
        Int::Big(b) => l2r_intarr_push_big(a, b)
    }
}

fn l2r_intarr_replicate(n : u64, x : Int) -> LIntArr {
    match x {
        Int::Small(v) => if l2r_int_is_tag_small(v) { l2r_intarr_replicate_word(n, ((v << 1) | 1) as u64) } else { l2r_intarr_replicate_big(n, l2r_big_of_i64(v)) },
        Int::Big(b) => l2r_intarr_replicate_big(n, b)
    }
}


fn lean_mk_empty_intarr() -> LIntArr { l2r_intarr_empty() }

fn lean_mk_empty_intarr_with_capacity(n : Nat) -> LIntArr {
    match n {
        Nat::Small(c) => if (c >> 63) == 0 { l2r_intarr_with_capacity(c) } else { l2r_internal_panic_at<LIntArr>(4) },
        Nat::Big(_) => l2r_internal_panic_at<LIntArr>(4)
    }
}

fn lean_intarr_get_size(v : LIntArr) -> Nat { Nat::Small{l2r_intarr_size(v)} }
fn lean_intarr_size(v : LIntArr) -> u64 { l2r_intarr_size(v) }
fn lean_intarr_fget(v : LIntArr, i : Nat) -> Int { l2r_intarr_get(v, lean_usize_of_nat(i)) }
fn lean_intarr_fget_borrowed(v : LIntArr, i : Nat) -> Int { l2r_intarr_get(v, lean_usize_of_nat(i)) }
fn lean_intarr_uget(v : LIntArr, i : u64) -> Int { l2r_intarr_get(v, i) }
fn lean_intarr_uget_borrowed(v : LIntArr, i : u64) -> Int { l2r_intarr_get(v, i) }

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default.
fn lean_intarr_get(dflt : Int, v : LIntArr, i : Nat) -> Int {
    if l2r_index_ok(i, l2r_intarr_size(v)) { l2r_intarr_get(v, lean_usize_of_nat(i)) } else {
        let ignored = l2r_panic_code(0);
        dflt
    }
}

fn lean_intarr_get_borrowed(dflt : Int, v : LIntArr, i : Nat) -> Int { lean_intarr_get(dflt, v, i) }
fn lean_intarr_fset(v : LIntArr, i : Nat, x : Int) -> LIntArr { l2r_intarr_set(v, lean_usize_of_nat(i), x) }
fn lean_intarr_uset(v : LIntArr, i : u64, x : Int) -> LIntArr { l2r_intarr_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_intarr_set(v : LIntArr, i : Nat, x : Int) -> LIntArr {
    if l2r_index_ok(i, l2r_intarr_size(v)) { l2r_intarr_set(v, lean_usize_of_nat(i), x) } else {
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_intarr_push(v : LIntArr, x : Int) -> LIntArr { l2r_intarr_push(v, x) }
fn lean_intarr_pop(v : LIntArr) -> LIntArr { l2r_intarr_pop(v) }
fn lean_intarr_fswap(v : LIntArr, i : Nat, j : Nat) -> LIntArr { l2r_intarr_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) }
fn lean_intarr_uswap(v : LIntArr, i : u64, j : u64) -> LIntArr { l2r_intarr_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_intarr_swap(v : LIntArr, i : Nat, j : Nat) -> LIntArr {
    let n = l2r_intarr_size(v);
    if l2r_index_ok(i, n) && l2r_index_ok(j, n) { l2r_intarr_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) } else { v }
}

// `Array.replicate n x`.
fn lean_mk_intarr(n : Nat, x : Int) -> LIntArr {
    match n {
        Nat::Small(c) => l2r_intarr_replicate(c, x),
        Nat::Big(_) => l2r_internal_panic_at<LIntArr>(4)
    }
}

// `Array.toList` glue (see `l2r_array_to_list`).
fn l2r_intarr_to_list<L>(a : LIntArr, nil : L, cons : Int -> (L -> L)) -> L {
    l2r_intarr_to_list_go(a, l2r_intarr_size(a), nil, cons)
}

fn l2r_intarr_to_list_go<L>(a : LIntArr, i : u64, acc : L, cons : Int -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_intarr_to_list_go(a, i - 1, cons(l2r_intarr_get(a, i - 1))(acc), cons) }
}

