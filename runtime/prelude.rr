fn sqrtf(x : f32) -> f32 { core::intrinsic::math::sqrt(x, 0) }
#[ffi(import)]
fn cbrtf(x : f32) -> f32 [{ unsafe { leanrt::float::libm::cbrtf(x) } }];
fn ceilf(x : f32) -> f32 { core::intrinsic::math::ceil(x, 0) }
fn floorf(x : f32) -> f32 { core::intrinsic::math::floor(x, 0) }
fn roundf(x : f32) -> f32 { core::intrinsic::math::round(x, 0) }
