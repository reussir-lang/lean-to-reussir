// ===========================================================================
// String
//
// Positions are `Nat` byte offsets. A big position (2^63 or more) is never
// valid; the functions below reproduce what Lean's C code does with
// non-scalar positions (exactly the big `Nat`s here). Sizes, lengths and
// valid positions are below 2^63 (memory), so they are made with
// `l2r_nat_small`.

#[ffi(import)]
fn lean_mk_string(s : str) -> LStr [{ leanrt::string::from_bytes((*s).as_bytes()) }];

#[ffi(import)]
fn lean_string_of_usize(n : u64) -> LStr [{ leanrt::string::of_u64(n) }];

#[ffi(import)]
fn lean_string_append(a : LStr, b : LStr) -> LStr [{ leanrt::string::append(a, b) }];

#[ffi(import)]
fn lean_string_push(s : LStr, c : u32) -> LStr [{ leanrt::string::push(s, c) }];

// `String.ofList`/`String.mk` (lean2rr's `stringOfList`): a unique empty
// string with room for `n` bytes, and the UTF-8 size of the characters,
// added up over the list first, as natively `lean_string_mk` makes the
// string at its exact size (review RLF1-06: pushing onto "" grew it, up to
// twice its size).
#[ffi(import)]
fn l2r_string_with_capacity(n : u64) -> LStr [{ leanrt::string::with_capacity(n) }];

fn l2r_utf8_size_add(n : u64, c : u32) -> u64 {
    if c < 128 { n + 1 } else { if c < 2048 { n + 2 } else { if c < 65536 { n + 3 } else { n + 4 } } }
}

#[ffi(import)]
fn l2r_string_size(s : LStr) -> u64 [{ { let r = s.utf8().len() as u64; leanrt::rc_release(s); r } }];

#[ffi(import)]
fn l2r_string_length(s : LStr) -> u64 [{ { let r = leanrt::string::length(&s); leanrt::rc_release(s); r } }];

fn lean_string_utf8_byte_size(s : LStr) -> Nat { l2r_nat_small(l2r_string_size(s)) }
fn lean_string_length(s : LStr) -> Nat { l2r_nat_small(l2r_string_length(s)) }

// The string rules are lean-runtime's (`sem::string`, on the bytes and
// `u64` positions); a big `Nat` position is passed as `u64::MAX`
// (`l2r_pos_of_nat`, `l2r_pos_of_word`), which every rule but `next`/`prev`
// treats as Lean's C treats a non-scalar position. `get?`/`get!` answer
// `0x110000` for `none` (lean2rr's glue builds the `Option Char`; `get!`
// panics). The reads whose rule calls out of line (to decode a character
// that is not ASCII) decide the release first (`leanrt::string::read_owned`),
// so that LLVM removes the caller's increment and the read's decrement.
#[ffi(import)]
fn l2r_string_get(s : LStr, i : u64) -> u32 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_get(b, i)) }];
#[ffi(import)]
fn l2r_string_get_opt(s : LStr, i : u64) -> u32 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_get_opt(b, i).unwrap_or(0x110000)) }];
#[ffi(import)]
fn l2r_string_get_bang(s : LStr, i : u64) -> u32 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_get_bang(b, i).unwrap_or(0x110000)) }];
#[ffi(import)]
fn l2r_char_default() -> u32 [{ sem::string::CHAR_DEFAULT }];
#[ffi(import)]
fn l2r_string_get_fast(s : LStr, i : u64) -> u32 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_get_fast(b, i)) }];
#[ffi(import)]
fn l2r_string_next(s : LStr, i : u64) -> u64 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_next(b, i)) }];
// `get_fast` and `next_fast` at the word `x` of a position a proof keeps
// valid: a big one is unreachable code, inside the texture (as
// `l2r_array_get_word`).
#[ffi(import)]
fn l2r_string_get_fast_word(s : LStr, x : u64) -> u32 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_get_fast(b, leanrt::index_word(x))) }];
#[ffi(import)]
fn l2r_string_next_fast_word(s : LStr, x : u64) -> u64 [{ leanrt::string::read_owned(s, |b| sem::string::utf8_next_fast(b, leanrt::index_word(x))) }];
#[ffi(import)]
fn l2r_string_prev(s : LStr, i : u64) -> u64 [{ { let r = sem::string::utf8_prev(s.utf8(), i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_at_end(s : LStr, i : u64) -> bool [{ { let r = sem::string::utf8_at_end(s.utf8(), i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_is_valid_pos(s : LStr, i : u64) -> bool [{ { let r = sem::string::is_valid_pos(s.utf8(), i); leanrt::rc_release(s); r } }];
#[ffi(import)]
fn l2r_string_extract(s : LStr, b : u64, e : u64) -> LStr [{ leanrt::string::extract(s, b, e) }];
#[ffi(import)]
fn l2r_string_extract_fast(s : LStr, b : u64, e : u64) -> LStr [{ leanrt::string::extract_fast(s, b, e) }];
#[ffi(import)]
fn l2r_string_set(s : LStr, i : u64, c : u32) -> LStr [{ leanrt::string::set(s, i, c) }];
#[ffi(import)]
fn l2r_string_get_byte(s : LStr, i : u64) -> u8 [{ { let r = sem::string::get_byte_fast(s.utf8(), i); leanrt::rc_release(s); r } }];

// A `Nat` position as lean-runtime's string rules take it: its value, or
// `u64::MAX` for a big one (past the end of every string).
fn l2r_pos_of_nat(p : Nat) -> u64 {
    let x = l2r_nat_raw(p);
    if (x & 1) == 1 { x >> 1 } else { let d = l2r_nat_drop_raw(x); 18446744073709551615 }
}

// `l2r_pos_of_nat` of a position's word, for a read: no call, so nothing
// comes between the caller's increment of the string and the read's
// decrement (a big position's release, a call, rejoining the read kept
// both); the read releases a big position afterwards (`l2r_nat_drop_raw`).
fn l2r_pos_of_word(x : u64) -> u64 {
    if (x & 1) == 1 { x >> 1 } else { 18446744073709551615 }
}

// `String.Pos.Raw.get`: the character at byte `p`, or `'A'`.
fn lean_string_utf8_get(s : LStr, p : Nat) -> u32 {
    let x = l2r_nat_raw(p);
    let c = l2r_string_get(s, l2r_pos_of_word(x));
    let d = l2r_nat_drop_raw(x);
    c
}

// `String.Pos.Raw.get?`.
fn l2r_string_utf8_get_opt(s : LStr, p : Nat) -> u32 {
    let x = l2r_nat_raw(p);
    let c = l2r_string_get_opt(s, l2r_pos_of_word(x));
    let d = l2r_nat_drop_raw(x);
    c
}

// `String.Pos.Raw.get!`: panics (C message) and returns `'A'`.
fn lean_string_utf8_get_bang(s : LStr, p : Nat) -> u32 {
    let x = l2r_nat_raw(p);
    let c = l2r_string_get_bang(s, l2r_pos_of_word(x));
    let d = l2r_nat_drop_raw(x);
    if c == 1114112 { let ignored = l2r_panic_code(1); l2r_char_default() } else { c }
}

// `String.Pos.get`/`Pos.Raw.get'` and `next'` take a proof that the
// position is valid and not the end: never a big `Nat` (see
// `l2r_string_get_fast_word`).
fn lean_string_utf8_get_fast(s : LStr, p : Nat) -> u32 { l2r_string_get_fast_word(s, l2r_nat_raw(p)) }

// `String.Pos.Raw.next`: `p + 1` at or past the end. lean-runtime's `next`
// takes a position below 2^63 (a small `Nat`) and may answer 2^63, a big
// `Nat`; for a big position C computes `p + 1` on the `Nat`, as here.
fn lean_string_utf8_next(s : LStr, p : Nat) -> Nat {
    let x = l2r_nat_raw(p);
    if (x & 1) == 1 { l2r_nat_of_u64(l2r_string_next(s, x >> 1)) } else { lean_nat_add(l2r_nat_of_raw(x), l2r_nat_small(1)) }
}

fn lean_string_utf8_next_fast(s : LStr, p : Nat) -> Nat { l2r_nat_small(l2r_string_next_fast_word(s, l2r_nat_raw(p))) }

fn lean_string_utf8_prev(s : LStr, p : Nat) -> Nat {
    let x = l2r_nat_raw(p);
    if (x & 1) == 1 { l2r_nat_small(l2r_string_prev(s, x >> 1)) } else { lean_nat_sub(l2r_nat_of_raw(x), l2r_nat_small(1)) }
}

fn lean_string_utf8_at_end(s : LStr, p : Nat) -> bool {
    let x = l2r_nat_raw(p);
    let r = l2r_string_at_end(s, l2r_pos_of_word(x));
    let d = l2r_nat_drop_raw(x);
    r
}

fn lean_string_is_valid_pos(s : LStr, p : Nat) -> bool {
    let x = l2r_nat_raw(p);
    let r = l2r_string_is_valid_pos(s, l2r_pos_of_word(x));
    let d = l2r_nat_drop_raw(x);
    r
}

// `String.Pos.Raw.extract`. A non-scalar (big) position counts as
// SIZE_MAX, as natively since Lean 4.34: a big start gives "", a big end
// extracts to the end of the string.
fn lean_string_utf8_extract(s : LStr, b : Nat, e : Nat) -> LStr {
    let bi = l2r_pos_of_nat(b);
    l2r_string_extract(s, bi, l2r_pos_of_nat(e))
}

// `String.extract` (positions of `s`, valid by their proofs: never big).
fn lean_string_utf8_extract_fast(s : LStr, b : Nat, e : Nat) -> LStr {
    l2r_string_extract_fast(s, l2r_index_of_nat(b), l2r_index_of_nat(e))
}

fn lean_string_utf8_set(s : LStr, p : Nat, c : u32) -> LStr {
    let x = l2r_nat_raw(p);
    if (x & 1) == 1 { l2r_string_set(s, x >> 1, c) } else { let d = l2r_nat_drop_raw(x); s }
}

fn lean_string_get_byte_fast(s : LStr, i : Nat) -> u8 { l2r_string_get_byte(s, lean_usize_of_nat(i)) }
fn lean_string_uget_byte_fast(s : LStr, i : u64) -> u8 { l2r_string_get_byte(s, i) }

// Two references to the same string are equal without comparing the bytes,
// as natively (`lean_string_eq`): `leanrt::string::dec_eq`.
#[ffi(import)]
fn lean_string_dec_eq(a : LStr, b : LStr) -> bool [{ leanrt::string::dec_eq(a, b) }];
#[ffi(import)]
fn lean_string_dec_lt(a : LStr, b : LStr) -> bool [{ { let r = sem::string::lt(a.utf8(), b.utf8()); leanrt::rc_release(a); leanrt::rc_release(b); r } }];
// `String.compare`: 0 = lt, 1 = eq, 2 = gt (lean2rr maps it to `Ordering`).
#[ffi(import)]
fn l2r_string_compare(a : LStr, b : LStr) -> u8 [{ { let r = (sem::string::compare(a.utf8(), b.utf8()) as i8 + 1) as u8; leanrt::rc_release(a); leanrt::rc_release(b); r } }];
#[ffi(import)]
fn lean_string_hash(s : LStr) -> u64 [{ { let r = sem::hash::string_hash(s.utf8()); leanrt::rc_release(s); r } }];

// `String.toUTF8` / `String.ofByteArray` / `String.fromUTF8`: copies, as
// natively; from bytes, the characters are counted.
#[ffi(import)]
fn lean_string_to_utf8(s : LStr) -> RVec<u8> [{ leanrt::array::bytes_of_string(s) }];
#[ffi(import)]
fn lean_string_from_utf8_unchecked(b : RVec<u8>) -> LStr [{ leanrt::array::string_of_bytes(b) }];
#[ffi(import)]
fn lean_string_validate_utf8(b : RVec<u8>) -> bool [{ { let r = leanrt::string::validate(leanrt::array::as_slice(&b)); leanrt::array::release(b); r } }];
// `String.fromUTF8!`-style lossy decoding (`lean_decode_lossy_utf8`).
#[ffi(import)]
fn lean_decode_lossy_utf8(b : RVec<u8>) -> LStr [{ leanrt::string::from_bytes_lossy(leanrt::array::as_slice(&b)) }];

#[ffi(import)]
fn l2r_string_memcmp(a : LStr, b : LStr, ls : u64, rs : u64, len : u64) -> bool [{ { let r = sem::string::memcmp(a.utf8(), b.utf8(), ls, rs, len); leanrt::rc_release(a); leanrt::rc_release(b); r } }];

fn lean_string_memcmp(a : LStr, b : LStr, ls : Nat, rs : Nat, len : Nat) -> bool {
    l2r_string_memcmp(a, b, lean_usize_of_nat(ls), lean_usize_of_nat(rs), lean_usize_of_nat(len))
}

// Slices (`String.Slice` is a Lean structure; lean2rr's glue passes its
// string and byte bounds).
#[ffi(import)]
fn l2r_slice_hash(s : LStr, b : u64, e : u64) -> u64 [{
    sem::hash::slice_hash(s.utf8().get(b as usize..e as usize).unwrap_or(&[]))
}];
#[ffi(import)]
fn l2r_slice_dec_lt(s1 : LStr, b1 : u64, e1 : u64, s2 : LStr, b2 : u64, e2 : u64) -> bool [{
    sem::string::lt(s1.utf8().get(b1 as usize..e1 as usize).unwrap_or(&[]), s2.utf8().get(b2 as usize..e2 as usize).unwrap_or(&[]))
}];
// `ByteSlice.beq` (`lean_byteslice_beq`) on the fields `byteArray`,
// `start`, `stop` of both slices (`start ≤ stop ≤ size` by the structure's
// proofs).
#[ffi(import)]
fn l2r_byteslice_beq(a : RVec<u8>, sa : u64, ea : u64, b : RVec<u8>, sb : u64, eb : u64) -> bool [{
    {
        let x = leanrt::array::as_slice(&a).get(sa as usize..ea as usize).unwrap_or(&[]);
        let y = leanrt::array::as_slice(&b).get(sb as usize..eb as usize).unwrap_or(&[]);
        let r = x == y;
        leanrt::array::release(a);
        leanrt::array::release(b);
        r
    }
}];

// ---- Glue helpers for externs over Lean-defined types ----
//
// The prelude cannot name generated types (`List Char`, `Ordering`,
// `Option Char`, ...), so these helpers are generic in the result type and
// take its constructors as arguments: lean2rr's glue for such an extern is a
// call passing the constructor values (nullary constructors as values,
// others as curried closures).

// `String.compare a b` (`lean_string_compare`).
fn l2r_string_compare_with<O>(a : LStr, b : LStr, lt : O, eq : O, gt : O) -> O {
    let r = l2r_string_compare(a, b);
    if r == 0 { lt } else { if r == 1 { eq } else { gt } }
}

// `String.toList`/`String.data` (`lean_string_data`): the characters of a
// valid UTF-8 string, built from the end.
fn l2r_string_to_list<L>(s : LStr, nil : L, cons : u32 -> (L -> L)) -> L {
    l2r_string_to_list_go(s, l2r_string_size(s), nil, cons)
}

fn l2r_string_to_list_go<L>(s : LStr, i : u64, acc : L, cons : u32 -> (L -> L)) -> L {
    if i == 0 { acc } else {
        let j = l2r_string_prev(s, i);
        l2r_string_to_list_go(s, j, cons(l2r_string_get_fast(s, j))(acc), cons)
    }
}

// `String.Pos.Raw.get?` (`lean_string_utf8_get_opt`).
fn l2r_string_utf8_get_opt_with<O>(s : LStr, p : Nat, none : O, some : u32 -> O) -> O {
    let c = l2r_string_utf8_get_opt(s, p);
    if c == 1114112 { none } else { some(c) }
}

// `Array.toList` (`lean_array_to_list`), built from the end. `E` is the
// array's storage type; `cons` takes the stored element (lean2rr unboxes
// inside the closure when the array stores boxes).
fn l2r_array_to_list<E, L>(a : RVec<E>, nil : L, cons : E -> (L -> L)) -> L {
    l2r_array_to_list_go(a, l2r_array_size(a), nil, cons)
}

fn l2r_array_to_list_go<E, L>(a : RVec<E>, i : u64, acc : L, cons : E -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_array_to_list_go(a, i - 1, cons(l2r_array_get(a, i - 1))(acc), cons) }
}

// `Float.frExp` (`lean_float_frexp`): `mk` builds the `Float × Int`.
fn l2r_float_frexp_with<P>(x : f64, mk : f64 -> (Int -> P)) -> P {
    mk(l2r_float_frexp_mant(x))(l2r_float_frexp_exp(x))
}

fn l2r_float32_frexp_with<P>(x : f32, mk : f32 -> (Int -> P)) -> P {
    mk(l2r_float32_frexp_mant(x))(l2r_float32_frexp_exp(x))
}

// ===========================================================================
// Array
//
// `RVec<E>` where `E` is the element's storage type (lean2rr boxes element
// types that cannot cross the FFI boundary; a compact array of scalars
// stores `u8`, `u16`, `u32`, `u64`, `f32` or `f64`, at which every texture
// with a `<T>` parameter works). Indices are `Nat`; big ones are always
// out of bounds.

#[ffi(import)]
fn l2r_array_empty<T>() -> RVec<T> [{ leanrt::array::empty() }];
#[ffi(import)]
fn l2r_array_with_capacity<T>(n : u64, elem : u64) -> RVec<T> [{ leanrt::array::with_capacity_checked(n, elem) }];
#[ffi(import)]
fn l2r_array_size<T>(v : RVec<T>) -> u64 [{ { let r = leanrt::array::size(&v); leanrt::array::release(v); r } }];
// Reads. Every read takes its array owned (an FFI call consumes its
// arguments): the caller's increment, then the read's decrement, which
// LLVM removes together only when no call and no other store come between
// them on any path. So a read first gives its reference up for a view
// (`l2r_array_give`, `leanrt::array::give`): a shared array's decrement,
// before the bounds check and anything else. The view (a `u64`: the
// block's address, bit 0 set for a shared array; the last reference keeps
// its count of 1) is valid until `l2r_view_take` (the element; the last
// reference frees the block) or `l2r_view_end` ends it. The bounds check
// is Reussir code between the two, and its failing branch has nothing to
// release. Each texture is small enough for LLVM to inline at a call site
// it judges cold.
#[ffi(import)]
fn l2r_array_give<T>(v : RVec<T>) -> u64 [{ leanrt::array::give(v) }];
#[ffi(import)]
fn l2r_view_size(p : u64) -> u64 [{ unsafe { leanrt::array::view_size(p) } }];
#[ffi(import)]
fn l2r_view_take<T>(p : u64, i : u64) -> T [{ unsafe { leanrt::array::view_take(p, i) } }];
#[ffi(import)]
fn l2r_view_end<T>(p : u64) -> u64 [{ { unsafe { leanrt::array::view_end::<[:T:]>(p) }; 0 } }];

// An index that a proof or the prelude's check keeps in bounds was not
// (a lean2rr or runtime bug): `INTERNAL PANIC: array index i out of
// bounds n (runtime invariant)`.
#[ffi(import)]
fn l2r_array_index_bug_code(i : u64, n : u64) -> u64 [{ leanrt::array::index_bug(i, n as usize) }];

fn l2r_array_index_bug<T>(i : u64, n : u64) -> T {
    let ignored = l2r_array_index_bug_code(i, n);
    core::intrinsic::panic::panic<T>()
}

// Element `i`, which must be in bounds (a runtime invariant, checked).
fn l2r_array_get<T>(v : RVec<T>, i : u64) -> T {
    let p = l2r_array_give<T>(v);
    let n = l2r_view_size(p);
    if i < n { l2r_view_take<T>(p, i) } else { l2r_array_index_bug<T>(i, n) }
}

#[ffi(import)]
fn l2r_array_push<T>(v : RVec<T>, x : T) -> RVec<T> [{ leanrt::array::push(v, x) }];
#[ffi(import)]
fn l2r_array_set<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> [{ leanrt::array::set(v, i, x) }];
#[ffi(import)]
fn l2r_array_pop<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::pop(v) }];
#[ffi(import)]
fn l2r_array_swap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> [{ leanrt::array::swap(v, i, j) }];
#[ffi(import)]
fn l2r_array_replicate<T>(n : u64, x : T) -> RVec<T> [{ leanrt::array::replicate(n, x) }];
#[ffi(import)]
fn l2r_array_append<T>(a : RVec<T>, b : RVec<T>) -> RVec<T> [{ leanrt::array::append(a, b) }];
#[ffi(import)]
fn l2r_array_extract<T>(v : RVec<T>, b : u64, e : u64) -> RVec<T> [{ leanrt::array::extract(v, b, e) }];
#[ffi(import)]
fn l2r_array_truncate<T>(v : RVec<T>, n : u64) -> RVec<T> [{ leanrt::array::truncate(v, n) }];
#[ffi(import)]
fn l2r_array_reverse<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::reverse(v) }];

fn lean_mk_empty_array<T>() -> RVec<T> { l2r_array_empty<T>() }

// A capacity is only a hint (lean-runtime's `sem::array::empty_with_capacity`,
// LB-37): a capacity that cannot be reserved reserves nothing. One that is not
// a Lean scalar (a big `Nat`, >= 2^63) is released and gives the empty array;
// the others are checked by `leanrt::array::with_capacity_checked`; `elem` is
// the native element size (for Lean's allocation-size checks).
fn l2r_mk_empty_with_capacity<T>(n : Nat, elem : u64) -> RVec<T> {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { l2r_array_with_capacity<T>(x >> 1, elem) } else { let d = l2r_nat_drop_raw(x); l2r_array_empty<T>() }
}

fn lean_mk_empty_array_with_capacity<T>(n : Nat) -> RVec<T> { l2r_mk_empty_with_capacity<T>(n, 8) }

fn lean_array_get_size<T>(v : RVec<T>) -> Nat { l2r_nat_small(l2r_array_size(v)) }
fn lean_array_size<T>(v : RVec<T>) -> u64 { l2r_array_size(v) }

fn lean_array_fget<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get_word(v, l2r_nat_raw(i)) }
fn lean_array_fget_borrowed<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get_word(v, l2r_nat_raw(i)) }
fn lean_array_uget<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }
fn lean_array_uget_borrowed<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }

// An index that is in bounds (a `Fin` of the size, or checked by
// `l2r_word_index_ok`): never a big `Nat` (natively `lean_unbox` of it would
// be garbage). The big case ends the program instead of rejoining the
// update (`fset`, `fswap`): a rejoining path with refcount traffic on the
// big number would make LLVM reload the array's count. Reads take the
// index as its word instead (`l2r_array_get_word`).
fn l2r_index_of_nat(i : Nat) -> u64 {
    let x = l2r_nat_raw(i);
    if (x & 1) == 1 { x >> 1 } else { l2r_unreachable<u64>() }
}

// A read at the word `x` of a `Nat` index that a proof keeps in bounds
// (`a[i]'h`, `ByteArray.get`, `FloatArray.get`): the big and out-of-bounds
// cases are one failing branch, after the view (with `l2r_index_of_nat` in
// front of the read, the big case's panic came after the caller's
// increment with the array still held, and LLVM kept both).
fn l2r_array_get_word<T>(v : RVec<T>, x : u64) -> T {
    let p = l2r_array_give<T>(v);
    let n = l2r_view_size(p);
    if l2r_word_index_ok(x, n) { l2r_view_take<T>(p, x >> 1) } else { l2r_index_fail<T>(x, n) }
}

// The failing branch of a read at an index proved in bounds (never taken
// unless lean2rr or the runtime is wrong), with `l2r_index_of_nat`'s and
// the read's former messages: a big index is unreachable code, a small one
// the read's `index_bug`.
fn l2r_index_fail<T>(x : u64, n : u64) -> T {
    if (x & 1) == 1 { l2r_array_index_bug<T>(x >> 1, n) } else { l2r_unreachable<T>() }
}

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default. The index is taken once (as its word): no reference
// counting on it in bounds. In bounds the default is released after the
// view's end (`l2r_consume`): Reussir would release it at the start of the
// branch, between give and take, and a default that holds the other
// reference to the array (a tree whose children are read, `cs[i]!` with the
// tree as the default) freed the block the view reads (review PAR-01). Out
// of bounds the panic comes first, then the view's end, as natively
// (`lean_array_get_panic` inside the extern, then the caller's release of
// the array it lent): when the view held the last reference, what freeing
// the array releases (a handle that flushes) comes after the message, and
// under `LEAN_ABORT_ON_PANIC` not at all (review HA-01). The panic is the
// one call between a give and its view's end that can run Lean code (a
// stderr stream that `IO.setStderr` made of Lean functions), which may drop
// the reference that keeps a shared array alive: nothing reads through the
// view after it (`l2r_view_end` of a shared view reads nothing;
// `leanrt::array::give`).
fn lean_array_get<T>(dflt : T, v : RVec<T>, i : Nat) -> T {
    let x = l2r_nat_raw(i);
    let p = l2r_array_give<T>(v);
    if l2r_word_index_ok(x, l2r_view_size(p)) {
        let r = l2r_view_take<T>(p, x >> 1);
        let d = l2r_consume<T>(dflt);
        r
    } else {
        let ignored = l2r_panic_code(0);
        let e = l2r_view_end<T>(p);
        let d = l2r_nat_drop_raw(x);
        dflt
    }
}

fn lean_array_get_borrowed<T>(dflt : T, v : RVec<T>, i : Nat) -> T { lean_array_get(dflt, v, i) }

// Reads of an element of an array of boxes at a type that a box holds as
// an immediate, or as an immediate or one of leanrt's own cells (lean2rr's
// `boxWordRead?`): `T` is `u64` (the box's word, for `UInt8/16/32`,
// `Char`, `Bool`, an enumeration: `l2r_any_word_as_<k>` reads it, any
// pointer is a mismatch), `Nat` or `Int`. An immediate is read without a
// copy of the box: one test of bit 0, no reference counting; a big
// `Nat`/`Int` is copied as `l2r_any_as` copies it. The view ends as in
// `l2r_view_take` (the block freed when it held the last reference; a
// word that is not an immediate is then only printed by the mismatch).
#[ffi(import)]
fn l2r_view_take_as<T>(p : u64, i : u64) -> T [{ {
    trait Take: Sized { fn take(a: &leanrt::any::LAny) -> Self; }
    impl Take for u64 {
        #[inline(always)]
        fn take(a: &leanrt::any::LAny) -> u64 { a.word() }
    }
    // A big number: copied out of line (the texture stays small enough
    // for LLVM to inline at a cold call site).
    #[cold]
    #[inline(never)]
    fn big<B>(a: &leanrt::any::LAny, num: u64) -> B { leanrt::any::as_(a.clone(), num) }
    impl Take for leanrt::nat::LNat {
        #[inline(always)]
        fn take(a: &leanrt::any::LAny) -> Self {
            let w = a.word();
            if w & 1 == 1 { unsafe { leanrt::nat::LNat::from_raw(w) } } else { big(a, leanrt::any::NUM_NAT) }
        }
    }
    impl Take for leanrt::nat::LInt {
        #[inline(always)]
        fn take(a: &leanrt::any::LAny) -> Self {
            let w = a.word();
            if w & 1 == 1 { unsafe { leanrt::nat::LInt::from_raw(w) } } else { big(a, leanrt::any::NUM_INT) }
        }
    }
    let o = (p & !1) as *mut leanrt::drop::Hdr;
    let r = <[:T:] as Take>::take(unsafe { &*leanrt::drop::elems::<leanrt::any::LAny>(o).add(i as usize) });
    if (p & 1) == 0 { leanrt::drop::free_vec::<leanrt::any::LAny>(o); }
    r
} }];

// A box taken at `T` as `l2r_view_take_as` reads it: `get!`'s default.
#[ffi(import)]
fn l2r_any_take_as<T>(a : LAny) -> T [{ {
    trait Take: Sized { fn take(a: leanrt::any::LAny) -> Self; }
    impl Take for u64 {
        #[inline(always)]
        fn take(a: leanrt::any::LAny) -> u64 { a.into_raw() }
    }
    impl Take for leanrt::nat::LNat {
        #[inline(always)]
        fn take(a: leanrt::any::LAny) -> Self { leanrt::any::as_(a, leanrt::any::NUM_NAT) }
    }
    impl Take for leanrt::nat::LInt {
        #[inline(always)]
        fn take(a: leanrt::any::LAny) -> Self { leanrt::any::as_(a, leanrt::any::NUM_INT) }
    }
    <[:T:] as Take>::take(a)
} }];

fn l2r_array_get_as<T>(v : RVec<LAny>, i : u64) -> T {
    let p = l2r_array_give<LAny>(v);
    let n = l2r_view_size(p);
    if i < n { l2r_view_take_as<T>(p, i) } else { l2r_array_index_bug<T>(i, n) }
}

fn l2r_array_get_word_as<T>(v : RVec<LAny>, x : u64) -> T {
    let p = l2r_array_give<LAny>(v);
    let n = l2r_view_size(p);
    if l2r_word_index_ok(x, n) { l2r_view_take_as<T>(p, x >> 1) } else { l2r_index_fail<T>(x, n) }
}

fn lean_array_fget_as<T>(v : RVec<LAny>, i : Nat) -> T { l2r_array_get_word_as<T>(v, l2r_nat_raw(i)) }
fn lean_array_fget_borrowed_as<T>(v : RVec<LAny>, i : Nat) -> T { l2r_array_get_word_as<T>(v, l2r_nat_raw(i)) }
fn lean_array_uget_as<T>(v : RVec<LAny>, i : u64) -> T { l2r_array_get_as<T>(v, i) }
fn lean_array_uget_borrowed_as<T>(v : RVec<LAny>, i : u64) -> T { l2r_array_get_as<T>(v, i) }

// `get!` (as `lean_array_get`): out of bounds, the default taken at `T`.
fn lean_array_get_as<T>(dflt : LAny, v : RVec<LAny>, i : Nat) -> T {
    let x = l2r_nat_raw(i);
    let p = l2r_array_give<LAny>(v);
    if l2r_word_index_ok(x, l2r_view_size(p)) {
        let r = l2r_view_take_as<T>(p, x >> 1);
        let d = l2r_consume<LAny>(dflt);
        r
    } else {
        let e = l2r_view_end<LAny>(p);
        let d = l2r_nat_drop_raw(x);
        let ignored = l2r_panic_code(0);
        l2r_any_take_as<T>(dflt)
    }
}
fn lean_array_get_borrowed_as<T>(dflt : LAny, v : RVec<LAny>, i : Nat) -> T { lean_array_get_as<T>(dflt, v, i) }

fn lean_array_fset<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> { l2r_array_set(v, l2r_index_of_nat(i), x) }
fn lean_array_uset<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> { l2r_array_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_array_set<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> {
    let w = l2r_nat_raw(i);
    if l2r_word_index_ok(w, l2r_array_size(v)) { l2r_array_set(v, w >> 1, x) } else {
        let d = l2r_nat_drop_raw(w);
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_array_push<T>(v : RVec<T>, x : T) -> RVec<T> { l2r_array_push(v, x) }
fn lean_array_pop<T>(v : RVec<T>) -> RVec<T> { l2r_array_pop(v) }

fn lean_array_fswap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    l2r_array_swap(v, l2r_index_of_nat(i), l2r_index_of_nat(j))
}

fn lean_array_uswap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> { l2r_array_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_array_swap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    let n = l2r_array_size(v);
    let x = l2r_nat_raw(i);
    let y = l2r_nat_raw(j);
    if l2r_word_index_ok(x, n) && l2r_word_index_ok(y, n) { l2r_array_swap(v, x >> 1, y >> 1) } else {
        let d = l2r_nat_drop_raw(x) + l2r_nat_drop_raw(y);
        v
    }
}

// `Array.replicate n x`. As `lean_mk_array` (lean-runtime's
// `sem::array::replicate_len`, `l2r_replicate_len`): a big `n` that is a
// `size_t` (2^63 <= n < 2^64) is the size asked for, and the byte size
// `24 + 8n` then overflows (`integer overflow in runtime computation`);
// 2^64 or more is `out of memory`. Unlike `Array.mkEmpty`: natively out of
// memory for every big capacity; lean2rr gives the empty array (LB-37;
// cross-test XT-5).
fn lean_mk_array<T>(n : Nat, x : T) -> RVec<T> { l2r_array_replicate(l2r_replicate_len(n), x) }

// ---- ByteArray (RVec<u8>) ----

fn lean_mk_empty_byte_array(n : Nat) -> RVec<u8> { l2r_mk_empty_with_capacity<u8>(n, 1) }
fn lean_byte_array_size(v : RVec<u8>) -> Nat { l2r_nat_small(l2r_array_size(v)) }
fn lean_sarray_size<T>(v : RVec<T>) -> u64 { l2r_array_size(v) }
fn lean_byte_array_uget(v : RVec<u8>, i : u64) -> u8 { l2r_array_get(v, i) }
fn lean_byte_array_fget(v : RVec<u8>, i : Nat) -> u8 { l2r_array_get_word(v, l2r_nat_raw(i)) }
// `ByteArray.get!`: 0 out of bounds (no panic, as lean.h).
fn lean_byte_array_get(v : RVec<u8>, i : Nat) -> u8 {
    let x = l2r_nat_raw(i);
    let p = l2r_array_give<u8>(v);
    if l2r_word_index_ok(x, l2r_view_size(p)) { l2r_view_take<u8>(p, x >> 1) } else {
        let e = l2r_view_end<u8>(p);
        let d = l2r_nat_drop_raw(x);
        0
    }
}
fn lean_byte_array_push(v : RVec<u8>, x : u8) -> RVec<u8> { l2r_array_push(v, x) }
fn lean_byte_array_uset(v : RVec<u8>, i : u64, x : u8) -> RVec<u8> { l2r_array_set(v, i, x) }
fn lean_byte_array_fset(v : RVec<u8>, i : Nat, x : u8) -> RVec<u8> { l2r_array_set(v, l2r_index_of_nat(i), x) }
// `ByteArray.set!`: unchanged out of bounds.
fn lean_byte_array_set(v : RVec<u8>, i : Nat, x : u8) -> RVec<u8> {
    let w = l2r_nat_raw(i);
    if l2r_word_index_ok(w, l2r_array_size(v)) { l2r_array_set(v, w >> 1, x) } else { let d = l2r_nat_drop_raw(w); v }
}
#[ffi(import)]
fn lean_byte_array_hash(v : RVec<u8>) -> u64 [{ { let r = sem::hash::byte_array_hash(leanrt::array::as_slice(&v)); leanrt::array::release(v); r } }];
#[ffi(import)]
fn lean_sarray_dec_eq(a : RVec<u8>, b : RVec<u8>) -> bool [{ { let r = leanrt::array::as_slice(&a) == leanrt::array::as_slice(&b); leanrt::array::release(a); leanrt::array::release(b); r } }];
#[ffi(import)]
fn l2r_byte_array_copy_slice(src : RVec<u8>, so : u64, dest : RVec<u8>, d : u64, len : u64, exact : bool) -> RVec<u8> [{
    leanrt::array::copy_slice(src, so, dest, d, len, exact)
}];
// `ByteArray.copySlice` (lean-runtime's `sem::array::copy_slice`, in the
// texture; a source offset past the end returns `dest` inline): the offsets
// and the length are passed saturated (`l2r_nat_sat`), so ones of 2^64 or
// more give the definition's result (LB-06 lifted; natively
// `lean_nat_to_size_t` ends with `out of memory`).
fn lean_byte_array_copy_slice(src : RVec<u8>, so : Nat, dest : RVec<u8>, d : Nat, len : Nat, exact : bool) -> RVec<u8> {
    let s = l2r_nat_sat(so);
    if s > l2r_array_size(src) { dest } else {
        let n = l2r_nat_sat(len);
        let o = l2r_nat_sat(d);
        l2r_byte_array_copy_slice(src, s, dest, o, n, exact)
    }
}
// `ByteArray.mk`/`ByteArray.data` convert from/to `Array UInt8` (an array
// of boxes), `FloatArray.mk`/`FloatArray.data` from/to `Array Float`: a new
// array of exactly the source's size, the elements converted in one loop
// (`leanrt::array`), as natively. lean2rr calls these; in a program that
// casts, `l2r_bytes_of_boxes` and `l2r_floats_of_boxes` only for an array
// whose boxes they read (`l2r_boxes_all_imm`, `l2r_boxes_all_float_words`),
// its generated loop (`l2r_byte_array_of_array`, ...) otherwise.
#[ffi(import)]
fn l2r_boxes_of_bytes(src : RVec<u8>) -> RVec<LAny> [{ leanrt::array::boxes_of_bytes(src) }];
#[ffi(import)]
fn l2r_bytes_of_boxes(src : RVec<LAny>) -> RVec<u8> [{ leanrt::array::bytes_of_boxes(src) }];
#[ffi(import)]
fn l2r_boxes_all_imm(src : RVec<LAny>) -> bool [{ leanrt::array::boxes_all_imm(src) }];
#[ffi(import)]
fn l2r_boxes_of_floats(src : RVec<f64>) -> RVec<LAny> [{ leanrt::array::boxes_of_floats(src) }];
#[ffi(import)]
fn l2r_floats_of_boxes(src : RVec<LAny>) -> RVec<f64> [{ leanrt::array::floats_of_boxes(src) }];
#[ffi(import)]
fn l2r_boxes_all_float_words(src : RVec<LAny>) -> bool [{ leanrt::array::boxes_all_float_words(src) }];

// ---- FloatArray (RVec<f64>) ----

fn lean_mk_empty_float_array(n : Nat) -> RVec<f64> { l2r_mk_empty_with_capacity<f64>(n, 8) }
fn lean_float_array_size(v : RVec<f64>) -> Nat { l2r_nat_small(l2r_array_size(v)) }
fn lean_float_array_uget(v : RVec<f64>, i : u64) -> f64 { l2r_array_get(v, i) }
fn lean_float_array_fget(v : RVec<f64>, i : Nat) -> f64 { l2r_array_get_word(v, l2r_nat_raw(i)) }
// `FloatArray.get!`: 0.0 out of bounds.
fn lean_float_array_get(v : RVec<f64>, i : Nat) -> f64 {
    let x = l2r_nat_raw(i);
    let p = l2r_array_give<f64>(v);
    if l2r_word_index_ok(x, l2r_view_size(p)) { l2r_view_take<f64>(p, x >> 1) } else {
        let e = l2r_view_end<f64>(p);
        let d = l2r_nat_drop_raw(x);
        0.0
    }
}
fn lean_float_array_push(v : RVec<f64>, x : f64) -> RVec<f64> { l2r_array_push(v, x) }
fn lean_float_array_uset(v : RVec<f64>, i : u64, x : f64) -> RVec<f64> { l2r_array_set(v, i, x) }
fn lean_float_array_fset(v : RVec<f64>, i : Nat, x : f64) -> RVec<f64> { l2r_array_set(v, l2r_index_of_nat(i), x) }
fn lean_float_array_set(v : RVec<f64>, i : Nat, x : f64) -> RVec<f64> {
    let w = l2r_nat_raw(i);
    if l2r_word_index_ok(w, l2r_array_size(v)) { l2r_array_set(v, w >> 1, x) } else { let d = l2r_nat_drop_raw(w); v }
}

// ===========================================================================
// Standard streams
//
// lean2rr builds each `IO.FS.Stream` field as a closure over these
// primitives (fd 0 = stdin, 1 = stdout, 2 = stderr). They are the handle
// operations on lean-runtime's models of glibc's stdin/stdout/stderr
// `FILE`s (`lean_runtime::io`, through leanrt::io): stdout buffered, stderr
// unbuffered, all finished at exit as natively. putStr/write/flush/read/getLine record their outcome in the
// last-error slot (use `l2r_io_finish`, as for files): EPIPE, EBADF (also
// for the wrong direction), EINVAL on streams closed at startup; isTty
// cannot fail.

#[ffi(import)]
fn l2r_stream_putStr(fd : u64, s : LStr) -> u64 [{ { leanrt::io::stream_put(fd, s.utf8()); leanrt::rc_release(s); 0 } }];

#[ffi(import)]
fn l2r_stream_write(fd : u64, b : RVec<u8>) -> u64 [{ { leanrt::io::stream_put(fd, leanrt::array::as_slice(&b)); leanrt::array::release(b); 0 } }];

#[ffi(import)]
fn l2r_stream_flush(fd : u64) -> u64 [{ { leanrt::io::stream_flush(fd); 0 } }];

#[ffi(import)]
fn l2r_stream_read(fd : u64, n : u64) -> RVec<u8> [{ leanrt::io::stream_read(fd, n) }];

#[ffi(import)]
fn l2r_stream_getLine(fd : u64) -> LStr [{ leanrt::io::stream_get_line(fd) }];

#[ffi(import)]
fn l2r_stream_isTty(fd : u64) -> bool [{ leanrt::io::is_tty(fd) }];

// A runtime diagnostic line (`dbgTrace`, `timeit`, `allocprof`):
// `io_eprintln`, to the current stderr stream.
fn l2r_diag_println(s : LStr) -> u64 { l2r_stderr_put(lean_string_push(s, 10)) }

// ===========================================================================
// ST.Ref / IO.Ref
//
// lean2rr represents a reference whose contents have type `T` as a generated
// shared record `L2RRef_N(Cell<T>)` around Reussir's mutable cell, so all
// aliases see updates and the value keeps its own representation; these
// helpers act on the cell (`r.0`). `get` returns a copy (the cell keeps its
// reference); `swap` moves the old value out, so after `swap` with the
// placeholder (Lean's `take`) a value held only by the cell is unshared.
// The `lean_st_*` externs return BaseIO results, so lean2rr wraps these.

fn l2r_rc_get<T>(c : Cell<T>) -> T { core::intrinsic::cell::get(c) }

// `ST.Ref.set` on the reference `r` (a record of type `R`, lean2rr's
// `L2RRefN`) whose cell is `c` (`r.0`). As natively (`lean_st_ref_set`),
// the new value is stored before the old one is released, so code that the
// release runs (the `sync` dependents of a promise it drops,
// `leanrt::task::resolve`) sees the new value. Reussir's `cell::set`
// releases the old value before the store: the old value is taken (a
// second reference) and released after the store, by an FFI call
// (`l2r_release_value_then`), which Reussir keeps there. Natively the set
// borrows the reference, and the caller releases it after the set: when the
// set is the reference's last use, the old value is released first, then
// the reference, which frees the new value. Here the cell `c` dies at the
// store, so the reference `r` is passed too, and released by the same FFI
// call after the old value (a release of `c` at the store would free the
// cell, and the new value with it, before the old value: test
// `RtRefSetLastUse`).
fn l2r_rc_set_ref<T, R>(c : Cell<T>, v : T, r : R) -> u64 {
    let old = core::intrinsic::cell::get(c);
    core::intrinsic::cell::set(c, v);
    l2r_release_value_then<T, R>(old, r)
}

// The release of a value a reference gave up, then of the reference, as
// `lean_dec` does natively (`leanrt::drop::release`): the last reference to
// a record is freed inside a free the runtime starts, so what it holds is
// released in Lean's order (its last field first) and the `sync`
// dependents of the promises it drops run when that free ends, before the
// next release and before the caller goes on. Returns 0.
#[ffi(import)]
fn l2r_release_value_then<T, R>(x : T, r : R) -> u64 [{ { leanrt::drop::release(x); leanrt::drop::release(r); 0 } }];

fn l2r_rc_swap<T>(c : Cell<T>, v : T) -> T {
    let old = core::intrinsic::cell::get(c);
    core::intrinsic::cell::set(c, v);
    old
}

// ST.Ref in a program that creates tasks (lean2rr's `createsTasks`; plan
// §5.14, "References"; `leanrt::refs`): lean2rr puts a point before each
// operation. A read is a polling point and a write a publication
// (lean-runtime's `ref_read`, `before_publish`), and while some reference
// is taken by a `modify` (`take`, then `set`), another thread's operation
// on that reference waits for modify's store (Lean 4.35's rule): the
// points answer whether a reference is taken, and only then is the wait
// called (`l2r_ref_wait`, with the reference's record: the call then holds
// a reference to it). `take` always records the reference
// (`l2r_ref_take_mark`). A program without tasks calls none of these.

#[ffi(import)]
fn l2r_ref_read_point() -> bool [{ leanrt::refs::read_point() }];

#[ffi(import)]
fn l2r_ref_write_point() -> bool [{ leanrt::refs::write_point() }];

#[ffi(import)]
fn l2r_ref_swap_point() -> bool [{ leanrt::refs::swap_point() }];

// The address of reference record `r` (as `l2r_ptr_addr_rec`, which gives
// the reference the call received back inline), then the wait: `store` 1
// for `set` and `swap`. Returns 0.
#[ffi(import)]
fn l2r_ref_wait<R>(r : R, store : u64) -> u64 [{
    {
        let p = unsafe { *(&r as *const [:R:] as *const usize) };
        if (p >> 56) == 0 {
            let c = unsafe { *(p as *const u32) };
            if c > 1 && c < leanrt::drop::IMMORTAL {
                unsafe { *(p as *mut u32) = c - 1 };
                ::std::mem::forget(r);
            }
        }
        leanrt::refs::wait(p, store != 0);
        0
    }
}];

// `take`: the reference is taken by the running thread (after waiting for
// another thread's store). Returns 0.
#[ffi(import)]
fn l2r_ref_take_mark<R>(r : R) -> u64 [{
    {
        let p = unsafe { *(&r as *const [:R:] as *const usize) };
        if (p >> 56) == 0 {
            let c = unsafe { *(p as *const u32) };
            if c > 1 && c < leanrt::drop::IMMORTAL {
                unsafe { *(p as *mut u32) = c - 1 };
                ::std::mem::forget(r);
            }
        }
        leanrt::refs::take(p);
        0
    }
}];

// The task manager's finalization, in a program that creates tasks (the
// generated `l2r_std_drop_workers`): the next pool worker's stream cells
// become the current ones, the running thread's set aside; 1 if there was
// one (`leanrt::sched::worker_streams_enter`). The generated
// `l2r_std_leave` then drops them.
#[ffi(import)]
fn l2r_worker_streams_enter(base : u64) -> u64 [{ leanrt::sched::worker_streams_enter(base) as u64 }];

// `LRef<T>`: a shared cell of the runtime (a 0-or-1 element vector). Not
// used by generated code any more (promises hold the `LCell` of their
// task); kept with its functions.

#[ffi(import)]
fn l2r_ref_new<T>(v : T) -> LRef<T> [{ leanrt::array::ref_new(v) }];

#[ffi(import)]
fn l2r_ref_get<T>(r : LRef<T>) -> T [{ leanrt::array::ref_get(r) }];

// The old value is released after the new one is stored, as `lean_dec`
// does (`l2r_rc_set_ref`).
#[ffi(import)]
fn l2r_ref_set<T>(r : LRef<T>, v : T) -> u64 [{ { leanrt::array::ref_set(r, v); 0 } }];

#[ffi(import)]
fn l2r_ref_swap<T>(r : LRef<T>, v : T) -> T [{ leanrt::array::ref_swap(r, v) }];

// `ST.Prim.Ref.take`: move the value out, leaving the cell empty until the
// next `set` (so the value stays uniquely referenced, as in Lean).
#[ffi(import)]
fn l2r_ref_take<T>(r : LRef<T>) -> T [{ leanrt::array::ref_take(r) }];

// An empty cell, and whether a cell is empty.
#[ffi(import)]
fn l2r_ref_empty<T>() -> LRef<T> [{ leanrt::array::ref_empty() }];

#[ffi(import)]
fn l2r_ref_is_empty<T>(r : LRef<T>) -> bool [{ leanrt::array::ref_is_empty(r) }];

// ---- IO.Promise ----
//
// A promise is an `LPromise`: a runtime object holding the cell of its
// task (`Promise.result?`, a task whose value is an `Option`, lean2rr's
// `Option Box` so that typed and uniform code share it), which stays
// unresolved until `Promise.resolve` (translation plan §5.14). Dropping the
// last reference to an unresolved promise resolves it with `none`, as
// natively (`leanrt::task::Promise`, through the program's
// `l2r_promise_drop_c`).
#[ffi(rust = "::reussir_rt::rc::Rc<::std::boxed::Box<dyn std::any::Any>>")]
pub struct LPromise;

// A new promise for the unresolved task `c`. Before `main` (no task manager)
// Lean's internal panic.
#[ffi(import)]
fn l2r_promise_new<S>(c : LCell<S>) -> LPromise [{
    {
        let c = ::std::mem::ManuallyDrop::new(c);
        let p: usize = unsafe { ::std::mem::transmute_copy(&*c) };
        leanrt::task::promise_new(p)
    }
}];

// The task of promise `p` (a new reference).
#[ffi(import)]
fn l2r_promise_cell<S>(p : LPromise) -> LCell<S> [{
    {
        let a = leanrt::task::promise_cell(&p);
        let c: Rc<[:S:]> = unsafe { ::std::mem::transmute_copy(&a) };
        let r = c.clone();
        ::std::mem::forget(c);
        leanrt::rc_release(p);
        leanrt::drop::Cell::from_inner(r)
    }
}];

// Release a promise (after an operation that borrows it).
#[ffi(import)]
fn l2r_promise_release(p : LPromise) -> u64 [{ { drop(p); 0 } }];

// Resolve the promise whose task is `c` with the state `v` (`done(some x)`,
// or `done(none)` for a dropped promise) unless it is resolved already
// (only the first resolution counts): lean-runtime's `resolve`
// (`leanrt::task::resolve_with`), which tests the promise and calls the
// store after its writers point, during which another context may resolve
// it (review HR-01), then walks its dependents. The old state (the pending
// one) is released after the walk, outside the store; `v`, when the promise
// was resolved already. `c` is consumed (released here). Returns 0.
#[ffi(import)]
fn l2r_promise_resolve_with<T>(c : LCell<T>, v : T) -> u64 [{
    {
        let mut c = c;
        let a: usize = unsafe { ::std::mem::transmute_copy(&c) };
        let mut v = Some(v);
        let mut old = None;
        leanrt::task::resolve_with(a, &mut || {
            if let Some(v) = v.take() {
                old = Some(unsafe { ::std::mem::replace(c.data_mut(), v) });
            }
        });
        drop(c);
        drop(v);
        if let Some(old) = old {
            leanrt::drop::release(old);
        }
        0
    }
}];

// `Option.getOrBlock!` on `none`: Lean's forced panic message, then block
// forever (as natively).
#[ffi(import)]
fn l2r_promise_dropped() -> u64 [{ leanrt::promise_dropped() }];

fn l2r_option_get_or_block_none<T>() -> T {
    let ignored = l2r_promise_dropped();
    l2r_unreachable<T>()
}

#[ffi(import)]
fn l2r_ref_ptr_eq<T>(a : LRef<T>, b : LRef<T>) -> bool [{ leanrt::array::ref_ptr_eq(a, b) }];

// ===========================================================================
// Once-cells (constants and closed terms)
//
// A slot stores one reference forever. `T` is a pointer-sized (or smaller)
// boundary type; lean2rr boxes other values in a one-field shared struct.

#[ffi(import)]
fn l2r_once_has(slot : u64) -> bool [{ leanrt::once::has(slot) }];

// A thunk has its value: whoever waits for it goes on
// (`l2r_thunk_wait_busy`).
#[ffi(import)]
fn l2r_thunk_done(a : u64) -> u64 [{ { leanrt::sched::on_finish(a as usize); 0 } }];

// A `busy` thunk is needed: wait until it has its value.
#[ffi(import)]
fn l2r_thunk_wait_busy(a : u64) -> u64 [{ { leanrt::sched::thunk_wait_busy(a as usize); 0 } }];

// The accessor of a constant, first: whether its value is there, by its
// word in the runtime's table at a fixed address (one load, inlined;
// a second load, of its set flag, when the word is 0:
// `leanrt::once::ready`). Then, when it is not: whether it has its value,
// else the caller computes and sets it (another context computing it is
// waited for).
#[ffi(import)]
fn l2r_once_ready(slot : u64) -> bool [{ leanrt::once::ready(slot) }];

#[ffi(import)]
fn l2r_once_claim(slot : u64) -> bool [{ leanrt::once::claim(slot) }];

// A new reference to the value of set slot `slot` (inline: its word in the
// table, then the increment; `leanrt::once::get_raw`). Read at the type it
// was stored at (`leanrt::once::word_of`).
#[ffi(import)]
fn l2r_once_get<T>(slot : u64) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let raw = leanrt::once::get_raw(slot);
        let p: ::std::mem::ManuallyDrop<[:T:]> = unsafe { ::std::mem::transmute_copy(&raw) };
        (*p).clone()
    }
}];

// Store `v` in slot `slot` and return it (the slot keeps a reference).
#[ffi(import)]
fn l2r_once_set<T>(slot : u64, v : T) -> T [{
    {
        leanrt::once::set_raw(slot, leanrt::once::word_of::<[:T:]>(v.clone()));
        v
    }
}];

// Store `v` in slot `slot`: its reference moves into the slot (the
// accessor of a constant reads the slot afterwards, `l2r_once_get`).
#[ffi(import)]
fn l2r_once_put<T>(slot : u64, v : T) -> u64 [{
    {
        leanrt::once::set_raw(slot, leanrt::once::word_of::<[:T:]>(v));
        0
    }
}];

// Mutable global cells (e.g. the current standard streams for
// `IO.setStdout`/`setStderr`/`setStdin`), in the same slot numbering as the
// once-cells: `l2r_once_has`/`l2r_once_get` read them, `l2r_once_set`
// initializes them, and `l2r_cell_swap` replaces the value and returns the
// previous one.
#[ffi(import)]
fn l2r_cell_swap<T>(slot : u64, v : T) -> T [{
    {
        let old = leanrt::once::swap_raw(slot, leanrt::once::word_of::<[:T:]>(v));
        let p: [:T:] = unsafe { ::std::mem::transmute_copy(&old) };
        p
    }
}];

// Empty a set cell, moving its value (and reference) to the caller.
#[ffi(import)]
fn l2r_once_take<T>(slot : u64) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let raw = leanrt::once::take_raw(slot);
        let p: [:T:] = unsafe { ::std::mem::transmute_copy(&raw) };
        p
    }
}];

// Stream contexts: natively each thread has its own current standard
// streams. `l2r_std_push(base)` sets the cells `base..base+2` aside (empty,
// so they are rebuilt as the process's streams on first use) when a task
// starts; `l2r_std_pop(base)` puts them back when it ends (lean2rr's
// `l2r_std_leave` first empties them, releasing the task's streams).
#[ffi(import)]
fn l2r_std_push(base : u64) -> u64 [{ { leanrt::once::push_context(base, 3); 0 } }];

#[ffi(import)]
fn l2r_std_pop(base : u64) -> u64 [{ { leanrt::once::pop_context(base, 3); 0 } }];

// ===========================================================================
// Thunks and tasks
//
// A `Thunk α` or `Task α` is an `LCell<S>` whose state type `S` lean2rr
// generates once for thunks and once for tasks, over boxes:
// `enum S { pending(L2RUnit -> LAny), busy, done(LAny) }` (a shared enum;
// tasks also have `bind(L2RUnit -> LCell<S>)`). lean2rr also generates
// the functions that force the state (`l2r_thunk_get_S`, `l2r_task_get_S`,
// ...): a thunk runs its closure
// on first `get` and keeps the value; a task created after `main` has
// started stays pending until it is needed or `main` returns (during module
// initialization it is computed at once). `leanrt::task` keeps the queues
// of pending tasks and answers questions about their state.

// A new cell; its padding (after the count) is the runtime's index slot for
// tasks (`leanrt::task`), set to "none" here.
#[ffi(import)]
fn l2r_lcell_new<T>(v : T) -> LCell<T> [{
    {
        assert!(::std::mem::size_of::<[:T:]>() == ::std::mem::size_of::<usize>());
        let c = Rc::new(v);
        leanrt::task::init_cell(unsafe { ::std::mem::transmute_copy::<Rc<[:T:]>, usize>(&c) });
        leanrt::drop::Cell::from_inner(c)
    }
}];

// The state (a new reference); the cell's reference is released first
// (`leanrt::drop::cell_get`), so that LLVM cancels it with the caller's
// increment.
#[ffi(import)]
fn l2r_lcell_get<T>(c : LCell<T>) -> T [{ leanrt::drop::cell_get(c) }];

// The old state is released after the new one is stored, as `lean_dec`
// does (`l2r_rc_set_ref`). The store is one another context can see (a thunk's
// or a task's value, a bind task's continuation): first the writers of the
// streams this context handed off end (lean-runtime's
// `sched::before_publish`; one relaxed load when there is none).
#[ffi(import)]
fn l2r_lcell_set<T>(c : LCell<T>, v : T) -> u64 [{
    {
        let mut c = c;
        leanrt::sched::before_publish();
        let old = unsafe { ::std::mem::replace(c.data_mut(), v) };
        leanrt::drop::release(old);
        0
    }
}];

// Store `v`, returning the previous value (its reference moves out, so a
// uniquely held state can be reused by the caller).
#[ffi(import)]
fn l2r_lcell_swap<T>(c : LCell<T>, v : T) -> T [{
    {
        let mut c = c;
        unsafe { ::std::mem::replace(c.data_mut(), v) }
    }
}];

// A new deferred task at priority `prio` (`kind`: 1 a pure task, 2 a
// dependent, see `leanrt::task::register`), given to lean-runtime's
// scheduler, which never runs it inside the call (LB-39). Its job holds no
// reference: the program's last one releases the task (`leanrt::task`).
// Returns 0 (1, the caller runs it now, is never answered).
#[ffi(import)]
fn l2r_task_register<S>(c : LCell<S>, tag : u64, prio : u64, kind : u64) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        let r = leanrt::task::register(p, tag, prio, kind);
        drop(c);
        r
    }
}];

// The walk of a finished task's dependents: the tag of the next `sync`
// dependent to run (`u64::MAX`: the walk is over), which
// `l2r_task_handed<S>()` then gives (with the runtime's reference; to be
// dropped instead when `l2r_task_deleting()`).
#[ffi(import)]
fn l2r_task_walk_next() -> u64 [{ leanrt::task::walk_next() }];

// Before task `a` runs: the tag of the deepest pending task of the chain of
// tasks it waits for (`u64::MAX`: none), given by `l2r_task_handed<S>()`.
#[ffi(import)]
fn l2r_task_source_next_at(a : u64) -> u64 [{ leanrt::task::source_next(a as usize) }];

#[ffi(import)]
fn l2r_task_handed<S>() -> LCell<S> [{ unsafe { ::std::mem::transmute_copy(&leanrt::task::handed()) } }];

#[ffi(import)]
fn l2r_task_deleting() -> bool [{ leanrt::task::deleting() }];

// A task starts running, inside its job (`leanrt::task::begin`); the
// reference passed is released. 1: a dedicated task, which runs as on a
// thread of its own with a fresh stream context (`l2r_std_enter_if` opens
// it; the runtime closes it at the task's end, `leanrt::sched`'s
// `task_end`); 0: a pool task (its emulated worker's stream cells, which
// the runtime installed) or a `sync := true` dependent (the current
// thread's).
#[ffi(import)]
fn l2r_task_begin<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        let r = leanrt::task::begin(p);
        if r & leanrt::task::B_RELEASE != 0 {
            drop(unsafe { ::std::ptr::read(&c) });
        }
        drop(c);
        r & leanrt::task::B_ENTER
    }
}];

// A running `bind` task now waits for the unfinished task `src` it
// continues as (its job reports it to lean-runtime's scheduler; the
// reference passed is released).
#[ffi(import)]
fn l2r_task_bind_wait<S>(c : LCell<S>, src : u64) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        leanrt::task::bind_wait(p, src as usize);
        drop(c);
        0
    }
}];

// The running task has stored its value (`leanrt::task::end`); then the
// reference passed, the job's, is released: if the program dropped its own
// while the task ran, this is the last, and the task is released before
// lean-runtime ends it, so its finish wakes no waiter, as natively. Returns
// 0: lean-runtime ends the task and walks its dependents once the job has
// returned (the task walk helper of Lower/Promises.lean does nothing; it is
// not named here: conv-liveness takes every name in this file, comments
// included, as a root, and would keep the helper in every program).
#[ffi(import)]
fn l2r_task_end<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        let r = leanrt::task::end(p);
        drop(c);
        r
    }
}];

// A task's identity for the runtime (`leanrt::task`): the address of its
// cell. The reference passed is released here, so a caller whose call is
// the cell's last use passes a cell that may be freed before the runtime
// reads it: the generated code uses the cell again on some path after the
// call that takes the address (or a closure it builds first holds it).
#[ffi(import)]
fn l2r_lcell_addr<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        drop(c);
        p as u64
    }
}];

// `IO.cancel` of task `c`: the cancel, then the reference passed is
// released, as natively the caller's decrement comes after
// `lean_io_cancel`, which borrows the task. When `IO.cancel` is the task's
// last use, the release is the cell's last: it releases an unfinished task
// (`leanrt::task::on_last_reference`) after the cancel. (Hunt HTG-02: the
// generated code passed `l2r_lcell_addr(c)`, which released the cell first,
// and the cancel read the index slot of a freed cell.)
#[ffi(import)]
fn l2r_task_cancel<S>(c : LCell<S>) -> u64 [{
    {
        let p: usize = unsafe { ::std::mem::transmute_copy(&c) };
        leanrt::task::cancel(p);
        drop(c);
        0
    }
}];

// Task `dep` (registered as a dependent) was created depending on task
// `src`, with `sync := true` or not (for its start and its cancellation).
// A `sync` dependent whose source finished during the call (lean-runtime's
// writers point, after the caller's test of `src`) has run inside it, its
// value stored (lean-runtime's review HR-02). Returns 0 (1, the caller runs
// it now, is never answered).
#[ffi(import)]
fn l2r_task_depend_at(src : u64, dep : u64, sync : bool) -> u64 [{ leanrt::task::depend(src as usize, dep as usize, sync) }];

// 2 finished, else 1 (`leanrt::task::status`).
#[ffi(import)]
fn l2r_task_status_at(a : u64) -> u8 [{ leanrt::task::status(a as usize) }];

// For `IO.waitAny`'s generated loop (`leanrt::task::wait_status`): 1 while
// it collects the list; then 2 at the position lean-runtime's `wait_any`
// chose, 1 elsewhere (the loop's test for 0, run a waiting task, is never
// true).
#[ffi(import)]
fn l2r_task_wait_status_at(a : u64) -> u8 [{ leanrt::task::wait_status(a as usize) }];

// `IO.getTaskState`: lean-runtime's `state`, 0 waiting, 1 running, 2
// finished (the generated branches for 3 and 4 are never taken; see
// lean2rr's `taskStateFn`).
#[ffi(import)]
fn l2r_task_query_at(a : u64) -> u8 [{ leanrt::task::query(a as usize) }];

#[ffi(import)]
fn l2r_task_deferring() -> bool [{ leanrt::task::deferring() }];

// A constant whose value may hold tasks waits for them when it is first
// computed (lean2rr's `l2r_persist_T`, as native `lean_mark_persistent`):
// a walk over its cells, skipped when every task has finished
// (`l2r_task_settled`). The walk visits each cell once
// (`l2r_persist_seen`: whether walk `h` has seen it, else it records it)
// and keeps what it reads out of thunks, tasks and references until it ends
// (`l2r_persist_keep`), so that no cell it has seen is freed meanwhile.
// It has two passes (`leanrt::persist`): the first collects the unfinished
// tasks (`l2r_persist_collect_at`); the second (`l2r_persist_rewalk`) runs,
// before each task it waits for, the collected ones that natively come
// before it in the workers' queue (`l2r_task_run_before`, generated, over
// `l2r_persist_before_at`).
#[ffi(import)]
fn l2r_task_settled() -> bool [{ leanrt::task::settled() }];

#[ffi(import)]
fn l2r_persist_begin() -> u64 [{ leanrt::persist::begin() }];

#[ffi(import)]
fn l2r_persist_seen<T>(h : u64, v : T) -> bool [{ leanrt::persist::seen::<[:T:]>(h, v) }];

#[ffi(import)]
fn l2r_persist_keep<T>(h : u64, v : T) -> u64 [{ leanrt::persist::keep::<[:T:]>(h, v) }];

#[ffi(import)]
fn l2r_persist_collect_at(h : u64, a : u64) -> bool [{ leanrt::persist::collect(h, a as usize) }];

#[ffi(import)]
fn l2r_persist_rewalk(h : u64) -> bool [{ leanrt::persist::rewalk(h) }];

#[ffi(import)]
fn l2r_persist_before_at(h : u64, a : u64) -> u64 [{ leanrt::persist::before(h, a as usize) }];

#[ffi(import)]
fn l2r_persist_end(h : u64) -> u64 [{ leanrt::persist::end(h) }];

#[ffi(import)]
fn l2r_task_manager_start() -> u64 [{ { leanrt::task::start(); 0 } }];

#[ffi(import)]
fn l2r_task_shutdown() -> u64 [{ { leanrt::task::shutdown(); 0 } }];

// The next queued task to run (when `main` has returned, or for a waiting
// `main`): its tag (`u64::MAX` if none), then the cell itself (with the
// runtime's reference; to be dropped instead when `l2r_task_deleting()`).
#[ffi(import)]
fn l2r_task_next_tag() -> u64 [{ leanrt::task::next_tag() }];

#[ffi(import)]
fn l2r_task_take<S>() -> LCell<S> [{ unsafe { ::std::mem::transmute_copy(&leanrt::task::handed()) } }];

#[ffi(import)]
fn l2r_task_check_canceled() -> bool [{ leanrt::task::check_canceled() }];

#[ffi(import)]
fn l2r_hang() -> u64 [{ leanrt::task::hang() }];

// A thunk forced by its own computation, or a cycle of tasks waiting for
// each other: native Lean waits forever (other tasks go on).
fn l2r_lazy_cycle<T>() -> T {
    let ignored = l2r_hang();
    l2r_unreachable<T>()
}

// `Task.get` of a `busy` task `a`: it runs on another context of the
// runtime's scheduler, which has blocked (`leanrt::sched`); wait until it
// has finished (1), then the caller looks again. On the running context it
// needs itself, and this waits forever.
#[ffi(import)]
fn l2r_task_wait_running(a : u64) -> u64 [{ leanrt::task::wait_running(a as usize) }];

// `IO.waitAny` when every task of the list is running or waits for a
// promise: wait until some task finishes (1), then the list is looked at
// again.
#[ffi(import)]
fn l2r_task_wait_progress() -> u64 [{ leanrt::task::wait_progress() }];

// ===========================================================================
// Std.Sync (`leanrt::sync`): `BaseMutex`, `Condvar`, `BaseRecursiveMutex`,
// `BaseSharedMutex`. Each is a runtime handle (`LHandle`; `lcAny` in mono
// code). A thread that must wait blocks its context of the scheduler and
// the others run meanwhile (`leanrt::sched`). The `l2r_io_*` functions are
// the payloads of the `BaseIO` externs `lean_io_*`.

#[ffi(import)]
fn l2r_sync_new(kind : u64) -> LHandle [{
    match kind { 0 => leanrt::sync::mutex_new(), 1 => leanrt::sync::condvar_new(), 2 => leanrt::sync::recmutex_new(), _ => leanrt::sync::sharedmutex_new() }
}];

// Operation `op` on `h` (see the functions below); the result of a `try`.
#[ffi(import)]
fn l2r_sync_op(op : u64, h : LHandle) -> bool [{
    {
        let r = match op {
            0 => { leanrt::sync::mutex_lock(&h); true }
            1 => leanrt::sync::mutex_try_lock(&h),
            2 => { leanrt::sync::mutex_unlock(&h); true }
            3 => { leanrt::sync::condvar_notify_one(&h); true }
            4 => { leanrt::sync::condvar_notify_all(&h); true }
            5 => { leanrt::sync::recmutex_lock(&h); true }
            6 => leanrt::sync::recmutex_try_lock(&h),
            7 => { leanrt::sync::recmutex_unlock(&h); true }
            8 => { leanrt::sync::sharedmutex_write(&h); true }
            9 => leanrt::sync::sharedmutex_try_write(&h),
            10 => { leanrt::sync::sharedmutex_unlock_write(&h); true }
            11 => { leanrt::sync::sharedmutex_read(&h); true }
            12 => leanrt::sync::sharedmutex_try_read(&h),
            _ => { leanrt::sync::sharedmutex_unlock_read(&h); true }
        };
        leanrt::rc_release(h);
        r
    }
}];

#[ffi(import)]
fn l2r_condvar_wait_h(c : LHandle, m : LHandle) -> u64 [{
    { leanrt::sync::condvar_wait(&c, &m); leanrt::rc_release(c); leanrt::rc_release(m); 0 }
}];

fn l2r_sync_unit(op : u64, h : LHandle) -> L2RUnit {
    let ignored = l2r_sync_op(op, h);
    L2RUnit::u{}
}

fn l2r_io_basemutex_new() -> LHandle { l2r_sync_new(0) }
fn l2r_io_basemutex_lock(m : LHandle) -> L2RUnit { l2r_sync_unit(0, m) }
fn l2r_io_basemutex_try_lock(m : LHandle) -> bool { l2r_sync_op(1, m) }
fn l2r_io_basemutex_unlock(m : LHandle) -> L2RUnit { l2r_sync_unit(2, m) }
fn l2r_io_condvar_new() -> LHandle { l2r_sync_new(1) }
fn l2r_io_condvar_wait(c : LHandle, m : LHandle) -> L2RUnit {
    let ignored = l2r_condvar_wait_h(c, m);
    L2RUnit::u{}
}
fn l2r_io_condvar_notify_one(c : LHandle) -> L2RUnit { l2r_sync_unit(3, c) }
fn l2r_io_condvar_notify_all(c : LHandle) -> L2RUnit { l2r_sync_unit(4, c) }
fn l2r_io_baserecmutex_new() -> LHandle { l2r_sync_new(2) }
fn l2r_io_baserecmutex_lock(m : LHandle) -> L2RUnit { l2r_sync_unit(5, m) }
fn l2r_io_baserecmutex_try_lock(m : LHandle) -> bool { l2r_sync_op(6, m) }
fn l2r_io_baserecmutex_unlock(m : LHandle) -> L2RUnit { l2r_sync_unit(7, m) }
fn l2r_io_basesharedmutex_new() -> LHandle { l2r_sync_new(3) }
fn l2r_io_basesharedmutex_write(m : LHandle) -> L2RUnit { l2r_sync_unit(8, m) }
fn l2r_io_basesharedmutex_try_write(m : LHandle) -> bool { l2r_sync_op(9, m) }
fn l2r_io_basesharedmutex_unlock_write(m : LHandle) -> L2RUnit { l2r_sync_unit(10, m) }
fn l2r_io_basesharedmutex_read(m : LHandle) -> L2RUnit { l2r_sync_unit(11, m) }
fn l2r_io_basesharedmutex_try_read(m : LHandle) -> bool { l2r_sync_op(12, m) }
fn l2r_io_basesharedmutex_unlock_read(m : LHandle) -> L2RUnit { l2r_sync_unit(13, m) }

// ===========================================================================
// Std.Internal.UV (`leanrt::net`, over lean-runtime's `sched::uv` and `net`):
// the primitives of lean2rr's shim (lean2rr/L2RShim.lean), which implements
// the `lean_uv_*` externs in Lean. Each `l2r_shim_*` is the payload of the
// shim's `BaseIO` extern `lean_shim_*`. Timers, sockets, signal watchers and
// operations are runtime handles (`LHandle`), promises `LPromise`; addresses
// are byte arrays (`leanrt::net::decode_addr`); errors lean-runtime's
// `IoError`s, kept in an operation (`leanrt::net::OpSt`), read as the
// `IO.Error` builder, code, file name and details.

fn l2r_unit_of(x : u64) -> L2RUnit { L2RUnit::u{} }

// Operations: their outcome (`leanrt::net::OpSt`).
#[ffi(import)]
fn l2r_shim_op_canceled(o : LHandle) -> bool [{ { let r = leanrt::net::op(&o).canceled; leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_code(o : LHandle) -> u32 [{ { let r = leanrt::net::op(&o).code as u32; leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_bytes(o : LHandle) -> RVec<u8> [{
    { let b = ::std::mem::take(&mut leanrt::net::op(&o).bytes); leanrt::rc_release(o); leanrt::array::bytes_of_vec(b) }
}];
#[ffi(import)]
fn l2r_shim_op_addr(o : LHandle) -> RVec<u8> [{
    { let b = leanrt::net::op(&o).addr.clone(); leanrt::rc_release(o); leanrt::array::bytes_of_vec(b) }
}];
// An operation's string `i`, decoded as Lean's `lean_mk_string` does (each
// invalid UTF-8 sequence becomes U+FFFD).
#[ffi(import)]
fn l2r_shim_op_str(o : LHandle, i : u32) -> LStr [{
    {
        let x = leanrt::net::op(&o);
        let s = leanrt::string::from_bytes_lossy(x.strs.get(i as usize).map(|v| v.as_slice()).unwrap_or(b""));
        leanrt::rc_release(o);
        s
    }
}];
#[ffi(import)]
fn l2r_shim_op_str_count(o : LHandle) -> u32 [{ { let r = leanrt::net::op(&o).strs.len() as u32; leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_has_handle(o : LHandle) -> bool [{ { let r = leanrt::net::op(&o).handle.is_some(); leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_handle(o : LHandle) -> LHandle [{
    { let h = leanrt::net::op(&o).handle.take().expect("leanrt: operation without a handle"); leanrt::rc_release(o); h }
}];
// An operation's error, its start's (`which` 0) or its completion's (1):
// the builder (`u32::MAX`: none), its code, file name and details.
#[ffi(import)]
fn l2r_shim_op_err_kind(o : LHandle, which : u8) -> u32 [{ { let r = leanrt::net::err_kind(&o, which); leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_err_code(o : LHandle, which : u8) -> u32 [{ { let r = leanrt::net::err_errno(&o, which); leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_err_file(o : LHandle, which : u8) -> LStr [{
    { let s = leanrt::string::from_bytes(&leanrt::net::err_texts(&o, which).0); leanrt::rc_release(o); s }
}];
#[ffi(import)]
fn l2r_shim_op_err_details(o : LHandle, which : u8) -> LStr [{
    { let s = leanrt::string::from_bytes(&leanrt::net::err_texts(&o, which).1); leanrt::rc_release(o); s }
}];
// `Timer.next`/`Signal.next`: whether the loop took the promise passed, or
// the loop's own (a new reference).
#[ffi(import)]
fn l2r_shim_op_fresh(o : LHandle) -> bool [{ { let r = leanrt::net::op(&o).fresh; leanrt::rc_release(o); r } }];
#[ffi(import)]
fn l2r_shim_op_promise(o : LHandle) -> LPromise [{
    { let p = leanrt::net::op(&o).promise.clone().expect("leanrt: operation without a promise"); leanrt::rc_release(o); p }
}];

// Addresses (pure externs of the shim).
#[ffi(import)]
fn lean_shim_pton(s : LStr, v6 : bool) -> RVec<u8> [{
    { let b = leanrt::net::pton(s.utf8(), v6); leanrt::rc_release(s); leanrt::array::bytes_of_vec(b) }
}];
#[ffi(import)]
fn lean_shim_ntop(a : RVec<u8>) -> LStr [{
    { let s = leanrt::string::from_bytes(&leanrt::net::ntop(leanrt::array::as_slice(&a))); leanrt::array::release(a); s }
}];
#[ffi(import)]
fn l2r_shim_ifaces() -> LHandle [{ leanrt::net::ifaces() }];

// `IO.Promise.isResolved`, which borrows the promise: released after the
// question (a last reference resolves it with `none`).
#[ffi(import)]
fn l2r_shim_promise_is_resolved(p : LPromise) -> bool [{
    { let r = leanrt::task::promise_is_resolved(leanrt::task::promise_cell(&p)); drop(p); r }
}];

// The loop (lean-runtime's `sched::uv`: each lets the loop catch up first).
#[ffi(import)]
fn l2r_shim_loop_configure_h(a : bool, b : bool) -> u64 [{ { leanrt::net::loop_configure(a, b); 0 } }];
fn l2r_shim_loop_configure(a : bool, b : bool) -> L2RUnit { l2r_unit_of(l2r_shim_loop_configure_h(a, b)) }
#[ffi(import)]
fn l2r_uv_event_loop_alive() -> bool [{ leanrt::net::loop_alive() }];

// Timers and signal watchers. `next` gets the shim's new promise `p` and
// its completion's promise `r`; `stop` and `cancel` give up the loop's
// promise on the caller's context, as natively on the calling thread.
#[ffi(import)]
fn l2r_shim_timer_new(timeout : u64, repeating : bool) -> LHandle [{ leanrt::net::timer_new(timeout, repeating) }];
#[ffi(import)]
fn l2r_shim_timer_next(t : LHandle, p : LPromise, r : LPromise) -> LHandle [{ { let o = leanrt::net::timer_next(&t, p, r); leanrt::rc_release(t); o } }];
#[ffi(import)]
fn l2r_shim_timer_ctl_h(t : LHandle, which : u8) -> u64 [{ { leanrt::net::timer_ctl(&t, which); leanrt::rc_release(t); 0 } }];
fn l2r_shim_timer_ctl(t : LHandle, which : u8) -> L2RUnit { l2r_unit_of(l2r_shim_timer_ctl_h(t, which)) }
#[ffi(import)]
fn l2r_shim_signal_new(signum : u32, repeating : bool) -> LHandle [{ leanrt::net::signal_new(signum as i32, repeating) }];
#[ffi(import)]
fn l2r_shim_signal_next(s : LHandle, p : LPromise, r : LPromise) -> LHandle [{ { let o = leanrt::net::signal_next(&s, p, r); leanrt::rc_release(s); o } }];
#[ffi(import)]
fn l2r_shim_signal_ctl(s : LHandle, which : u8) -> LHandle [{ { let o = leanrt::net::signal_ctl(&s, which); leanrt::rc_release(s); o } }];

