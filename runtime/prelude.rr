// ===========================================================================
// String
//
// Positions are `Nat` byte offsets. A `Nat::Big` position is never valid;
// the functions below reproduce what Lean's C code does with non-scalar
// positions (Lean's scalars stop at 2^63, which matters for `extract`).

#[ffi(import)]
fn lean_mk_string(s : str) -> LStr [{ leanrt::string::from_bytes((*s).as_bytes()) }];

#[ffi(import)]
fn lean_string_of_usize(n : u64) -> LStr [{ leanrt::string::of_u64(n) }];

#[ffi(import)]
fn lean_string_append(a : LStr, b : LStr) -> LStr [{ leanrt::string::append(a, b) }];

#[ffi(import)]
fn lean_string_push(s : LStr, c : u32) -> LStr [{ leanrt::string::push(s, c) }];

#[ffi(import)]
fn l2r_string_size(s : LStr) -> u64 [{ s.len() as u64 }];

#[ffi(import)]
fn l2r_string_length(s : LStr) -> u64 [{ leanrt::string::length(&s) }];

fn lean_string_utf8_byte_size(s : LStr) -> Nat { Nat::Small{l2r_string_size(s)} }
fn lean_string_length(s : LStr) -> Nat { Nat::Small{l2r_string_length(s)} }
fn lean_string_size(s : LStr) -> Nat { Nat::Small{l2r_string_size(s) + 1} }
fn lean_string_len(s : LStr) -> Nat { Nat::Small{l2r_string_length(s)} }

#[ffi(import)]
fn l2r_string_get(s : LStr, i : u64) -> u32 [{ leanrt::string::get(&s, i) }];
#[ffi(import)]
fn l2r_string_get_opt(s : LStr, i : u64) -> u32 [{ leanrt::string::get_opt(&s, i) }];
#[ffi(import)]
fn l2r_string_get_fast(s : LStr, i : u64) -> u32 [{ leanrt::string::get_fast(&s, i) }];
#[ffi(import)]
fn l2r_string_next(s : LStr, i : u64) -> u64 [{ leanrt::string::next(&s, i) }];
#[ffi(import)]
fn l2r_string_next_fast(s : LStr, i : u64) -> u64 [{ leanrt::string::next_fast(&s, i) }];
#[ffi(import)]
fn l2r_string_prev(s : LStr, i : u64) -> u64 [{ leanrt::string::prev(&s, i) }];
#[ffi(import)]
fn l2r_string_is_valid_pos(s : LStr, i : u64) -> bool [{ leanrt::string::is_valid_pos(&s, i) }];
#[ffi(import)]
fn l2r_string_extract(s : LStr, b : u64, e : u64) -> LStr [{ leanrt::string::extract(s, b, e) }];
#[ffi(import)]
fn l2r_string_set(s : LStr, i : u64, c : u32) -> LStr [{ leanrt::string::set(s, i, c) }];
#[ffi(import)]
fn l2r_string_get_byte(s : LStr, i : u64) -> u8 [{ s.get(i as usize).copied().unwrap_or(0) }];

// `String.Pos.Raw.get`: the character at byte `p`, or `'A'`.
fn lean_string_utf8_get(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get(s, i),
        Nat::Big(_) => 65
    }
}

// `String.Pos.Raw.get?`: 0x110000 encodes `none` (lean2rr's glue builds
// the `Option Char`).
fn l2r_string_utf8_get_opt(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get_opt(s, i),
        Nat::Big(_) => 1114112
    }
}

// `String.Pos.Raw.get!`: panics (C message) and returns `'A'`.
fn lean_string_utf8_get_bang(s : LStr, p : Nat) -> u32 {
    let c = l2r_string_utf8_get_opt(s, p);
    if c == 1114112 { let ignored = l2r_panic_code(1); 65 } else { c }
}

fn lean_string_utf8_get_fast(s : LStr, p : Nat) -> u32 {
    match p {
        Nat::Small(i) => l2r_string_get_fast(s, i),
        Nat::Big(_) => 65
    }
}

// `String.Pos.Raw.next`: `p + 1` at or past the end.
fn lean_string_utf8_next(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => {
            let r = l2r_string_next(s, i);
            if r == 0 { lean_nat_add(p, Nat::Small{1}) } else { Nat::Small{r} }
        },
        Nat::Big(_) => lean_nat_add(p, Nat::Small{1})
    }
}

fn lean_string_utf8_next_fast(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => Nat::Small{l2r_string_next_fast(s, i)},
        Nat::Big(_) => lean_nat_add(p, Nat::Small{1})
    }
}

fn lean_string_utf8_prev(s : LStr, p : Nat) -> Nat {
    match p {
        Nat::Small(i) => Nat::Small{l2r_string_prev(s, i)},
        Nat::Big(_) => lean_nat_sub(p, Nat::Small{1})
    }
}

fn lean_string_utf8_at_end(s : LStr, p : Nat) -> bool {
    match p {
        Nat::Small(i) => i >= l2r_string_size(s),
        Nat::Big(_) => true
    }
}

fn lean_string_is_valid_pos(s : LStr, p : Nat) -> bool {
    match p {
        Nat::Small(i) => l2r_string_is_valid_pos(s, i),
        Nat::Big(_) => false
    }
}

// Lean treats positions >= 2^63 as non-scalars, for which `extract`
// returns the whole string.
fn l2r_nat_is_lean_scalar(p : Nat) -> bool {
    match p {
        Nat::Small(i) => (i >> 63) == 0,
        Nat::Big(_) => false
    }
}

fn lean_string_utf8_extract(s : LStr, b : Nat, e : Nat) -> LStr {
    if l2r_nat_is_lean_scalar(b) && l2r_nat_is_lean_scalar(e) {
        l2r_string_extract(s, lean_usize_of_nat(b), lean_usize_of_nat(e))
    } else { s }
}

fn lean_string_utf8_set(s : LStr, p : Nat, c : u32) -> LStr {
    match p {
        Nat::Small(i) => l2r_string_set(s, i, c),
        Nat::Big(_) => s
    }
}

fn lean_string_get_byte_fast(s : LStr, i : Nat) -> u8 { l2r_string_get_byte(s, lean_usize_of_nat(i)) }
fn lean_string_uget_byte_fast(s : LStr, i : u64) -> u8 { l2r_string_get_byte(s, i) }

#[ffi(import)]
fn lean_string_dec_eq(a : LStr, b : LStr) -> bool [{ *a == *b }];
#[ffi(import)]
fn lean_string_dec_lt(a : LStr, b : LStr) -> bool [{ leanrt::string::dec_lt(&a, &b) }];
#[ffi(import)]
fn lean_string_lt(a : LStr, b : LStr) -> bool [{ leanrt::string::dec_lt(&a, &b) }];
fn lean_string_eq(a : LStr, b : LStr) -> bool { lean_string_dec_eq(a, b) }
fn lean_string_ne(a : LStr, b : LStr) -> bool { !lean_string_dec_eq(a, b) }
// `String.compare`: 0 = lt, 1 = eq, 2 = gt (lean2rr maps it to `Ordering`).
#[ffi(import)]
fn l2r_string_compare(a : LStr, b : LStr) -> u8 [{ leanrt::string::compare(&a, &b) }];
#[ffi(import)]
fn lean_string_hash(s : LStr) -> u64 [{ leanrt::string::hash(&s) }];

// `String.toUTF8` / `String.ofByteArray` / `String.fromUTF8`: a string and
// a byte array share their representation, so these do not copy.
#[ffi(import)]
fn lean_string_to_utf8(s : LStr) -> RVec<u8> [{ leanrt::array::bytes_of_string(s) }];
#[ffi(import)]
fn lean_string_from_utf8_unchecked(b : RVec<u8>) -> LStr [{ leanrt::array::string_of_bytes(b) }];
#[ffi(import)]
fn lean_string_validate_utf8(b : RVec<u8>) -> bool [{ leanrt::string::validate(leanrt::array::as_slice(&b)) }];
// `String.fromUTF8!`-style lossy decoding (`lean_decode_lossy_utf8`).
#[ffi(import)]
fn lean_decode_lossy_utf8(b : RVec<u8>) -> LStr [{ leanrt::string::from_bytes_lossy(leanrt::array::as_slice(&b)) }];

#[ffi(import)]
fn l2r_string_memcmp(a : LStr, b : LStr, ls : u64, rs : u64, len : u64) -> bool [{ leanrt::string::memcmp(&a, &b, ls, rs, len) }];

fn lean_string_memcmp(a : LStr, b : LStr, ls : Nat, rs : Nat, len : Nat) -> bool {
    l2r_string_memcmp(a, b, lean_usize_of_nat(ls), lean_usize_of_nat(rs), lean_usize_of_nat(len))
}

// Slices (`String.Slice` is a Lean structure; lean2rr's glue passes its
// string and byte bounds).
#[ffi(import)]
fn l2r_slice_hash(s : LStr, b : u64, e : u64) -> u64 [{
    leanrt::string::hash(s.get(b as usize..e as usize).unwrap_or(&[]))
}];
#[ffi(import)]
fn l2r_slice_dec_lt(s1 : LStr, b1 : u64, e1 : u64, s2 : LStr, b2 : u64, e2 : u64) -> bool [{
    s1.get(b1 as usize..e1 as usize).unwrap_or(&[]) < s2.get(b2 as usize..e2 as usize).unwrap_or(&[])
}];

// ---- Glue helpers for externs over Lean-defined types ----
//
// The prelude cannot name generated types (`List Char`, `Ordering`,
// `Option Char`, ...), so these helpers are generic in the result type and
// take its constructors as arguments: lean2rr's glue for such an extern is a
// call passing the constructor values (nullary constructors as values,
// others as curried closures).

// `String.compare a b` (`lean_string_compare`).
fn l2r_string_compare_with<O>(a : LStr, b : LStr, lt : O, eq : O, gt : O) -> O {
    let r = l2r_string_compare(a, b);
    if r == 0 { lt } else { if r == 1 { eq } else { gt } }
}

// `String.toList`/`String.data` (`lean_string_data`): the characters of a
// valid UTF-8 string, built from the end.
fn l2r_string_to_list<L>(s : LStr, nil : L, cons : u32 -> (L -> L)) -> L {
    l2r_string_to_list_go(s, l2r_string_size(s), nil, cons)
}

fn l2r_string_to_list_go<L>(s : LStr, i : u64, acc : L, cons : u32 -> (L -> L)) -> L {
    if i == 0 { acc } else {
        let j = l2r_string_prev(s, i);
        l2r_string_to_list_go(s, j, cons(l2r_string_get_fast(s, j))(acc), cons)
    }
}

// `String.Pos.Raw.get?` (`lean_string_utf8_get_opt`).
fn l2r_string_utf8_get_opt_with<O>(s : LStr, p : Nat, none : O, some : u32 -> O) -> O {
    let c = l2r_string_utf8_get_opt(s, p);
    if c == 1114112 { none } else { some(c) }
}

// `Array.toList` (`lean_array_to_list`), built from the end. `E` is the
// array's storage type; `cons` takes the stored element (lean2rr unboxes
// inside the closure when the array stores boxes).
fn l2r_array_to_list<E, L>(a : RVec<E>, nil : L, cons : E -> (L -> L)) -> L {
    l2r_array_to_list_go(a, l2r_array_size(a), nil, cons)
}

fn l2r_array_to_list_go<E, L>(a : RVec<E>, i : u64, acc : L, cons : E -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_array_to_list_go(a, i - 1, cons(l2r_array_get(a, i - 1))(acc), cons) }
}

// `Float.frExp` (`lean_float_frexp`): `mk` builds the `Float × Int`.
fn l2r_float_frexp_with<P>(x : f64, mk : f64 -> (Int -> P)) -> P {
    mk(l2r_float_frexp_mant(x))(l2r_float_frexp_exp(x))
}

fn l2r_float32_frexp_with<P>(x : f32, mk : f32 -> (Int -> P)) -> P {
    mk(l2r_float32_frexp_mant(x))(l2r_float32_frexp_exp(x))
}

fn lean_string_pos_sub(a : Nat, b : Nat) -> Nat { lean_nat_sub(a, b) }
fn lean_string_pos_min(a : Nat, b : Nat) -> Nat { if lean_nat_dec_le(a, b) { a } else { b } }

// ---- `String.Internal.*` (implemented by exported Lean definitions) ----

#[ffi(import)]
fn l2r_string_drop(s : LStr, n : u64) -> LStr [{ leanrt::string::drop(s, n) }];
#[ffi(import)]
fn l2r_string_drop_right(s : LStr, n : u64) -> LStr [{ leanrt::string::drop_right(s, n) }];
#[ffi(import)]
fn lean_string_isprefixof(p : LStr, s : LStr) -> bool [{ leanrt::string::is_prefix_of(&p, &s) }];
#[ffi(import)]
fn l2r_string_pos_of(s : LStr, c : u32) -> u64 [{ leanrt::string::pos_of(&s, c) }];
#[ffi(import)]
fn lean_string_contains(s : LStr, c : u32) -> bool [{ leanrt::string::contains(&s, c) }];
#[ffi(import)]
fn l2r_string_pushn(s : LStr, c : u32, n : u64) -> LStr [{ leanrt::string::pushn(s, c, n) }];
#[ffi(import)]
fn lean_string_trim(s : LStr) -> LStr [{ leanrt::string::trim(s) }];
#[ffi(import)]
fn lean_string_capitalize(s : LStr) -> LStr [{ leanrt::string::capitalize(s) }];
#[ffi(import)]
fn l2r_string_offset_of_pos(s : LStr, p : u64) -> u64 [{ leanrt::string::offset_of_pos(&s, p) }];

fn lean_string_drop(s : LStr, n : Nat) -> LStr { l2r_string_drop(s, l2r_nat_sat_u64(n)) }
fn lean_string_dropright(s : LStr, n : Nat) -> LStr { l2r_string_drop_right(s, l2r_nat_sat_u64(n)) }
fn lean_string_posof(s : LStr, c : u32) -> Nat { Nat::Small{l2r_string_pos_of(s, c)} }
fn lean_string_front(s : LStr) -> u32 { l2r_string_get(s, 0) }
fn lean_string_isempty(s : LStr) -> bool { l2r_string_size(s) == 0 }
fn lean_string_offsetofpos(s : LStr, p : Nat) -> Nat { Nat::Small{l2r_string_offset_of_pos(s, l2r_nat_sat_u64(p))} }

fn lean_string_pushn(s : LStr, c : u32, n : Nat) -> LStr {
    match n {
        Nat::Small(k) => l2r_string_pushn(s, c, k),
        Nat::Big(_) => l2r_internal_panic_at<LStr>(4)
    }
}

// A `Nat` as a `u64`, saturating (for counts and positions where every
// value beyond the string behaves alike).
fn l2r_nat_sat_u64(n : Nat) -> u64 {
    match n {
        Nat::Small(x) => x,
        Nat::Big(_) => 18446744073709551615
    }
}

fn lean_string_any(s : LStr, p : u32 -> bool) -> bool { l2r_string_any_from(s, p, 0, l2r_string_size(s)) }

fn l2r_string_any_from(s : LStr, p : u32 -> bool, i : u64, n : u64) -> bool {
    if i >= n { false } else {
        if p(l2r_string_get_fast(s, i)) { true } else { l2r_string_any_from(s, p, l2r_string_next_fast(s, i), n) }
    }
}

// `String.Internal.foldl (f : String → Char → String) (init : String) (s : String)`.
fn lean_string_foldl(f : LStr -> (u32 -> LStr), init : LStr, s : LStr) -> LStr {
    l2r_string_foldl_from(f, init, s, 0, l2r_string_size(s))
}

fn l2r_string_foldl_from(f : LStr -> (u32 -> LStr), acc : LStr, s : LStr, i : u64, n : u64) -> LStr {
    if i >= n { acc } else {
        let acc2 = f(acc)(l2r_string_get_fast(s, i));
        l2r_string_foldl_from(f, acc2, s, l2r_string_next_fast(s, i), n)
    }
}

// `String.Internal.nextWhile s p i`: advance while `p` holds and not at the end.
fn lean_string_nextwhile(s : LStr, p : u32 -> bool, i : Nat) -> Nat {
    match i {
        Nat::Small(k) => Nat::Small{l2r_string_next_while(s, p, k, l2r_string_size(s))},
        Nat::Big(_) => i
    }
}

fn l2r_string_next_while(s : LStr, p : u32 -> bool, i : u64, n : u64) -> u64 {
    if i >= n { i } else {
        if p(l2r_string_get(s, i)) { l2r_string_next_while(s, p, l2r_string_next(s, i), n) } else { i }
    }
}

// ===========================================================================
// Array
//
// `RVec<E>` where `E` is the element's storage type (lean2rr boxes element
// types that cannot cross the FFI boundary). Indices are `Nat`; `Nat::Big`
// indices are always out of bounds.

#[ffi(import)]
fn l2r_array_empty<T>() -> RVec<T> [{ leanrt::array::empty() }];
#[ffi(import)]
fn l2r_array_with_capacity<T>(n : u64) -> RVec<T> [{ leanrt::array::with_capacity(n.min(1 << 24) as usize) }];
#[ffi(import)]
fn l2r_array_size<T>(v : RVec<T>) -> u64 [{ leanrt::array::size(&v) }];
// Element `i`, which must be in bounds.
#[ffi(import)]
fn l2r_array_get<T>(v : RVec<T>, i : u64) -> T [{ leanrt::array::get(&v, i) }];
#[ffi(import)]
fn l2r_array_push<T>(v : RVec<T>, x : T) -> RVec<T> [{ leanrt::array::push(v, x) }];
#[ffi(import)]
fn l2r_array_set<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> [{ leanrt::array::set(v, i, x) }];
#[ffi(import)]
fn l2r_array_pop<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::pop(v) }];
#[ffi(import)]
fn l2r_array_swap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> [{ leanrt::array::swap(v, i, j) }];
#[ffi(import)]
fn l2r_array_replicate<T>(n : u64, x : T) -> RVec<T> [{ leanrt::array::replicate(n, x) }];
#[ffi(import)]
fn l2r_array_append<T>(a : RVec<T>, b : RVec<T>) -> RVec<T> [{ leanrt::array::append(a, b) }];
#[ffi(import)]
fn l2r_array_extract<T>(v : RVec<T>, b : u64, e : u64) -> RVec<T> [{ leanrt::array::extract(v, b, e) }];
#[ffi(import)]
fn l2r_array_truncate<T>(v : RVec<T>, n : u64) -> RVec<T> [{ leanrt::array::truncate(v, n) }];
#[ffi(import)]
fn l2r_array_reverse<T>(v : RVec<T>) -> RVec<T> [{ leanrt::array::reverse(v) }];

fn lean_mk_empty_array<T>() -> RVec<T> { l2r_array_empty<T>() }

fn lean_mk_empty_array_with_capacity<T>(n : Nat) -> RVec<T> {
    match n {
        Nat::Small(k) => l2r_array_with_capacity<T>(k),
        Nat::Big(_) => l2r_internal_panic_at<RVec<T>>(4)
    }
}

fn lean_array_get_size<T>(v : RVec<T>) -> Nat { Nat::Small{l2r_array_size(v)} }
fn lean_array_size<T>(v : RVec<T>) -> u64 { l2r_array_size(v) }

fn lean_array_fget<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get(v, lean_usize_of_nat(i)) }
fn lean_array_fget_borrowed<T>(v : RVec<T>, i : Nat) -> T { l2r_array_get(v, lean_usize_of_nat(i)) }
fn lean_array_uget<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }
fn lean_array_uget_borrowed<T>(v : RVec<T>, i : u64) -> T { l2r_array_get(v, i) }

// Whether `i` is a valid index of an array of size `n`.
fn l2r_index_ok(i : Nat, n : u64) -> bool {
    match i {
        Nat::Small(k) => k < n,
        Nat::Big(_) => false
    }
}

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default.
fn lean_array_get<T>(dflt : T, v : RVec<T>, i : Nat) -> T {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_get(v, lean_usize_of_nat(i)) } else {
        let ignored = l2r_panic_code(0);
        dflt
    }
}

fn lean_array_get_borrowed<T>(dflt : T, v : RVec<T>, i : Nat) -> T { lean_array_get(dflt, v, i) }

fn lean_array_fset<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> { l2r_array_set(v, lean_usize_of_nat(i), x) }
fn lean_array_uset<T>(v : RVec<T>, i : u64, x : T) -> RVec<T> { l2r_array_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_array_set<T>(v : RVec<T>, i : Nat, x : T) -> RVec<T> {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_set(v, lean_usize_of_nat(i), x) } else {
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_array_push<T>(v : RVec<T>, x : T) -> RVec<T> { l2r_array_push(v, x) }
fn lean_array_pop<T>(v : RVec<T>) -> RVec<T> { l2r_array_pop(v) }

fn lean_array_fswap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    l2r_array_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j))
}

fn lean_array_uswap<T>(v : RVec<T>, i : u64, j : u64) -> RVec<T> { l2r_array_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_array_swap<T>(v : RVec<T>, i : Nat, j : Nat) -> RVec<T> {
    let n = l2r_array_size(v);
    if l2r_index_ok(i, n) && l2r_index_ok(j, n) { l2r_array_swap(v, lean_usize_of_nat(i), lean_usize_of_nat(j)) } else { v }
}

// `Array.replicate n x`.
fn lean_mk_array<T>(n : Nat, x : T) -> RVec<T> {
    match n {
        Nat::Small(k) => l2r_array_replicate(k, x),
        Nat::Big(_) => l2r_internal_panic_at<RVec<T>>(4)
    }
}

// ---- ByteArray (RVec<u8>) ----

fn lean_mk_empty_byte_array(n : Nat) -> RVec<u8> { lean_mk_empty_array_with_capacity<u8>(n) }
fn lean_byte_array_size(v : RVec<u8>) -> Nat { Nat::Small{l2r_array_size(v)} }
fn lean_sarray_size<T>(v : RVec<T>) -> u64 { l2r_array_size(v) }
fn lean_byte_array_uget(v : RVec<u8>, i : u64) -> u8 { l2r_array_get(v, i) }
fn lean_byte_array_fget(v : RVec<u8>, i : Nat) -> u8 { l2r_array_get(v, lean_usize_of_nat(i)) }
// `ByteArray.get!`: 0 out of bounds (no panic, as lean.h).
fn lean_byte_array_get(v : RVec<u8>, i : Nat) -> u8 {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_get(v, lean_usize_of_nat(i)) } else { 0 }
}
fn lean_byte_array_push(v : RVec<u8>, x : u8) -> RVec<u8> { l2r_array_push(v, x) }
fn lean_byte_array_uset(v : RVec<u8>, i : u64, x : u8) -> RVec<u8> { l2r_array_set(v, i, x) }
fn lean_byte_array_fset(v : RVec<u8>, i : Nat, x : u8) -> RVec<u8> { l2r_array_set(v, lean_usize_of_nat(i), x) }
// `ByteArray.set!`: unchanged out of bounds.
fn lean_byte_array_set(v : RVec<u8>, i : Nat, x : u8) -> RVec<u8> {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_set(v, lean_usize_of_nat(i), x) } else { v }
}
#[ffi(import)]
fn lean_byte_array_hash(v : RVec<u8>) -> u64 [{ leanrt::hash::murmur64a(leanrt::array::as_slice(&v), 11) }];
#[ffi(import)]
fn lean_sarray_dec_eq(a : RVec<u8>, b : RVec<u8>) -> bool [{ leanrt::array::as_slice(&a) == leanrt::array::as_slice(&b) }];
#[ffi(import)]
fn l2r_byte_array_copy_slice(src : RVec<u8>, so : u64, dest : RVec<u8>, d : u64, len : u64, exact : bool) -> RVec<u8> [{
    leanrt::array::copy_slice(src, so, dest, d, len, exact)
}];
fn lean_byte_array_copy_slice(src : RVec<u8>, so : Nat, dest : RVec<u8>, d : Nat, len : Nat, exact : bool) -> RVec<u8> {
    l2r_byte_array_copy_slice(src, l2r_nat_sat_u64(so), dest, l2r_nat_sat_u64(d), l2r_nat_sat_u64(len), exact)
}
// `ByteArray.mk`/`ByteArray.data` convert from/to `Array UInt8` (`RVec<u8>`
// too: `UInt8` crosses the boundary unboxed), so they are the identity.
fn lean_byte_array_mk(a : RVec<u8>) -> RVec<u8> { a }
fn lean_byte_array_data(a : RVec<u8>) -> RVec<u8> { a }

// ---- FloatArray (RVec<f64>) ----

fn lean_mk_empty_float_array(n : Nat) -> RVec<f64> { lean_mk_empty_array_with_capacity<f64>(n) }
fn lean_float_array_size(v : RVec<f64>) -> Nat { Nat::Small{l2r_array_size(v)} }
fn lean_float_array_uget(v : RVec<f64>, i : u64) -> f64 { l2r_array_get(v, i) }
fn lean_float_array_fget(v : RVec<f64>, i : Nat) -> f64 { l2r_array_get(v, lean_usize_of_nat(i)) }
// `FloatArray.get!`: 0.0 out of bounds.
fn lean_float_array_get(v : RVec<f64>, i : Nat) -> f64 {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_get(v, lean_usize_of_nat(i)) } else { 0.0 }
}
fn lean_float_array_push(v : RVec<f64>, x : f64) -> RVec<f64> { l2r_array_push(v, x) }
fn lean_float_array_uset(v : RVec<f64>, i : u64, x : f64) -> RVec<f64> { l2r_array_set(v, i, x) }
fn lean_float_array_fset(v : RVec<f64>, i : Nat, x : f64) -> RVec<f64> { l2r_array_set(v, lean_usize_of_nat(i), x) }
fn lean_float_array_set(v : RVec<f64>, i : Nat, x : f64) -> RVec<f64> {
    if l2r_index_ok(i, l2r_array_size(v)) { l2r_array_set(v, lean_usize_of_nat(i), x) } else { v }
}
fn lean_float_array_mk(a : RVec<f64>) -> RVec<f64> { a }
fn lean_float_array_data(a : RVec<f64>) -> RVec<f64> { a }

// ===========================================================================
// Standard streams
//
// lean2rr builds each `IO.FS.Stream` field as a closure over these
// primitives (fd 0 = stdin, 1 = stdout, 2 = stderr). stdout is buffered
// like C stdio and flushed at exit.

#[ffi(import)]
fn l2r_stream_putStr(fd : u64, s : LStr) -> u64 [{ { leanrt::io::write_std(fd, &s); 0 } }];

#[ffi(import)]
fn l2r_stream_write(fd : u64, b : RVec<u8>) -> u64 [{ { leanrt::io::write_std(fd, leanrt::array::as_slice(&b)); 0 } }];

#[ffi(import)]
fn l2r_stream_flush(fd : u64) -> u64 [{ { leanrt::io::flush_std(fd); 0 } }];

#[ffi(import)]
fn l2r_stream_read(fd : u64, n : u64) -> RVec<u8> [{
    {
        let bytes = if fd == 0 { leanrt::io::read_stdin(n as usize) } else { std::vec::Vec::new() };
        leanrt::array::bytes_of_string(Rc::new(bytes))
    }
}];

#[ffi(import)]
fn l2r_stream_getLine(fd : u64) -> LStr [{
    {
        let bytes = if fd == 0 { leanrt::io::read_line_stdin() } else { std::vec::Vec::new() };
        leanrt::string::from_bytes_lossy(&bytes)
    }
}];

#[ffi(import)]
fn l2r_stream_isTty(fd : u64) -> bool [{ leanrt::io::is_tty(fd) }];

// `IO.eprint`/`IO.eprintln` helpers (also used for `dbgTrace`).
fn l2r_eprintln(s : LStr) -> u64 { l2r_stream_putStr(2, lean_string_push(s, 10)) }

// ===========================================================================
// ST.Ref / IO.Ref
//
// A reference is a shared cell (`LRef<T>`); all aliases see updates. The
// `lean_st_*` externs return BaseIO results, so lean2rr wraps these
// primitives.

#[ffi(import)]
fn l2r_ref_new<T>(v : T) -> LRef<T> [{ leanrt::array::from_rc(Rc::new(vec![v])) }];

#[ffi(import)]
fn l2r_ref_get<T>(r : LRef<T>) -> T [{
    {
        let c = leanrt::array::into_rc(r);
        let v = c.first().cloned().expect("leanrt: read of an empty ST.Ref (after take)");
        v
    }
}];

#[ffi(import)]
fn l2r_ref_set<T>(r : LRef<T>, v : T) -> u64 [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        cell.clear();
        cell.push(v);
        0
    }
}];

#[ffi(import)]
fn l2r_ref_swap<T>(r : LRef<T>, v : T) -> T [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        let old = cell.pop().expect("leanrt: swap of an empty ST.Ref (after take)");
        cell.push(v);
        old
    }
}];

// `ST.Prim.Ref.take`: move the value out, leaving the cell empty until the
// next `set` (so the value stays uniquely referenced, as in Lean).
#[ffi(import)]
fn l2r_ref_take<T>(r : LRef<T>) -> T [{
    {
        let mut c = leanrt::array::into_rc(r);
        let cell = unsafe { c.data_mut() };
        cell.pop().expect("leanrt: take of an empty ST.Ref")
    }
}];

#[ffi(import)]
fn l2r_ref_ptr_eq<T>(a : LRef<T>, b : LRef<T>) -> bool [{
    {
        let (x, y) = (leanrt::array::into_rc(a), leanrt::array::into_rc(b));
        std::ptr::eq(&*x as *const std::vec::Vec<[:T:]>, &*y as *const std::vec::Vec<[:T:]>)
    }
}];

// ===========================================================================
// Once-cells (constants and closed terms)
//
// A slot stores one reference forever. `T` is a pointer-sized (or smaller)
// boundary type; lean2rr boxes other values in a one-field shared struct.

#[ffi(import)]
fn l2r_once_has(slot : u64) -> bool [{ leanrt::once::has(slot) }];

#[ffi(import)]
fn l2r_once_get<T>(slot : u64) -> T [{
    {
        let raw = leanrt::once::get_raw(slot);
        let p: ::std::mem::ManuallyDrop<[:T:]> = unsafe { ::std::mem::transmute_copy(&raw) };
        (*p).clone()
    }
}];

#[ffi(import)]
fn l2r_once_set<T>(slot : u64, v : T) -> T [{
    {
        assert!(::std::mem::size_of::<[:T:]>() <= ::std::mem::size_of::<usize>());
        let keep = ::std::mem::ManuallyDrop::new(v.clone());
        let mut raw: usize = 0;
        unsafe {
            ::std::ptr::copy_nonoverlapping(&*keep as *const [:T:] as *const u8, &mut raw as *mut usize as *mut u8, ::std::mem::size_of::<[:T:]>())
        };
        leanrt::once::set_raw(slot, raw);
        v
    }
}];

// ===========================================================================
// Thunks, tasks, debugging, platform

// `dbgTrace msg f`: print `msg` to stderr, then `f ()`.
fn lean_dbg_trace<T>(msg : LStr, f : L2RUnit -> T) -> T {
    let ignored = l2r_eprintln(msg);
    f(L2RUnit::u{})
}

// `dbgTraceIfShared`: this runtime does not track sharing observably; the
// value is returned unchanged.
fn lean_dbg_trace_if_shared<T>(msg : LStr, a : T) -> T { a }

fn lean_dbg_stack_trace<T>(f : L2RUnit -> T) -> T { f(L2RUnit::u{}) }

#[ffi(import)]
fn l2r_sleep_ms(ms : u32) -> u64 [{ { std::thread::sleep(std::time::Duration::from_millis(ms as u64)); 0 } }];

fn lean_dbg_sleep<T>(ms : u32, f : L2RUnit -> T) -> T {
    let ignored = l2r_sleep_ms(ms);
    f(L2RUnit::u{})
}

fn lean_system_platform_windows(u : L2RUnit) -> bool { false }
fn lean_system_platform_osx(u : L2RUnit) -> bool { false }
fn lean_system_platform_emscripten(u : L2RUnit) -> bool { false }
fn lean_internal_is_stage0(u : L2RUnit) -> bool { false }
fn lean_internal_has_llvm_backend(u : L2RUnit) -> bool { false }
fn lean_version_get_major(u : L2RUnit) -> Nat { Nat::Small{4} }
fn lean_version_get_minor(u : L2RUnit) -> Nat { Nat::Small{33} }
fn lean_version_get_patch(u : L2RUnit) -> Nat { Nat::Small{0} }
fn lean_version_get_is_release(u : L2RUnit) -> bool { true }
fn lean_version_get_special_desc(u : L2RUnit) -> LStr { lean_mk_string("") }
fn lean_system_platform_target(u : L2RUnit) -> LStr { lean_mk_string("aarch64-unknown-linux-gnu") }

#[ffi(import)]
fn l2r_hardware_concurrency() -> u32 [{ std::thread::available_parallelism().map(|n| n.get() as u32).unwrap_or(1) }];
fn lean_internal_get_hardware_concurrency(u : L2RUnit) -> u32 { l2r_hardware_concurrency() }

// ===========================================================================
// IO primitives
//
// Convention: an IO/BaseIO extern `lean_io_xxx` whose result cannot fail
// has a payload primitive `l2r_io_xxx` taking the same passed arguments and
// returning the payload; lean2rr wraps it in `EST.Out.ok`/`ST.Out`
// (`wrapIOResult`).

fn l2r_io_mono_ms_now() -> Nat { Nat::Small{l2r_io_mono_ms_now_u64()} }
fn l2r_io_mono_nanos_now() -> Nat { Nat::Small{l2r_io_mono_nanos_now_u64()} }
fn l2r_io_get_num_heartbeats() -> Nat { Nat::Small{0} }
fn l2r_io_check_canceled() -> bool { false }
fn l2r_io_get_tid() -> u64 { l2r_io_get_tid_u64() }

#[ffi(import)]
fn l2r_io_get_tid_u64() -> u64 [{ { extern "C" { fn gettid() -> i32; } unsafe { gettid() as u64 } } }];

#[ffi(import)]
fn l2r_io_mono_ms_now_u64() -> u64 [{
    {
        let mut ts = [0i64; 2];
        extern "C" { fn clock_gettime(clk: i32, ts: *mut i64) -> i32; }
        unsafe { clock_gettime(1, ts.as_mut_ptr()) };
        (ts[0] as u64) * 1000 + (ts[1] as u64) / 1000000
    }
}];

#[ffi(import)]
fn l2r_io_mono_nanos_now_u64() -> u64 [{
    {
        let mut ts = [0i64; 2];
        extern "C" { fn clock_gettime(clk: i32, ts: *mut i64) -> i32; }
        unsafe { clock_gettime(1, ts.as_mut_ptr()) };
        (ts[0] as u64) * 1000000000 + (ts[1] as u64)
    }
}];


#[ffi(import)]
fn l2r_io_get_random_bytes(n : u64) -> RVec<u8> [{
    {
        use std::io::Read;
        let mut buf = vec![0u8; n as usize];
        if let Ok(mut f) = std::fs::File::open("/dev/urandom") { let _r = f.read_exact(&mut buf); }
        leanrt::array::bytes_of_string(Rc::new(buf))
    }
}];

#[ffi(import)]
fn l2r_io_process_get_pid() -> u32 [{ std::process::id() }];

// `IO.getEnv name : BaseIO (Option String)`.
#[ffi(import)]
fn l2r_getenv_has(name : LStr) -> bool [{
    std::env::var_os(std::ffi::OsStr::new(std::str::from_utf8(&name).unwrap_or("\0"))).is_some()
}];
#[ffi(import)]
fn l2r_getenv_value(name : LStr) -> LStr [{
    {
        let v = std::env::var_os(std::ffi::OsStr::new(std::str::from_utf8(&name).unwrap_or("\0"))).unwrap_or_default();
        leanrt::string::from_bytes_lossy(std::os::unix::ffi::OsStrExt::as_bytes(v.as_os_str()))
    }
}];
fn l2r_io_getenv_with<O>(name : LStr, none : O, some : LStr -> O) -> O {
    if l2r_getenv_has(name) { some(l2r_getenv_value(name)) } else { none }
}

// `IO.appPath`, `IO.currentDir` (these cannot fail in practice here).
#[ffi(import)]
fn l2r_io_app_path() -> LStr [{
    {
        let p = std::env::current_exe().unwrap_or_default();
        leanrt::string::from_bytes_lossy(std::os::unix::ffi::OsStrExt::as_bytes(p.as_os_str()))
    }
}];
#[ffi(import)]
fn l2r_io_current_dir() -> LStr [{
    {
        let p = std::env::current_dir().unwrap_or_default();
        leanrt::string::from_bytes_lossy(std::os::unix::ffi::OsStrExt::as_bytes(p.as_os_str()))
    }
}];
