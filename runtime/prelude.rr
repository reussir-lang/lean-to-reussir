fn lean_system_platform_nbits(u : L2RUnit) -> Nat { l2r_nat_small(64) }

// The value modulo 2^64 (`UInt64.ofNat`, `USize.ofNat`, ...).
fn l2r_nat_low(a : Nat) -> u64 {
    let x = l2r_nat_raw(a);
    if (x & 1) == 1 { x >> 1 } else { l2r_nat_low_raw(x) }
}

// Whether word `w` (of a `Nat`) is an index below `n` (a big word never is).
fn l2r_word_index_ok(w : u64, n : u64) -> bool { (w & 1) == 1 && (w >> 1) < n }

