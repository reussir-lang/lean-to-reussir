#[ffi(import)]
fn l2r_natarr_word(a : LNatArr, i : u64) -> u64 [{ { let r = leanrt::tagvec::word(&a, i); leanrt::rc_release(a); r } }];
// The word at `i`; a big word owns a reference.
#[ffi(import)]
fn l2r_natarr_word_owned(a : LNatArr, i : u64) -> u64 [{ { let r = leanrt::tagvec::word_owned(&a, i); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_natarr_set_word(a : LNatArr, i : u64, w : u64) -> LNatArr [{ leanrt::tagvec::set_word(a, i, w) }];
#[ffi(import)]
fn l2r_natarr_push_word(a : LNatArr, w : u64) -> LNatArr [{ leanrt::tagvec::push_word(a, w) }];
#[ffi(import)]
fn l2r_natarr_pop(a : LNatArr) -> LNatArr [{ leanrt::tagvec::pop(a) }];
#[ffi(import)]
fn l2r_natarr_swap(a : LNatArr, i : u64, j : u64) -> LNatArr [{ leanrt::tagvec::swap(a, i, j) }];
#[ffi(import)]
fn l2r_natarr_append(a : LNatArr, b : LNatArr) -> LNatArr [{ leanrt::tagvec::append(a, b) }];
#[ffi(import)]
fn l2r_natarr_extract(a : LNatArr, s : u64, e : u64) -> LNatArr [{ leanrt::tagvec::extract(a, s, e) }];
#[ffi(import)]
fn l2r_natarr_truncate(a : LNatArr, n : u64) -> LNatArr [{ leanrt::tagvec::truncate(a, n) }];
#[ffi(import)]
fn l2r_natarr_reverse(a : LNatArr) -> LNatArr [{ leanrt::tagvec::reverse(a) }];


// Elements are `Nat` words (see the Nat section): `lean_box` of a small
// value, an owned reference to a big number otherwise; the handles move in
// and out as their words. The array is consumed once (a second use in one
// branch would make Reussir release it out of line in the other): a big
// word comes back owning a reference.
fn l2r_natarr_get(a : LNatArr, i : u64) -> Nat { l2r_nat_of_raw(l2r_natarr_word_owned(a, i)) }
fn l2r_natarr_set(a : LNatArr, i : u64, x : Nat) -> LNatArr { l2r_natarr_set_word(a, i, l2r_nat_raw(x)) }
fn l2r_natarr_push(a : LNatArr, x : Nat) -> LNatArr { l2r_natarr_push_word(a, l2r_nat_raw(x)) }
fn l2r_natarr_replicate(n : u64, x : Nat) -> LNatArr { l2r_natarr_replicate_word(n, l2r_nat_raw(x)) }


fn lean_mk_empty_natarr() -> LNatArr { l2r_natarr_empty() }

fn lean_mk_empty_natarr_with_capacity(n : Nat) -> LNatArr {
    let w = l2r_nat_raw(n);
    if (w & 1) == 1 { l2r_natarr_with_capacity(w >> 1) } else { l2r_internal_panic_at<LNatArr>(4) }
}

fn lean_natarr_get_size(v : LNatArr) -> Nat { l2r_nat_small(l2r_natarr_size(v)) }
fn lean_natarr_size(v : LNatArr) -> u64 { l2r_natarr_size(v) }
fn lean_natarr_fget(v : LNatArr, i : Nat) -> Nat { l2r_natarr_get(v, l2r_index_of_nat(i)) }
fn lean_natarr_fget_borrowed(v : LNatArr, i : Nat) -> Nat { l2r_natarr_get(v, l2r_index_of_nat(i)) }
fn lean_natarr_uget(v : LNatArr, i : u64) -> Nat { l2r_natarr_get(v, i) }
fn lean_natarr_uget_borrowed(v : LNatArr, i : u64) -> Nat { l2r_natarr_get(v, i) }

// `Array.get!Internal`: out of bounds, panic ("index out of bounds") and
// return the default.
fn lean_natarr_get(dflt : Nat, v : LNatArr, i : Nat) -> Nat {
    let w = l2r_nat_raw(i);
    if l2r_word_index_ok(w, l2r_natarr_size(v)) { l2r_natarr_get(v, w >> 1) } else {
        let d = l2r_nat_drop_raw(w);
        let ignored = l2r_panic_code(0);
        dflt
    }
}

fn lean_natarr_get_borrowed(dflt : Nat, v : LNatArr, i : Nat) -> Nat { lean_natarr_get(dflt, v, i) }
fn lean_natarr_fset(v : LNatArr, i : Nat, x : Nat) -> LNatArr { l2r_natarr_set(v, l2r_index_of_nat(i), x) }
fn lean_natarr_uset(v : LNatArr, i : u64, x : Nat) -> LNatArr { l2r_natarr_set(v, i, x) }

// `Array.set!`: out of bounds, panic and return the array unchanged.
fn lean_natarr_set(v : LNatArr, i : Nat, x : Nat) -> LNatArr {
    let w = l2r_nat_raw(i);
    if l2r_word_index_ok(w, l2r_natarr_size(v)) { l2r_natarr_set(v, w >> 1, x) } else {
        let d = l2r_nat_drop_raw(w);
        let ignored = l2r_panic_code(0);
        v
    }
}

fn lean_natarr_push(v : LNatArr, x : Nat) -> LNatArr { l2r_natarr_push(v, x) }
fn lean_natarr_pop(v : LNatArr) -> LNatArr { l2r_natarr_pop(v) }
fn lean_natarr_fswap(v : LNatArr, i : Nat, j : Nat) -> LNatArr { l2r_natarr_swap(v, l2r_index_of_nat(i), l2r_index_of_nat(j)) }
fn lean_natarr_uswap(v : LNatArr, i : u64, j : u64) -> LNatArr { l2r_natarr_swap(v, i, j) }

// `Array.swapIfInBounds`.
fn lean_natarr_swap(v : LNatArr, i : Nat, j : Nat) -> LNatArr {
    let n = l2r_natarr_size(v);
    let x = l2r_nat_raw(i);
    let y = l2r_nat_raw(j);
    if l2r_word_index_ok(x, n) && l2r_word_index_ok(y, n) { l2r_natarr_swap(v, x >> 1, y >> 1) } else {
        let d = l2r_nat_drop_raw(x) + l2r_nat_drop_raw(y);
        v
    }
}

// `Array.replicate n x` (big sizes as `lean_mk_array`).
fn lean_mk_natarr(n : Nat, x : Nat) -> LNatArr { l2r_natarr_replicate(l2r_nat_to_size_t(n), x) }

// `Array.toList` glue (see `l2r_array_to_list`).
fn l2r_natarr_to_list<L>(a : LNatArr, nil : L, cons : Nat -> (L -> L)) -> L {
    l2r_natarr_to_list_go(a, l2r_natarr_size(a), nil, cons)
}

fn l2r_natarr_to_list_go<L>(a : LNatArr, i : u64, acc : L, cons : Nat -> (L -> L)) -> L {
    if i == 0 { acc } else { l2r_natarr_to_list_go(a, i - 1, cons(l2r_natarr_get(a, i - 1))(acc), cons) }
}


// ---- Array Int (LIntArr) ----

#[ffi(import)]
fn l2r_intarr_empty() -> LIntArr [{ leanrt::tagvec::empty() }];
#[ffi(import)]
fn l2r_intarr_with_capacity(n : u64) -> LIntArr [{ leanrt::tagvec::with_capacity(n) }];
#[ffi(import)]
fn l2r_intarr_replicate_word(n : u64, w : u64) -> LIntArr [{ leanrt::tagvec::replicate_word(n, w) }];
#[ffi(import)]
fn l2r_intarr_size(a : LIntArr) -> u64 [{ { let r = leanrt::tagvec::size(&a); leanrt::rc_release(a); r } }];
#[ffi(import)]
fn l2r_intarr_word(a : LIntArr, i : u64) -> u64 [{ { let r = leanrt::tagvec::word(&a, i); leanrt::rc_release(a); r } }];
