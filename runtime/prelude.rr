fn lean_mk_empty_intarr_with_capacity(n : Nat) -> LIntArr {
    let w = l2r_nat_raw(n);
    if (w & 1) == 1 { l2r_intarr_with_capacity(w >> 1) } else { l2r_internal_panic_at<LIntArr>(4) }
}

// Element `i`, which must be in bounds (checked; see `l2r_array_get`).
fn l2r_intarr_get(a : LIntArr, i : u64) -> Int {
    let p = l2r_intarr_give(a);
    let n = l2r_intarr_view_size(p);
    if i < n { l2r_intarr_take(p, i) } else { l2r_array_index_bug<Int>(i, n) }
}

// A read at the word `x` of a `Nat` index a proof keeps in bounds (see
// `l2r_array_get_word`).
fn l2r_intarr_get_word(a : LIntArr, x : u64) -> Int {
    let p = l2r_intarr_give(a);
    let n = l2r_intarr_view_size(p);
    if l2r_word_index_ok(x, n) { l2r_intarr_take(p, x >> 1) } else { l2r_index_fail<Int>(x, n) }
}

fn lean_intarr_get_size(v : LIntArr) -> Nat { l2r_nat_small(l2r_intarr_size(v)) }
