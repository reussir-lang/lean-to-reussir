fn lean_isize_dec_lt(a : u64, b : u64) -> bool { (a as i64) < (b as i64) }
fn lean_isize_dec_le(a : u64, b : u64) -> bool { (a as i64) <= (b as i64) }
fn lean_isize_to_int8(a : u64) -> u8 { a as u8 }
fn lean_isize_to_int16(a : u64) -> u16 { a as u16 }
fn lean_isize_to_int32(a : u64) -> u32 { a as u32 }
fn lean_isize_to_int64(a : u64) -> u64 { ((a as i64) as i64) as u64 }
fn lean_isize_to_float(a : u64) -> f64 { (a as i64) as f64 }
fn lean_isize_to_float32(a : u64) -> f32 { (a as i64) as f32 }
fn lean_bool_to_isize(b : bool) -> u64 { if b { 1 } else { 0 } }
fn lean_float_to_isize(a : f64) -> u64 {
    let d : f64 = a;
    let lo : f64 = (0.0 - 9223372036854775809.0);
    let hi : f64 = 9223372036854775808.0;
    if d != d { 0 } else { if lo < d { if d < hi { (d as i64) as u64 } else { 9223372036854775807 } } else { 9223372036854775808 } }
}
fn lean_float32_to_isize(a : f32) -> u64 {
    let d : f64 = (a as f64);
    let lo : f64 = (0.0 - 9223372036854775809.0);
    let hi : f64 = 9223372036854775808.0;
    if d != d { 0 } else { if lo < d { if d < hi { (d as i64) as u64 } else { 9223372036854775807 } } else { 9223372036854775808 } }
}

// END GENERATED: scalars

fn lean_uint64_mix_hash(a : u64, b : u64) -> u64 { l2r_mix_hash(a, b) }

#[ffi(import)]
fn l2r_mix_hash(a : u64, b : u64) -> u64 [{ leanrt::hash::mix(a, b) }];

fn lean_strict_and(a : bool, b : bool) -> bool { a && b }
fn lean_strict_or(a : bool, b : bool) -> bool { a || b }

// ===========================================================================
// Float (f64) and Float32 (f32)
//
// Arithmetic and comparisons are IEEE operations (ordered comparisons, as
// C); math functions are LLVM intrinsics (libm), `log` goes through libm.

fn lean_float_add(a : f64, b : f64) -> f64 { a + b }
fn lean_float_sub(a : f64, b : f64) -> f64 { a - b }
fn lean_float_mul(a : f64, b : f64) -> f64 { a * b }
fn lean_float_div(a : f64, b : f64) -> f64 { a / b }
fn lean_float_negate(a : f64) -> f64 { -a }
fn lean_float_beq(a : f64, b : f64) -> bool { a == b }
fn lean_float_decLe(a : f64, b : f64) -> bool { a <= b }
fn lean_float_decLt(a : f64, b : f64) -> bool { a < b }
fn lean_float_isnan(a : f64) -> bool { a != a }
fn lean_float_isfinite(a : f64) -> bool { let inf : f64 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) < inf }
fn lean_float_isinf(a : f64) -> bool { let inf : f64 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) == inf }
fn lean_float_to_float32(a : f64) -> f32 { a as f32 }
fn lean_float32_to_float(a : f32) -> f64 { a as f64 }

fn lean_float32_add(a : f32, b : f32) -> f32 { a + b }
fn lean_float32_sub(a : f32, b : f32) -> f32 { a - b }
fn lean_float32_mul(a : f32, b : f32) -> f32 { a * b }
fn lean_float32_div(a : f32, b : f32) -> f32 { a / b }
fn lean_float32_negate(a : f32) -> f32 { -a }
fn lean_float32_beq(a : f32, b : f32) -> bool { a == b }
fn lean_float32_decLe(a : f32, b : f32) -> bool { a <= b }
fn lean_float32_decLt(a : f32, b : f32) -> bool { a < b }
fn lean_float32_isnan(a : f32) -> bool { a != a }
fn lean_float32_isfinite(a : f32) -> bool { let inf : f32 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) < inf }
fn lean_float32_isinf(a : f32) -> bool { let inf : f32 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) == inf }

#[ffi(import)]
fn lean_float_to_string(a : f64) -> LStr [{ leanrt::float::to_string(a) }];
#[ffi(import)]
fn lean_float32_to_string(a : f32) -> LStr [{ leanrt::float::to_string32(a) }];
#[ffi(import)]
fn lean_float_of_bits(u : u64) -> f64 [{ leanrt::float::of_bits(u) }];
#[ffi(import)]
fn lean_float_to_bits(a : f64) -> u64 [{ leanrt::float::to_bits(a) }];
#[ffi(import)]
fn lean_float32_of_bits(u : u32) -> f32 [{ leanrt::float::of_bits32(u) }];
#[ffi(import)]
fn lean_float32_to_bits(a : f32) -> u32 [{ leanrt::float::to_bits32(a) }];
#[ffi(import)]
fn l2r_float_scalbn(a : f64, n : i32) -> f64 [{ leanrt::float::scalb(a, n) }];
#[ffi(import)]
fn l2r_float32_scalbn(a : f32, n : i32) -> f32 [{ leanrt::float::scalb32(a, n) }];
// `Float.frExp` returns a `Float × Int`: lean2rr's glue pairs these.
#[ffi(import)]
fn l2r_float_frexp_mant(a : f64) -> f64 [{ leanrt::float::frexp_mant(a) }];
#[ffi(import)]
fn l2r_float_frexp_exp_i64(a : f64) -> i64 [{ leanrt::float::frexp_exp(a) }];
#[ffi(import)]
fn l2r_float32_frexp_mant(a : f32) -> f32 [{ leanrt::float::frexp_mant32(a) }];
#[ffi(import)]
fn l2r_float32_frexp_exp_i64(a : f32) -> i64 [{ leanrt::float::frexp_exp32(a) }];
fn l2r_float_frexp_exp(a : f64) -> Int { Int::Small{l2r_float_frexp_exp_i64(a)} }
fn l2r_float32_frexp_exp(a : f32) -> Int { Int::Small{l2r_float32_frexp_exp_i64(a)} }

// `Float.scaleB x i`: Lean's small Ints are 32-bit, so `i` outside the i32
// range takes the big-number branch of `lean_float_scaleb`: 0 when `x == 0`
// or `i < 0`, else `x * inf`.
fn lean_float_scaleb(a : f64, b : Int) -> f64 {
    match b {
        Int::Small(n) => if n >= 0 - 2147483648 && n <= 2147483647 { l2r_float_scalbn(a, n as i32) } else { l2r_float_scaleb_big(a, n < 0) },
        Int::Big(bb) => l2r_float_scaleb_big(a, l2r_big_is_neg(bb))
    }
}

fn l2r_float_scaleb_big(a : f64, neg : bool) -> f64 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { a * inf }
}

fn lean_float32_scaleb(a : f32, b : Int) -> f32 {
    match b {
        Int::Small(n) => if n >= 0 - 2147483648 && n <= 2147483647 { l2r_float32_scalbn(a, n as i32) } else { l2r_float32_scaleb_big(a, n < 0) },
        Int::Big(bb) => l2r_float32_scaleb_big(a, l2r_big_is_neg(bb))
    }
}

fn l2r_float32_scaleb_big(a : f32, neg : bool) -> f32 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { ((a as f64) * inf) as f32 }
}

// libm functions under their C names (the extern symbols of `Float.sin`, ...).
fn sin(x : f64) -> f64 { core::intrinsic::math::sin(x, 0) }
fn cos(x : f64) -> f64 { core::intrinsic::math::cos(x, 0) }
fn tan(x : f64) -> f64 { core::intrinsic::math::tan(x, 0) }
fn asin(x : f64) -> f64 { core::intrinsic::math::asin(x, 0) }
fn acos(x : f64) -> f64 { core::intrinsic::math::acos(x, 0) }
fn atan(x : f64) -> f64 { core::intrinsic::math::atan(x, 0) }
fn atan2(y : f64, x : f64) -> f64 { core::intrinsic::math::atan2(y, x, 0) }
fn sinh(x : f64) -> f64 { core::intrinsic::math::sinh(x, 0) }
fn cosh(x : f64) -> f64 { core::intrinsic::math::cosh(x, 0) }
fn tanh(x : f64) -> f64 { core::intrinsic::math::tanh(x, 0) }
#[ffi(import)]
fn asinh(x : f64) -> f64 [{ unsafe { leanrt::float::libm::asinh(x) } }];
#[ffi(import)]
fn acosh(x : f64) -> f64 [{ unsafe { leanrt::float::libm::acosh(x) } }];
#[ffi(import)]
fn atanh(x : f64) -> f64 [{ unsafe { leanrt::float::libm::atanh(x) } }];
fn exp(x : f64) -> f64 { core::intrinsic::math::exp(x, 0) }
fn exp2(x : f64) -> f64 { core::intrinsic::math::exp2(x, 0) }
fn log2(x : f64) -> f64 { core::intrinsic::math::log2(x, 0) }
fn log10(x : f64) -> f64 { core::intrinsic::math::log10(x, 0) }
fn pow(x : f64, y : f64) -> f64 { core::intrinsic::math::powf(x, y, 0) }
fn sqrt(x : f64) -> f64 { core::intrinsic::math::sqrt(x, 0) }
#[ffi(import)]
fn cbrt(x : f64) -> f64 [{ unsafe { leanrt::float::libm::cbrt(x) } }];
fn ceil(x : f64) -> f64 { core::intrinsic::math::ceil(x, 0) }
fn floor(x : f64) -> f64 { core::intrinsic::math::floor(x, 0) }
fn round(x : f64) -> f64 { core::intrinsic::math::round(x, 0) }
fn fabs(x : f64) -> f64 { core::intrinsic::math::absf(x, 0) }
#[ffi(import)]
fn log(x : f64) -> f64 [{ leanrt::float::ln(x) }];

fn sinf(x : f32) -> f32 { core::intrinsic::math::sin(x, 0) }
fn cosf(x : f32) -> f32 { core::intrinsic::math::cos(x, 0) }
fn tanf(x : f32) -> f32 { core::intrinsic::math::tan(x, 0) }
fn asinf(x : f32) -> f32 { core::intrinsic::math::asin(x, 0) }
fn acosf(x : f32) -> f32 { core::intrinsic::math::acos(x, 0) }
fn atanf(x : f32) -> f32 { core::intrinsic::math::atan(x, 0) }
fn atan2f(y : f32, x : f32) -> f32 { core::intrinsic::math::atan2(y, x, 0) }
fn sinhf(x : f32) -> f32 { core::intrinsic::math::sinh(x, 0) }
fn coshf(x : f32) -> f32 { core::intrinsic::math::cosh(x, 0) }
fn tanhf(x : f32) -> f32 { core::intrinsic::math::tanh(x, 0) }
#[ffi(import)]
fn asinhf(x : f32) -> f32 [{ unsafe { leanrt::float::libm::asinhf(x) } }];
#[ffi(import)]
fn acoshf(x : f32) -> f32 [{ unsafe { leanrt::float::libm::acoshf(x) } }];
#[ffi(import)]
fn atanhf(x : f32) -> f32 [{ unsafe { leanrt::float::libm::atanhf(x) } }];
fn expf(x : f32) -> f32 { core::intrinsic::math::exp(x, 0) }
fn exp2f(x : f32) -> f32 { core::intrinsic::math::exp2(x, 0) }
fn log2f(x : f32) -> f32 { core::intrinsic::math::log2(x, 0) }
fn log10f(x : f32) -> f32 { core::intrinsic::math::log10(x, 0) }
