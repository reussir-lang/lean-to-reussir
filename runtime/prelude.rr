#[ffi(import)]
fn lean_sarray_dec_eq(a : RVec<u8>, b : RVec<u8>) -> bool [{ { let r = leanrt::array::as_slice(&a) == leanrt::array::as_slice(&b); leanrt::array::release(a); leanrt::array::release(b); r } }];
#[ffi(import)]
