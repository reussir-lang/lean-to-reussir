fn l2r_nat_sat(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x >> 1 } else { l2r_nat_sat_raw(x) }
}

// `Array.replicate`'s size (`lean_mk_array`): a big `n` is checked by
// lean-runtime's `sem::array::replicate_len` (a small one by the
// allocation, `leanrt::array::check_alloc`).
#[ffi(import)]
fn l2r_replicate_len_raw(a : u64) -> u64 [{ leanrt::nat::nat_replicate_len(a) }];

fn l2r_replicate_len(n : Nat) -> u64 {
    let x = l2r_nat_raw(n);
    if (x & 1) == 1 { x >> 1 } else { l2r_replicate_len_raw(x) }
}

// ===========================================================================
// Int
//
// An `Int` is one word as well, Lean's own encoding (leanrt::nat): a value
// in the `int32` range is the odd word `lean_box((unsigned)(int)i)`, its
// 32-bit two's complement pattern zero-extended, shifted and tagged (so a
// `Nat` below 2^31 and the `Int` of the same value have the same word); an
// even word is a reference to a big number (any value outside `int32`).
// `l2r_int_val` reads a small word (`lean_scalar_to_int64`). Ownership of
// words as for `Nat`.

#[ffi(import)]
fn l2r_int_raw(i : Int) -> u64 [{ i.into_raw() }];
#[ffi(import)]
fn l2r_int_of_raw(w : u64) -> Int [{ unsafe { leanrt::nat::LInt::from_raw(w) } }];
#[ffi(import)]
fn l2r_int_drop_raw(w : u64) -> u64 [{ { drop(unsafe { leanrt::nat::LInt::from_raw(w) }); 0 } }];

// The value of a small word.
fn l2r_int_val(w : u64) -> i64 { (((w >> 1) as u32) as i32) as i64 }

// Whether `v` is in the small range, `int32`.
fn l2r_int_is_tag_small(v : i64) -> bool { ((v + 2147483648) as u64) < 4294967296 }

// A value in the `int32` range.
fn l2r_int_small(v : i64) -> Int { l2r_int_of_raw((((v as u32) as u64) << 1) | 1) }

#[ffi(import)]
fn l2r_int_big_of_i64(v : i64) -> Int [{ leanrt::nat::int_big_of_i64(v) }];

fn l2r_int_of_i64(v : i64) -> Int {
    if l2r_int_is_tag_small(v) { l2r_int_small(v) } else { l2r_int_big_of_i64(v) }
}

#[ffi(import)]
fn l2r_int_neg_raw(a : u64) -> Int [{ leanrt::nat::int_neg(a) }];
#[ffi(import)]
fn l2r_int_add_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_add(a, b) }];
#[ffi(import)]
fn l2r_int_sub_raw(a : u64, b : u64) -> Int [{ leanrt::nat::int_sub(a, b) }];
