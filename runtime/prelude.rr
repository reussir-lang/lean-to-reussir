fn lean_float32_negate(a : f32) -> f32 { -a }
fn lean_float32_beq(a : f32, b : f32) -> bool { a == b }
fn lean_float32_decLe(a : f32, b : f32) -> bool { a <= b }
fn lean_float32_decLt(a : f32, b : f32) -> bool { a < b }
fn lean_float32_isnan(a : f32) -> bool { a != a }
fn lean_float32_isfinite(a : f32) -> bool { let inf : f32 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) < inf }
fn lean_float32_isinf(a : f32) -> bool { let inf : f32 = 1.0 / 0.0; core::intrinsic::math::absf(a, 0) == inf }

#[ffi(import)]
fn lean_float_to_string(a : f64) -> LStr [{ leanrt::float::to_string(a) }];
#[ffi(import)]
fn lean_float32_to_string(a : f32) -> LStr [{ leanrt::float::to_string32(a) }];
#[ffi(import)]
fn lean_float_of_bits(u : u64) -> f64 [{ leanrt::float::of_bits(u) }];
#[ffi(import)]
fn lean_float_to_bits(a : f64) -> u64 [{ leanrt::float::to_bits(a) }];
#[ffi(import)]
fn lean_float32_of_bits(u : u32) -> f32 [{ leanrt::float::of_bits32(u) }];
// The bits of a float copied unchanged, NaN payloads included: what an
// `unsafeCast` between `Float` and `UInt64` (`Float32` and `UInt32`) reads
// natively, unlike `Float.ofBits`/`toBits`, which canonicalize NaN.
#[ffi(import)]
fn l2r_f64_of_raw_bits(u : u64) -> f64 [{ f64::from_bits(u) }];
#[ffi(import)]
fn l2r_f64_raw_bits(a : f64) -> u64 [{ a.to_bits() }];
#[ffi(import)]
fn l2r_f32_of_raw_bits(u : u32) -> f32 [{ f32::from_bits(u) }];
#[ffi(import)]
fn l2r_f32_raw_bits(a : f32) -> u32 [{ a.to_bits() }];
#[ffi(import)]
fn lean_float32_to_bits(a : f32) -> u32 [{ leanrt::float::to_bits32(a) }];
#[ffi(import)]
fn l2r_float_scalbn(a : f64, n : i32) -> f64 [{ leanrt::float::scalb(a, n) }];
#[ffi(import)]
fn l2r_float32_scalbn(a : f32, n : i32) -> f32 [{ leanrt::float::scalb32(a, n) }];
// `Float.frExp` returns a `Float × Int`: lean2rr's glue pairs these.
#[ffi(import)]
fn l2r_float_frexp_mant(a : f64) -> f64 [{ leanrt::float::frexp_mant(a) }];
#[ffi(import)]
fn l2r_float_frexp_exp_i64(a : f64) -> i64 [{ leanrt::float::frexp_exp(a) }];
#[ffi(import)]
fn l2r_float32_frexp_mant(a : f32) -> f32 [{ leanrt::float::frexp_mant32(a) }];
#[ffi(import)]
fn l2r_float32_frexp_exp_i64(a : f32) -> i64 [{ leanrt::float::frexp_exp32(a) }];
fn l2r_float_frexp_exp(a : f64) -> Int { l2r_int_of_i64(l2r_float_frexp_exp_i64(a)) }
fn l2r_float32_frexp_exp(a : f32) -> Int { l2r_int_of_i64(l2r_float32_frexp_exp_i64(a)) }

// `Float.scaleB x i`: an `i` outside the `int32` range is a big number and
// takes the big-number branch of `lean_float_scaleb`: 0 when `x == 0` or
// `i < 0`, else `x * inf`.
fn lean_float_scaleb(a : f64, b : Int) -> f64 {
    let x = l2r_int_raw(b);
    if (x & 1) == 1 { l2r_float_scalbn(a, l2r_int_val(x) as i32) } else { l2r_float_scaleb_big(a, l2r_int_is_neg_raw(x)) }
}

fn l2r_float_scaleb_big(a : f64, neg : bool) -> f64 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { a * inf }
}

fn lean_float32_scaleb(a : f32, b : Int) -> f32 {
    let x = l2r_int_raw(b);
    if (x & 1) == 1 { l2r_float32_scalbn(a, l2r_int_val(x) as i32) } else { l2r_float32_scaleb_big(a, l2r_int_is_neg_raw(x)) }
}

fn l2r_float32_scaleb_big(a : f32, neg : bool) -> f32 {
    let inf : f64 = 1.0 / 0.0;
    if a == 0.0 || neg { 0.0 } else { ((a as f64) * inf) as f32 }
}

// libm functions under their C names (the extern symbols of `Float.sin`,
// `Float32.pow`, ...). The exact operations (sqrt, ceil, floor, round, fabs)
// are LLVM intrinsics. The others call the C library's function through
// `leanrt::float::libm`, opaquely: LLVM would fold a call whose operand it
// knows (an `f32` one in double precision, `exp2` through `pow`) and rewrite
// `pow` with a constant operand (`pow(x, 0.5)` into `sqrt`, `pow(2.0, y)`
// into `exp2`, ...), and glibc's results differ from those in the last bit
// on some inputs (cross-tests XT-3, XT-4). Natively they are glibc's, run
// at run time even on literal operands.
#[ffi(import)]
fn sin(x : f64) -> f64 [{ leanrt::float::libm::sin(x) }];
#[ffi(import)]
fn cos(x : f64) -> f64 [{ leanrt::float::libm::cos(x) }];
#[ffi(import)]
fn tan(x : f64) -> f64 [{ leanrt::float::libm::tan(x) }];
#[ffi(import)]
fn asin(x : f64) -> f64 [{ leanrt::float::libm::asin(x) }];
#[ffi(import)]
fn acos(x : f64) -> f64 [{ leanrt::float::libm::acos(x) }];
#[ffi(import)]
fn atan(x : f64) -> f64 [{ leanrt::float::libm::atan(x) }];
#[ffi(import)]
fn sinh(x : f64) -> f64 [{ leanrt::float::libm::sinh(x) }];
#[ffi(import)]
fn cosh(x : f64) -> f64 [{ leanrt::float::libm::cosh(x) }];
#[ffi(import)]
fn tanh(x : f64) -> f64 [{ leanrt::float::libm::tanh(x) }];
#[ffi(import)]
fn asinh(x : f64) -> f64 [{ leanrt::float::libm::asinh(x) }];
#[ffi(import)]
fn acosh(x : f64) -> f64 [{ leanrt::float::libm::acosh(x) }];
#[ffi(import)]
fn atanh(x : f64) -> f64 [{ leanrt::float::libm::atanh(x) }];
#[ffi(import)]
fn exp(x : f64) -> f64 [{ leanrt::float::libm::exp(x) }];
#[ffi(import)]
fn exp2(x : f64) -> f64 [{ leanrt::float::libm::exp2(x) }];
#[ffi(import)]
fn log(x : f64) -> f64 [{ leanrt::float::libm::log(x) }];
#[ffi(import)]
fn log2(x : f64) -> f64 [{ leanrt::float::libm::log2(x) }];
#[ffi(import)]
fn log10(x : f64) -> f64 [{ leanrt::float::libm::log10(x) }];
#[ffi(import)]
fn cbrt(x : f64) -> f64 [{ leanrt::float::libm::cbrt(x) }];
#[ffi(import)]
fn atan2(y : f64, x : f64) -> f64 [{ leanrt::float::libm::atan2(y, x) }];
#[ffi(import)]
fn pow(x : f64, y : f64) -> f64 [{ leanrt::float::libm::pow(x, y) }];
fn sqrt(x : f64) -> f64 { core::intrinsic::math::sqrt(x, 0) }
fn ceil(x : f64) -> f64 { core::intrinsic::math::ceil(x, 0) }
fn floor(x : f64) -> f64 { core::intrinsic::math::floor(x, 0) }
fn round(x : f64) -> f64 { core::intrinsic::math::round(x, 0) }
fn fabs(x : f64) -> f64 { core::intrinsic::math::absf(x, 0) }

#[ffi(import)]
fn sinf(x : f32) -> f32 [{ leanrt::float::libm::sinf(x) }];
#[ffi(import)]
fn cosf(x : f32) -> f32 [{ leanrt::float::libm::cosf(x) }];
#[ffi(import)]
fn tanf(x : f32) -> f32 [{ leanrt::float::libm::tanf(x) }];
#[ffi(import)]
fn asinf(x : f32) -> f32 [{ leanrt::float::libm::asinf(x) }];
#[ffi(import)]
fn acosf(x : f32) -> f32 [{ leanrt::float::libm::acosf(x) }];
#[ffi(import)]
fn atanf(x : f32) -> f32 [{ leanrt::float::libm::atanf(x) }];
#[ffi(import)]
fn sinhf(x : f32) -> f32 [{ leanrt::float::libm::sinhf(x) }];
#[ffi(import)]
fn coshf(x : f32) -> f32 [{ leanrt::float::libm::coshf(x) }];
#[ffi(import)]
fn tanhf(x : f32) -> f32 [{ leanrt::float::libm::tanhf(x) }];
#[ffi(import)]
fn asinhf(x : f32) -> f32 [{ leanrt::float::libm::asinhf(x) }];
#[ffi(import)]
fn acoshf(x : f32) -> f32 [{ leanrt::float::libm::acoshf(x) }];
#[ffi(import)]
fn atanhf(x : f32) -> f32 [{ leanrt::float::libm::atanhf(x) }];
#[ffi(import)]
fn expf(x : f32) -> f32 [{ leanrt::float::libm::expf(x) }];
#[ffi(import)]
fn exp2f(x : f32) -> f32 [{ leanrt::float::libm::exp2f(x) }];
#[ffi(import)]
fn logf(x : f32) -> f32 [{ leanrt::float::libm::logf(x) }];
#[ffi(import)]
