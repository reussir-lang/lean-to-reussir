// ===========================================================================
// Debugging, platform

// `dbgTrace msg f`: print `msg` to stderr, then `f ()`.
fn lean_dbg_trace<T>(msg : LStr, f : L2RUnit -> T) -> T {
    let ignored = l2r_diag_println(msg);
    f(L2RUnit::u{})
}

// `dbgTraceIfShared msg a`: prints `shared RC <msg>` when `a` is a heap
// object whose reference count is not 1 (scalars never are). Reference-counted
// storage types (runtime handles and Reussir records) have their u32 count at
// offset 0 of the object they point to. Nullary constructors are Reussir
// immediates, scalars in Lean: a pointer with a nonzero top byte (the `tbi`
// encoding) or to a dummy box with an immortal count (>= 2^31).
// This must be an FFI import (lean2rr then passes values that cannot cross
// the boundary in fresh wrappers, which are never shared: native Lean's
// small `Nat`s are scalars), so the message reaches the current stderr
// stream from Rust (`leanrt::io::diag_put`). The pieces below
// (`l2r_shared_check<S>(a)`, `l2r_last_shared()`, `l2r_shared_rc_text`)
// allow the same from Reussir code.
#[ffi(import)]
fn lean_dbg_trace_if_shared<T>(msg : LStr, a : T) -> T [{
    {
        let name = ::std::any::type_name::<[:T:]>();
        let boxed = name.starts_with("reussir_rt::") && ::std::mem::size_of::<[:T:]>() == ::std::mem::size_of::<usize>();
        let p = if boxed { unsafe { *(&a as *const [:T:] as *const usize) } } else { 0 };
        let shared = boxed && (p >> 56) == 0 && {
            let c = unsafe { *(p as *const u32) };
            c != 1 && c < 0x8000_0000
        };
        if shared {
            let mut line = b"shared RC ".to_vec();
            line.extend_from_slice(&msg.utf8()[..msg.utf8().iter().position(|&b| b == 0).unwrap_or(msg.utf8().len())]);
            line.push(b'\n');
            leanrt::io::diag_put(leanrt::string::from_bytes(&line));
        }
        leanrt::rc_release(msg);
        a
    }
}];

#[ffi(import)]
fn l2r_shared_check<T>(a : T) -> T [{
    {
        let name = ::std::any::type_name::<[:T:]>();
        let boxed = name.starts_with("reussir_rt::") && ::std::mem::size_of::<[:T:]>() == ::std::mem::size_of::<usize>();
        let p = if boxed { unsafe { *(&a as *const [:T:] as *const usize) } } else { 0 };
        let shared = boxed && (p >> 56) == 0 && {
            let c = unsafe { *(p as *const u32) };
            c != 1 && c < 0x8000_0000
        };
        leanrt::set_last_shared(shared);
        a
    }
}];

#[ffi(import)]
fn l2r_last_shared() -> bool [{ leanrt::last_shared() }];

#[ffi(import)]
fn l2r_shared_rc_text(msg : LStr) -> LStr [{
    {
        let mut line = b"shared RC ".to_vec();
        line.extend_from_slice(&msg.utf8()[..msg.utf8().iter().position(|&b| b == 0).unwrap_or(msg.utf8().len())]);
        line.push(b'\n');
        leanrt::rc_release(msg);
        leanrt::string::from_bytes(&line)
    }
}];

// `Void.mk` (`runST`'s initial world): the world has no representation.
fn lean_void_mk<T>(x : T) -> L2RUnit { L2RUnit::u{} }

fn lean_dbg_stack_trace<T>(f : L2RUnit -> T) -> T { f(L2RUnit::u{}) }

#[ffi(import)]
fn l2r_sleep_ms(ms : u32) -> u64 [{ { leanrt::task::sleep_ms(ms); 0 } }];

fn lean_dbg_sleep<T>(ms : u32, f : L2RUnit -> T) -> T {
    let ignored = l2r_sleep_ms(ms);
    f(L2RUnit::u{})
}

// `ptrAddrUnsafe` (lean2rr's `addrOf`): what native Lean answers. A value
// natively represented by a boxed scalar answers that word, `lean_box(n) =
// 2n+1`: a `Nat` below 2^63, an `Int` in the `int32` range (its 32 bits),
// `UInt8/16/32`, `Char`, `Bool`, enumerations (their index), nullary
// constructors (their index), `Unit` (`box(0) = 1`). A heap value answers its
// handle pointer (below). A `[value]` struct answers its field's. `UInt64`,
// `Float` and the like are natively boxed into a new cell at every call
// (`ptrEq x x` is only true once Lean's CSE merged the two calls): they
// answer a fresh number (`l2r_addr_fresh`), and a `Box` holding one answers
// the `Box` cell (natively the cell that boxing made).

fn l2r_addr_word(w : u64) -> u64 { w + w + 1 }

#[ffi(import)]
fn l2r_addr_fresh() -> u64 [{ leanrt::fresh_addr() }];

// A `Nat` from 2^63 to 2^64 is natively a big number object (one per
// computation); here it has no object, so it answers a number computed from
// its value: even (never a boxed scalar), and scrambled, so that the values
// that land on real pointers (a `Big` handle's address) are unlikely ones.
// Equal values are therefore `ptrEq` (natively only the same object is).
fn l2r_addr_nat(n : Nat) -> u64 {
    match n {
        Nat::Small(x) => if (x >> 63) == 0 { x + x + 1 } else { (x + x) ^ 6510615555426900570 },
        Nat::Big(b) => l2r_ptr_addr_obj<LBig>(b)
    }
}

// An `Int` in the `int32` range is natively the boxed scalar of its 32 bits
// (`lean_int64_to_int`); others are big number objects. An `i64` outside
// that range answers a number computed from its value (as `l2r_addr_nat`):
// the bits rotated left by one, which is injective, except that the 2^32
// values landing on a boxed `int32` word are moved to the words the
// rotation gives the `int32` values themselves (unused otherwise).
fn l2r_addr_int(i : Int) -> u64 {
    match i {
        Int::Small(x) => if ((x as i32) as i64) == x { l2r_addr_word((x as u32) as u64) } else { l2r_addr_int_wide(x) },
        Int::Big(b) => l2r_ptr_addr_obj<LBig>(b)
    }
}

fn l2r_addr_int_wide(x : i64) -> u64 {
    let u : u64 = x as u64;
    let r : u64 = (u << 1) | (u >> 63);
    let lim : u64 = 8589934592;
    if (r & 1) == 1 {
        if r < lim {
            let w : u64 = r >> 1;
            if w < 2147483648 { w + w } else { (w + w + 1) - lim }
        } else { r }
    } else { r }
}

// `ptrAddrUnsafe` of a heap value that lean2rr passes as it is (not a
// wrapper built for the call): its handle pointer, whatever its count. The
// value is the Lean object itself, so its address is its identity even when
// this call holds its last reference (`ptrEq a b` where `a`'s own call
// released the other reference to the same object).
//
// A value lean2rr converted to another representation answers the address
// of the value it was converted from (`leanrt::origin`).
#[ffi(import)]
fn l2r_ptr_addr_obj<T>(a : T) -> u64 [{
    {
        let size = ::std::mem::size_of::<[:T:]>();
        if size == ::std::mem::size_of::<usize>() {
            let p = unsafe { *(&a as *const [:T:] as *const usize) };
            leanrt::origin::addr(p).unwrap_or(p as u64)
        } else {
            leanrt::fresh_addr()
        }
    }
}];

// The same for a shared Reussir record (a generated struct or enum). The
// reference the call received is given back inline when others remain (a
// record's count is the `u32` at its address; static cells and immediates,
// tagged in the top byte, and a last reference go through the record's
// release), so that the call costs no out-of-line release: `ptrEq` in a
// traversal (`Expr.replace`) spent 40% of its time there.
#[ffi(import)]
fn l2r_ptr_addr_rec<T>(a : T) -> u64 [{
    {
        let p = unsafe { *(&a as *const [:T:] as *const usize) };
        let id = leanrt::origin::addr(p).unwrap_or(p as u64);
        if (p >> 56) == 0 {
            let c = unsafe { *(p as *const u32) };
            if c > 1 {
                unsafe { *(p as *mut u32) = c - 1 };
                ::std::mem::forget(a);
            }
        }
        id
    }
}];

// The release, after a call, of an argument the callee only borrows
// natively (lean2rr's Lower/Borrow): an effectful FFI call, so it stays
// after the call. Returns 0.
#[ffi(import)]
fn l2r_release_after<T>(x : T) -> u64 [{ { drop(x); 0 } }];

// Conversion origins (`leanrt::origin`): `l2r_origin_note(src, dst, code)`
// records that `dst` was converted from `src` (whose representation
// lean2rr numbers `code`) and returns `dst`; `l2r_origin_back(x, code)`
// says whether `x` was converted from a value of representation `code`,
// which `l2r_origin_take(x)` then gives back.
#[ffi(import)]
fn l2r_origin_note<S, D>(src : S, dst : D, code : u64) -> D [{ leanrt::origin::note::<[:S:], [:D:]>(src, dst, code) }];
#[ffi(import)]
fn l2r_origin_back<S>(x : S, code : u64) -> bool [{ leanrt::origin::back::<[:S:]>(x, code) }];
#[ffi(import)]
fn l2r_origin_take<S, D>(x : S) -> D [{ leanrt::origin::take::<[:S:], [:D:]>(x) }];

// A shared record or array used at another Reussir type with the same
// layout (lean2rr's `retypable`: instantiations differing only in phantom
// positions, isomorphic inductives read through `unsafeCast`): the same
// object, reinterpreted. Their drop and copy glue do the same.
#[ffi(import)]
fn l2r_retype<S, D>(x : S) -> D [{ unsafe { ::std::mem::transmute::<[:S:], [:D:]>(x) } }];

// Sharing is not observable here: answering "shared" / "not a scalar" only
// makes such code take its general path.
fn lean_is_exclusive_obj<T>(a : T) -> bool { false }
fn lean_is_scalar<T>(a : T) -> bool { false }
fn lean_sharecommon_quick<T>(a : T) -> T { a }

