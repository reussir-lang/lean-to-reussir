// The platform queries. leanrt builds only for Linux with glibc on aarch64
// and x86-64 (`leanrt::rt::PLATFORM_TARGET`), so Windows, macOS and
// Emscripten are false, Linux (`isLinux`, new in Lean 4.34) is true, and
// `numBits` (`lean_system_platform_nbits`) is 64 (`USize` is `u64` here).
// `System.Platform.target` is natively `LEAN_PLATFORM_TARGET`, the
// toolchain's target triple: the one the native toolchain for leanrt's
// target reports.
fn lean_system_platform_windows(u : L2RUnit) -> bool { false }
fn lean_system_platform_osx(u : L2RUnit) -> bool { false }
fn lean_system_platform_linux(u : L2RUnit) -> bool { true }
fn lean_system_platform_emscripten(u : L2RUnit) -> bool { false }
fn lean_internal_is_stage0(u : L2RUnit) -> bool { false }
fn lean_internal_has_llvm_backend(u : L2RUnit) -> bool { false }
fn lean_version_get_major(u : L2RUnit) -> Nat { l2r_nat_small(4) }
fn lean_version_get_minor(u : L2RUnit) -> Nat { l2r_nat_small(34) }
fn lean_version_get_patch(u : L2RUnit) -> Nat { l2r_nat_small(0) }
fn lean_version_get_is_release(u : L2RUnit) -> bool { true }
fn lean_version_get_special_desc(u : L2RUnit) -> LStr { lean_mk_string("") }
#[ffi(import)]
fn l2r_platform_target() -> LStr [{ leanrt::string::from_bytes(leanrt::rt::PLATFORM_TARGET.as_bytes()) }];
fn lean_system_platform_target(u : L2RUnit) -> LStr { l2r_platform_target() }

#[ffi(import)]
