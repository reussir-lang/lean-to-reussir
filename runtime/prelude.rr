fn l2r_shim_tcp_wait_readable(s : LHandle, r : LPromise) -> LHandle [{ { let o = leanrt::net::tcp_wait_readable(&s, r); leanrt::rc_release(s); o } }];
#[ffi(import)]
fn l2r_shim_tcp_cancel_recv_h(s : LHandle) -> u64 [{ { leanrt::net::tcp_cancel_recv(&s); leanrt::rc_release(s); 0 } }];
fn l2r_shim_tcp_cancel_recv(s : LHandle) -> L2RUnit { l2r_unit_of(l2r_shim_tcp_cancel_recv_h(s)) }
#[ffi(import)]
fn l2r_shim_tcp_accept(s : LHandle, r : LPromise) -> LHandle [{ { let o = leanrt::net::tcp_accept(&s, r); leanrt::rc_release(s); o } }];
#[ffi(import)]
fn l2r_shim_tcp_try_accept(s : LHandle) -> LHandle [{ { let o = leanrt::net::tcp_try_accept(&s); leanrt::rc_release(s); o } }];
#[ffi(import)]
fn l2r_shim_tcp_cancel_accept_h(s : LHandle) -> u64 [{ { leanrt::net::tcp_cancel_accept(&s); leanrt::rc_release(s); 0 } }];
